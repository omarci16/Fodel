# Copy to .env and fill in. Never commit .env.

# Transactional email (https://resend.com) — powers all four forms.
# Without it the endpoints still validate and respond, but log instead of send.
RESEND_API_KEY=

# Where form submissions are delivered.
FODEL_INBOX=info@fodel.nl

# Verified sender domain in Resend. Must be a domain FODEL controls.
FODEL_FROM="FODEL Website <website@fodel.nl>"
