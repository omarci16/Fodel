# Copy to .env and fill in. Never commit .env.

# Supabase (https://supabase.com) — the database behind properties, the
# admin system and the seller portal. Project Settings → API in your
# Supabase dashboard has all three values.
#
# SUPABASE_URL and SUPABASE_ANON_KEY are what the public website uses to read
# published listings. The anon key is low-privilege by design — every query
# it makes is still filtered by the database's own security rules (Row-Level
# Security), so this key is safe even though it lives in server code that
# talks to a public database.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# The service-role key BYPASSES every security rule — it can read and write
# anything. Not required to run the public website (Stage 1). Collected now
# because Stage 2 onward (the admin system and seller portal) need it for
# privileged server-side actions. Never put this key in any file that ships
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (https://resend.com) — powers all four forms.
# Without it the endpoints still validate and respond, but log instead of send.
RESEND_API_KEY=

# Where form submissions are delivered.
FODEL_INBOX=info@fodel.nl

# Verified sender domain in Resend. Must be a domain FODEL controls.
FODEL_FROM="FODEL Website <website@fodel.nl>"

# Self-hosted map basemap (Stage 7). Public URL of the .pmtiles file built by
# `npm run build:pmtiles` and uploaded to Cloudflare R2 (or any public host).
# Until this is set, every <Map> on the site shows a plain "unavailable"
# message instead of a blank/broken tile grid.
PMTILES_URL=

# Stripe (Stage 8) — plumbing only, inert unless STRIPE_ENABLED=true. FODEL's
# live payment process is bank transfer; leave this "false" (or unset) to
# keep it that way. Only set the two keys below if you deliberately turn
# card payment on.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
