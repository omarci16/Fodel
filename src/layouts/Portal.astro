---
/**
 * Portal shell — sidebar, page ground and the small amount of script every
 * screen shares (menus, the confirm dialog, the mobile drawer).
 *
 * 3.0: the top bar became a floating ink sidebar, in the landing page's own
 * language (slab, radius scale, pill buttons, ink-tinted shadows). Menu items
 * are grouped by what they ask of you — things waiting on you, the data, the
 * content, the money — and carry a red counter when somebody is waiting.
 *
 * Always noindex: nothing under /portal/ is for search engines.
 */
import '~/styles/global.css';
import '~/styles/portal.css';
import { icon, type IconName } from '~/lib/portal/icons';
import FontPreload from '~/components/FontPreload.astro';

interface Props {
  title: string;
  /** Hide the chrome — used by the login and invite-accept screens. */
  bare?: boolean;
  /** Document language. The portal works in Hungarian; only invite acceptance follows the invitee. */
  lang?: string;
}

const { title, bare = false, lang = 'hu' } = Astro.props;
const { profile, supabase } = Astro.locals;
const isAdmin = profile?.role === 'admin';

/** A head-count that can never take a page down: a failed count is a zero. */
async function count(query: PromiseLike<{ count: number | null }>): Promise<number> {
  try {
    return (await query).count ?? 0;
  } catch {
    return 0;
  }
}
const head = { count: 'exact', head: true } as const;

let waiting = { inbox: 0, enquiries: 0, valuations: 0, services: 0, payment: 0 };
if (!bare && profile && supabase) {
  const [enquiries, inbox, valuations, services, payment] = await Promise.all([
    count(supabase.from('enquiries').select('id', head).eq('handled', false)),
    isAdmin ? count(supabase.from('properties').select('id', head).eq('status', 'submitted')) : 0,
    isAdmin
      ? count(supabase.from('valuations').select('id', head).in('status', ['queued', 'needs_review', 'insufficient_data']))
      : 0,
    isAdmin ? count(supabase.from('service_requests').select('id', head).eq('status', 'requested')) : 0,
    !isAdmin ? count(supabase.from('properties').select('id', head).eq('status', 'awaiting_payment')) : 0,
  ]);
  waiting = { inbox, enquiries, valuations, services, payment };
}

type Item = { href: string; label: string; icon: IconName; count?: number; match?: string[] };
type Group = { label?: string; items: Item[] };

const GROUPS: Group[] = isAdmin
  ? [
      { items: [{ href: '/portal/dashboard', label: 'Áttekintés', icon: 'home' }] },
      {
        label: 'Teendők',
        items: [
          { href: '/portal/inbox', label: 'Beérkező hirdetések', icon: 'inbox', count: waiting.inbox, match: ['/portal/review'] },
          { href: '/portal/enquiries', label: 'Érdeklődők', icon: 'phone', count: waiting.enquiries },
          { href: '/portal/valuations', label: 'Értékbecslések', icon: 'calc', count: waiting.valuations },
          { href: '/portal/services', label: 'Helyszíni szolgáltatások', icon: 'camera', count: waiting.services },
        ],
      },
      {
        label: 'Adatok',
        items: [
          { href: '/portal/properties', label: 'Ingatlanok', icon: 'building' },
          { href: '/portal/database', label: 'Adatbázis', icon: 'database' },
          { href: '/portal/users', label: 'Felhasználók', icon: 'users' },
        ],
      },
      {
        label: 'Tartalom és pénz',
        items: [
          { href: '/portal/top10', label: 'Top 10', icon: 'star' },
          { href: '/portal/content/blog', label: 'Blog', icon: 'pen' },
          { href: '/portal/payments', label: 'Fizetések', icon: 'card', match: ['/portal/invoices'] },
        ],
      },
      { items: [{ href: '/portal/settings', label: 'Beállítások', icon: 'gear', match: ['/portal/taxonomy'] }] },
    ]
  : [
      { items: [{ href: '/portal/dashboard', label: 'Áttekintés', icon: 'home' }] },
      {
        label: 'Hirdetéseim',
        items: [
          { href: '/portal/properties', label: 'Ingatlanaim', icon: 'building', count: waiting.payment },
          { href: '/portal/enquiries', label: 'Érdeklődők', icon: 'phone', count: waiting.enquiries },
        ],
      },
      { items: [{ href: '/portal/settings', label: 'Beállítások', icon: 'gear' }] },
    ];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (item: Item) =>
  [item.href, ...(item.match ?? [])].some((p) => current === p || current.startsWith(`${p}/`));

const urgent = waiting.inbox + waiting.enquiries + waiting.valuations + waiting.services + waiting.payment;
const displayName = profile?.full_name || profile?.email || '';
const initials =
  displayName
    .split(/[\s@.]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join('') || 'F';

// The public homepage in the signed-in person's own language. Plain
// navigation: the session stays, unlike the logout button beside it.
const homeHref = profile?.locale === 'nl' ? '/nl/' : '/hu/';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {lang === 'hu' ? 'FODEL portál' : 'FODEL'}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <FontPreload />
  </head>
  <body class:list={['portal', { bare }]} data-drawer="closed">
    <div class="pt-progress" aria-hidden="true"><i></i></div>
    {
      bare ? (
        <main class="pm bare">
          <slot />
        </main>
      ) : (
        <div class="pt-shell">
          <aside class="pt-side" id="pt-side" aria-label="Portál menü">
            <div class="pt-side-in surface-ink">
              <div class="pt-brand">
                <a href="/portal/dashboard" aria-label="FODEL — áttekintés">
                  <span class="word">FODEL</span>
                  <span class="rule" aria-hidden="true" />
                  <span class="sub">Ingatlan</span>
                </a>
                <span class="tag">{isAdmin ? 'Admin' : 'Hirdető'}</span>
              </div>

              <button type="button" class="pt-search" data-palette-open aria-label="Gyors ugrás megnyitása">
                <Fragment set:html={icon('search', 17)} />
                <span>Ugrás bárhová</span>
                <kbd>⌘K</kbd>
              </button>

              <nav class="pt-nav" aria-label="Portál navigáció">
                <span class="pt-glide" aria-hidden="true" />
                {GROUPS.map((group) => (
                  <div class="pt-nav-group">
                    {group.label && <p class="pt-nav-label">{group.label}</p>}
                    <ul>
                      {group.items.map((item) => (
                        <li>
                          <a
                            class="pt-link"
                            href={item.href}
                            data-astro-prefetch="hover"
                            aria-current={isActive(item) ? 'page' : undefined}
                          >
                            <Fragment set:html={icon(item.icon, 19)} />
                            <span class="txt">{item.label}</span>
                            {item.count ? (
                              <span class="pt-count" aria-label={`${item.count} vár`}>
                                {item.count}
                              </span>
                            ) : null}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </nav>

              <div class="pt-side-foot">
                <div class="pt-me">
                  <span class="pt-avatar" aria-hidden="true">
                    {initials}
                  </span>
                  <span class="pt-me-name">
                    <b>{displayName}</b>
                    <span>{isAdmin ? 'Adminisztrátor' : 'Hirdető'}</span>
                  </span>
                  <a class="pt-me-btn" href={homeHref} title="Vissza a weboldalra" aria-label="Vissza a weboldalra">
                    <Fragment set:html={icon('external', 17)} />
                  </a>
                  <form method="POST" action="/portal/logout">
                    <button type="submit" class="pt-me-btn" title="Kilépés" aria-label="Kilépés">
                      <Fragment set:html={icon('logout', 17)} />
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </aside>
          <div class="pt-scrim" data-drawer-close />

          <div class="pt-main-wrap">
            <div class="pt-mobilebar">
              <span class="word">FODEL</span>
              <button type="button" class="pt-burger" data-drawer-toggle aria-controls="pt-side" aria-label="Menü megnyitása">
                <Fragment set:html={icon('menu', 18)} />
                Menü
                {urgent > 0 && <span class="pt-count">{urgent}</span>}
              </button>
            </div>
            <main class="pm">
              <slot />
            </main>
          </div>
        </div>
      )
    }
  </body>
</html>

<script>
  import { icon, type IconName } from '~/lib/portal/icons';

  /* ── Feedback the moment something is pressed ────────────────────────────
     Navigations and requests start a progress bar at once; if a page takes
     longer than a blink, a skeleton stands in for it. Pages that arrive from
     a prefetch show neither — they are already there. */
  let busy = 0;
  let leaveTimer: number | undefined;
  const setBusy = (on: boolean) => {
    busy = Math.max(0, busy + (on ? 1 : -1));
    body.dataset.busy = busy > 0 ? 'true' : 'false';
  };
  const reset = () => {
    window.clearTimeout(leaveTimer);
    busy = 0;
    body.dataset.busy = 'false';
    document.querySelectorAll('.is-pending').forEach((el) => el.classList.remove('is-pending'));
    const main = document.querySelector<HTMLElement>('main.pm');
    main?.removeAttribute('data-leaving');
    main?.querySelector(':scope > .pt-skel')?.remove();
  };
  // Back/forward restores the page from memory: undo whatever was showing when it was left.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) reset();
  });

  const showSkeleton = () => {
    const main = document.querySelector<HTMLElement>('main.pm');
    if (!main || main.classList.contains('bare') || main.querySelector(':scope > .pt-skel')) return;
    const skeleton = document.createElement('div');
    skeleton.className = 'pt-skel';
    skeleton.setAttribute('aria-hidden', 'true');
    skeleton.innerHTML =
      '<b class="s-eyebrow"></b><b class="s-title"></b>' +
      '<div class="s-stats"><b></b><b></b><b></b></div>' +
      '<div class="s-rows"><b></b><b></b><b></b><b></b></div>';
    main.dataset.leaving = '';
    main.append(skeleton);
  };

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!link || link.target === '_blank' || link.hasAttribute('download') || link.dataset.noProgress !== undefined) return;
    const url = new URL(link.href, location.href);
    if (url.origin !== location.origin || !url.pathname.startsWith('/portal/') || url.pathname.startsWith('/portal/logout')) return;
    if (url.pathname === location.pathname && url.search === location.search) return;
    setBusy(true);
    leaveTimer = window.setTimeout(showSkeleton, 140);
    // A navigation that never lands (a blocked download, say) must not leave the bar running.
    window.setTimeout(reset, 15000);
  });

  document.addEventListener('submit', (event) => {
    if (event.defaultPrevented) return;
    const form = event.target as HTMLFormElement;
    if (form.target === '_blank') return;
    const submitter = (event as SubmitEvent).submitter as HTMLElement | null;
    // The class, never `disabled`: a disabled submitter would be left out of the form data.
    (submitter ?? form.querySelector<HTMLElement>('button[type="submit"], button:not([type])'))?.classList.add('is-pending');
    setBusy(true);
    window.setTimeout(reset, 15000);
  });

  // Requests the page makes itself (approve, move, save…) show the same bar.
  const nativeFetch = window.fetch.bind(window);
  window.fetch = (input, init) => {
    const target = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
    if (!target.includes('/api/portal')) return nativeFetch(input, init);
    setBusy(true);
    return nativeFetch(input, init).finally(() => setBusy(false));
  };

  /* ── Mobile drawer ─────────────────────────────────────────────────── */
  const body = document.body;
  const setDrawer = (open: boolean) => {
    body.dataset.drawer = open ? 'open' : 'closed';
    document.querySelector('[data-drawer-toggle]')?.setAttribute('aria-expanded', String(open));
  };
  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    if (target.closest('[data-drawer-toggle]')) setDrawer(body.dataset.drawer !== 'open');
    else if (target.closest('[data-drawer-close]')) setDrawer(false);
  });

  /* ── Gliding hover pill in the sidebar ─────────────────────────────── */
  const nav = document.querySelector<HTMLElement>('.pt-nav');
  const glide = nav?.querySelector<HTMLElement>('.pt-glide');
  if (nav && glide) {
    const move = (link: HTMLElement) => {
      glide.style.transform = `translateY(${link.offsetTop}px)`;
      glide.style.height = `${link.offsetHeight}px`;
      glide.dataset.on = 'true';
    };
    nav.querySelectorAll<HTMLElement>('.pt-link').forEach((link) => {
      link.addEventListener('pointerenter', () => move(link));
      link.addEventListener('focus', () => move(link));
    });
    nav.addEventListener('pointerleave', () => (glide.dataset.on = 'false'));
    nav.addEventListener('focusout', () => (glide.dataset.on = 'false'));
  }

  /* ── Menus (⋯) ─────────────────────────────────────────────────────── */
  let openMenu: { button: HTMLElement; pop: HTMLElement } | null = null;

  function closeMenu(returnFocus = false) {
    if (!openMenu) return;
    openMenu.pop.hidden = true;
    openMenu.button.setAttribute('aria-expanded', 'false');
    if (returnFocus) openMenu.button.focus();
    openMenu = null;
  }

  function placeMenu(button: HTMLElement, pop: HTMLElement) {
    const rect = button.getBoundingClientRect();
    const { offsetWidth: w, offsetHeight: h } = pop;
    const below = rect.bottom + 6;
    const top = below + h > window.innerHeight - 12 ? Math.max(12, rect.top - h - 6) : below;
    const left = Math.min(Math.max(12, rect.right - w), window.innerWidth - w - 12);
    pop.style.top = `${top}px`;
    pop.style.left = `${left}px`;
  }

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const button = target.closest<HTMLElement>('[data-menu]');
    if (button) {
      const pop = button.nextElementSibling as HTMLElement | null;
      if (!pop) return;
      const wasOpen = openMenu?.button === button;
      closeMenu();
      if (wasOpen) return;
      pop.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      placeMenu(button, pop);
      openMenu = { button, pop };
      pop.querySelector<HTMLElement>('a, button')?.focus({ preventScroll: true });
      return;
    }
    if (openMenu && !target.closest('.pt-menu-pop')) closeMenu();
    // Choosing an item closes the menu; the item's own handler still runs.
    else if (openMenu && target.closest('.pt-menu-pop :is(a, button)')) closeMenu();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu(true);
      setDrawer(false);
    }
    if (openMenu && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
      event.preventDefault();
      const items = [...openMenu.pop.querySelectorAll<HTMLElement>('a, button')];
      const at = items.indexOf(document.activeElement as HTMLElement);
      const next = event.key === 'ArrowDown' ? (at + 1) % items.length : (at - 1 + items.length) % items.length;
      items[next]?.focus();
    }
  });
  window.addEventListener('resize', () => closeMenu());
  window.addEventListener('scroll', () => closeMenu(), { passive: true, capture: true });

  /* ── window.pf — the portal's own dialogs ──────────────────────────────
     One <dialog>, reconfigured per question. Replaces confirm()/prompt(),
     which look foreign and cannot ask for a typed name. */
  type Ask = {
    tone?: 'danger' | 'default';
    title: string;
    body: string;
    /** Typing this exactly is what unlocks the confirm button. */
    expected?: string;
    /** A free-text answer (e.g. a note to the owner). */
    field?: { label: string; multiline?: boolean; required?: boolean; value?: string; placeholder?: string };
    icon?: IconName;
    confirmLabel: string;
    cancelLabel?: string;
  };

  let dialog: HTMLDialogElement | null = null;

  function ask(options: Ask): Promise<{ ok: boolean; value: string }> {
    if (!dialog) {
      dialog = document.createElement('dialog');
      dialog.className = 'pt-dialog';
      document.body.append(dialog);
    }
    const root = dialog;
    return new Promise((resolve) => {
      const danger = options.tone === 'danger';
      root.dataset.tone = danger ? 'danger' : 'default';

      const form = document.createElement('form');
      form.method = 'dialog';
      form.noValidate = true;

      const ic = document.createElement('div');
      ic.className = 'ic';
      ic.innerHTML = icon(options.icon ?? (danger ? 'trash' : 'alert'), 22);

      const h2 = document.createElement('h2');
      h2.textContent = options.title;
      const lead = document.createElement('p');
      lead.className = 'lead';
      lead.textContent = options.body;
      form.append(ic, h2, lead);

      let input: HTMLInputElement | HTMLTextAreaElement | null = null;
      if (options.expected) {
        const expect = document.createElement('strong');
        expect.className = 'expect';
        expect.textContent = options.expected;
        const label = document.createElement('label');
        label.className = 'tlabel';
        label.htmlFor = 'pt-ask-input';
        label.textContent = 'A megerősítéshez írja be a fenti nevet pontosan így:';
        const text = document.createElement('input');
        text.id = 'pt-ask-input';
        text.autocomplete = 'off';
        text.spellcheck = false;
        text.setAttribute('autocapitalize', 'none');
        // The point is to type it. Pasting would defeat the pause.
        for (const type of ['paste', 'drop']) text.addEventListener(type, (e) => e.preventDefault());
        input = text;
        form.append(expect, label, text);
      } else if (options.field) {
        const label = document.createElement('label');
        label.className = 'tlabel';
        label.htmlFor = 'pt-ask-input';
        label.textContent = options.field.label;
        const field = options.field.multiline ? document.createElement('textarea') : document.createElement('input');
        field.id = 'pt-ask-input';
        if (options.field.value) field.value = options.field.value;
        if (options.field.placeholder) field.placeholder = options.field.placeholder;
        input = field;
        form.append(label, field);
      }

      const row = document.createElement('div');
      row.className = 'row';
      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.className = 'btn ghost';
      cancel.textContent = options.cancelLabel ?? 'Mégse';
      const go = document.createElement('button');
      go.type = 'submit';
      go.className = 'btn go';
      go.textContent = options.confirmLabel;
      row.append(cancel, go);
      form.append(row);

      const sync = () => {
        const value = input?.value ?? '';
        const matches = options.expected ? value.trim() === options.expected.trim() : true;
        const filled = options.field?.required ? value.trim().length > 0 : true;
        go.disabled = !(matches && filled);
        if (input && options.expected) input.dataset.match = String(matches && value.length > 0);
      };
      input?.addEventListener('input', sync);
      sync();

      let settled = false;
      const finish = (ok: boolean) => {
        if (settled) return;
        settled = true;
        const value = input?.value ?? '';
        root.close();
        resolve({ ok, value });
      };
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!go.disabled) finish(true);
      });
      cancel.addEventListener('click', () => finish(false));
      root.oncancel = (event) => {
        event.preventDefault();
        finish(false);
      };
      root.onclick = (event) => {
        if (event.target === root) finish(false);
      };

      root.replaceChildren(form);
      root.showModal();
      (input ?? cancel).focus();
    });
  }

  /* ── Toasts ────────────────────────────────────────────────────────────
     A short, self-dismissing confirmation that does not move the page.
     Any server banner marked data-toast is lifted into one on arrival. */
  let toastHost: HTMLElement | null = null;
  const toast = (message: string, tone: 'ok' | 'error' | 'warn' = 'ok') => {
    if (!toastHost) {
      toastHost = document.createElement('div');
      toastHost.className = 'pt-toasts';
      toastHost.setAttribute('role', 'status');
      toastHost.setAttribute('aria-live', 'polite');
      document.body.append(toastHost);
    }
    const node = document.createElement('div');
    node.className = 'pt-toast';
    node.dataset.tone = tone;
    node.innerHTML = `<span class="pt-toast-ic">${icon(tone === 'ok' ? 'check' : 'alert', 16)}</span><span></span>`;
    (node.lastElementChild as HTMLElement).textContent = message;
    toastHost.append(node);
    const leave = () => {
      node.dataset.leaving = 'true';
      node.addEventListener('animationend', () => node.remove(), { once: true });
      window.setTimeout(() => node.remove(), 600);
    };
    window.setTimeout(leave, tone === 'error' ? 7000 : 3600);
    node.addEventListener('click', leave);
  };
  document.querySelectorAll<HTMLElement>('[data-toast]').forEach((banner) => {
    toast(banner.textContent?.trim() ?? '', (banner.dataset.toast as 'ok' | 'error' | 'warn') || 'ok');
    banner.remove();
  });

  /* ── Quick jump (⌘K) ───────────────────────────────────────────────────
     Every sidebar destination plus the things you do most, one keystroke away. */
  type Jump = { label: string; hint?: string; href: string; icon: string };
  let palette: HTMLDialogElement | null = null;
  const jumps = (): Jump[] => {
    const fromNav = [...document.querySelectorAll<HTMLAnchorElement>('.pt-link')].map((link) => ({
      label: link.querySelector('.txt')?.textContent?.trim() ?? '',
      href: link.getAttribute('href') ?? '',
      icon: link.querySelector('svg')?.outerHTML ?? '',
    }));
    return [
      ...fromNav,
      { label: 'Új ingatlan felvétele', hint: 'Üres piszkozat', href: '/portal/properties/new', icon: icon('plus', 19) },
      { label: 'Vissza a weboldalra', href: document.querySelector<HTMLAnchorElement>('.pt-me-btn')?.getAttribute('href') ?? '/hu/', icon: icon('external', 19) },
    ].filter((entry) => entry.label && entry.href);
  };
  const openPalette = () => {
    if (!palette) {
      palette = document.createElement('dialog');
      palette.className = 'pt-dialog pt-palette';
      palette.setAttribute('aria-label', 'Gyors ugrás');
      document.body.append(palette);
    }
    const root = palette;
    const items = jumps();
    root.innerHTML = `<div class="pt-pal-box"><div class="pt-pal-field">${icon('search', 19)}<input type="text" placeholder="Hová szeretne ugrani?" aria-label="Keresés" autocomplete="off" spellcheck="false" /><kbd>Esc</kbd></div><ul class="pt-pal-list" role="listbox"></ul></div>`;
    const input = root.querySelector('input') as HTMLInputElement;
    const list = root.querySelector('ul') as HTMLUListElement;
    let at = 0;
    const render = () => {
      const needle = input.value.trim().toLowerCase();
      const shown = items.filter((entry) => !needle || entry.label.toLowerCase().includes(needle));
      at = Math.min(at, Math.max(0, shown.length - 1));
      list.replaceChildren(
        ...shown.map((entry, index) => {
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', String(index === at));
          li.innerHTML = `<a href="${entry.href}"><span class="ic">${entry.icon}</span><span class="t"></span><span class="h"></span></a>`;
          (li.querySelector('.t') as HTMLElement).textContent = entry.label;
          (li.querySelector('.h') as HTMLElement).textContent = entry.hint ?? '';
          li.addEventListener('pointermove', () => {
            at = index;
            list.querySelectorAll('li').forEach((row, i) => row.setAttribute('aria-selected', String(i === at)));
          });
          return li;
        })
      );
      if (shown.length === 0) list.innerHTML = '<li class="empty">Nincs találat</li>';
    };
    input.addEventListener('input', () => {
      at = 0;
      render();
    });
    input.addEventListener('keydown', (event) => {
      const rows = list.querySelectorAll<HTMLElement>('li[role="option"]');
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        at = (at + (event.key === 'ArrowDown' ? 1 : -1) + rows.length) % Math.max(1, rows.length);
        rows.forEach((row, i) => row.setAttribute('aria-selected', String(i === at)));
        rows[at]?.scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Enter') {
        event.preventDefault();
        rows[at]?.querySelector('a')?.click();
      }
    });
    root.addEventListener('click', (event) => {
      if (event.target === root) root.close();
      else if ((event.target as Element).closest('a')) root.close();
    });
    render();
    if (!root.open) root.showModal();
    input.focus();
  };
  document.addEventListener('click', (event) => {
    if ((event.target as Element).closest('[data-palette-open]')) {
      setDrawer(false);
      openPalette();
    }
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (palette?.open) palette.close();
      else openPalette();
    }
  });

  (window as any).pf = {
    toast,
    /** A short single-line answer (a link, a caption); resolves to null when cancelled. */
    prompt: async (o: { title: string; body: string; label: string; confirmLabel?: string; value?: string; placeholder?: string; required?: boolean; multiline?: boolean }) => {
      const answer = await ask({
        title: o.title,
        body: o.body,
        icon: 'edit',
        field: { label: o.label, multiline: o.multiline ?? false, required: o.required ?? true, value: o.value, placeholder: o.placeholder },
        confirmLabel: o.confirmLabel ?? 'Rendben',
      });
      return answer.ok ? answer.value.trim() : null;
    },
    /** Replaces alert(): says one thing and waits to be dismissed. */
    alert: async (o: { title: string; body: string }) => {
      await ask({ title: o.title, body: o.body, confirmLabel: 'Rendben', cancelLabel: 'Bezár' });
    },
    /** Permanent actions: the confirm button stays locked until the name is typed. */
    confirmType: async (o: { title: string; body: string; expected: string; confirmLabel?: string }) =>
      (await ask({ tone: 'danger', confirmLabel: 'Végleges törlés', ...o })).ok,
    /** A plain yes/no. */
    confirm: async (o: { title: string; body: string; confirmLabel?: string; danger?: boolean }) =>
      (await ask({ tone: o.danger ? 'danger' : 'default', confirmLabel: 'Rendben', ...o })).ok,
    /** A short free-text answer; resolves to null when cancelled. */
    askNote: async (o: { title: string; body: string; label: string; confirmLabel?: string; multiline?: boolean }) => {
      const answer = await ask({
        title: o.title,
        body: o.body,
        field: { label: o.label, multiline: o.multiline ?? true, required: true },
        confirmLabel: o.confirmLabel ?? 'Küldés',
      });
      return answer.ok ? answer.value.trim() : null;
    },
  };
</script>

<style is:global>
  html,
  body {
    min-height: 100%;
  }
</style>
