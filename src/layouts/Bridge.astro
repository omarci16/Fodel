---
/**
 * Document shell for the English and German pages outside the full hu/nl site:
 * the blog list and articles (brief §5).
 *
 * Same reasoning as LocaleBridgePage: Base/Nav/Footer are typed and worded
 * for hu/nl only, and wrapping an English article in Hungarian navigation
 * would mix languages on the page. This shell carries only what is verified
 * in these languages — FODEL's own brand line, the language's home, its
 * articles, and the locale-neutral contact facts.
 */
import { BRAND, LOCALE_META } from '~/i18n/ui';
import { COMPANY } from '~/config/company';
import { abs } from '~/lib/seo';
import { BLOG_PATH } from '~/lib/blog';
import '~/styles/global.css';

interface Props {
  locale: 'en' | 'de';
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** hreflang pairs between the en and de versions of the same page, when both exist. */
  alternates?: Partial<Record<'en' | 'de', string>>;
  schema?: unknown[];
}

const { locale, title, description, ogImage, ogType = 'website', alternates = {}, schema = [] } = Astro.props;
const brand = BRAND[locale];
const meta = LOCALE_META[locale];
const canonical = abs(Astro.url.pathname);
const fullTitle = `${title} — ${brand.name}`;
const T = {
  en: { home: 'Home', articles: 'Articles', listings: 'Listings (Dutch)', contact: 'Contact' },
  de: { home: 'Startseite', articles: 'Artikel', listings: 'Angebote (Niederländisch)', contact: 'Kontakt' },
}[locale];
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {Object.keys(alternates).length > 1 &&
      Object.entries(alternates).map(([code, href]) => (
        <link rel="alternate" hreflang={code} href={abs(href!)} />
      ))}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(ogImage ?? '/og/fodel-default.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#102A43" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} is:inline />}
  </head>
  <body>
    <header class="bar">
      <a class="mark" href={`/${locale}/`} aria-label={brand.name}><span>FODEL</span></a>
      <nav aria-label={T.home}>
        <a href={`/${locale}/`}>{T.home}</a>
        <a href={BLOG_PATH[locale]} aria-current={Astro.url.pathname.startsWith(BLOG_PATH[locale]) ? 'page' : undefined}>{T.articles}</a>
        <a href="/nl/woningen/">{T.listings}</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p class="foot-brand">{brand.name} · {brand.signature}</p>
      <p>
        {COMPANY.phones.slice(0, 1).map((phone) => <a href={phone.href}>{phone.display}</a>)}
        <span aria-hidden="true"> · </span>
        <a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a>
      </p>
      <p>{COMPANY.address.oneLine}</p>
    </footer>
  </body>
</html>

<style>
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px var(--pad-x);
  }
  .mark {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 18px;
    letter-spacing: 0.38em;
    color: var(--ink);
  }
  .mark span {
    margin-right: -0.38em;
  }
  .bar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .bar nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: var(--fw-medium);
    color: var(--ink);
    transition: background-color 0.3s var(--ease-out);
  }
  .bar nav a:hover,
  .bar nav a[aria-current='page'] {
    background: rgba(16, 42, 67, 0.07);
  }
  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 var(--pad-x) var(--section-y);
  }
  .foot {
    display: grid;
    gap: 6px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 36px var(--pad-x) 48px;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    color: var(--taupe);
  }
  .foot-brand {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }
  .foot a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 700px) {
    .bar {
      padding: 18px var(--pad-x-mob);
    }
    .bar nav a {
      padding: 0 12px;
      font-size: 14px;
    }
    main {
      padding: 0 var(--pad-x-mob) var(--section-y-mob);
    }
    .foot {
      padding: 28px var(--pad-x-mob) 36px;
    }
  }
</style>
