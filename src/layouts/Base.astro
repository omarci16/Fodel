---
/**
 * Document shell.
 *
 * Everything the prototype had none of lives here: per-page title and
 * description, canonical, hreflang, Open Graph, and JSON-LD. The prototype
 * shipped one static <title> for all nine screens and an empty <div id="root">.
 */
import { LOCALE_META, BRAND, UI, type Locale } from '~/i18n/ui';
import { graph, organisationSchema, abs } from '~/lib/seo';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import CookieConsent from '~/components/CookieConsent.astro';
import '~/styles/global.css';
import { getCompany } from '~/lib/runtime-config';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path of the equivalent page in each locale, for hreflang. */
  alternates?: Partial<Record<Locale, string>>;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD nodes merged into the page @graph. */
  schema?: unknown[];
  noindex?: boolean;
  /** Property detail pages manage their own top spacing. */
  flush?: boolean;
}

const {
  locale,
  title,
  description,
  alternates = {},
  ogImage,
  ogType = 'website',
  schema = [],
  noindex = false,
  flush = false,
} = Astro.props;

const meta = LOCALE_META[locale];
const brand = BRAND[locale];
const ui = UI[locale];

const canonical = abs(Astro.url.pathname);
const fullTitle = title.includes('FODEL') ? title : `${title} — ${brand.name}`;
const socialImage = abs(ogImage ?? '/og/fodel-default.jpg');

const company = await getCompany();
const jsonLd = graph([organisationSchema(locale, company), ...schema]);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* hreflang — reciprocal across every locale that has this page. */}
    {
      Object.entries(alternates).map(([loc, path]) => (
        <link rel="alternate" hreflang={LOCALE_META[loc as Locale].hreflang} href={abs(path)} />
      ))
    }
    {
      alternates.nl && (
        <link rel="alternate" hreflang="x-default" href={abs(alternates.nl)} />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <meta name="theme-color" content="#102A43" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>

    <Nav locale={locale} alternates={alternates} />

    <div class="site-body" data-flush={flush ? '' : undefined}>
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <Footer locale={locale} />
    <CookieConsent locale={locale} />

    <div class="grain" aria-hidden="true"></div>
    <div class="cursor" id="cursor" aria-hidden="true"></div>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ── Reveal on scroll ──
         One shared observer for the whole page. Content is visible by default
         and only hidden once we know JS can bring it back. Anything already on
         screen at load is revealed on the next frame, so the first viewport
         animates in rather than popping. */
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (!reduced && 'IntersectionObserver' in window && targets.length) {
        targets.forEach((el) => el.setAttribute('data-reveal-ready', ''));

        // A masked element starts fully clipped, and Chrome reports a fully
        // clipped element as never intersecting — so masks are watched
        // through their (unclipped) parent and revealed from there.
        const watched = new Map<Element, HTMLElement[]>();
        targets.forEach((el) => {
          const sentinel = el.dataset.reveal === 'mask' && el.parentElement ? el.parentElement : el;
          watched.set(sentinel, [...(watched.get(sentinel) ?? []), el]);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              watched.get(entry.target)?.forEach((el) => el.setAttribute('data-visible', ''));
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );

        requestAnimationFrame(() => watched.forEach((_, el) => observer.observe(el)));
      }

      /* ── Scroll-linked work ──
         Word reveals and parallax share one rAF-throttled scroll handler, and
         only touch elements that are near the viewport. */
      const words = Array.from(document.querySelectorAll<HTMLElement>('[data-words]'));
      const parallax = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

      if (!reduced) {
        // Split text nodes into word spans, keeping any inline markup intact.
        for (const el of words) {
          const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          const nodes: Text[] = [];
          while (walker.nextNode()) nodes.push(walker.currentNode as Text);
          for (const node of nodes) {
            const frag = document.createDocumentFragment();
            for (const part of node.data.split(/(\s+)/)) {
              if (!part) continue;
              if (/^\s+$/.test(part)) {
                frag.append(part);
              } else {
                const w = document.createElement('span');
                w.className = 'w';
                w.textContent = part;
                frag.append(w);
              }
            }
            node.replaceWith(frag);
          }
          el.setAttribute('data-words-ready', '');
        }

        let ticking = false;
        const update = () => {
          ticking = false;
          const vh = window.innerHeight;

          for (const el of words) {
            const r = el.getBoundingClientRect();
            if (r.bottom < -vh || r.top > vh * 2) continue;
            const spans = el.querySelectorAll<HTMLElement>('.w');
            const p = Math.min(1, Math.max(0, (vh * 0.88 - r.top) / (r.height + vh * 0.3)));
            const lit = Math.round(p * spans.length);
            spans.forEach((s, i) => s.toggleAttribute('data-on', i < lit));
          }

          for (const el of parallax) {
            const r = el.getBoundingClientRect();
            if (r.bottom < -200 || r.top > vh + 200) continue;
            const speed = Number(el.dataset.parallax) || 0.12;
            const offset = (r.top + r.height / 2 - vh / 2) * -speed;
            el.style.setProperty('--py', `${offset.toFixed(1)}px`);
          }
        };
        const request = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        };
        if (words.length || parallax.length) {
          window.addEventListener('scroll', request, { passive: true });
          window.addEventListener('resize', request, { passive: true });
          update();
        }

        /* ── Count-up ──
           [data-count] holds the final figure; digits roll up from zero once,
           keeping any suffix ("4%") and the element's width steady via
           tabular figures. */
        const counters = document.querySelectorAll<HTMLElement>('[data-count]');
        if (counters.length && 'IntersectionObserver' in window) {
          const io = new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              io.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const final = el.dataset.count ?? el.textContent ?? '';
              const match = final.match(/^(\D*)(\d+)(.*)$/);
              if (!match) continue;
              const [, pre, digits, post] = match;
              const to = Number(digits);
              const from = to > 1000 ? to - 40 : 0;
              const t0 = performance.now();
              const dur = 1600;
              const step = (t: number) => {
                const k = Math.min(1, (t - t0) / dur);
                const eased = 1 - Math.pow(1 - k, 4);
                el.textContent = `${pre}${Math.round(from + (to - from) * eased)}${post}`;
                if (k < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            }
          }, { threshold: 0.6 });
          counters.forEach((el) => io.observe(el));
        }
      }

      /* ── Pointer label ── */
      const cursor = document.getElementById('cursor');
      if (cursor && !reduced && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let active: HTMLElement | null = null;
        window.addEventListener('pointermove', (e) => {
          cursor.style.setProperty('--cx', `${e.clientX}px`);
          cursor.style.setProperty('--cy', `${e.clientY}px`);
          const target = (e.target as HTMLElement).closest<HTMLElement>('[data-cursor]');
          if (target !== active) {
            active = target;
            if (target) cursor.textContent = target.dataset.cursor ?? '';
            cursor.toggleAttribute('data-active', !!target);
          }
        }, { passive: true });
        document.addEventListener('pointerleave', () => {
          active = null;
          cursor.removeAttribute('data-active');
        });
      }

      /* ── Photograph → hero morph ──
         Name exactly one image, the one being clicked, so the next page's
         hero (which carries the same name) can morph out of it. Cleared on
         return from the back/forward cache so two cards never share it. */
      const clearNames = () =>
        document.querySelectorAll<HTMLElement>('[data-vt]').forEach((el) => (el.style.viewTransitionName = ''));
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[href]');
        if (!link) return;
        const forId = (link as HTMLElement).dataset.vtFor;
        const img = link.querySelector<HTMLElement>('[data-vt]') ?? (forId ? document.getElementById(forId) : null);
        clearNames();
        if (img) img.style.viewTransitionName = 'prop-hero';
      });
      window.addEventListener('pageshow', clearNames);
    </script>
  </body>
</html>

<style is:global>
  @view-transition {
    navigation: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }
</style>

<style>
  .site-body {
    padding-top: var(--nav-h);
  }
  .site-body[data-flush] {
    padding-top: 0;
  }
  main:focus {
    outline: none;
  }
  /* 1080px, not 768px. Nav.astro switches to the compact bar + burger at
     1080px, and .drawer positions itself at var(--nav-h-mob). Reserving the
     full 112px desktop height down to 768px left 46px of dead space above
     every page between 769 and 1080px, and put the drawer's top edge in the
     wrong place across that whole band. One breakpoint, defined once. */
  @media (max-width: 1080px) {
    .site-body {
      padding-top: var(--nav-h-mob);
    }
  }
</style>
