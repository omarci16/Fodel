---
/**
 * Full-bleed parallax CTA band, ported from the prototype including its
 * touch fallback (background-attachment: fixed is unsupported on iOS, so
 * touch devices get a translated <img> layer instead).
 */
import { getImage } from 'astro:assets';
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import ctaImage from '~/assets/site/cta.png';

interface Props {
  eyebrow: string;
  title: string;
  titleEm?: string;
  body?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  alt?: string;
}

const { eyebrow, title, titleEm, body, primary, secondary, alt = '' } = Astro.props;

const bg = await getImage({ src: ctaImage, format: 'avif', width: 1920, quality: 62 });
const bgMobile = await getImage({ src: ctaImage, format: 'avif', width: 900, quality: 60 });
---

<section class="parallax-cta" data-bg="dark" style={`--cta-bg:url(${bg.src});--cta-bg-mob:url(${bgMobile.src})`}>
  <div class="parallax-cta-media" aria-hidden="true">
    <img src={bgMobile.src} alt={alt} loading="lazy" decoding="async" width="900" height="506" />
  </div>
  <div class="parallax-cta-overlay"></div>

  <div class="parallax-cta-content">
    <Eyebrow center space="20px" class="cta-eyebrow reveal">{eyebrow}</Eyebrow>
    <h2 class="reveal">
      {title}{titleEm && <><br /><em>{titleEm}</em></>}
    </h2>
    {body && <p class="reveal">{body}</p>}
    <div class="actions reveal">
      <Button variant="dark" light href={primary.href}>{primary.label}</Button>
      {secondary && <Button variant="outline" light href={secondary.href}>{secondary.label}</Button>}
    </div>
  </div>
</section>

<script>
  // Devices that cannot do background-attachment: fixed get the <img> layer,
  // shifted on scroll. Same behaviour as the prototype.
  const band = document.querySelector<HTMLElement>('.parallax-cta');
  if (band) {
    const touch = window.matchMedia('(hover: none), (max-width: 1024px)').matches;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (touch) band.classList.add('touch-parallax');

    if (touch && !reduced) {
      let ticking = false;
      const update = () => {
        const rect = band.getBoundingClientRect();
        const progress = (rect.top + rect.height / 2 - window.innerHeight / 2) / window.innerHeight;
        band.style.setProperty('--parallax-shift', `${(-progress * 42).toFixed(1)}px`);
        ticking = false;
      };
      const request = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };
      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request, { passive: true });
      update();
    }
  }
</script>

<style>
  .parallax-cta {
    background-image: var(--cta-bg);
  }
  /* The <img> layer is only used on touch; on desktop the fixed background wins. */
  .parallax-cta:not(.touch-parallax) .parallax-cta-media {
    display: none;
  }

  :global(.cta-eyebrow) {
    color: var(--on-dark-body);
    letter-spacing: 0.38em;
  }

  h2 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(30px, 3.8vw, 60px);
    line-height: 1.08;
    color: #f4f4f2;
    margin-bottom: 18px;
  }
  h2 em {
    font-style: italic;
    opacity: 0.85;
  }

  p {
    font-size: var(--fs-body);
    /* ADJUSTED: was rgba(cream,.65) over a photograph. */
    color: rgba(244, 244, 242, 0.86);
    letter-spacing: 0.04em;
    margin-bottom: 44px;
    text-shadow: 0 1px 12px rgba(7, 21, 34, 0.4);
  }

  .actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .parallax-cta {
      background-image: var(--cta-bg-mob);
    }
    .actions {
      flex-direction: column;
      width: 100%;
    }
    p {
      margin-bottom: 32px;
    }
  }
</style>
