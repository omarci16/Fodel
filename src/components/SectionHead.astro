---
/**
 * One structural treatment for section eyebrow, heading and separator.
 *
 * 1.4: each line of the title sits in its own mask (.line, global.css), so
 * whenever this head is inside a .reveal — its own class or an ancestor's —
 * the title rises out of the mask line by line and the rule draws itself on.
 * Titles written with "\n" get one mask per line; a slotted title gets one.
 */
import Eyebrow from './Eyebrow.astro';
import GoldRule from './GoldRule.astro';

interface Props {
  eyebrow: string;
  title?: string;
  align?: 'left' | 'center';
  rule?: boolean;
  size?: 'default' | 'large';
  class?: string;
}

// 2.0: no rule by default. The short line under every heading was the
// template's signature, and with rounded surfaces around it read as clutter.
const {
  eyebrow,
  title,
  align = 'left',
  rule = false,
  size = 'default',
  class: className,
} = Astro.props;
const centered = align === 'center';
const lines = title ? title.split('\n') : [];
---

<div class:list={['section-head-standard', { centered, large: size === 'large' }, className]}>
  <div class="copy">
    <Eyebrow center={centered} space="18px">{eyebrow}</Eyebrow>
    <h2>
      {
        lines.length > 0 ? (
          lines.map((line, i) => (
            <span class="line" style={`--i:${i}`}>
              <span>{line}</span>
            </span>
          ))
        ) : (
          <span class="line">
            <span>
              <slot name="title" />
            </span>
          </span>
        )
      }
    </h2>
    {rule && <GoldRule center={centered} />}
  </div>
  <slot />
</div>

<style>
  /* Its own space below, so whatever follows a heading — a paragraph, a
     list — never sits against it. Pages that want more set it on the class. */
  .section-head-standard {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 28px;
  }
  .copy {
    min-width: 0;
  }
  /* A link or control set beside the heading sits on its last baseline. */
  .section-head-standard > :global(.btn-text),
  .section-head-standard > :global(.btn) {
    flex-shrink: 0;
    margin-bottom: 0.35em;
  }
  h2 {
    margin: 0;
    color: var(--section-head-color, var(--ink));
    font-family: var(--serif);
    font-size: clamp(30px, 3.1vw, 48px);
    font-weight: var(--fw-medium);
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .copy :global(.gold-rule) {
    margin-top: 24px;
  }
  .large h2 {
    font-weight: var(--fw-hero);
    font-size: clamp(38px, 4.9vw, 76px);
    letter-spacing: var(--ls-display);
    line-height: 1.02;
  }
  .centered {
    display: block;
    text-align: center;
  }
  .centered .copy {
    max-width: 850px;
    margin-inline: auto;
  }
  :global([data-bg='dark']) .section-head-standard {
    --section-head-color: var(--cream);
  }

  @media (max-width: 700px) {
    .section-head-standard {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
  }
</style>
