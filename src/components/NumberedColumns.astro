---
/**
 * Three (or more) numbered columns — FODEL's three-step model, the About
 * page's values. One treatment everywhere these appear.
 *
 * A single rule runs across the top of the row and draws itself from left to
 * right as the row scrolls in, with a node where each column begins: the
 * steps read as one sequence, not three boxes.
 */
interface Item {
  num: string;
  title: string;
  body: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['ncols', 'reveal', className]} style={`--n:${items.length}`}>
  <ol>
    {
      items.map((item, i) => (
        <li style={`--i:${i}`}>
          <span class="num num-fig">{item.num}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  /* 2.0: the columns are cards — one surface each, the figure set large in
     the corner and the text anchored to the foot, so a row of them reads as
     three equal steps however long each text runs. */
  ol {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }
  li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 36px 36px 40px;
    border-radius: var(--r-xl);
    background: var(--ncol-bg, var(--paper));
    border: 1px solid var(--ncol-border, rgba(16, 42, 67, 0.07));
    transition:
      transform 0.7s var(--ease-out),
      box-shadow 0.7s var(--ease-out);
  }
  li:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  :global([data-bg='dark']) li {
    --ncol-bg: rgba(244, 244, 242, 0.05);
    --ncol-border: var(--on-dark-rule);
  }
  /* -0.05em takes out the numeral's side bearing. */
  .num {
    display: block;
    margin: 0 0 64px -0.05em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(64px, 5.6vw, 96px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink);
  }
  h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(22px, 1.8vw, 28px);
    letter-spacing: var(--ls-heading);
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 12px;
  }
  p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    max-width: 40ch;
  }

  /* Staggered entrance. */
  :global([data-reveal-ready]) li {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 1.1s var(--ease-out),
      transform 1.1s var(--ease-out),
      box-shadow 0.7s var(--ease-out);
    transition-delay: calc(0.15s + var(--i, 0) * 0.12s);
  }
  :global([data-reveal-ready][data-visible]) li {
    opacity: 1;
    transform: none;
  }
  :global([data-reveal-ready][data-visible]) li:hover {
    transform: translateY(-4px);
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-reveal-ready]) li {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1000px) {
    ol {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    li {
      min-height: 0;
      display: grid;
      grid-template-columns: 72px minmax(0, 1fr);
      column-gap: 8px;
      padding: 28px 24px;
    }
    .num {
      grid-row: span 2;
      margin: 0;
      font-size: 44px;
    }
    h3 {
      margin-bottom: 8px;
    }
  }
</style>
