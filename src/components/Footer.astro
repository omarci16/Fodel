---
/**
 * Footer, ported from the prototype.
 *
 * Adds what was legally missing: registered address, VAT and KvK, plus links
 * to the privacy, terms, cookie and accessibility pages. Dutch law requires
 * the KvK number on the site; while it is unset the block renders a visible
 * placeholder and the build's preflight check fails, so it cannot ship
 * forgotten.
 */
import Logo from './Logo.astro';
import Eyebrow from './Eyebrow.astro';
import { UI, BRAND, CATEGORY_FALLBACK, path, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { slugify } from '~/lib/properties';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const brand = BRAND[locale];
const year = new Date().getFullYear();
const COMPANY = await getCompany();
const weekdayHours = locale === 'hu'
  ? `Hétfő–Péntek · ${COMPANY.hours.weekdays.from}–${COMPANY.hours.weekdays.to}`
  : `Maandag–vrijdag · ${COMPANY.hours.weekdays.from}–${COMPANY.hours.weekdays.to}`;
const foundedPlace = locale === 'hu' ? 'Hága, Hollandia' : 'Den Haag, Nederland';

const navItems = [
  { key: 'properties', label: ui.nav.properties },
  { key: 'sellers', label: ui.nav.sellers },
  { key: 'buyers', label: ui.nav.buyers },
  { key: 'about', label: ui.nav.about },
  { key: 'blog', label: ui.nav.blog },
  { key: 'contact', label: ui.nav.contact },
] as const;

const legalItems = [
  { key: 'imprint', label: locale === 'hu' ? 'Impresszum' : 'Colofon' },
  { key: 'privacy', label: locale === 'hu' ? 'Adatvédelem' : 'Privacy' },
  { key: 'terms', label: locale === 'hu' ? 'ÁSZF' : 'Voorwaarden' },
  { key: 'cookies', label: locale === 'hu' ? 'Sütik' : 'Cookies' },
  { key: 'accessibility', label: locale === 'hu' ? 'Akadálymentesítés' : 'Toegankelijkheid' },
] as const;

const featuredCategories: (keyof typeof CATEGORY_FALLBACK)[] = [
  'house',
  'mansion',
  'farm',
  'holiday',
  'agricultural',
  'land',
];
---

<footer class="footer" data-bg="dark">
  <div class="grid">
    <div class="brand">
      <Logo locale={locale} light href={`/${locale}/`} />
      <p class="tagline">{brand.tagline}</p>
      <p class="founded">
        {
          locale === 'hu'
            ? `Alapítva ${COMPANY.founded}-ban, ${foundedPlace}.`
            : `Opgericht in ${COMPANY.founded} te ${foundedPlace}.`
        }
      </p>
    </div>

    <nav class="col" aria-label={ui.footer.navigation}>
      <Eyebrow space="18px">{ui.footer.navigation}</Eyebrow>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={path(locale, item.key)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="col" aria-label={ui.footer.categories}>
      <Eyebrow space="18px">{ui.footer.categories}</Eyebrow>
      <ul>
        {
          featuredCategories.map((key) => (
            <li>
              <a href={`${path(locale, 'properties')}${slugify(CATEGORY_FALLBACK[key][locale].slug)}/`}>
                {CATEGORY_FALLBACK[key][locale].label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="col">
      <Eyebrow space="18px">{ui.footer.contact}</Eyebrow>
      <ul class="contact">
        {
          COMPANY.phones.filter((p) => p.public).map((p) => (
            <li>
              <a href={p.href}>{p.display}</a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a>
        </li>
      </ul>
      <p class="hours">
        {weekdayHours}<br />
        {
          locale === 'hu'
            ? `Visszahívás ${COMPANY.hours.callback.to}-ig, hétvégén is.`
            : `Terugbellen tot ${COMPANY.hours.callback.to} uur, ook in het weekend.`
        }
      </p>
      <p class="callback-note">{ui.footer.callbackNote}</p>
    </div>
  </div>

  <div class="legal-block">
    <div class="legal-details">
      <Eyebrow space="18px">{ui.footer.companyDetails}</Eyebrow>
      <p>
        {COMPANY.names.legal} · {COMPANY.address.oneLine}
      </p>
      <p>
        {locale === 'hu' ? 'Holland adószám' : 'BTW-nummer'}: {COMPANY.registration.vat}
        {' · '}
        KvK: {
          COMPANY.registration.kvk ?? (
            <span class="missing" title="Not yet supplied by the client">
              —
            </span>
          )
        }
      </p>
    </div>

    <nav class="legal-links" aria-label={ui.footer.legal}>
      <ul>
        {
          legalItems.map((item) => (
            <li>
              <a href={path(locale, item.key)}>{item.label}</a>
            </li>
          ))
        }
        {/* The portal's only entry point from the public site. Deliberately
            here rather than in the main navigation: it is for the handful of
            people who advertise with FODEL, not for the buyers the top nav
            exists to serve. rel=nofollow because /portal is noindex anyway. */}
        <li>
          <a href="/portal/login" rel="nofollow">{ui.footer.portalLogin}</a>
        </li>
      </ul>
    </nav>
  </div>

  {/* The wordmark, at the width of the page: the logo's own wide tracking,
      scaled until the five letters reach both margins. Decorative — the
      name is already the first thing in this footer. */}
  <div class="wordmark" aria-hidden="true">
    <p class="wordmark-letters">
      {['F', 'O', 'D', 'E', 'L'].map((l, i) => <span style={`--i:${i}`}>{l}</span>)}
    </p>
    <span class="wordmark-rule"></span>
    <p class="wordmark-sub">
      <span>{brand.name.replace('FODEL', '').trim() || 'VASTGOED'}</span>
      <span class="num">52°04′N 4°18′E — 47°30′N 19°02′E</span>
    </p>
  </div>

  <div class="baseline">
    <p>© {COMPANY.founded}–{year} {COMPANY.names.legal} · {COMPANY.network.slice(0, 3).join(' · ')}</p>
    <p class="signature">{brand.signature}</p>
    <a class="to-top" href="#main">
      {locale === 'hu' ? 'Vissza az oldal tetejére' : 'Terug naar boven'}
      <svg width="10" height="14" viewBox="0 0 10 14" fill="none" aria-hidden="true">
        <path d="M5 14V1.5M1 5.5l4-4 4 4" stroke="currentColor" stroke-width="1.1" />
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(90% 60% at 100% 100%, var(--ink-soft) 0%, transparent 60%),
      linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 100%);
    color: var(--cream);
    padding: 120px var(--pad-x) 40px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    gap: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--on-dark-rule);
  }

  .tagline {
    /* ADJUSTED: was rgba(cream,.45) — 3.8:1, below AA. */
    color: var(--on-dark-muted);
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    margin-top: 20px;
    max-width: 26ch;
  }
  .founded {
    color: var(--on-dark-faint);
    font-size: var(--fs-micro);
    line-height: 1.8;
    margin-top: 12px;
    max-width: 26ch;
  }

  .col ul {
    list-style: none;
  }
  .col li {
    margin-bottom: 10px;
  }
  .col a {
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 2px;
    transition:
      color var(--dur-fast) ease,
      background-size 0.6s var(--ease-out);
  }
  .col a:hover {
    color: var(--cream);
    background-size: 100% 1px;
  }

  .contact a {
    font-variant-numeric: tabular-nums;
  }
  .hours,
  .callback-note {
    font-size: var(--fs-micro);
    line-height: 1.8;
    color: var(--on-dark-faint);
    margin-top: 18px;
  }
  .callback-note {
    margin-top: 8px;
  }

  .legal-block {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    padding: 36px 0;
    border-bottom: 1px solid var(--on-dark-rule);
  }
  .legal-details p {
    font-size: var(--fs-micro);
    line-height: 1.9;
    color: var(--on-dark-faint);
  }
  .missing {
    color: #e9b8b8;
    font-weight: var(--fw-medium);
  }
  .legal-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    list-style: none;
  }
  .legal-links a {
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--on-dark-muted);
  }
  .legal-links a:hover {
    color: var(--cream);
  }

  /* ── Wordmark ── */
  .wordmark {
    padding-top: 96px;
    user-select: none;
  }
  .wordmark-letters {
    display: flex;
    justify-content: space-between;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(72px, 19vw, 340px);
    line-height: 0.74;
    color: var(--cream);
    /* Nudge the outer letters onto the margins: the side bearings of F and L
       would otherwise leave the word visibly inset from the grid. */
    margin-inline: -0.045em -0.03em;
  }
  .wordmark-rule {
    display: block;
    height: 1px;
    margin: 0.9vw 0 18px;
    background: var(--on-dark-field-border);
  }
  .wordmark-sub {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: var(--fs-micro);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .wordmark-sub .num {
    letter-spacing: 0.16em;
  }

  .baseline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--on-dark-rule);
  }
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
    transition: color var(--dur-fast) ease;
  }
  .to-top svg {
    transition: transform 0.6s var(--ease-out);
  }
  .to-top:hover {
    color: var(--cream);
  }
  .to-top:hover svg {
    transform: translateY(-4px);
  }
  .baseline p {
    /* ADJUSTED: was rgba(cream,.25) — 2.0:1. */
    font-size: var(--fs-micro);
    color: var(--on-dark-faint);
    letter-spacing: 0.05em;
  }
  .signature {
    font-family: var(--serif);
  }

  @media (max-width: 1100px) {
    .baseline {
      flex-wrap: wrap;
    }
    .signature {
      order: 3;
      width: 100%;
    }
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 36px 24px;
    }
    .brand {
      grid-column: 1 / -1;
    }
    .footer {
      padding: 72px var(--pad-x-mob) 32px;
    }
    .wordmark {
      padding-top: 64px;
    }
    .wordmark-sub {
      flex-direction: column;
      gap: 8px;
      letter-spacing: 0.3em;
    }
  }
  @media (max-width: 560px) {
    .baseline {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
