---
/**
 * Property card, ported from the prototype.
 *
 * Two changes beyond styling: the whole card is a real <a> (crawlable,
 * shareable, middle-clickable), and the reference number is shown — sellers
 * and buyers quote it on the phone, and the prototype omitted it entirely.
 *
 * `data-*` attributes carry the filterable values so the properties page can
 * filter pre-rendered markup without re-rendering anything.
 *
 * 1.4: the photograph is uncovered from its bottom edge as it scrolls in,
 * carries a pointer label, and is the element that morphs into the property
 * page's hero on click (data-vt, see Base.astro). The rule above the price
 * draws across in ink on hover. `ratio` and `sizes` let a page set a card
 * large or tall inside an editorial grid.
 */
import { Image } from 'astro:assets';
import Eyebrow from './Eyebrow.astro';
import ArrowChip from './ArrowChip.astro';
import { type Locale, UI } from '~/i18n/ui';
import { text, url as propertyUrl, type Property } from '~/lib/properties';
import { eur, area, floorArea } from '~/lib/format';

interface Props {
  property: Property;
  locale: Locale;
  /** Above-the-fold cards skip lazy-loading so the LCP image is not delayed. */
  eager?: boolean;
  class?: string;
  rank?: number;
  /** Image aspect ratio, e.g. "4 / 5". Defaults to 4 / 3. */
  ratio?: string;
  sizes?: string;
  /** Set false where the card is revealed by its container instead, or
   *  shouldn't animate in at all (the listing grid: a results page, read
   *  and filtered, not scrolled through as a showcase). */
  reveal?: boolean;
}

const {
  property,
  locale,
  eager = false,
  class: className,
  rank,
  ratio,
  sizes = '(max-width: 768px) 100vw, (max-width: 1200px) 45vw, 30vw',
  reveal = true,
} = Astro.props;
const d = property.data;
const ui = UI[locale];

const href = propertyUrl(property, locale);
const title = text(d.title, locale);
const tag = d.tag ? text(d.tag, locale) : null;
const category = d.categoryLabels[locale] ?? d.categoryLabels.hu;
const heroAlt = text(d.media.heroAlt, locale);

/** Each figure with its own small drawing, so floor and plot area can never
 *  be mistaken for each other; the label is there for screen readers. */
const specs = [
  d.rooms ? { icon: 'bed', label: ui.property.beds, value: `${d.rooms.bedrooms} ${locale === 'hu' ? 'szoba' : 'slk.'}` } : null,
  d.areas.floorM2 ? { icon: 'floor', label: ui.property.area, value: floorArea(d.areas.floorM2) } : null,
  d.areas.plotM2 ? { icon: 'plot', label: ui.property.land, value: area(d.areas.plotM2, locale) } : null,
].filter(Boolean) as { icon: 'bed' | 'floor' | 'plot'; label: string; value: string }[];
---

<article
  class:list={['prop-card', className]}
  style={ratio ? `--card-ratio:${ratio}` : undefined}
  data-property
  data-category={d.category}
  data-region={d.location.region}
  data-county={d.location.county}
  data-price={d.price.eur}
  data-floor={d.areas.floorM2 ?? 0}
  data-plot={d.areas.plotM2}
  data-beds={d.rooms?.bedrooms ?? 0}
  data-featured={d.listing.featured ? '1' : '0'}
  data-bargain={d.listing.bargain ? '1' : '0'}
  data-published={d.listing.publishedAt.getTime()}
>
  <a class="card-link" href={href}>
    <div
      class:list={['card-img-wrap', { reveal }]}
      data-reveal={reveal ? 'mask' : undefined}
      data-cursor={ui.cta.viewProperty}
    >
      <div class="card-img-inner" data-vt>
        {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
        <Image
          src={d.media.hero as any}
          alt={heroAlt}
          widths={[400, 600, 800, 1200]}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          class="card-img"
          inferSize={typeof d.media.hero === 'string'}
        />
      </div>
      <span class="card-tags">
        {rank && <span class="tag tag-rank num">{String(rank).padStart(2, '0')}</span>}
        {(d.listing.bargain || tag) && <span class="tag">{d.listing.bargain ? (locale === 'hu' ? 'Alkalmi vétel' : 'Buitenkans') : tag}</span>}
      </span>
      {
        d.status !== 'active' && (
          <span class="status">
            {d.status === 'sold' ? ui.property.sold : ui.property.reserved}
          </span>
        )
      }
      <ArrowChip size={44} class="card-chip" />
    </div>

    <div class="card-body">
      <Eyebrow class="card-meta">{d.location.region} · {category}</Eyebrow>
      <h3 class="card-title">{title}</h3>
      <p class="card-location">
        {d.location.settlement}, {d.location.county}
        <span class="ref">· {ui.property.reference} {d.ref}</span>
      </p>
      <div class="card-foot">
        <span class="price num">{eur(d.price.eur)}</span>
        {
          specs.length > 0 && (
            <ul class="specs">
              {specs.map((s) => (
                <li title={s.label}>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    {s.icon === 'bed' && (
                      <path d="M1.75 12.5V4M1.75 9.5h12.5v3M1.75 7.25h4.5v2.25M6.25 7.25h6a2 2 0 0 1 2 2v.25" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    )}
                    {s.icon === 'floor' && (
                      <path d="M2 7.25 8 2.5l6 4.75M3.5 6.25v7.25h9V6.25M6.75 13.5V10h2.5v3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    )}
                    {s.icon === 'plot' && (
                      <path d="M2 5.5 8 2.5l6 3-6 3-6-3ZM2 5.5v5l6 3 6-3v-5M8 8.5v5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    )}
                  </svg>
                  <span class="sr-only">{s.label}: </span>
                  <span class="num">{s.value}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </a>
</article>

<style>
  .prop-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  /* A column all the way down, so in any row of cards the price line sits
     at the same height whether a title takes one line or two. */
  .card-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: var(--r-lg);
  }
  .card-link:focus-visible {
    outline-offset: 6px;
  }
  .card-img-wrap {
    position: relative;
    aspect-ratio: var(--card-ratio, 4 / 3);
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--mist);
    /* Keeps the radius clipping the photograph while it scales (Safari). */
    isolation: isolate;
    transform: translateZ(0);
  }
  .card-img-inner {
    height: 100%;
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* A soft floor of ink so the chip has something to sit on. */
  .card-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 29, 48, 0.18) 0%, transparent 26%, transparent 60%, rgba(10, 29, 48, 0.28));
    opacity: 0.7;
    transition: opacity 0.9s var(--ease-out);
    pointer-events: none;
  }
  .card-link:hover .card-img-wrap::after,
  .card-link:focus-visible .card-img-wrap::after {
    opacity: 1;
  }

  .card-tags {
    position: absolute;
    z-index: 1;
    top: 14px;
    left: 14px;
    right: 110px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag,
  .status {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 13px;
    border-radius: var(--r-pill);
    font-family: var(--sans);
    font-weight: var(--fw-medium);
    font-size: 13px;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .tag {
    background: rgba(250, 250, 248, 0.9);
    backdrop-filter: blur(10px) saturate(1.4);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    color: var(--ink);
  }
  .tag-rank {
    background: var(--ink);
    color: var(--cream);
    padding: 0 11px;
  }
  .status {
    position: absolute;
    z-index: 1;
    top: 14px;
    right: 14px;
    background: var(--ink);
    color: var(--cream);
  }

  /* The way in: a disc that rises into the corner when the card is pointed at. */
  .card-img-wrap :global(.card-chip) {
    position: absolute;
    z-index: 1;
    right: 14px;
    bottom: 14px;
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
    opacity: 0;
    transform: translateY(10px) scale(0.85);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  .card-link:hover .card-img-wrap :global(.card-chip),
  .card-link:focus-visible .card-img-wrap :global(.card-chip) {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .card-img-wrap :global(.card-chip) {
      display: none;
    }
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 4px 0;
  }
  .card-body :global(.card-meta) {
    margin-bottom: 10px;
    color: var(--taupe);
  }
  .card-title {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(20px, 1.55vw, 23px);
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 6px;
    transition: color 0.3s ease;
  }
  .card-location {
    font-family: var(--sans);
    font-weight: var(--fw-body);
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--taupe);
    margin-bottom: 18px;
  }
  .ref {
    white-space: nowrap;
  }
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .price {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 22px;
    letter-spacing: -0.015em;
    color: var(--ink);
    white-space: nowrap;
  }
  .specs {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px 14px;
    list-style: none;
  }
  .specs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    line-height: 1.2;
    color: var(--taupe);
    white-space: nowrap;
  }
  .specs svg {
    flex-shrink: 0;
    color: var(--ink);
    opacity: 0.7;
  }
</style>
