---
/**
 * Cookie consent — opt-in, with genuine reject parity.
 *
 * The site currently sets no non-essential cookies at all, so nothing is
 * gated behind this yet. It exists because the moment analytics is added,
 * ePrivacy requires prior consent, and retrofitting a compliant banner is
 * how sites end up with dark patterns. Accept and reject are the same size,
 * the same weight, and the same distance from the user's thumb.
 *
 * 1.4: a card in the corner rather than a bar across the page, so it never
 * sits on the content it is asking about; both answers are the same button.
 */
import Button from './Button.astro';
import { path, type Locale } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  hu: {
    title: 'Sütik',
    body: 'Ez az oldal csak a működéshez feltétlenül szükséges sütiket használja. Statisztikai célú mérést csak az Ön kifejezett hozzájárulásával végzünk.',
    accept: 'Elfogadom',
    reject: 'Elutasítom',
    more: 'Részletek',
  },
  nl: {
    title: 'Cookies',
    body: 'Deze site gebruikt alleen cookies die noodzakelijk zijn om te functioneren. Statistieken meten wij uitsluitend met uw uitdrukkelijke toestemming.',
    accept: 'Akkoord',
    reject: 'Weigeren',
    more: 'Meer informatie',
  },
}[locale];
---

<aside
  class="cookie-consent"
  id="cookie-consent"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-body"
  hidden
>
  <h2 id="cookie-title">
    <span class="rule" aria-hidden="true"></span>
    {copy.title}
  </h2>
  <p id="cookie-body">
    {copy.body}
    <a href={path(locale, 'cookies')}>{copy.more}</a>
  </p>
  <div class="actions">
    <Button variant="outline" light id="cookie-reject">{copy.reject}</Button>
    <Button variant="outline" light id="cookie-accept">{copy.accept}</Button>
  </div>
</aside>

<script>
  const KEY = 'fodel:consent';
  const banner = document.getElementById('cookie-consent');

  if (banner && !localStorage.getItem(KEY)) {
    // Deferred so the banner never competes with the LCP element.
    requestIdleCallback?.(() => banner.removeAttribute('hidden')) ??
      setTimeout(() => banner.removeAttribute('hidden'), 800);
  }

  const decide = (value: 'granted' | 'denied') => {
    localStorage.setItem(KEY, JSON.stringify({ analytics: value, at: Date.now() }));
    banner?.setAttribute('hidden', '');
    // When analytics is added, it initialises here — and only here.
    document.dispatchEvent(new CustomEvent('fodel:consent', { detail: { analytics: value } }));
  };

  document.getElementById('cookie-accept')?.addEventListener('click', () => decide('granted'));
  document.getElementById('cookie-reject')?.addEventListener('click', () => decide('denied'));
</script>

<style>
  /* Above the nav, below the pointer label. */
  .cookie-consent {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: calc(var(--z-cursor) - 50);
    width: min(420px, calc(100vw - 48px));
    padding: 28px 28px 24px;
    background:
      radial-gradient(120% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    color: var(--cream);
    border: 1px solid var(--on-dark-rule);
    box-shadow: var(--shadow-lg);
    animation: fx-fade-up 0.9s var(--ease-out) both;
  }
  .cookie-consent[hidden] {
    display: none;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    font-family: var(--sans);
    font-weight: var(--fw-regular);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--cream);
  }
  .rule {
    width: 28px;
    height: 1px;
    background: var(--cream);
  }
  p {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--on-dark-body);
  }
  p a {
    color: var(--cream);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  /* Equal weight by design — no visual nudge toward accepting. */
  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 22px;
  }
  .actions :global(.btn) {
    padding-inline: 12px;
  }

  @media (max-width: 600px) {
    .cookie-consent {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
      padding: 22px 20px 20px;
    }
  }
</style>
