---
/**
 * Sellers. Ported from the prototype, with the commission band now pointing at
 * a real price list and a real order form instead of a generic contact link.
 *
 * The argument sequence (cash buyers → serious intent → €200–300 to view) is
 * FODEL's strongest sales asset and is kept exactly as the prototype ordered it.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import PointsList from '~/components/PointsList.astro';
import NumberedColumns from '~/components/NumberedColumns.astro';
import FaqAccordion from '~/components/FaqAccordion.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { COMMISSION, LISTING_PACKAGES } from '~/config/company';
import { copy } from '~/data/copy';
import { alternatesFor } from '~/lib/page';
import { serviceSchema, faqSchema } from '~/lib/seo';
import { faqFor, faqAnswerText } from '~/data/faq';
import vineyard from '~/assets/properties/vineyard.png';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const c = copy(locale).sellers;
const steps = copy(locale).steps;

const cheapest = LISTING_PACKAGES[0].priceEur;

// The seller FAQ doubles as FAQPage markup — this is the content answer
// engines quote when someone asks how selling to foreign buyers works.
const sellerFaq = faqFor(locale, 'seller').slice(0, 8);
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternatesFor('sellers')}
  schema={[
    serviceSchema(locale, c.hero.title, c.meta.description),
    ...(sellerFaq.length > 0
      ? [faqSchema(sellerFaq.map((e) => ({ question: e.question, answer: faqAnswerText(e) })))]
      : []),
  ]}
>
  <PageHeader
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    titleEm={c.hero.titleEm}
    body={c.hero.body}
    image={vineyard}
    imageAlt={locale === 'hu' ? 'Szőlőbirtok a Dunántúlon' : 'Wijngaard in Transdanubië'}
    primary={{ label: c.hero.cta, href: path(locale, 'submitAd') }}
    secondary={{ label: c.hero.secondary, href: path(locale, 'priceList') }}
  />

  {/* ── Benefits + buyer personas ── */}
  <div class="split">
    <section class="benefits reveal">
      <SectionHead eyebrow={c.benefits.eyebrow} title={c.benefits.title} rule={false} />
      <PointsList items={c.benefits.points} />
    </section>

    <section class="personas reveal">
      <SectionHead eyebrow={c.personas.eyebrow} title={c.personas.title} rule={false} />
      <dl class="persona-list">
        {
          c.personas.items.map((p: any, i: number) => (
            <div class="persona">
              <span class="persona-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <dt>{p.title}</dt>
              <dd>{p.body}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  {/* ── Three-step model ── */}
  <section class="how">
    <SectionHead eyebrow={c.how.eyebrow} title={c.how.title} size="large" class="how-head reveal" />
    <NumberedColumns items={steps} />
  </section>

  {/* ── Commission band ── */}
  <section class="commission" data-bg="dark">
    <div class="commission-copy reveal">
      <SectionHead eyebrow={c.commission.eyebrow} title={c.commission.title} rule={false} />
      <p>{c.commission.body}</p>
    </div>
    <div class="commission-figure reveal">
      <span class="pct num">{COMMISSION.percent}<span class="pct-sign">%</span></span>
      <span class="pct-note">
        {locale === 'hu' ? `min. ${COMMISSION.minimumEur} € + ${COMMISSION.vatPercent}% áfa` : `min. € ${COMMISSION.minimumEur} + ${COMMISSION.vatPercent}% btw`}
      </span>
    </div>
  </section>

  {/* ── Pricing summary ── */}
  <section class="pricing">
    <SectionHead
      eyebrow={locale === 'hu' ? 'Hirdetési csomagok' : 'Advertentiepakketten'}
      title={locale === 'hu' ? `Hirdetés már ${cheapest} €-tól` : `Adverteren vanaf € ${cheapest}`}
      size="large"
      class="reveal"
    />
    <div class="pricing-side reveal">
      <p>
        {
          locale === 'hu'
            ? 'A hirdetési díj tartalmazza a szöveg szerkesztését, a képfeldolgozást és a hirdetés összeállítását. Idegen nyelvű fordítás nyelvenként 25 €.'
            : 'De advertentieprijs omvat het redigeren van de tekst, de beeldbewerking en het opmaken van de advertentie. Vertaling kost € 25 per taal.'
        }
      </p>
      <div class="pricing-actions">
        <Button variant="dark" href={path(locale, 'priceList')}>{c.commission.cta}</Button>
        <Button variant="text" href={path(locale, 'submitAd')}>{ui.cta.submitAd}</Button>
      </div>
    </div>
  </section>

  {/* ── Seller FAQ ── */}
  <FaqAccordion
    eyebrow={locale === 'hu' ? 'Gyakori kérdések' : 'Veelgestelde vragen'}
    title={locale === 'hu' ? 'Amit az eladók kérdezni szoktak' : 'Wat verkopers ons vragen'}
    entries={sellerFaq}
    moreHref={path(locale, 'faq')}
    moreLabel={locale === 'hu' ? 'Összes kérdés és válasz' : 'Alle vragen en antwoorden'}
  />
</Base>

<style>
  /* ── Benefits + personas ──
     Subgrid, so both lists start on one line whatever the headings wrap to.
     No gold rule under these heads: the list's own hairline is the rule. */
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    border-top: 1px solid var(--border);
  }
  .benefits,
  .personas {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
    padding: var(--section-y) var(--pad-x);
  }
  .split :global(.section-head-standard) {
    align-self: start;
    margin-bottom: 26px;
  }
  .personas {
    background: var(--linen);
  }
  .persona-list {
    border-top: 1px solid var(--border);
  }
  .persona {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    column-gap: 0;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .persona-num {
    grid-row: span 2;
    padding-top: 5px;
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--taupe);
  }
  .persona dt {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 20px;
    letter-spacing: var(--ls-heading);
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .persona dd {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--taupe);
  }

  /* ── Three-step model ── */
  .how {
    padding: var(--section-y) var(--pad-x);
    border-top: 1px solid var(--border);
  }
  .how :global(.how-head) {
    margin-bottom: 72px;
  }

  /* ── Pricing ── */
  .pricing {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 64px;
    align-items: end;
    padding: var(--section-y) var(--pad-x);
    background: var(--linen);
  }
  .pricing-side {
    padding-bottom: 46px;
  }
  .pricing-side p {
    max-width: 48ch;
    margin-bottom: 36px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  .pricing-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 36px;
  }

  /* ── Commission ── */
  .commission {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 80px;
    align-items: center;
    padding: var(--section-y) var(--pad-x);
    background:
      radial-gradient(80% 90% at 100% 50%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
  }
  .commission p {
    max-width: 56ch;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-lead);
    /* ADJUSTED: was rgba(cream,.55) — this is a key sales paragraph. */
    color: var(--on-dark-body);
  }
  .commission-figure {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
  }
  .pct {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(112px, 15vw, 240px);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--cream);
  }
  .pct-sign {
    font-size: 0.5em;
    letter-spacing: 0;
    vertical-align: 0.72em;
    margin-left: 0.04em;
  }
  .pct-note {
    font-size: var(--fs-small);
    letter-spacing: 0.06em;
    color: var(--on-dark-muted);
  }

  @media (max-width: 900px) {
    .split,
    .pricing,
    .commission {
      grid-template-columns: 1fr;
    }
    .split {
      grid-template-rows: none;
    }
    .benefits,
    .personas {
      display: block;
    }
    .benefits,
    .personas,
    .how,
    .pricing,
    .commission {
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
    .how :global(.how-head) {
      margin-bottom: 32px;
    }
    .pricing {
      gap: 8px;
    }
    .pricing-side {
      padding-bottom: 0;
    }
    .commission {
      gap: 40px;
    }
    .commission-figure {
      align-items: flex-start;
    }
  }
</style>
