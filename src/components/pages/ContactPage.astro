---
/**
 * Contact. Ported from the prototype's split layout.
 *
 * The form now reaches a real inbox. Hours are corrected to FODEL's published
 * 09:00–18:00, and the free callback running to 21:00 including weekends is
 * surfaced — the prototype discarded it, and it is a genuine selling point.
 *
 * 2.0: every way to reach FODEL is its own rounded tile — the phone numbers
 * and the address for e-mail dial or open directly — and the callback form
 * sits beside them on a white card that stays in view while they are read.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { copy } from '~/data/copy';
import { alternatesFor } from '~/lib/page';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const c = copy(locale).contact;
const hu = locale === 'hu';
const COMPANY = await getCompany();
const weekdayHours = hu
  ? `Hétfő–Péntek · ${COMPANY.hours.weekdays.from}–${COMPANY.hours.weekdays.to}`
  : `Maandag–vrijdag · ${COMPANY.hours.weekdays.from}–${COMPANY.hours.weekdays.to}`;
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternatesFor('contact')}
>
  <div class="contact">
    {/* ── Details ── */}
    <section class="details">
      <p class="c-eyebrow">
        <span class="c-eyebrow-rule" aria-hidden="true"></span>
        <span>{c.hero.eyebrow}</span>
      </p>
      <h1>
        <span class="line"><span>{c.hero.title}</span></span>
        <span class="line" style="--i:1"><span><em>{c.hero.titleEm}</em></span></span>
      </h1>
      <p class="callback-note">{c.note}</p>

      <ul class="channels">
        {
          COMPANY.phones.filter((p) => p.public).map((p, i) => (
            <li style={`--i:${i}`}>
              <a class="tile" href={p.href}>
                <span class="tile-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M6.2 2.5 7.9 6.4 5.9 7.8a10.6 10.6 0 0 0 6.3 6.3l1.4-2 3.9 1.7-.6 3a1.8 1.8 0 0 1-1.9 1.4C8.7 17.8 2.2 11.3 1.8 5a1.8 1.8 0 0 1 1.4-1.9l3-.6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="tile-label">{p.label[locale]}</span>
                <span class="tile-value num">{p.display}</span>
                {p.note && <span class="tile-note">{p.note[locale]}</span>}
              </a>
            </li>
          ))
        }
        <li>
          <a class="tile" href={`mailto:${COMPANY.email.primary}`}>
            <span class="tile-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <rect x="2" y="4" width="16" height="12" rx="2.5" stroke="currentColor" stroke-width="1.4" />
                <path d="m2.8 5.2 7.2 5.6 7.2-5.6" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="tile-label">E-mail</span>
            <span class="tile-value">{COMPANY.email.primary}</span>
          </a>
        </li>
        <li>
          <div class="tile">
            <span class="tile-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4" />
                <path d="M10 5.5V10l3 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="tile-label">{ui.footer.hours}</span>
            <span class="tile-value">{weekdayHours}</span>
            <span class="tile-note">
              {
                hu
                  ? `Visszahívás ${COMPANY.hours.callback.to}-ig, hétvégén is.`
                  : `Terugbellen tot ${COMPANY.hours.callback.to} uur, ook in het weekend.`
              }
            </span>
          </div>
        </li>
        <li class="wide">
          <div class="tile">
            <span class="tile-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M10 18s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                <circle cx="10" cy="8" r="2.2" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </span>
            <span class="tile-label">{hu ? 'Cím' : 'Adres'}</span>
            <span class="tile-value tile-address">
              {COMPANY.names.legal} · {COMPANY.address.street}, {COMPANY.address.postalCode} {COMPANY.address.city}, {COMPANY.address.country}
            </span>
          </div>
        </li>
      </ul>
    </section>

    {/* ── Form ── */}
    <section class="form-side">
      <div class="form-card">
        <h2>{c.formTitle}</h2>

        <FormShell locale={locale} endpoint="/api/callback" formId="callback">
          <Field locale={locale} name="name" label={ui.form.name} required autocomplete="name" span="half" />
          <Field locale={locale} name="phone" label={ui.form.phone} type="tel" autocomplete="tel" span="half" />
          <Field locale={locale} name="email" label={ui.form.email} type="email" required autocomplete="email" span="full" />
          <Field
            locale={locale}
            name="subject"
            label={ui.form.subject}
            type="select"
            options={c.subjects.map((s: string) => ({ value: s, label: s }))}
            span="full"
          />
          <Field
            locale={locale}
            name="callTime"
            label={hu ? 'Mikor hívhatjuk?' : 'Wanneer kunnen wij u bellen?'}
            placeholder={hu ? 'pl. hétköznap délután' : 'bijv. doordeweeks in de middag'}
            span="full"
          />
          <Field
            locale={locale}
            name="message"
            label={ui.form.message}
            type="textarea"
            placeholder={ui.form.messagePlaceholder}
            rows={5}
            span="full"
          />
        </FormShell>
      </div>
    </section>
  </div>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 580px);
    gap: clamp(48px, 6vw, 104px);
    align-items: start;
    padding: 72px var(--pad-x) var(--section-y);
  }

  .c-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 32px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    animation: fx-fade-up 1.2s var(--ease-out) 0.3s both;
  }
  .c-eyebrow-rule {
    width: 32px;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    animation: fx-draw 1.2s var(--ease-out) 0.4s both;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(44px, 5.6vw, 92px);
    line-height: 1.02;
    letter-spacing: var(--ls-display);
    color: var(--ink);
  }
  h1 .line > span {
    animation: fx-rise 1.4s var(--ease-out) both;
    animation-delay: calc(0.35s + var(--i, 0) * 0.11s);
  }
  .callback-note {
    max-width: 52ch;
    margin-top: 28px;
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
    animation: fx-fade-up 1.3s var(--ease-out) 0.7s both;
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 56px;
    list-style: none;
    animation: fx-fade-up 1.3s var(--ease-out) 0.85s both;
  }
  .channels .wide {
    grid-column: 1 / -1;
  }
  .tile {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 16px;
    align-content: start;
    height: 100%;
    padding: 22px 24px 24px 20px;
    border-radius: var(--r-xl);
    background: rgba(16, 42, 67, 0.04);
    border: 1px solid transparent;
    color: var(--ink);
    transition:
      background-color 0.4s var(--ease-out),
      box-shadow 0.5s var(--ease-out),
      border-color 0.4s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  a.tile:hover,
  a.tile:focus-visible {
    background: var(--white);
    border-color: rgba(16, 42, 67, 0.06);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .tile-icon {
    grid-row: span 3;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: inset 0 0 0 1px rgba(16, 42, 67, 0.08);
    color: var(--ink);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out);
  }
  a.tile:hover .tile-icon,
  a.tile:focus-visible .tile-icon {
    background: var(--ink);
    color: var(--cream);
  }
  .tile-label {
    margin-top: 1px;
    font-size: 13.5px;
    font-weight: var(--fw-medium);
    color: var(--taupe);
  }
  .tile-value {
    margin-top: 4px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(19px, 1.6vw, 23px);
    letter-spacing: -0.01em;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .tile-address {
    font-family: var(--sans);
    font-weight: var(--fw-body);
    font-size: var(--fs-body);
    line-height: 1.55;
    letter-spacing: 0;
  }
  .tile-note {
    margin-top: 6px;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--taupe);
  }

  .form-side {
    position: sticky;
    top: calc(var(--nav-h) + 16px);
    animation: fx-fade-up 1.3s var(--ease-out) 0.6s both;
  }
  .form-card {
    padding: clamp(28px, 3vw, 44px);
    border-radius: var(--r-2xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.06);
    box-shadow: var(--shadow-float);
  }
  h2 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(24px, 2.2vw, 30px);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 28px;
  }

  @media (max-width: 1100px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .form-side {
      position: static;
    }
  }
  @media (max-width: 900px) {
    .contact {
      gap: 40px;
      padding: 40px var(--pad-x-mob) var(--section-y-mob);
    }
    .c-eyebrow {
      margin-bottom: 22px;
    }
    .channels {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }
    .form-card {
      padding: 24px 20px;
      border-radius: var(--r-xl);
    }
  }
</style>
