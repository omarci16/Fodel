---
/**
 * About. Ported from the prototype.
 *
 * The unsupported "several hundred transactions since 2013" claim is removed.
 * Per the explicit 1.3 client direction, company summaries say founded in Den
 * Haag; the historical Almere-Buiten origin story remains in the narrative.
 * See company.ts for the documented source conflict.
 *
 * 1.4: the origin quote is set as the page's statement, lit word by word; the
 * values, figures and approach use the shared components, and the page ends
 * on the contact band instead of stopping at the footer.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import SectionHead from '~/components/SectionHead.astro';
import PointsList from '~/components/PointsList.astro';
import NumberedColumns from '~/components/NumberedColumns.astro';
import StatsBand from '~/components/StatsBand.astro';
import ParallaxCta from '~/components/ParallaxCta.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { copy } from '~/data/copy';
import { alternatesFor } from '~/lib/page';
import { splitOpeningQuote } from '~/lib/typography';
import kuria from '~/assets/properties/kuria.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const c = copy(locale).about;
const cta = copy(locale).home.cta;
const stats = copy(locale).stats;
const hu = locale === 'hu';
const COMPANY = await getCompany();
const quote = splitOpeningQuote(c.origin.quote);
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternatesFor('about')}
>
  <PageHeader
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    titleEm={c.hero.titleEm}
    body={c.hero.body}
    image={kuria}
    imageAlt={hu ? 'Restaurált magyar kúria angolparkkal' : 'Gerestaureerd Hongaars landhuis met park'}
    primary={{ label: ui.cta.getInTouch, href: path(locale, 'contact') }}
  />

  {/* ── Origin ── */}
  <section class="origin" data-bg="dark">
    <figure>
      <p class="origin-source reveal">
        <span class="origin-rule draw" aria-hidden="true"></span>
        {c.origin.eyebrow}
      </p>
      <blockquote class="origin-quote" data-words>
        {quote.mark && <span class="hang-quote">{quote.mark}</span>}{quote.rest}
      </blockquote>
      <figcaption class="origin-cite reveal">{COMPANY.names.legal} — fodel.nl</figcaption>
    </figure>
  </section>

  {/* ── Values ── */}
  <section class="values">
    <SectionHead eyebrow={c.values.eyebrow} title={c.values.title} size="large" class="values-head reveal" />
    <NumberedColumns items={c.values.items} />
  </section>

  {/* ── Figures ── */}
  <section class="figures">
    <StatsBand stats={stats} />
  </section>

  {/* ── Approach + story ── */}
  <div class="split">
    <section class="approach reveal">
      <SectionHead eyebrow={c.approach.eyebrow} rule={false}>
        <Fragment slot="title">{c.approach.title}<br /><em>{c.approach.titleEm}</em></Fragment>
      </SectionHead>
      <PointsList items={c.approach.points} />
    </section>

    <section class="story reveal">
      <SectionHead eyebrow={c.story.eyebrow} rule={false}>
        <Fragment slot="title">{c.story.title}<br /><em>{c.story.titleEm}</em></Fragment>
      </SectionHead>
      <div class="story-body">
        {c.story.paragraphs.map((p: string) => <p class="story-p">{p}</p>)}

        <dl class="details">
          <div>
            <dt>{hu ? 'Cím' : 'Adres'}</dt>
            <dd>{COMPANY.address.oneLine}</dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a></dd>
          </div>
          <div>
            <dt>{hu ? 'Nyelvek' : 'Talen'}</dt>
            <dd>Nederlands · Deutsch · English · Français · Magyar</dd>
          </div>
        </dl>
      </div>
    </section>
  </div>

  <ParallaxCta
    eyebrow={cta.eyebrow}
    title={cta.title}
    titleEm={cta.titleEm}
    body={cta.body}
    primary={{ label: ui.cta.callback, href: path(locale, 'contact') }}
    secondary={{ label: ui.cta.browseProperties, href: path(locale, 'properties') }}
  />
</Base>

<style>
  /* ── Origin ── */
  .origin {
    padding: 152px var(--pad-x) 136px;
    background:
      radial-gradient(120% 80% at 85% 0%, var(--ink-soft) 0%, transparent 55%),
      linear-gradient(180deg, var(--ink) 0%, var(--ink-deep) 100%);
  }
  .origin figure {
    max-width: 1180px;
  }
  .origin-source {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 44px;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-body);
  }
  .origin-rule {
    flex-shrink: 0;
    width: 48px;
    height: 1px;
    background: var(--cream);
  }
  .origin-quote {
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(30px, 3.9vw, 62px);
    line-height: 1.14;
    letter-spacing: var(--ls-display);
    color: var(--cream);
    text-wrap: balance;
  }
  .origin-cite {
    margin-top: 56px;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  /* ── Values ── */
  .values {
    padding: var(--section-y) var(--pad-x);
  }
  .values :global(.values-head) {
    margin-bottom: 72px;
  }

  /* ── Figures ── */
  .figures {
    padding: 96px var(--pad-x) 104px;
    background: var(--linen);
  }

  /* ── Approach + story ──
     Subgrid, so the list and the story start on one line whatever the
     headings wrap to. No gold rule: the hairline under each head is the rule. */
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: auto 1fr;
    border-top: 1px solid var(--border);
  }
  .approach,
  .story {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 0;
    align-content: start;
    padding: var(--section-y) var(--pad-x);
  }
  .split :global(.section-head-standard) {
    align-self: start;
    margin-bottom: 26px;
  }
  .story {
    background: var(--linen);
  }
  .story-body {
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .story-p {
    max-width: 60ch;
    margin-bottom: 18px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  .details {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 16px 40px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .details dt {
    margin-bottom: 6px;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--taupe);
  }
  .details dd {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink);
  }
  .details a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 1280px) {
    .details {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .origin {
      padding: 96px var(--pad-x-mob) 80px;
    }
    .origin-source {
      margin-bottom: 32px;
    }
    .origin-cite {
      margin-top: 36px;
    }
    .values {
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
    .values :global(.values-head) {
      margin-bottom: 32px;
    }
    .figures {
      padding: 48px var(--pad-x-mob) 56px;
    }
    .split {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }
    .approach,
    .story {
      display: block;
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
  }
</style>
