---
/**
 * About. Ported from the prototype.
 *
 * The unsupported "several hundred transactions since 2013" claim is removed.
 * Per the explicit 1.3 client direction, company summaries say founded in Den
 * Haag; the historical Almere-Buiten origin story remains in the narrative.
 * See company.ts for the documented source conflict.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import GoldRule from '~/components/GoldRule.astro';
import SectionHead from '~/components/SectionHead.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';
import { copy } from '~/data/copy';
import { alternatesFor } from '~/lib/page';
import kuria from '~/assets/properties/kuria.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const c = copy(locale).about;
const stats = copy(locale).stats;
const hu = locale === 'hu';
const COMPANY = await getCompany();
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternatesFor('about')}
>
  <PageHeader
    eyebrow={c.hero.eyebrow}
    title={c.hero.title}
    titleEm={c.hero.titleEm}
    body={c.hero.body}
    image={kuria}
    imageAlt={hu ? 'Restaurált magyar kúria angolparkkal' : 'Gerestaureerd Hongaars landhuis met park'}
    primary={{ label: ui.cta.getInTouch, href: path(locale, 'contact') }}
  />

  {/* ── Origin ── */}
  <section class="origin" data-bg="dark">
    <div class="origin-inner reveal">
      <GoldRule center space="48px" />
      <Eyebrow center space="28px">{c.origin.eyebrow}</Eyebrow>
      <blockquote>{c.origin.quote}</blockquote>
      <GoldRule center space="24px" />
      <p class="o-source">{COMPANY.names.legal} — fodel.nl</p>
    </div>
  </section>

  {/* ── Values ── */}
  <section class="values">
    <SectionHead eyebrow={c.values.eyebrow} title={c.values.title} align="center" class="v-head reveal" />
    <ol class="v-grid">
      {
        c.values.items.map((v: any) => (
          <li class="value reveal">
            <span class="v-num">{v.num}</span>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── Stats ── */}
  <section class="stats">
    {
      stats.map((s: any) => (
        <div class="stat reveal">
          <span class="s-value">{s.value}</span>
          <span class="s-label">{s.label}</span>
        </div>
      ))
    }
  </section>

  {/* ── Approach + story ── */}
  <div class="split">
    <section class="approach reveal">
      <SectionHead eyebrow={c.approach.eyebrow}>
        <Fragment slot="title">{c.approach.title}<br /><em>{c.approach.titleEm}</em></Fragment>
      </SectionHead>
      <ul class="points">
        {
          c.approach.points.map((p: string) => (
            <li>
              <span class="dash" aria-hidden="true" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="story reveal">
      <SectionHead eyebrow={c.story.eyebrow}>
        <Fragment slot="title">{c.story.title}<br /><em>{c.story.titleEm}</em></Fragment>
      </SectionHead>
      {c.story.paragraphs.map((p: string) => <p class="story-p">{p}</p>)}

      <dl class="details">
        <div>
          <dt>{hu ? 'Cím' : 'Adres'}</dt>
          <dd>{COMPANY.address.oneLine}</dd>
        </div>
        <div>
          <dt>{hu ? 'E-mail' : 'E-mail'}</dt>
          <dd><a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a></dd>
        </div>
        <div>
          <dt>{hu ? 'Nyelvek' : 'Talen'}</dt>
          <dd>Nederlands · Deutsch · English · Français · Magyar</dd>
        </div>
      </dl>
    </section>
  </div>

</Base>

<style>

  .origin {
    background: var(--ink);
    padding: 128px var(--pad-x);
  }
  .origin-inner {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }
  blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: var(--fw-light);
    font-size: clamp(21px, 2.4vw, 36px);
    line-height: 1.55;
    color: var(--cream);
    margin-bottom: 48px;
  }
  .o-source {
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-body);
  }

  .values {
    padding: var(--section-y) var(--pad-x);
    border-bottom: 1px solid var(--border);
  }
  .v-head {
    text-align: center;
    margin-bottom: 80px;
  }
  .v-head h2 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(28px, 3.5vw, 54px);
    color: var(--ink);
  }
  .v-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
  }
  .value {
    padding: 48px 52px;
    border-top: 2px solid var(--accent);
  }
  .value + .value {
    border-left: 1px solid var(--border);
  }
  .v-num {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: 52px;
    line-height: 1;
    color: var(--accent);
    opacity: 0.62; /* was .45 — 2.64:1, below the 3:1 large-text floor */
    margin-bottom: 28px;
  }
  .value h3 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: 23px;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .value p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--linen);
    border-bottom: 1px solid var(--border);
    padding: 64px var(--pad-x);
  }
  .stat {
    text-align: center;
    padding: 24px;
  }
  .stat + .stat {
    border-left: 1px solid var(--border);
  }
  .s-value {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(40px, 4.5vw, 68px);
    line-height: 1;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .s-label {
    font-family: var(--sans);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--border);
  }
  .approach,
  .story {
    padding: 88px var(--pad-x);
  }
  .story {
    background: var(--linen);
    border-left: 1px solid var(--border);
  }
  .split h2 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(26px, 2.8vw, 42px);
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 24px;
  }
  .split h2 em {
    font-style: italic;
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 16px;
    list-style: none;
  }
  .points li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  .dash {
    width: 20px;
    height: 1px;
    background: var(--accent);
    margin-top: 13px;
    flex-shrink: 0;
  }
  .story-p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 18px;
  }
  .details {
    margin-top: 28px;
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }
  .details > div {
    margin-bottom: 14px;
  }
  .details dt {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--taupe);
    margin-bottom: 3px;
  }
  .details dd {
    font-size: var(--fs-small);
    color: var(--ink);
  }
  .details a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cta {
    background: var(--linen);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding: 72px var(--pad-x);
  }
  .cta-title {
    font-family: var(--serif);
    font-weight: var(--fw-regular);
    font-size: clamp(26px, 2.8vw, 42px);
    color: var(--ink);
    margin-bottom: 8px;
  }
  .cta-body {
    font-size: var(--fs-body);
    color: var(--taupe);
  }
  .cta-actions {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .origin {
      padding: 56px var(--pad-x-mob);
    }
    blockquote {
      margin-bottom: 28px;
    }
    .values {
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
    .v-head {
      margin-bottom: 32px;
    }
    .v-grid,
    .split {
      grid-template-columns: 1fr;
    }
    .value {
      padding: 24px 0;
    }
    .value + .value {
      border-left: none;
    }
    .v-num {
      font-size: 40px;
      margin-bottom: 14px;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
      padding: 36px var(--pad-x-mob);
    }
    .stat:nth-child(odd) {
      border-left: none;
    }
    .stat:nth-child(-n + 2) {
      border-bottom: 1px solid var(--border);
    }
    .approach,
    .story {
      padding: 44px var(--pad-x-mob);
    }
    .story {
      border-left: none;
      border-top: 1px solid var(--border);
    }
    .cta {
      flex-direction: column;
      align-items: stretch;
      padding: 44px var(--pad-x-mob);
    }
    .cta-actions {
      flex-direction: column;
    }
  }
</style>
