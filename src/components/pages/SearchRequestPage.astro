---
/**
 * Kerestető / Zoekdienst — FODEL's free search service, absent from the
 * prototype. It is their highest-intent lead capture: the visitor states what
 * they want, FODEL hunt for it including off-market, and it costs the visitor
 * nothing. "Plaats een GRATIS zoekopdracht" is their own framing.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, type Locale } from '~/i18n/ui';
import { getTaxonomy, termLabel } from '~/lib/runtime-config';
import { alternatesFor } from '~/lib/page';
import { serviceSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const hu = locale === 'hu';

const t = hu
  ? {
      metaTitle: 'Kerestető — Ingyenes ingatlankeresés',
      metaDescription:
        'Nem találta meg, amit keres? Adja meg az igényeit, és megkeressük Önnek — a hirdetéseinken kívüli kínálatból is. A szolgáltatás ingyenes.',
      eyebrow: 'Kerestető',
      title: 'Mondja el, mit keres —',
      titleEm: 'mi megkeressük',
      body: 'Ha a kínálatunkban nem talált megfelelőt, adja meg az igényeit. Magyar partnerhálózatunkon keresztül olyan ingatlanokat is elérünk, amelyek még nem szerepelnek a weboldalon. A szolgáltatás díjmentes.',
      howHead: 'Hogyan működik?',
      steps: [
        { n: '01', t: 'Kitölti az űrlapot', b: 'Megadja a típust, a régiót, a keretösszeget és az elvárásait.' },
        { n: '02', t: 'Keresünk', b: 'Partnereinkkel átnézzük a kínálatot, a nem hirdetett ingatlanokat is.' },
        { n: '03', t: 'Értesítjük', b: 'E-mailben küldjük az Ön feltételeinek megfelelő ingatlanokat.' },
        { n: '04', t: 'Kísérjük', b: 'Megtekintés, áralku, kétnyelvű szerződés — végig Ön mellett vagyunk.' },
      ],
      formHead: 'Ingyenes keresési megbízás',
      free: 'Díjmentes',
      submit: 'Kerestetés elküldése',
      successTitle: 'Köszönjük!',
      successBody:
        'Megkaptuk a keresési igényét. Amint találunk az Ön feltételeinek megfelelő ingatlant, e-mailben értesítjük.',
    }
  : {
      metaTitle: 'Zoekdienst — Gratis zoekopdracht in Hongarije',
      metaDescription:
        'Niet gevonden wat u zoekt? Geef uw wensen door en wij gaan voor u op zoek — ook buiten ons eigen aanbod. De zoekdienst is gratis.',
      eyebrow: 'Zoekdienst',
      title: 'Vertel ons wat u zoekt —',
      titleEm: 'wij gaan op zoek',
      body: 'Staat het juiste pand niet bij ons aanbod? Geef uw wensen door. Via ons Hongaarse partnernetwerk bereiken wij ook woningen die nog niet online staan. De dienst is gratis.',
      howHead: 'Hoe werkt het?',
      steps: [
        { n: '01', t: 'U vult het formulier in', b: 'Type, streek, budget en uw specifieke wensen.' },
        { n: '02', t: 'Wij zoeken', b: 'Samen met onze partners, ook buiten het geadverteerde aanbod om.' },
        { n: '03', t: 'U hoort van ons', b: 'U ontvangt per e-mail wat aan uw criteria voldoet.' },
        { n: '04', t: 'Wij begeleiden', b: 'Bezichtiging, onderhandeling en tweetalig contract — wij blijven erbij.' },
      ],
      formHead: 'Gratis zoekopdracht',
      free: 'Gratis',
      submit: 'Zoekopdracht versturen',
      successTitle: 'Dank u wel!',
      successBody:
        'Wij hebben uw zoekopdracht ontvangen. Zodra wij iets vinden dat aan uw criteria voldoet, nemen wij per e-mail contact op.',
    };

const taxonomy = await getTaxonomy();
const categoryOptions = taxonomy.category.filter((term) => term.enabled).map((term) => ({
  value: term.key, label: termLabel(term, locale),
}));
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('searchRequest')}
  schema={[serviceSchema(locale, t.eyebrow, t.metaDescription)]}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.body} compact />

  <section class="how">
    <Eyebrow space="24px">{t.howHead}</Eyebrow>
    <ol>
      {
        t.steps.map((s: any) => (
          <li>
            <span class="n">{s.n}</span>
            <h2>{s.t}</h2>
            <p>{s.b}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="form-section slab">
    <div class="form-inner">
      <div class="form-head">
        <span class="badge">{t.free}</span>
        <h2>{t.formHead}</h2>
      </div>

      <FormShell
        locale={locale}
        endpoint="/api/search-request"
        formId="search-request"
        submitLabel={t.submit}
        successTitle={t.successTitle}
        successBody={t.successBody}
      >
        <Field locale={locale} name="name" label={ui.form.name} required autocomplete="name" span="half" />
        <Field locale={locale} name="email" label={ui.form.email} type="email" required autocomplete="email" span="half" />
        <Field locale={locale} name="phone" label={ui.form.phone} type="tel" autocomplete="tel" span="half" />
        <Field
          locale={locale}
          name="propertyType"
          label={hu ? 'Keresett ingatlantípus' : 'Gezocht type'}
          type="select"
          required
          options={categoryOptions}
          span="half"
        />
        <Field
          locale={locale}
          name="region"
          label={hu ? 'Régió, megye vagy település' : 'Streek, comitaat of plaats'}
          placeholder={hu ? 'pl. Balaton, Zala megye' : 'bijv. Balaton, comitaat Zala'}
          span="full"
        />
        <Field
          locale={locale}
          name="budgetMin"
          label={hu ? 'Keret-tól (€)' : 'Budget vanaf (€)'}
          type="number"
          min={0}
          span="half"
        />
        <Field
          locale={locale}
          name="budgetMax"
          label={hu ? 'Keret-ig (€)' : 'Budget tot (€)'}
          type="number"
          min={0}
          span="half"
        />
        <Field
          locale={locale}
          name="requirements"
          label={hu ? 'Elvárások, kívánságok' : 'Wensen en eisen'}
          type="textarea"
          rows={6}
          hint={
            hu
              ? 'Például: vízközelség, erdőszél, kilátás, állattartás lehetősége, kiadhatóság, jó internet, repülőtér közelsége.'
              : 'Bijvoorbeeld: nabij water, aan de bosrand, uitzicht, ruimte voor dieren, verhuurbaarheid, goed internet, afstand tot een luchthaven.'
          }
          span="full"
        />
      </FormShell>
    </div>
  </section>
</Base>

<style>
  .how {
    padding: 56px var(--pad-x) 72px;
  }
  .how ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
  }
  .how li {
    display: flex;
    flex-direction: column;
    padding: 26px 26px 28px;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
  }
  .n {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: var(--fw-medium);
    line-height: 1;
  }
  .how h2 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 21px;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .how p {
    font-size: var(--fs-small);
    line-height: var(--lh-body);
    color: var(--taupe);
  }

  .form-section {
    padding: var(--section-y) calc(var(--pad-x) - var(--slab-x));
    background: var(--linen);
  }
  .form-inner {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(28px, 4vw, 52px);
    border-radius: var(--r-2xl);
    background: var(--white);
    box-shadow: var(--shadow-float);
  }
  .form-head {
    margin-bottom: 32px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 14px;
    margin-bottom: 16px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--cream);
    font-size: 13px;
    font-weight: var(--fw-medium);
  }
  .form-head h2 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(24px, 2.6vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
  }

  @media (max-width: 1000px) {
    .how ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .how {
      padding: 32px var(--pad-x-mob) 48px;
    }
    .how ol {
      grid-template-columns: 1fr;
    }
    .n {
      margin-bottom: 24px;
    }
    .form-section {
      padding: 48px calc(var(--pad-x-mob) - var(--slab-x) + 4px);
    }
    .form-inner {
      padding: 24px 20px;
      border-radius: var(--r-xl);
    }
  }
</style>
