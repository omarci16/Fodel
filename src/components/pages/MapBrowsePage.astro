---
/**
 * Map browse. A full-viewport clustered map of every active listing, with a
 * "search this area" action that hands the current bounds to the listings
 * page as a `?bbox=` parameter.
 *
 * (The comment that stood here claimed bbox filtering was only approximate,
 * matching on settlement text. That is no longer true and had not been since
 * Stage 6: `search_properties()` takes a real `p_bbox` and compares lat/lng
 * directly — see supabase/migrations/0004_search.sql. Plain range comparisons
 * are exact and need no PostGIS, because Hungary is small and never crosses
 * the antimeridian.)
 *
 * A secondary view by decision, not by accident: the list is the primary way
 * to browse, and the map is reachable from it rather than from the main
 * navigation. Until 1.1 nothing linked here at all.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Map from '~/components/Map.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { alternatesFor, crumbs } from '~/lib/page';
import { breadcrumbSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];

const title = locale === 'hu' ? 'Ingatlanok térképen' : 'Woningen op de kaart';
const description =
  locale === 'hu'
    ? 'Böngéssze a FODEL magyarországi ingatlanait térképen, régió szerint csoportosítva.'
    : 'Blader door het Hongaarse vastgoed van FODEL op de kaart, gegroepeerd per regio.';

const trail = crumbs(locale, [
  { name: ui.nav.properties, url: path(locale, 'properties') },
  { name: title, url: path(locale, 'map') },
]);

/**
 * Filters arrive from the listings page and go back with the visitor.
 * Switching view is meant to be a change of presentation, not a reset — the
 * map hands `bbox` forward to the list, and this hands everything else back.
 */
const carried = new URLSearchParams(Astro.url.searchParams);
carried.delete('page');
const carriedQuery = carried.toString();
const listHref = carriedQuery
  ? `${path(locale, 'properties')}?${carriedQuery}`
  : path(locale, 'properties');
---

<Base
  locale={locale}
  title={title}
  description={description}
  alternates={alternatesFor('map')}
  schema={[breadcrumbSchema(trail)]}
  flush
>
  <div class="map-page">
    <div class="map-head">
      <Eyebrow space="8px">{ui.nav.properties}</Eyebrow>
      <h1>{title}</h1>
      <a href={listHref} class="list-link">{ui.filters.viewList}</a>
      <button type="button" id="search-this-area" class="area-btn">
        {locale === 'hu' ? 'Keresés ezen a területen' : 'Zoek in dit gebied'}
      </button>
    </div>
    <div class="map-wrap">
      <Map mode="browse" locale={locale} id="browse-map" />
    </div>
  </div>
</Base>

<style>
  .map-page {
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--nav-h));
  }
  .map-head {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px var(--pad-x);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: 22px;
    color: var(--ink);
    flex: 1;
  }
  .area-btn {
    padding: 10px 20px;
    background: var(--ink);
    color: var(--cream);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
  }
  .list-link {
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe);
    border: 1px solid var(--border);
    padding: 9px 16px;
  }
  .list-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .map-wrap {
    flex: 1;
    min-height: 0;
  }
  @media (max-width: 768px) {
    .map-page {
      height: calc(100vh - var(--nav-h-mob));
    }
    .map-head {
      padding: 16px var(--pad-x-mob);
    }
  }
</style>
