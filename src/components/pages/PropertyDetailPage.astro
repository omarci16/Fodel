---
/**
 * Property detail. Ported from the prototype, plus the fields it was missing:
 * FODEL reference number, EPC class (legally required in EU property ads),
 * coordinates and a map link, features, video, and — most importantly — the
 * owner's own contact details where the seller has agreed to publish them.
 * That last block is FODEL's actual differentiator, expressed as data.
 */
import { Image, getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import GoldRule from '~/components/GoldRule.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import Map from '~/components/Map.astro';
import VideoEmbed from '~/components/VideoEmbed.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { COMPANY } from '~/config/company';
import { featureLabel } from '~/data/features';
import { activeProperties, similarTo, text, url as propUrl, type Property } from '~/lib/properties';
import { propertyAlternates, crumbs } from '~/lib/page';
import { propertySchema, breadcrumbSchema, videoObjectSchema } from '~/lib/seo';
import { eur, huf, area, floorArea, epcLabel, formatDate } from '~/lib/format';
import { extractYouTubeId } from '~/lib/video';

interface Props {
  locale: Locale;
  property: Property;
}

const { locale, property } = Astro.props;
const d = property.data;
const ui = UI[locale];

const title = text(d.title, locale);
const subtitle = d.subtitle ? text(d.subtitle, locale) : '';
const description = text(d.description, locale);
const category = d.categoryLabels[locale] ?? d.categoryLabels.hu;
const tag = d.tag ? text(d.tag, locale) : null;

const gallery = [
  { src: d.media.hero, alt: text(d.media.heroAlt, locale), label: null as string | null },
  ...d.media.gallery.map((g) => ({
    src: g.src,
    alt: text(g.alt, locale),
    label: g.label ? text(g.label, locale) : null,
  })),
];

const HERO_WIDTHS = [900, 1400, 1920];
const HERO_SIZES = '100vw';

// Structured data and Open Graph get a right-sized variant, not the source
// file. Using `.src` of the original would point crawlers and social scrapers
// at a multi-megabyte PNG — and would force the originals to ship in dist.
const shareImage = await getImage({
  src: gallery[0].src,
  width: 1200,
  height: 630,
  fit: 'cover',
  // 'jpg', not 'jpeg' — the build accepts both, the dev image endpoint only
  // accepts 'jpg' and 500s otherwise.
  format: 'jpg',
  quality: 80,
  inferSize: typeof gallery[0].src === 'string',
});

const pageUrl = propUrl(property, locale);
const epc = epcLabel(d.building.epcClass, { epcMissing: ui.property.epcMissing });

const specs = [
  d.rooms && { label: ui.property.beds, value: String(d.rooms.bedrooms) },
  d.rooms && { label: ui.property.baths, value: String(d.rooms.bathrooms) },
  d.areas.floorM2 && { label: ui.property.area, value: floorArea(d.areas.floorM2) },
  { label: ui.property.land, value: area(d.areas.plotM2, locale) },
  { label: ui.property.epc, value: epc.value },
  d.building.yearBuilt && { label: ui.property.yearBuilt, value: String(d.building.yearBuilt) },
].filter(Boolean) as { label: string; value: string }[];

const all = await activeProperties();
const similar = similarTo(property, all, 3);

const trail = crumbs(locale, [
  { name: ui.nav.properties, url: path(locale, 'properties') },
  { name: d.location.region, url: path(locale, 'properties') },
  { name: title, url: pageUrl },
]);

const mapUrl = `https://www.openstreetmap.org/?mlat=${d.location.lat}&mlon=${d.location.lng}#map=13/${d.location.lat}/${d.location.lng}`;

const metaDescription = `${title} — ${d.location.settlement}, ${d.location.county}. ${eur(
  d.price.eur
)}${d.areas.floorM2 ? `, ${floorArea(d.areas.floorM2)}` : ''}, ${area(d.areas.plotM2, locale)}. ${
  locale === 'hu' ? 'Azonosító' : 'Referentie'
} ${d.ref}.`;

const videoId = d.media.videoUrl ? extractYouTubeId(d.media.videoUrl) : null;
---

<Base
  locale={locale}
  title={`${title} — ${d.location.settlement}`}
  description={metaDescription}
  alternates={propertyAlternates(d.categorySlugs, d.ref)}
  ogType="article"
  ogImage={shareImage.src}
  schema={[
    propertySchema(property, locale, pageUrl, shareImage.src),
    breadcrumbSchema(trail),
    videoId &&
      videoObjectSchema({
        name: title,
        description,
        url: d.media.videoUrl!,
        videoId,
        uploadDate: d.listing.publishedAt,
      }),
  ]}
>
  <div class="detail-top">
  <nav class="crumbs no-print" aria-label={ui.a11y.breadcrumb}>
    <ol>
      {
        trail.map((c, i) => (
          <li>
            {i < trail.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          </li>
        ))
      }
    </ol>
  </nav>

  {/* ── Gallery hero ── */}
  <div class="property-detail-hero" id="gallery" tabindex="-1" aria-roledescription="carousel" aria-label={title}>
    {
      gallery.map((image, i) => (
        <div
          class="property-detail-hero-media gallery-slide"
          data-slide={i}
          data-active={i === 0 ? '' : undefined}
          hidden={i !== 0}
        >
          {/* The first photograph shares its name with the card photograph a
              visitor clicked (PropertyCard, Base.astro), so the one morphs
              into the other across the page transition. */}
          <div class="slide-inner" style={i === 0 ? 'view-transition-name: prop-hero' : undefined}>
            {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
            <Image
              src={image.src as any}
              alt={image.alt}
              widths={HERO_WIDTHS}
              sizes={HERO_SIZES}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              inferSize={typeof image.src === 'string'}
            />
          </div>
        </div>
      ))
    }
    <div class="property-detail-hero-overlay"></div>

    <div class="hero-foot">
      <div class="hero-title">
        {tag && <span class="hero-tag">{tag}</span>}
        <span class="hero-kicker">{d.location.region} — {category}</span>
        <span class="hero-name">{title}</span>
      </div>

      {
        gallery.length > 1 && (
          <div class="hero-gallery no-print">
            <div class="property-detail-gallery-controls">
              <button class="property-detail-nav" type="button" id="gal-prev" aria-label={ui.property.prevImage} aria-controls="gallery">
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                  <path d="M18 5H1.5M5.5 1l-4 4 4 4" stroke="currentColor" stroke-width="1.1" />
                </svg>
              </button>
              <p class="property-detail-gallery-count num" id="gal-count" role="status">
                01 / {String(gallery.length).padStart(2, '0')}
              </p>
              <button class="property-detail-nav" type="button" id="gal-next" aria-label={ui.property.nextImage} aria-controls="gallery">
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                  <path d="M0 5h16.5M12.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
                </svg>
              </button>
            </div>
            <div class="gal-bar" aria-hidden="true">
              {gallery.map((_, i) => <span data-seg={i} data-on={i === 0 ? '' : undefined} />)}
            </div>
          </div>
        )
      }
    </div>
  </div>
  </div>

  {/* ── Body ── */}
  <div class="body">
    <div class="main">
      <Eyebrow space="12px">{d.location.region} — {category}</Eyebrow>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}

      <p class="location">
        {d.location.settlement}, {d.location.county}
        <a class="map-link no-print" href={mapUrl} target="_blank" rel="noopener">
          {locale === 'hu' ? 'OpenStreetMap-en' : 'Op OpenStreetMap'}
        </a>
      </p>

      <div class="price-row">
        <span class="price">{eur(d.price.eur)}</span>
        <span class="price-huf">{huf(d.price.huf, locale)}</span>
        <span class="price-asof">
          {locale === 'hu' ? 'Árfolyam' : 'Koers'}: {formatDate(d.price.asOf, locale)}
        </span>
      </div>

      <dl class="specs">
        {
          specs.map((s) => (
            <div class="spec">
              <dd>{s.value}</dd>
              <dt>{s.label}</dt>
            </div>
          ))
        }
      </dl>

      <div class="ref-row">
        <span>{ui.property.reference} <strong>{d.ref}</strong></span>
        <button type="button" class="print-btn no-print" id="print-btn">
          {locale === 'hu' ? 'Nyomtatás' : 'Afdrukken'}
        </button>
      </div>

      <div class="prose">
        <h2 class="sr-heading">{ui.property.description}</h2>
        <p class="lead">{description}</p>
        <slot />
      </div>

      {
        d.features.length > 0 && (
          <section class="features">
            <Eyebrow space="14px">{ui.property.features}</Eyebrow>
            <ul>
              {d.features.map((f) => <li>{featureLabel(f, locale)}</li>)}
            </ul>
          </section>
        )
      }

      {
        d.media.videoUrl && (
          <section class="video no-print">
            <Eyebrow space="14px">{ui.property.video}</Eyebrow>
            <VideoEmbed url={d.media.videoUrl} title={title} locale={locale} />
          </section>
        )
      }

      <GoldRule class="prose-rule" />

      <div class="detail-map no-print">
        <Map mode="pin" lat={d.location.lat} lng={d.location.lng} precision={d.location.precision} locale={locale} id={`map-${d.ref}`} />
      </div>

      {/* FODEL's actual USP, as a data-driven block rather than a slogan. */}
      {
        d.seller.contactVisible && d.seller.name && (
          <aside class="owner">
            <Eyebrow space="10px">{ui.property.ownerContact}</Eyebrow>
            <p class="owner-note">{ui.property.ownerContactNote}</p>
            <p class="owner-name">{d.seller.name}</p>
            {d.seller.phone && (
              <p class="owner-phone">
                <a href={`tel:${d.seller.phone.replace(/\s/g, '')}`}>{d.seller.phone}</a>
              </p>
            )}
            {d.seller.speaks.length > 0 && (
              <p class="owner-speaks">
                {locale === 'hu' ? 'Beszélt nyelvek' : 'Spreekt'}:{' '}
                {d.seller.speaks.map((s) => s.toUpperCase()).join(' · ')}
              </p>
            )}
          </aside>
        )
      }

      <aside class="guarantee">
        <Eyebrow space="8px">
          {locale === 'hu' ? 'FODEL Garancia' : 'De FODEL-garantie'}
        </Eyebrow>
        <p>
          {
            locale === 'hu'
              ? 'Minden hirdető azonosítása megtörtént. Kétnyelvű adásvételi szerződés, meghatalmazásos képviselet és földhivatali ügyintézés igény szerint elérhető.'
              : 'Elke adverteerder is door ons geïdentificeerd. Tweetalige koopovereenkomst, vertegenwoordiging met volmacht en inschrijving bij het kadaster zijn op verzoek beschikbaar.'
          }
        </p>
      </aside>
    </div>

    {/* ── Enquiry ── */}
    <aside class="enquiry no-print" data-bg="dark">
      <Eyebrow space="10px">{ui.property.enquire}</Eyebrow>
      <h2 class="enq-title">{ui.property.enquireTitle}</h2>

      <FormShell
        locale={locale}
        endpoint="/api/enquiry"
        formId="enquiry"
        onDark
        meta={{ propertyRef: d.ref, propertyTitle: title }}
      >
        <Field locale={locale} name="name" label={ui.form.name} required autocomplete="name" span="full" onDark />
        <Field locale={locale} name="email" label={ui.form.email} type="email" required autocomplete="email" span="full" onDark />
        <Field locale={locale} name="phone" label={ui.form.phone} type="tel" autocomplete="tel" span="full" onDark />
        <Field
          locale={locale}
          name="message"
          label={ui.form.message}
          type="textarea"
          placeholder={ui.form.messagePlaceholder}
          span="full"
          onDark
        />
      </FormShell>

      <p class="enq-alt">
        {locale === 'hu' ? 'Vagy hívjon minket' : 'Of bel ons'}:<br />
        {
          COMPANY.phones.slice(0, 2).map((p) => (
            <a href={p.href}>{p.display}</a>
          ))
        }
      </p>
    </aside>
  </div>

  {/* ── Similar ── */}
  {
    similar.length > 0 && (
      <section class="similar no-print">
        <Eyebrow space="12px">{ui.property.similar}</Eyebrow>
        <h2>{ui.property.similarInRegion}</h2>
        <div class="sim-grid">
          {similar.map((p) => <PropertyCard property={p} locale={locale} class="reveal" />)}
        </div>
      </section>
    )
  }
</Base>

<script>
  // Gallery: click, keyboard arrows and swipe. The prototype had click only.
  // 1.4: the incoming photograph fades in over the outgoing one, which is
  // only hidden once the fade has finished — so there is never a blank frame
  // and never more than two slides rendered (the rest stay `hidden`, so
  // their lazy images don't load until they are asked for).
  const root = document.getElementById('gallery');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.gallery-slide'));
    const segments = Array.from(root.querySelectorAll<HTMLElement>('[data-seg]'));
    const counter = document.getElementById('gal-count');
    let index = 0;
    // Each change gets a number; a settle from an earlier, overtaken change
    // does nothing, so rapid clicking never hides a slide mid-fade.
    let generation = 0;

    const show = (next: number) => {
      const target = (next + slides.length) % slides.length;
      if (target === index) return;
      const outgoing = slides[index];
      const incoming = slides[target];
      index = target;
      const current = ++generation;
      root.setAttribute('data-moved', '');

      slides.forEach((slide) => slide.removeAttribute('data-leaving'));
      outgoing.removeAttribute('data-active');
      outgoing.setAttribute('data-leaving', '');
      incoming.hidden = false;
      incoming.setAttribute('data-active', '');

      const settle = () => {
        if (current !== generation) return;
        slides.forEach((slide, i) => {
          if (i !== index) {
            slide.hidden = true;
            slide.removeAttribute('data-leaving');
          }
        });
      };
      const onEnd = (e: AnimationEvent) => {
        if (e.target !== incoming) return;
        incoming.removeEventListener('animationend', onEnd);
        settle();
      };
      incoming.addEventListener('animationend', onEnd);
      // Reduced motion (no animation) or an interrupted fade still settles.
      window.setTimeout(settle, 1400);

      segments.forEach((seg, i) => seg.toggleAttribute('data-on', i <= index));
      if (counter) {
        counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }
    };

    document.getElementById('gal-prev')?.addEventListener('click', () => show(index - 1));
    document.getElementById('gal-next')?.addEventListener('click', () => show(index + 1));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
    });

    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const delta = e.changedTouches[0].clientX - startX;
      if (Math.abs(delta) > 48) show(delta < 0 ? index + 1 : index - 1);
    }, { passive: true });
  }

  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>

<style>
  /* ── Breadcrumb, laid over the top of the photograph ── */
  .detail-top {
    position: relative;
  }
  .crumbs {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 4;
    padding: 28px var(--pad-x);
    animation: fx-fade-up 1.2s var(--ease-out) 0.5s both;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    list-style: none;
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    line-height: 1.5;
    color: var(--on-dark-body);
  }
  .crumbs li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .crumbs li + li::before {
    content: '';
    width: 16px;
    height: 1px;
    background: rgba(244, 244, 242, 0.45);
  }
  .crumbs a {
    transition: color var(--dur-fast) ease;
  }
  .crumbs a:hover {
    color: var(--cream);
  }
  .crumbs [aria-current] {
    color: var(--cream);
  }
  .crumbs :focus-visible {
    outline-color: var(--cream);
  }

  /* ── Gallery hero ──
     Exactly the visible viewport under the nav, within sane bounds. */
  .property-detail-hero {
    height: clamp(560px, calc(100svh - var(--nav-h)), 1040px);
  }
  .gallery-slide[hidden] {
    display: none;
  }
  .gallery-slide[data-leaving] {
    z-index: 0;
  }
  .gallery-slide[data-active] {
    z-index: 1;
  }
  .slide-inner {
    position: absolute;
    inset: 0;
  }
  /* Only slides reached by the controls fade in (data-moved is set on the
     first change). The first photograph is on screen from the start, and may
     be arriving mid-morph from a card photograph — it must not also fade. */
  #gallery[data-moved] .gallery-slide[data-active] {
    animation: slide-in 0.9s var(--ease-out) both;
  }
  #gallery[data-moved] .gallery-slide[data-active] :global(img) {
    animation: slide-settle 1.8s var(--ease-out) both;
  }
  @keyframes slide-in {
    from {
      opacity: 0;
    }
  }
  @keyframes slide-settle {
    from {
      transform: scale(1.06);
    }
  }
  #gallery:focus-visible {
    outline-offset: -4px;
  }

  .hero-tag {
    align-self: flex-start;
    background: rgba(10, 29, 48, 0.5);
    border: 1px solid rgba(244, 244, 242, 0.22);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--cream);
    font-family: var(--sans);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    padding: 8px 16px;
    margin-bottom: 8px;
  }
  .hero-foot {
    position: absolute;
    left: var(--pad-x);
    right: var(--pad-x);
    bottom: 48px;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
  }
  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    color: var(--cream);
    animation: fx-fade-up 1.4s var(--ease-out) 0.45s both;
  }
  .hero-kicker {
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    line-height: 1.4;
    text-transform: uppercase;
    color: var(--on-dark-strong);
  }
  .hero-name {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(34px, 5.4vw, 92px);
    letter-spacing: var(--ls-display);
    line-height: 0.98;
    max-width: 14ch;
    text-wrap: balance;
    text-shadow: 0 2px 30px rgba(10, 29, 48, 0.25);
  }
  .hero-gallery {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 14px;
    flex-shrink: 0;
    animation: fx-fade-up 1.2s var(--ease-out) 0.7s both;
  }
  /* One segment per photograph, filled up to the one on screen. */
  .gal-bar {
    display: flex;
    gap: 4px;
    width: 100%;
    max-width: 260px;
  }
  .gal-bar span {
    flex: 1;
    height: 2px;
    background: rgba(244, 244, 242, 0.28);
    position: relative;
    overflow: hidden;
  }
  .gal-bar span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--cream);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  .gal-bar span[data-on]::after {
    transform: none;
  }

  /* ── Body ── */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 440px;
    gap: 104px;
    padding: 104px var(--pad-x) 120px;
    align-items: start;
  }

  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(38px, 4.4vw, 72px);
    letter-spacing: var(--ls-display);
    line-height: 1.02;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .subtitle {
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--taupe);
    margin-bottom: 14px;
  }
  .location {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    font-size: var(--fs-body);
    color: var(--taupe);
    margin-bottom: 40px;
  }
  .map-link {
    font-size: var(--fs-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 3px;
    transition: background-size 0.6s var(--ease-out);
  }
  .map-link:hover {
    background-size: 0% 1px;
    background-position: 100% 100%;
  }

  .price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 28px;
    padding: 28px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }
  .price {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(38px, 3.4vw, 56px);
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .price-huf {
    font-size: var(--fs-body);
    color: var(--taupe);
    font-variant-numeric: tabular-nums;
  }
  .price-asof {
    font-size: var(--fs-micro);
    letter-spacing: 0.04em;
    color: var(--taupe);
    margin-left: auto;
  }

  /* Hairline grid: rules between, not boxes around. */
  .specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 28px;
  }
  .spec {
