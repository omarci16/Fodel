---
/**
 * Home. Ported section-for-section from the prototype: split hero, search bar,
 * dual-audience band, featured selection, editorial pull-quote, three-step
 * model, parallax CTA.
 *
 * The dual-audience split is the strategic heart of the design and is kept
 * exactly as drawn — it is the correct way to express a two-sided marketplace.
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import GoldRule from '~/components/GoldRule.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import ParallaxCta from '~/components/ParallaxCta.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { copy } from '~/data/copy';
import { homeAlternates } from '~/lib/page';
import { activeProperties, homepageFeatured, regionsOf, categoriesOf, text, url } from '~/lib/properties';
import { websiteSchema } from '~/lib/seo';
import { eur } from '~/lib/format';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const c = copy(locale).home;
const steps = copy(locale).steps;

const all = await activeProperties();
const featured = await homepageFeatured(3);
const hero = featured[0];
const referral = c.referral;

const HERO_WIDTHS = [600, 900, 1200];
const HERO_SIZES = '(max-width: 900px) 100vw, 46vw';
const alternates = homeAlternates();
const schema = [websiteSchema(locale, path(locale, 'properties'))];
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternates}
  schema={schema}
>
  {/* ── HERO ── */}
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <span class="rule" aria-hidden="true"></span>
        <span>{c.hero.eyebrow}</span>
      </div>

      <h1>
        {
          c.hero.title.map((line: string, i: number) => (
            <>
              {i === c.hero.emphasis ? <em>{line}</em> : line}
              {i < c.hero.title.length - 1 && <br />}
            </>
          ))
        }
      </h1>

      <GoldRule space="28px" />
      <p class="hero-body">{c.hero.body}</p>

      <div class="hero-actions">
        <Button variant="dark" href={path(locale, 'properties')}>{c.hero.primary}</Button>
        <Button variant="outline" href={path(locale, 'sellers')}>{c.hero.secondary}</Button>
      </div>
    </div>

    {
      hero && (
        <div class="hero-media">
          {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
          <Image
            src={hero.data.media.hero as any}
            alt={text(hero.data.media.heroAlt, locale)}
            widths={HERO_WIDTHS}
            sizes={HERO_SIZES}
            loading="eager"
            fetchpriority="high"
            inferSize={typeof hero.data.media.hero === 'string'}
            class="hero-img"
          />
          <div class="hero-scrim" aria-hidden="true"></div>

          <a class="hero-card" href={url(hero, locale)} data-bg="dark">
            <Eyebrow space="2px" class="hero-card-eyebrow">{c.hero.featuredLabel}</Eyebrow>
            <span class="hero-card-title">{text(hero.data.title, locale)}</span>
            <span class="hero-card-meta">
              {hero.data.location.settlement} · {eur(hero.data.price.eur)}
            </span>
            <span class="hero-card-cta">
              {ui.cta.viewProperty}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </div>
      )
    }
  </section>

  {/* ── SEARCH ── */}
  <section class="search-band">
    <HomeSearch locale={locale} regions={regionsOf(all)} categories={categoriesOf(all)} />
  </section>

  {/* ── DUAL AUDIENCE ── */}
  <section class="audiences" data-bg="dark">
    {
      c.audiences.map((col: any) => (
        <div class="audience reveal">
          <Eyebrow space="16px">{col.eyebrow}</Eyebrow>
          <h2>{col.title}</h2>
          <GoldRule space="18px" />
          <p>{col.body}</p>
          <Button variant="text" light href={path(locale, col.to)}>
            {col.cta}
          </Button>
        </div>
      ))
    }
  </section>

  {/* ── FEATURED ── */}
  <section class="featured">
    <div class="section-head reveal">
      <div>
        <Eyebrow space="12px">{c.featured.eyebrow}</Eyebrow>
        <h2>{c.featured.title}</h2>
      </div>
      <Button variant="text" href={path(locale, 'properties')} class="head-link">
        {ui.cta.allProperties}
      </Button>
    </div>

    <div class="cards">
      {featured.map((p, i) => <PropertyCard property={p} locale={locale} eager={i === 0} class="reveal" />)}
    </div>

    <Button variant="outline" href={path(locale, 'properties')} block class="cards-more">
      {ui.cta.allProperties}
    </Button>
  </section>

  {/* ── QUOTE ── */}
  <section class="quote-band" data-bg="dark">
    <div class="quote-inner reveal">
      <GoldRule center space="48px" />
      <blockquote>{c.quote}</blockquote>
      <GoldRule center space="24px" />
      <p class="quote-source">{c.quoteSource}</p>
    </div>
  </section>

  {/* ── HOW IT WORKS ── */}
  <section class="how">
    <div class="how-head reveal">
      <Eyebrow center space="12px">{c.how.eyebrow}</Eyebrow>
      <h2>{c.how.title}</h2>
    </div>

    <ol class="steps">
      {
        steps.map((step: any) => (
          <li class="step reveal">
            <span class="step-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>

    <div class="how-cta reveal">
      <Button variant="dark" href={path(locale, 'sellers')}>{ui.cta.learnMore}</Button>
    </div>
  </section>

  {/* ── REFERRAL ── */}
  <section class="referral" data-bg="dark">
    <div class="referral-copy reveal">
      <Eyebrow space="16px">{referral.eyebrow}</Eyebrow>
      <h2>
        {referral.title}
        <br />
        <em>{referral.titleEm}</em>
      </h2>
      <p>{referral.body}</p>
      <ol class="referral-steps">
        {referral.steps.map((step: string, i: number) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            {step}
          </li>
        ))}
      </ol>
    </div>

    <div class="referral-form reveal">
      <FormShell
        locale={locale}
        endpoint="/api/referral"
        formId="referral"
        submitLabel={referral.submit}
        onDark
      >
        <Field locale={locale} name="referrerName" label={referral.fields.referrerName} required span="full" onDark />
        <Field locale={locale} name="referrerEmail" label={referral.fields.referrerEmail} type="email" required span="full" onDark />
        <Field locale={locale} name="referredName" label={referral.fields.referredName} required span="full" onDark />
        <Field locale={locale} name="referredEmail" label={referral.fields.referredEmail} type="email" required span="full" onDark />
      </FormShell>
    </div>
  </section>

  <ParallaxCta
    eyebrow={c.cta.eyebrow}
    title={c.cta.title}
    titleEm={c.cta.titleEm}
    body={c.cta.body}
    primary={{ label: ui.cta.callback, href: path(locale, 'contact') }}
    secondary={{ label: ui.cta.browseProperties, href: path(locale, 'properties') }}
  />
</Base>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: 54% 46%;
    min-height: calc(100vh - var(--nav-h));
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px 72px 80px var(--pad-x);
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
    font-family: var(--sans);
    font-weight: var(--fw-regular);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero-eyebrow .rule {
    width: 32px;
    height: 1px;
    background: var(--accent);
    flex-shrink: 0;
  }

  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(46px, 5.8vw, 92px);
    line-height: 1.04;
    color: var(--ink);
    margin-bottom: 32px;
  }
  h1 em {
    font-style: italic;
  }

  .hero-body {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-lead);
    color: var(--taupe);
    max-width: 42ch;
    margin-bottom: 48px;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .hero-media {
    position: relative;
    overflow: hidden;
    background: var(--mist);
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(244, 244, 242, 0.25) 0%, transparent 30%);
  }
  .hero-card {
    position: absolute;
    left: 44px;
    bottom: 44px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: rgba(16, 42, 67, 0.86);
    backdrop-filter: blur(12px);
    padding: 22px 30px;
    max-width: 320px;
  }
  .hero-card-title {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 19px;
    color: var(--cream);
  }
  .hero-card-meta {
    font-size: var(--fs-small);
    color: var(--on-dark-body);
    margin-bottom: 12px;
  }
  .hero-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-micro);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .hero-card:hover .hero-card-cta {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ── Search ── */
  .search-band {
    border-top: 1px solid var(--border);
    padding: 72px var(--pad-x);
  }

  /* ── Audiences ── */
  .audiences {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--ink);
    border-top: 1px solid var(--on-dark-rule);
  }
  .audience {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 88px var(--pad-x);
  }
  .audience + .audience {
    border-left: 1px solid var(--on-dark-rule);
  }
  .audience h2 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(28px, 2.8vw, 44px);
    line-height: 1.18;
    color: var(--cream);
    margin-bottom: 18px;
    white-space: pre-line;
  }
  .audience p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    /* ADJUSTED: the prototype used full cream here; --on-dark-body keeps the
       recessive feel while clearing AA comfortably. */
    color: var(--on-dark-body);
    margin-bottom: 28px;
    max-width: 40ch;
  }

  /* ── Featured ── */
  .featured {
    padding: var(--section-y) var(--pad-x);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 64px;
  }
  .section-head h2,
  .how-head h2 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(32px, 3.5vw, 54px);
    line-height: 1.08;
    color: var(--ink);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
  }
  .cards-more {
    display: none;
    margin-top: 28px;
  }

  /* ── Quote ── */
  .quote-band {
    background: var(--ink);
    padding: 128px var(--pad-x);
  }
  .quote-inner {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }
  blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: var(--fw-light);
    font-size: clamp(24px, 2.8vw, 42px);
    line-height: 1.55;
    color: var(--cream);
    margin-bottom: 48px;
  }
  .quote-source {
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--on-dark-body);
  }

  /* ── How ── */
  .how {
    padding: var(--section-y) var(--pad-x);
  }
  .how-head {
    text-align: center;
    margin-bottom: 80px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
  }
  .step {
    padding: 48px 52px;
    border-top: 2px solid var(--accent);
  }
  .step + .step {
    border-left: 1px solid var(--border);
  }
  .step-num {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: 52px;
    line-height: 1;
    color: var(--accent);
    opacity: 0.62; /* was .45 — 2.64:1, below the 3:1 large-text floor */
    margin-bottom: 28px;
  }
  .step h3 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: 23px;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .step p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  .how-cta {
    text-align: center;
    margin-top: 68px;
  }

  /* ── Referral ── */
  .referral {
    display: grid;
    grid-template-columns: 1fr 460px;
    gap: 64px;
    background: var(--ink);
    border-top: 1px solid var(--on-dark-rule);
    padding: 100px var(--pad-x);
  }
  .referral-copy h2 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(30px, 3.2vw, 48px);
    line-height: 1.12;
    color: var(--cream);
    margin-bottom: 24px;
  }
  .referral-copy h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .referral-copy p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--on-dark-body);
    max-width: 52ch;
    margin-bottom: 32px;
  }
  .referral-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .referral-steps li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: var(--fs-small);
    color: var(--on-dark-body);
    border-top: 2px solid var(--accent);
    padding-top: 12px;
  }
  .referral-steps .n {
    font-family: var(--serif);
    font-size: 20px;
    color: var(--accent);
    flex-shrink: 0;
  }
  .referral-form {
    background: var(--ink);
    border-top: 3px solid var(--accent);
    box-shadow: 0 24px 60px rgba(16, 42, 67, 0.22);
    padding: 36px;
    align-self: start;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .hero-media {
      order: -1;
      aspect-ratio: 4 / 3;
    }
    .hero-copy {
      padding: 36px var(--pad-x-mob) 32px;
    }
    .hero-eyebrow {
      margin-bottom: 20px;
    }
    h1 {
      margin-bottom: 20px;
    }
    .hero-body {
      margin-bottom: 28px;
    }
    .hero-actions {
      flex-direction: column;
    }
    .hero-card {
      left: 16px;
      right: 16px;
      bottom: 16px;
      max-width: none;
      padding: 16px 20px;
    }

    .search-band {
      padding: 44px var(--pad-x-mob);
    }
    .audiences {
      grid-template-columns: 1fr;
    }
    .audience {
      padding: 44px var(--pad-x-mob);
    }
    .audience + .audience {
      border-left: none;
      border-top: 1px solid var(--on-dark-rule);
    }

    .featured,
    .how {
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
    .section-head {
      margin-bottom: 32px;
    }
    .head-link {
      display: none;
    }
    .cards {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .cards-more {
      display: block;
    }

    .quote-band {
      padding: 64px var(--pad-x-mob);
    }
    blockquote {
      margin-bottom: 32px;
    }

    .how-head {
      margin-bottom: 40px;
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .step {
      padding: 28px 0;
    }
    .step + .step {
      border-left: none;
    }
    .step-num {
      font-size: 40px;
      margin-bottom: 16px;
    }
    .how-cta {
      margin-top: 36px;
    }

    .referral {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 56px var(--pad-x-mob);
    }
    .referral-form {
      padding: 28px;
    }
  }
</style>
