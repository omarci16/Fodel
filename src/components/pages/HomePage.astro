    background: rgba(244, 244, 242, 0.1);
  }
  .how-step h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(26px, 2.4vw, 38px);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .how-step p {
    max-width: 48ch;
    font-size: var(--fs-body-lg);
    line-height: 1.65;
    color: var(--taupe);
  }
  .how-step[data-tone='dark'] p {
