---
/**
 * Home.
 *
 * 2.0 composition, top to bottom — a stack of rounded surfaces on the cream
 * page, each set in from the viewport edge by the same margin:
 *
 *   hero        The split, as before: copy on the cream page in its own
 *               column, the photograph beside it — now a rounded stage that
 *               moves through the featured listings, the listing's card and
 *               a progress line for each.
 *   search      The working tool, straight after the promise, as one
 *               floating panel.
 *   featured    An editorial grid whose big photograph always ends level
 *               with the two beside it.
 *   statement   One dark slab: FODEL's signature line in its five languages
 *               running across the top, the verbatim line about Dutch buyers
 *               lit word by word, and the four figures the model rests on.
 *   audiences   The dual-audience split — still the strategic heart of the
 *               page — as two photographic cards that open towards the one
 *               being pointed at.
 *   how         The three-step model as cards that stack as they are read.
 *   top 10      A rail on a tinted slab, because ten ranked listings are a
 *               sequence.
 *   referral, cta
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import ParallaxCta from '~/components/ParallaxCta.astro';
import StatsBand from '~/components/StatsBand.astro';
import ArrowChip from '~/components/ArrowChip.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, BRAND, path, type Locale } from '~/i18n/ui';
import { copy } from '~/data/copy';
import { homeAlternates } from '~/lib/page';
import { activeProperties, homepageFeatured, editorsPick, regionsOf, text, url } from '~/lib/properties';
import { getTaxonomy, getCompany } from '~/lib/runtime-config';
import PostCard from '~/components/PostCard.astro';
import { latestArticles } from '~/lib/blog';
import { websiteSchema } from '~/lib/seo';
import { eur } from '~/lib/format';
import { splitOpeningQuote } from '~/lib/typography';
import sellersImage from '~/assets/properties/vineyard.png';
import buyersImage from '~/assets/properties/vevoknek.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hu = locale === 'hu';
const ui = UI[locale];
const c = copy(locale).home;
const steps = copy(locale).steps;
const stats = copy(locale).stats;

const all = await activeProperties();
const featured = await homepageFeatured(3);
const top = await editorsPick(10);
const taxonomy = await getTaxonomy();
const company = await getCompany();
// Brief 2 (§1/A): the three newest articles in this language — never another
// language's, never a case study, and no section at all when there are none.
const latest = await latestArticles(locale, 3);
// The valuation entry point appears only while an admin has confirmed the
// service is staffed (Beállítások → Szolgáltatások), and says "free" only once
// that is confirmed too.
const valuation = company.services.valuationEntry
  ? {
      href: path(locale, 'valuation'),
      label: company.services.valuationFreeConfirmed
        ? hu ? 'Ingyenes értékbecslés' : 'Gratis waardebepaling'
        : hu ? 'Mennyit ér az ingatlanom?' : 'Wat is mijn woning waard?',
    }
  : null;
const hero = featured[0];
const referral = c.referral;

const HERO_WIDTHS = [700, 1000, 1400, 1800];
const HERO_SIZES = '(max-width: 900px) 100vw, 54vw';
/** The stage moves through the featured listings; the first is the LCP. */
const slides = featured.slice(0, 4);
const alternates = homeAlternates();
const schema = [websiteSchema(locale, path(locale, 'properties'))];

/** The headline is sized from its longest unbreakable run. Lines may wrap at
 *  spaces and after a hyphen ("Nyugat-" / "Európában", as the prototype set
 *  it), so that — not the longest line — is what has to fit the column. */
const longestRun = Math.max(
  ...c.hero.title.flatMap((line: string) => line.split(/[\s-]+/)).map((run: string) => run.length)
);
/** …and from its longest authored line, which may wrap once but no more. */
const longestLine = Math.max(...c.hero.title.map((line: string) => line.length));

/** FODEL's signature line in each of the five languages it advertises in —
 *  verbatim from BRAND, which holds their own published wording. */
const signatures = (['hu', 'nl', 'de', 'en', 'fr'] as const).map((code) => ({
  code,
  text: BRAND[code].signature,
}));

const audienceImage = (to: string) => (to === 'sellers' ? sellersImage : buyersImage);
const quote = splitOpeningQuote(c.quote);
---


<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternates}
  schema={schema}
  whatsapp={{}}
>
  {/* ── HERO ── */}
  <section class="hero">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-rule" aria-hidden="true"></span>
        <span>{c.hero.eyebrow}</span>
      </p>

      <div class="hero-main">
        <h1 class="hero-title" style={`--run:${longestRun};--line:${longestLine}`}>
          {
            c.hero.title.map((line: string, i: number) => (
              <span class="line" style={`--i:${i}`}>
                <span class:list={{ quiet: i === c.hero.emphasis }}>{line}</span>
              </span>
            ))
          }
        </h1>

        <div class="hero-intro">
          <p class="hero-body">{c.hero.body}</p>
          <div class="hero-actions">
            <Button variant="dark" href={path(locale, 'properties')}>{c.hero.primary}</Button>
            <Button variant="text" href={path(locale, hu ? 'sellers' : 'searchRequest')}>{c.hero.secondary}</Button>
          </div>
        </div>
      </div>
    </div>

    {
      slides.length > 0 && (
        <div class="hero-stage" data-hero>
          {slides.map((p, i) => (
            <div class="hero-slide" id={`hero-photo-${i}`} data-vt data-active={i === 0 ? '' : undefined}>
              {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
              <Image
                src={p.data.media.hero as any}
                alt={i === 0 ? text(p.data.media.heroAlt, locale) : ''}
                widths={HERO_WIDTHS}
                sizes={HERO_SIZES}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'low'}
                inferSize={typeof p.data.media.hero === 'string'}
                class="hero-img"
              />
            </div>
          ))}
          <div class="hero-scrim" aria-hidden="true" />

          <div class="hero-panel">
          {slides.length > 1 && (
            <div class="hero-dots" role="group" aria-label={c.featured.title}>
              {slides.map((p, i) => (
                <button
                  type="button"
                  class="hero-dot"
                  data-go={i}
                  aria-label={text(p.data.title, locale)}
                  aria-current={i === 0 ? 'true' : 'false'}
                  data-active={i === 0 ? '' : undefined}
                >
                  <span class="hero-dot-track"><span class="hero-dot-fill" /></span>
                </button>
              ))}
            </div>
          )}
          <div class="hero-cards">
            {slides.map((p, i) => (
              <a
                class="hero-card"
                href={url(p, locale)}
                data-bg="dark"
                data-vt-for={`hero-photo-${i}`}
                data-active={i === 0 ? '' : undefined}
                inert={i !== 0}
              >
                <span class="hero-card-text">
                  <span class="hero-card-top">
                    <span class="hero-card-label">{c.hero.featuredLabel}</span>
                    <span class="hero-card-ref num">{ui.property.reference} {p.data.ref}</span>
                  </span>
                  <span class="hero-card-title">{text(p.data.title, locale)}</span>
                  <span class="hero-card-meta">
                    <span>{p.data.location.settlement}</span>
                    <span class="hero-card-dot" aria-hidden="true" />
                    <span class="num">{eur(p.data.price.eur)}</span>
                  </span>
                </span>
                <ArrowChip size={48} />
                <span class="sr-only">— {ui.cta.viewProperty}</span>
              </a>
            ))}
          </div>
          </div>
        </div>
      )
    }
  </section>

  {/* ── SEARCH ── */}
  <section class="search-band reveal">
    <HomeSearch locale={locale} regions={regionsOf(all)} categories={taxonomy.category.filter((term) => term.enabled)}>
      <p class="search-count">
        <span class="search-count-n num" data-count={String(all.length)}>{all.length}</span>
        <span class="search-count-text">{hu ? 'aktív hirdetés, közvetlenül a tulajdonostól' : 'actieve advertenties, direct van de eigenaar'}</span>
      </p>
    </HomeSearch>
  </section>

  {/* ── FEATURED ── */}
  <section class="featured">
    <SectionHead eyebrow={c.featured.eyebrow} title={c.featured.title} size="large" class="section-head reveal">
      <Button variant="outline" href={path(locale, 'properties')} class="head-link" arrow>
        {ui.cta.allProperties}
      </Button>
    </SectionHead>

    <div class="bento">
      {
        featured.map((p, i) => (
          <PropertyCard
            property={p}
            locale={locale}
            class={`bento-item bento-${i}`}
            ratio={i === 0 ? '4 / 5' : '3 / 2'}
            sizes={i === 0 ? '(max-width: 900px) 100vw, 58vw' : '(max-width: 900px) 100vw, 40vw'}
          />
        ))
      }
    </div>

    <Button variant="outline" href={path(locale, 'properties')} block arrow class="cards-more">
      {ui.cta.allProperties}
    </Button>
  </section>

  {/* ── STATEMENT: five languages, the line, the figures ── */}
  <section class="statement slab" data-bg="dark">
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {
          [0, 1].map(() => (
            <div class="marquee-group">
              {signatures.map((s) => (
                <span class="mq-item">
                  <span class="mq-lang">{s.code}</span>
                  <span class="mq-text">{s.text}</span>
                  <span class="mq-sep" />
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </div>

    <div class="statement-body">
      <div class="statement-inner">
        <p class="statement-source reveal">
          <span class="statement-rule draw" aria-hidden="true"></span>
          {c.quoteSource}
        </p>
        <blockquote class="statement-quote" data-words>
          {quote.mark && <span class="hang-quote">{quote.mark}</span>}{quote.rest}
        </blockquote>
      </div>

      <StatsBand stats={stats} class="statement-stats" />
    </div>
  </section>

  {/* ── DUAL AUDIENCE ── */}
  <section class="audiences" data-bg="dark">
    {
      c.audiences.map((col: any, i: number) => (
        <a class="aud" href={path(locale, col.to)}>
          <div class="aud-media" data-parallax="0.06">
            <Image
              src={audienceImage(col.to)}
              alt=""
              widths={[600, 900, 1300]}
              sizes="(max-width: 900px) 100vw, 60vw"
              loading="lazy"
            />
          </div>
          <div class="aud-shade" aria-hidden="true" />
          <div class="aud-copy">
            <span class="aud-idx num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')} / {String(c.audiences.length).padStart(2, '0')}
            </span>
            <div class="aud-text">
              <Eyebrow space="16px" class="aud-eyebrow">{col.eyebrow}</Eyebrow>
              <h2>
                {col.title.split('\n').map((line: string) => (
                  <span class="aud-line">{line}</span>
                ))}
              </h2>
              <p>{col.body}</p>
              <span class="aud-cta">
                <span>{col.cta}</span>
                <ArrowChip size={44} />
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </section>

  {/* ── HOW IT WORKS ── */}
  <section class="how" id="how">
    <div class="how-aside">
      <div class="how-sticky">
        <SectionHead eyebrow={c.how.eyebrow} title={c.how.title} size="large" class="reveal" />
        <div class="how-cta reveal" style="--reveal-delay:0.1s">
          <Button variant="dark" href={path(locale, 'sellers')}>{ui.cta.learnMore}</Button>
          {valuation && (
            <Button variant="outline" href={valuation.href} arrow>{valuation.label}</Button>
          )}
        </div>
      </div>
    </div>

    <ol class="how-steps">
      {
        steps.map((step: any, i: number) => (
          <li class="how-step" style={`--i:${i}`} data-tone={i === steps.length - 1 ? 'dark' : i === 0 ? 'light' : 'mist'} data-bg={i === steps.length - 1 ? 'dark' : undefined}>
            <div class="how-step-top">
              <span class="how-step-num num">{step.num}</span>
              <span class="how-step-icon" aria-hidden="true">
                {i === 0 && (
                  <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                    <circle cx="15" cy="15" r="11.5" stroke="currentColor" stroke-width="1.4" />
                    <path d="M3.5 15h23M15 3.5c3.2 3.1 4.8 7 4.8 11.5S18.2 23.4 15 26.5M15 3.5c-3.2 3.1-4.8 7-4.8 11.5s1.6 8.4 4.8 11.5" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
                {i === 1 && (
                  <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                    <path d="M15 3.5 24.5 7v7.2c0 6-4 10.4-9.5 12.3-5.5-1.9-9.5-6.3-9.5-12.3V7L15 3.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    <path d="m10.5 15 3.2 3.2 5.8-6.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {i >= 2 && (
                  <svg width="30" height="30" viewBox="0 0 30 30" fill="none">
                    <path d="M8 3.5h10.5L23.5 8.5v18H8v-23Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    <path d="M18 3.5v5.5h5.5M12 14.5h8M12 18.5h8M12 22.5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                )}
              </span>
            </div>
            <div class="how-step-text">
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── TOP 10 ── */}
  {
    top.length > 0 && (
      <section class="top-picks slab" aria-labelledby="top-picks-title">
        <div class="rail-head">
          <SectionHead
            eyebrow="FODEL Top 10"
            title={hu ? 'A FODEL ajánlásával' : 'Aanbevolen door FODEL'}
            size="large"
            class="reveal"
          />
          <div class="rail-controls">
            <Button variant="text" href={path(locale, 'top10')}>{hu ? `Mind a ${top.length}` : `Alle ${top.length}`}</Button>
            <div class="rail-arrows">
              <button type="button" class="rail-btn" data-rail="prev" aria-label={hu ? 'Előző' : 'Vorige'}>
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
                  <path d="M15 6H2M6.5 1.5 2 6l4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <button type="button" class="rail-btn" data-rail="next" aria-label={hu ? 'Következő' : 'Volgende'}>
                <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
                  <path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="rail" id="top-rail" tabindex="0" role="region" aria-label="FODEL Top 10">
          {top.map((p, index) => (
            <PropertyCard property={p} locale={locale} rank={index + 1} ratio="4 / 5" class="rail-item" sizes="(max-width: 900px) 80vw, 28vw" />
          ))}
        </div>
        <div class="rail-progress" aria-hidden="true">
          <span id="rail-progress" />
        </div>
      </section>
    )
  }

  {/* ── LATEST ARTICLES ── */}
  {
    latest.length > 0 && (
      <section class="latest" aria-label={hu ? 'Legfrissebb cikkeink' : 'Onze nieuwste artikelen'}>
        <div class="latest-head">
          <SectionHead
            eyebrow={hu ? 'Blog' : 'Nieuws'}
            title={hu ? 'Legfrissebb cikkeink' : 'Onze nieuwste artikelen'}
            size="large"
            class="reveal"
          />
          <Button variant="outline" href={path(locale, 'blog')} class="latest-all" arrow>
            {hu ? 'Összes cikk' : 'Alle artikelen'}
          </Button>
        </div>
        <div class:list={['latest-grid', `count-${latest.length}`]}>
          {latest.map((post, i) => (
            <PostCard post={post} locale={locale} class="reveal" style={`--reveal-delay:${i * 0.08}s`} />
          ))}
        </div>
      </section>
    )
  }

  {/* ── REFERRAL ── */}
  <section class="referral">
    <div class="referral-copy reveal">
      <Eyebrow space="20px">{referral.eyebrow}</Eyebrow>
      <h2>
        <span class="line"><span>{referral.title}</span></span>
        <span class="line" style="--i:1"><span><em>{referral.titleEm}</em></span></span>
      </h2>
      <p>{referral.body}</p>
      <ol class="referral-steps">
        {referral.steps.map((step: string, i: number) => (
          <li>
            <span class="n num">{String(i + 1).padStart(2, '0')}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="referral-form reveal" style="--reveal-delay:0.15s">
      <h3 class="referral-form-title">{referral.formTitle}</h3>
      <FormShell
        locale={locale}
        endpoint="/api/referral"
        formId="referral"
        submitLabel={referral.submit}
      >
        <Field locale={locale} name="referrerName" label={referral.fields.referrerName} required />
        <Field locale={locale} name="referrerEmail" label={referral.fields.referrerEmail} type="email" required />
        <Field locale={locale} name="referredName" label={referral.fields.referredName} required />
        <Field locale={locale} name="referredEmail" label={referral.fields.referredEmail} type="email" required />
      </FormShell>
    </div>
  </section>

  <ParallaxCta
    eyebrow={c.cta.eyebrow}
    title={c.cta.title}
    titleEm={c.cta.titleEm}
    body={c.cta.body}
    primary={{ label: ui.cta.callback, href: path(locale, 'contact') }}
    secondary={{ label: ui.cta.browseProperties, href: path(locale, 'properties') }}
  />
</Base>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Hero stage ──
     Moves through the featured listings. The progress line under each dot
     IS the timer: the next listing comes up when its animation ends, so
     pausing the animation pauses the stage and the two can never disagree.
     It holds still while the listing's own card is pointed at or focused
     (nobody should click one house and land on another), while it is off
     screen, and while the tab is hidden. With reduced motion it does not
     advance on its own; the dots still work. */
  const stage = document.querySelector<HTMLElement>('[data-hero]');
  if (stage) {
    const slides = Array.from(stage.querySelectorAll<HTMLElement>('.hero-slide'));
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('.hero-card'));
    const dots = Array.from(stage.querySelectorAll<HTMLButtonElement>('.hero-dot'));
    const count = slides.length;
    let index = 0;

    const holds = new Set<string>();
    const hold = (why: string, on: boolean) => {
      if (on) holds.add(why);
      else holds.delete(why);
      stage.toggleAttribute('data-paused', holds.size > 0);
    };

    const show = (next: number) => {
      index = (next + count) % count;
      slides.forEach((s, k) => s.toggleAttribute('data-active', k === index));
      cards.forEach((c, k) => {
        const on = k === index;
        c.toggleAttribute('data-active', on);
        c.inert = !on;
      });
      dots.forEach((d, k) => {
        d.removeAttribute('data-active');
        d.setAttribute('aria-current', String(k === index));
      });
      // Re-arm the active progress line from zero.
      const dot = dots[index];
      if (dot) {
        void dot.offsetWidth;
        dot.setAttribute('data-active', '');
      }
    };

    if (count > 1) {
      if (!reduced) stage.setAttribute('data-auto', '');
      dots.forEach((d) => {
        d.addEventListener('click', () => show(Number(d.dataset.go)));
        d.querySelector('.hero-dot-fill')?.addEventListener('animationend', () => {
          if (d.hasAttribute('data-active')) show(index + 1);
        });
      });
      cards.forEach((c) => {
        c.addEventListener('pointerenter', () => hold('pointer', true));
        c.addEventListener('pointerleave', () => hold('pointer', false));
        c.addEventListener('focusin', () => hold('focus', true));
        c.addEventListener('focusout', () => hold('focus', false));
      });
      document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
      // Watched through the hero section, not the stage: the stage opens
      // with a clip-path wipe, and Chrome reports a fully clipped element as
      // never intersecting — the stage would count as off screen for good.
      if ('IntersectionObserver' in window) {
        const hero = stage.closest('section') ?? stage;
        new IntersectionObserver(([entry]) => hold('offscreen', !entry.isIntersecting), { threshold: 0.2 }).observe(hero);
      }
    }
  }

  /* ── How it works: the cards stack as they are read. Each card eases back
     and dims a little as the next one slides up over it. Wide screens only;
     on phones they are an ordinary list. */
  const how = document.getElementById('how');
  const stacking = window.matchMedia('(min-width: 1001px)');
  if (how && !reduced) {
    const steps = Array.from(how.querySelectorAll<HTMLElement>('.how-step'));
    let ticking = false;
    const update = () => {
      ticking = false;
      if (!stacking.matches) {
        steps.forEach((s) => s.style.removeProperty('--p'));
        return;
      }
      const vh = window.innerHeight;
      steps.forEach((step, i) => {
        const next = steps[i + 1];
        if (!next) return;
        const stickAt = parseFloat(getComputedStyle(next).top) || 0;
        const distance = next.getBoundingClientRect().top - stickAt;
        const p = Math.min(1, Math.max(0, 1 - distance / (vh * 0.7)));
        step.style.setProperty('--p', p.toFixed(3));
      });
    };
    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request, { passive: true });
    update();
  }

  /* ── Top 10 rail: arrow buttons, a progress line, and drag-to-scroll
     for a mouse (touch and trackpads already scroll it natively). */
  const rail = document.getElementById('top-rail');
  const bar = document.getElementById('rail-progress');
  if (rail) {
    const step = () => (rail.querySelector<HTMLElement>('.rail-item')?.offsetWidth ?? 320) + 24;
    document.querySelector('[data-rail="prev"]')?.addEventListener('click', () =>
      rail.scrollBy({ left: -step(), behavior: reduced ? 'auto' : 'smooth' })
    );
    document.querySelector('[data-rail="next"]')?.addEventListener('click', () =>
      rail.scrollBy({ left: step(), behavior: reduced ? 'auto' : 'smooth' })
    );

    // The arrows say when there is nothing further that way, and the
    // controls step aside altogether when every pick already fits.
    const section = rail.closest<HTMLElement>('.top-picks');
    const prevBtn = document.querySelector<HTMLElement>('[data-rail="prev"]');
    const nextBtn = document.querySelector<HTMLElement>('[data-rail="next"]');
    const progress = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const visible = rail.clientWidth / rail.scrollWidth;
      const p = max > 0 ? rail.scrollLeft / max : 1;
      bar?.style.setProperty('--w', String(visible));
      bar?.style.setProperty('--p', String(p));
      prevBtn?.setAttribute('aria-disabled', String(rail.scrollLeft <= 1));
      nextBtn?.setAttribute('aria-disabled', String(rail.scrollLeft >= max - 1));
    };
    // Measured on the rail's natural layout (static mode stretches the cards
    // to fill the row, which would always "fit"); no paint happens between
    // removing and restoring the attribute.
    const measure = () => {
      section?.removeAttribute('data-static');
      const fits = rail.scrollWidth - rail.clientWidth <= 1;
      section?.toggleAttribute('data-static', fits);
      progress();
    };
    rail.addEventListener('scroll', progress, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    measure();

    let down = false;
    let moved = false;
    let startX = 0;
    let startLeft = 0;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = rail.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) {
        moved = true;
        rail.setAttribute('data-dragging', '');
      }
      if (moved) rail.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      down = false;
      rail.removeAttribute('data-dragging');
    });
    // A drag must not also open the card it ended on.
    rail.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true
    );
    rail.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>

