    transform: scale(calc(1 - var(--p, 0) * 0.04));
    box-shadow: 0 -18px 40px -32px rgba(var(--shadow-ink), 0.4);
    will-change: transform;
  }
  .how-step::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ink-deep);
    opacity: calc(var(--p, 0) * 0.1);
    pointer-events: none;
  }
