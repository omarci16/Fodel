---
/**
 * Home.
 *
 * 1.4 composition, top to bottom:
 *
 *   hero        The prototype's split — copy on the cream page, photograph
 *               beside it — with the headline sized to fill its column: as
 *               large as the longest word allows, lifted line by line out of
 *               its masks while the photograph opens from its left edge.
 *   search      The working tool, straight after the promise.
 *   marquee     FODEL's own signature line in all five of its languages.
 *   featured    An editorial grid, not three equal boxes.
 *   statement   FODEL's verbatim line about Dutch buyers, lit word by word as
 *               it is read, over the four figures the model rests on.
 *   audiences   The dual-audience split — still the strategic heart of the
 *               page — as two photographic panels that open towards the one
 *               being pointed at.
 *   how         The three-step model: the heading stays, the steps pass.
 *   top 10      A rail, because ten ranked listings are a sequence.
 *   referral, cta
 */
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import SectionHead from '~/components/SectionHead.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import HomeSearch from '~/components/HomeSearch.astro';
import ParallaxCta from '~/components/ParallaxCta.astro';
import StatsBand from '~/components/StatsBand.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, BRAND, path, type Locale } from '~/i18n/ui';
import { copy } from '~/data/copy';
import { homeAlternates } from '~/lib/page';
import { activeProperties, homepageFeatured, editorsPick, regionsOf, text, url } from '~/lib/properties';
import { getTaxonomy } from '~/lib/runtime-config';
import { websiteSchema } from '~/lib/seo';
import { eur } from '~/lib/format';
import { splitOpeningQuote } from '~/lib/typography';
import sellersImage from '~/assets/properties/vineyard.png';
import buyersImage from '~/assets/properties/vevoknek.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const hu = locale === 'hu';
const ui = UI[locale];
const c = copy(locale).home;
const steps = copy(locale).steps;
const stats = copy(locale).stats;

const all = await activeProperties();
const featured = await homepageFeatured(3);
const top = await editorsPick(10);
const taxonomy = await getTaxonomy();
const hero = featured[0];
const referral = c.referral;

const HERO_WIDTHS = [700, 1000, 1400, 1800];
const HERO_SIZES = '(max-width: 900px) 100vw, 56vw';
const alternates = homeAlternates();
const schema = [websiteSchema(locale, path(locale, 'properties'))];

/** The headline is sized from its longest unbreakable run. Lines may wrap at
 *  spaces and after a hyphen ("Nyugat-" / "Európában", as the prototype set
 *  it), so that — not the longest line — is what has to fit the column. */
const longestRun = Math.max(
  ...c.hero.title.flatMap((line: string) => line.split(/[\s-]+/)).map((run: string) => run.length)
);

/** FODEL's signature line in each of the five languages it advertises in —
 *  verbatim from BRAND, which holds their own published wording. */
const signatures = (['hu', 'nl', 'de', 'en', 'fr'] as const).map((code) => ({
  code,
  text: BRAND[code].signature,
}));

const audienceImage = (to: string) => (to === 'sellers' ? sellersImage : buyersImage);
const quote = splitOpeningQuote(c.quote);
---

<Base
  locale={locale}
  title={c.meta.title}
  description={c.meta.description}
  alternates={alternates}
  schema={schema}
>
  {/* ── HERO ── */}
  <section class="hero">
    {
      hero && (
        <div class="hero-media">
          <div class="hero-media-inner" id="hero-photo" data-vt>
            {/* astro:assets' <Image> has separate local/remote overloads; a src that can be either doesn't match either cleanly — the `as any` is a type-checker limitation, not a runtime one. */}
            <Image
              src={hero.data.media.hero as any}
              alt={text(hero.data.media.heroAlt, locale)}
              widths={HERO_WIDTHS}
              sizes={HERO_SIZES}
              loading="eager"
              fetchpriority="high"
              inferSize={typeof hero.data.media.hero === 'string'}
              class="hero-img"
            />
          </div>
          <div class="hero-scrim" aria-hidden="true" />
        </div>
      )
    }

    <div class="hero-top">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-rule" aria-hidden="true"></span>
        <span>{c.hero.eyebrow}</span>
      </p>
      <p class="hero-coords" aria-hidden="true">
        <span>52°04′N&ensp;4°18′E</span>
        <span class="hero-coords-line"><span>{hu ? '1 171 km' : '1.171 km'}</span></span>
        <span>47°30′N&ensp;19°02′E</span>
      </p>
    </div>

    <h1 class="hero-title" style={`--run:${longestRun}`}>
      {
        c.hero.title.map((line: string, i: number) => (
          <span class="line" style={`--i:${i}`}>
            <span class:list={{ em: i === c.hero.emphasis }}>{line}</span>
          </span>
        ))
      }
    </h1>

    <div class="hero-foot">
      <div class="hero-intro">
        <p class="hero-body">{c.hero.body}</p>
        <div class="hero-actions">
          <Button variant="dark" href={path(locale, 'properties')}>{c.hero.primary}</Button>
          <Button variant="text" href={path(locale, 'sellers')}>{c.hero.secondary}</Button>
        </div>
      </div>

      {
        hero && (
          <a class="hero-card" href={url(hero, locale)} data-bg="dark" data-vt-for="hero-photo">
            <span class="hero-card-top">
              <Eyebrow as="span">{c.hero.featuredLabel}</Eyebrow>
              <span class="hero-card-ref num">{ui.property.reference} {hero.data.ref}</span>
            </span>
            <span class="hero-card-title">{text(hero.data.title, locale)}</span>
            <span class="hero-card-meta">
              <span>{hero.data.location.settlement}</span>
              <span class="num">{eur(hero.data.price.eur)}</span>
            </span>
            <span class="hero-card-cta">
              {ui.cta.viewProperty}
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                <path d="M0 5h16.5M12.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
              </svg>
            </span>
          </a>
        )
      }
    </div>
  </section>

  {/* ── SEARCH ── */}
  <section class="search-band reveal">
    <HomeSearch locale={locale} regions={regionsOf(all)} categories={taxonomy.category.filter((term) => term.enabled)}>
      <p class="search-count">
        <span class="search-count-n num" data-count={String(all.length)}>{all.length}</span>
        <span>{hu ? 'aktív hirdetés, közvetlenül a tulajdonostól' : 'actieve advertenties, direct van de eigenaar'}</span>
      </p>
    </HomeSearch>
  </section>

  {/* ── FIVE LANGUAGES ── */}
  <section class="marquee" data-bg="dark" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-group">
            {signatures.map((s) => (
              <span class="mq-item">
                <span class="mq-lang">{s.code}</span>
                <span class="mq-text">{s.text}</span>
                <span class="mq-sep" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  {/* ── FEATURED ── */}
  <section class="featured">
    <SectionHead eyebrow={c.featured.eyebrow} title={c.featured.title} size="large" class="section-head reveal">
      <Button variant="text" href={path(locale, 'properties')} class="head-link">
        {ui.cta.allProperties}
      </Button>
    </SectionHead>

    <div class="bento">
      {
        featured.map((p, i) => (
          <PropertyCard
            property={p}
            locale={locale}
            class={`bento-item bento-${i}`}
            ratio={i === 0 ? '5 / 6' : i === 1 ? '4 / 5' : '4 / 3'}
            sizes={i === 0 ? '(max-width: 900px) 100vw, 55vw' : '(max-width: 900px) 100vw, 32vw'}
          />
        ))
      }
    </div>

    <Button variant="outline" href={path(locale, 'properties')} block class="cards-more">
      {ui.cta.allProperties}
    </Button>
  </section>

  {/* ── STATEMENT ── */}
  <section class="statement" data-bg="dark">
    <div class="statement-inner">
      <p class="statement-source reveal">
        <span class="statement-rule draw" aria-hidden="true"></span>
        {c.quoteSource}
      </p>
      <blockquote class="statement-quote" data-words>
        {quote.mark && <span class="hang-quote">{quote.mark}</span>}{quote.rest}
      </blockquote>
    </div>

    <StatsBand stats={stats} class="statement-stats" />
  </section>

  {/* ── DUAL AUDIENCE ── */}
  <section class="audiences" data-bg="dark">
    {
      c.audiences.map((col: any, i: number) => (
        <a class="aud" href={path(locale, col.to)}>
          <div class="aud-media" data-parallax="0.06">
            <Image
              src={audienceImage(col.to)}
              alt=""
              widths={[600, 900, 1300]}
              sizes="(max-width: 900px) 100vw, 60vw"
              loading="lazy"
            />
          </div>
          <div class="aud-shade" aria-hidden="true" />
          <div class="aud-copy">
            <span class="aud-idx num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')} / {String(c.audiences.length).padStart(2, '0')}
            </span>
            <div class="aud-text">
              <Eyebrow space="18px">{col.eyebrow}</Eyebrow>
              <h2>
                {col.title.split('\n').map((line: string) => (
                  <span class="aud-line">{line}</span>
                ))}
              </h2>
              <p>{col.body}</p>
              <span class="aud-cta">
                {col.cta}
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                  <path d="M0 5h16.5M12.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </section>

  {/* ── HOW IT WORKS ── */}
  <section class="how" id="how">
    <div class="how-aside">
      <div class="how-sticky">
        <SectionHead eyebrow={c.how.eyebrow} title={c.how.title} size="large" class="reveal" />
        <div class="how-counter" aria-hidden="true">
          <span class="how-counter-window">
            <span class="how-counter-reel">
              {steps.map((s: any) => <span>{s.num}</span>)}
            </span>
          </span>
          <span class="how-counter-total">/ {String(steps.length).padStart(2, '0')}</span>
        </div>
        <div class="how-cta">
          <Button variant="dark" href={path(locale, 'sellers')}>{ui.cta.learnMore}</Button>
        </div>
      </div>
    </div>

    <ol class="how-steps">
      {
        steps.map((step: any, i: number) => (
          <li class="how-step reveal" data-step={i}>
            <span class="how-step-num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── TOP 10 ── */}
  {
    top.length > 0 && (
      <section class="top-picks" aria-labelledby="top-picks-title">
        <div class="rail-head">
          <SectionHead
            eyebrow="FODEL Top 10"
            title={hu ? 'A FODEL ajánlásával' : 'Aanbevolen door FODEL'}
            size="large"
            class="reveal"
          />
          <div class="rail-controls">
            <button type="button" class="rail-btn" data-rail="prev" aria-label={hu ? 'Előző' : 'Vorige'}>
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                <path d="M18 5H1.5M5.5 1l-4 4 4 4" stroke="currentColor" stroke-width="1.1" />
              </svg>
            </button>
            <button type="button" class="rail-btn" data-rail="next" aria-label={hu ? 'Következő' : 'Volgende'}>
              <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                <path d="M0 5h16.5M12.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
              </svg>
            </button>
            <Button variant="text" href={path(locale, 'top10')}>{hu ? `Mind a ${top.length}` : `Alle ${top.length}`}</Button>
          </div>
        </div>

        <div class="rail" id="top-rail" tabindex="0" role="region" aria-label="FODEL Top 10">
          {top.map((p, index) => (
            <PropertyCard property={p} locale={locale} rank={index + 1} ratio="4 / 5" class="rail-item" sizes="(max-width: 900px) 80vw, 28vw" />
          ))}
        </div>
        <div class="rail-progress" aria-hidden="true">
          <span id="rail-progress" />
        </div>
      </section>
    )
  }

  {/* ── REFERRAL ── */}
  <section class="referral" data-bg="dark">
    <div class="referral-copy reveal">
      <Eyebrow space="20px">{referral.eyebrow}</Eyebrow>
      <h2>
        <span class="line"><span>{referral.title}</span></span>
        <span class="line" style="--i:1"><span><em>{referral.titleEm}</em></span></span>
      </h2>
      <p>{referral.body}</p>
      <ol class="referral-steps">
        {referral.steps.map((step: string, i: number) => (
          <li>
            <span class="n num">{String(i + 1).padStart(2, '0')}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="referral-form reveal" style="--reveal-delay:0.15s">
      <FormShell
        locale={locale}
        endpoint="/api/referral"
        formId="referral"
        submitLabel={referral.submit}
        onDark
      >
        <Field locale={locale} name="referrerName" label={referral.fields.referrerName} required span="full" onDark />
        <Field locale={locale} name="referrerEmail" label={referral.fields.referrerEmail} type="email" required span="full" onDark />
        <Field locale={locale} name="referredName" label={referral.fields.referredName} required span="full" onDark />
        <Field locale={locale} name="referredEmail" label={referral.fields.referredEmail} type="email" required span="full" onDark />
      </FormShell>
    </div>
  </section>

  <ParallaxCta
    eyebrow={c.cta.eyebrow}
    title={c.cta.title}
    titleEm={c.cta.titleEm}
    body={c.cta.body}
    primary={{ label: ui.cta.callback, href: path(locale, 'contact') }}
    secondary={{ label: ui.cta.browseProperties, href: path(locale, 'properties') }}
  />
</Base>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── How it works: the counter follows the step in the middle of the
     screen. Without JS every step is simply shown at full strength. */
  const how = document.getElementById('how');
  if (how && 'IntersectionObserver' in window) {
    const steps = Array.from(how.querySelectorAll<HTMLElement>('.how-step'));
    how.setAttribute('data-ready', '');
    const setActive = (n: number) => {
      how.style.setProperty('--n', String(n));
      steps.forEach((s, i) => s.toggleAttribute('data-active', i === n));
    };
    setActive(0);
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(Number((entry.target as HTMLElement).dataset.step));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );
    steps.forEach((s) => io.observe(s));
  }

  /* ── Top 10 rail: arrow buttons, a progress line, and drag-to-scroll
     for a mouse (touch and trackpads already scroll it natively). */
  const rail = document.getElementById('top-rail');
  const bar = document.getElementById('rail-progress');
  if (rail) {
    const step = () => (rail.querySelector<HTMLElement>('.rail-item')?.offsetWidth ?? 320) + 32;
    document.querySelector('[data-rail="prev"]')?.addEventListener('click', () =>
      rail.scrollBy({ left: -step(), behavior: reduced ? 'auto' : 'smooth' })
    );
    document.querySelector('[data-rail="next"]')?.addEventListener('click', () =>
      rail.scrollBy({ left: step(), behavior: reduced ? 'auto' : 'smooth' })
    );

    // The arrows say when there is nothing further that way, and the
    // controls step aside altogether when every pick already fits.
    const section = rail.closest<HTMLElement>('.top-picks');
    const prevBtn = document.querySelector<HTMLElement>('[data-rail="prev"]');
    const nextBtn = document.querySelector<HTMLElement>('[data-rail="next"]');
    const progress = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      const visible = rail.clientWidth / rail.scrollWidth;
      const p = max > 0 ? rail.scrollLeft / max : 1;
      bar?.style.setProperty('--w', String(visible));
      bar?.style.setProperty('--p', String(p));
      prevBtn?.setAttribute('aria-disabled', String(rail.scrollLeft <= 1));
      nextBtn?.setAttribute('aria-disabled', String(rail.scrollLeft >= max - 1));
    };
    // Measured on the rail's natural layout (static mode stretches the cards
    // to fill the row, which would always "fit"); no paint happens between
    // removing and restoring the attribute.
    const measure = () => {
      section?.removeAttribute('data-static');
      const fits = rail.scrollWidth - rail.clientWidth <= 1;
      section?.toggleAttribute('data-static', fits);
      progress();
    };
    rail.addEventListener('scroll', progress, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    measure();

    let down = false;
    let moved = false;
    let startX = 0;
    let startLeft = 0;
    rail.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = rail.scrollLeft;
    });
    window.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 6) {
        moved = true;
        rail.setAttribute('data-dragging', '');
      }
      if (moved) rail.scrollLeft = startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
      down = false;
      rail.removeAttribute('data-dragging');
    });
    // A drag must not also open the card it ended on.
    rail.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true
    );
    rail.addEventListener('dragstart', (e) => e.preventDefault());
  }
</script>

<style>
  /* ══ HERO ═════════════════════════════════════════════════════════════ */
  .hero {
    /* The photograph starts here; the copy column is everything to its left,
       less the page margin and a gutter. In container units so both follow
       the hero's width exactly (cqw is the content box — padding added back). */
    --split-at: 54%;
    --copy-w: calc(0.54 * (100cqw + 2 * var(--pad-x)) - var(--pad-x) - 72px);
    position: relative;
    container-type: inline-size;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: max(680px, calc(100svh - var(--nav-h)));
    padding: 40px var(--pad-x) 44px;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0 0 0 var(--split-at);
    overflow: hidden;
    background: var(--ink);
    animation: fx-wipe 1.6s var(--ease-in-out) both;
  }
  .hero-media-inner {
    position: absolute;
    inset: -6% 0;
    transform: translate3d(0, var(--py, 0px), 0);
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: fx-settle 2.8s var(--ease-out) both;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 29, 48, 0.62) 0%, rgba(10, 29, 48, 0.3) 38%, rgba(10, 29, 48, 0) 66%),
      linear-gradient(0deg, rgba(10, 29, 48, 0.55) 0%, rgba(10, 29, 48, 0) 38%),
      linear-gradient(180deg, rgba(10, 29, 48, 0.35) 0%, rgba(10, 29, 48, 0) 22%);
  }

  .hero-top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink);
    animation: fx-fade-up 1.2s var(--ease-out) 0.5s both;
  }
  .hero-eyebrow-rule {
    width: 40px;
    height: 1px;
    background: var(--ink);
    transform-origin: left;
    animation: fx-draw 1.2s var(--ease-out) 0.6s both;
  }
  .hero-coords {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--on-dark-strong);
    font-variant-numeric: tabular-nums;
    animation: fx-fade-up 1.2s var(--ease-out) 1.1s both;
  }
  .hero-coords-line {
    position: relative;
    display: block;
    width: clamp(60px, 9vw, 140px);
    height: 1px;
    background: rgba(244, 244, 242, 0.55);
  }
  .hero-coords-line span {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    font-size: 10px;
    letter-spacing: 0.2em;
    white-space: nowrap;
    color: var(--on-dark-body);
  }
  .hero-coords-line::before,
  .hero-coords-line::after {
    content: '';
    position: absolute;
    top: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cream);
  }
  .hero-coords-line::before {
    left: -2px;
  }
  .hero-coords-line::after {
    right: -2px;
  }

  /* The headline: the smallest of 7.6vw, the size at which its longest word
     fills the copy column, and the size at which four lines still leave room
     for the intro beneath them. */
  .hero-title {
    position: relative;
    align-self: center;
    max-width: var(--copy-w);
    margin: 28px 0 40px;
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: min(7.6vw, calc(var(--copy-w) / (var(--run) * 0.56)), calc((100svh - var(--nav-h) - 430px) / 3.9));
    line-height: 0.96;
    letter-spacing: var(--ls-display);
    color: var(--ink);
  }
  .hero-title .line > span {
    animation: fx-rise 1.4s var(--ease-out) both;
    animation-delay: calc(0.45s + var(--i, 0) * 0.11s);
  }
  .hero-title .em {
    font-style: italic;
    font-weight: var(--fw-light);
  }

  .hero-foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }
  .hero-intro {
    max-width: var(--copy-w);
    min-width: 0;
    animation: fx-fade-up 1.3s var(--ease-out) 1s both;
  }
  .hero-body {
    font-size: var(--fs-body-lg);
    line-height: 1.6;
