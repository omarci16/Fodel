    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .how-steps {
    display: grid;
    gap: 28px;
    list-style: none;
  }
  /* Each card sticks a little lower than the last, so the stack shows its
     edges; --p (0 → 1, from the script) eases a card back as the next one
     covers it. */
  .how-step {
    position: sticky;
    top: calc(var(--nav-h) + 40px + var(--i, 0) * 24px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
    min-height: 440px;
    padding: 36px clamp(28px, 3.4vw, 52px) 44px;
