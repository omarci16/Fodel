---
/**
 * English / German article list (brief §5). Only posts written and published
 * in this language appear; there is no fallback to another language's text.
 * Case studies are listed separately via `?type=case-study`, as on hu/nl.
 */
import Bridge from '~/layouts/Bridge.astro';
import PostCard from '~/components/PostCard.astro';
import { publishedPosts, BLOG_PATH } from '~/lib/blog';

interface Props {
  locale: 'en' | 'de';
}

const { locale } = Astro.props;
const showCases = Astro.url.searchParams.get('type') === 'case-study';
const [articles, cases] = await Promise.all([
  publishedPosts(locale, { kind: 'article' }),
  publishedPosts(locale, { kind: 'case_study' }),
]);
const posts = showCases ? cases : articles;

const T = {
  en: {
    title: 'Articles',
    description: 'Background on the Hungarian property market and on buying in Hungary, from FODEL Real Estates.',
    heading: 'Articles',
    intro: 'Background on the Hungarian property market and on buying a home in Hungary.',
    articles: 'Articles',
    cases: 'Case studies',
    empty: 'There are no articles in English yet.',
    other: 'Our articles in Dutch',
  },
  de: {
    title: 'Artikel',
    description: 'Hintergründe zum ungarischen Immobilienmarkt und zum Immobilienkauf in Ungarn, von FODEL Immobilien.',
    heading: 'Artikel',
    intro: 'Hintergründe zum ungarischen Immobilienmarkt und zum Kauf einer Immobilie in Ungarn.',
    articles: 'Artikel',
    cases: 'Fallstudien',
    empty: 'Es gibt noch keine Artikel auf Deutsch.',
    other: 'Unsere Artikel auf Niederländisch',
  },
}[locale];
---

<Bridge locale={locale} title={T.title} description={T.description}>
  <header class="page-head">
    <h1>{T.heading}</h1>
    <p>{T.intro}</p>
  </header>

  {cases.length > 0 && (
    <nav class="kinds" aria-label={T.title}>
      <a href={BLOG_PATH[locale]} aria-current={!showCases ? 'page' : undefined}>{T.articles}</a>
      <a href={`${BLOG_PATH[locale]}?type=case-study`} aria-current={showCases ? 'page' : undefined}>{T.cases}</a>
    </nav>
  )}

  {posts.length > 0 ? (
    <div class="grid">
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </div>
  ) : (
    <div class="empty">
      <p>{T.empty}</p>
      <a href="/nl/nieuws/">{T.other} →</a>
    </div>
  )}
</Bridge>

<style>
  .page-head {
    max-width: 720px;
    padding: 32px 0 40px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(36px, 5vw, 64px);
    letter-spacing: var(--ls-display);
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .page-head p {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .kinds a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(16, 42, 67, 0.16);
    font-size: 15px;
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .kinds a[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .empty {
    display: grid;
    gap: 12px;
    padding: 32px;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    color: var(--taupe);
  }
  .empty a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .empty {
      padding: 24px 20px;
    }
  }
</style>
