---
/** Five-step, optional-facts valuation request. Numeric results remain gated by settings. */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import FormShell from '~/components/forms/FormShell.astro';
import ArrowChip from '~/components/ArrowChip.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { getCompany, getTaxonomy, termLabel } from '~/lib/runtime-config';
import { VALUATION_QUESTIONS, questionField } from '~/data/valuation-questions';
import { FEATURES } from '~/data/features';
import { valuationPackages, priceLabel } from '~/lib/valuation/packages';
import { isStripeEnabled } from '~/lib/stripe';
import { alternatesFor } from '~/lib/page';
import { serviceSchema } from '~/lib/seo';

interface Props { locale: Locale }
const { locale } = Astro.props;
const hu = locale === 'hu';
const company = await getCompany();
const ui = UI[locale];
const taxonomy = await getTaxonomy();
const categories = taxonomy.category.filter((term) => term.enabled).map((term) => ({ key: term.key, label: termLabel(term, locale) }));
const conditions = taxonomy.condition.filter((term) => term.enabled).map((term) => ({ key: term.key, label: termLabel(term, locale) }));
const heatings = taxonomy.heating.filter((term) => term.enabled).map((term) => ({ key: term.key, label: termLabel(term, locale) }));
const steps = hu ? ['Ingatlan','Épület és műszaki állapot','Környezet','Extrák és korlátok','Fotók és elérhetőség'] : ['Woning','Gebouw en technische staat','Omgeving','Extra’s en beperkingen','Foto’s en contact'];
const notice = company.services.valuationNotice?.[locale]?.trim() || (hu ? 'Tájékoztató, piaci alapú értékmeghatározás. Az eredmény nem hivatalos szakvélemény.' : 'Indicatieve, marktgebaseerde waardebepaling. Het resultaat is geen officieel taxatierapport.');
const featureKeys = ['garage','carport','storage-building','barn-hall','animal-housing','gazebo','outdoor-oven','cellar','outbuildings','stables','terrace','balcony','pool'];
const choice = (value: string, huLabel: string, nlLabel: string) => ({ value, label: hu ? huLabel : nlLabel });
const unknown = choice('nem-tudom','Nem tudom','Weet ik niet');
const packages = valuationPackages(company.services).filter((pkg) => pkg.enabled);
const visit = packages.find((pkg) => pkg.kind === 'expert_visit');
const visitPrice = visit?.priceEur ?? null;
const cardPayments = isStripeEnabled();
---
<Base locale={locale} title={hu ? 'Értékmeghatározás — FODEL' : 'Waardebepaling — FODEL'} description={hu ? 'Részletes, tájékoztató piaci értékmeghatározás.' : 'Uitgebreide, indicatieve marktwaardebepaling.'} alternates={alternatesFor('valuation')} schema={[serviceSchema(locale, hu ? 'Értékmeghatározás' : 'Waardebepaling', notice)]}>
  <PageHeader eyebrow={hu ? 'Értékmeghatározás' : 'Waardebepaling'} title={hu ? 'Mennyit ér' : 'Wat is uw woning'} titleEm={hu ? 'az ingatlana?' : 'waard?'} body={hu ? 'Adja meg az ismert adatokat. Munkatársunk ellenőrzi az eredményt, és e-mailben küldi.' : 'Vul in wat u weet. Onze medewerker controleert het resultaat en stuurt het per e-mail.'} compact />
  <section class="wizard-wrap">
    <div class="wizard" data-submit-url={path(locale, 'submitAd')} data-valuation-url={path(locale, 'valuation')} data-visit-price={visitPrice ?? ''} data-doc-url="/api/valuation/upload-url" data-next-label={hu ? 'Tovább' : 'Verder'} data-submit-label={hu ? 'Kérelem elküldése' : 'Aanvraag versturen'}>
      <nav class="progress" aria-label={hu ? 'Űrlap lépései' : 'Formulierstappen'}>
        {steps.map((label, index) => <span class="progress-item" data-progress={index + 1}><b>{index + 1}</b><span>{label}</span></span>)}
      </nav>
      <FormShell locale={locale} endpoint="/api/valuation" formId="valuation" submitLabel={hu ? 'Kérelem elküldése' : 'Aanvraag versturen'} successTitle={hu ? 'Köszönjük!' : 'Dank u wel!'} successBody={hu ? 'Munkatársunk ellenőrzi az adatokat, és e-mailben küldi a tájékoztató eredményt.' : 'Onze medewerker controleert de gegevens en stuurt de indicatieve uitkomst per e-mail.'} multipart>
        <section class="step" data-step="1" aria-label={steps[0]}>
          <h2 tabindex="-1">{steps[0]}</h2><p class="step-intro">{hu ? 'Csak az ingatlan típusa, települése és alapterülete kötelező.' : 'Alleen woningtype, plaats en woonoppervlak zijn verplicht.'}</p>
          <fieldset class="chips" data-required-group><legend>{hu ? 'Ingatlan típusa' : 'Type woning'} <span aria-hidden="true">*</span></legend>
            {categories.map((item) => <label><input type="radio" name="category" value={item.key} required /><span>{item.label}</span></label>)}
          </fieldset>
          <label class="control">{hu ? 'Település' : 'Plaats'} <span aria-hidden="true">*</span><input id="settlement" name="settlement" required autocomplete="address-level2" list="settlement-options" /><small>{hu ? 'Kezdjen gépelni. Ha nincs a listában, szabadon megadhatja.' : 'Begin te typen. Staat de plaats niet in de lijst, vul hem zelf in.'}</small></label>
          <datalist id="settlement-options"></datalist><input type="hidden" name="kshCode" id="ksh-code" /><input type="hidden" name="countyCode" id="county-code" /><input type="hidden" name="county" id="county-name" />
          <label class="control">{hu ? 'Pontos cím (csak munkatársunknak)' : 'Exact adres (alleen voor onze medewerker)'}<input name="addressPrivate" autocomplete="street-address" maxlength="300" /></label>
          <div class="two"><label class="control">{hu ? 'Hasznos alapterület' : 'Woonoppervlak'} <span aria-hidden="true">*</span><span class="unit"><input name="floorM2" type="number" min="1" max="100000" step="0.1" required /><span>m²</span></span></label><label class="control">{hu ? 'Telekterület' : 'Perceeloppervlak'}<span class="unit"><input name="plotM2" type="number" min="0" step="0.1" /><span>m²</span></span><small id="plot-ha" hidden></small></label></div>
          <div class="two">{[['bedrooms',hu ? 'Szobák' : 'Kamers'],['bathrooms',hu ? 'Fürdőszobák' : 'Badkamers'],['parcelCount',hu ? 'Helyrajzi számok' : 'Kadastrale percelen']].map(([name,label]) => <div class="control"><label for={`v-${name}`}>{label}</label><div class="stepper"><button type="button" data-stepper={name} data-delta="-1" aria-label={`${label}: −1`}>−</button><input id={`v-${name}`} name={name} type="number" min="0" max="100" step="1" inputmode="numeric" /><button type="button" data-stepper={name} data-delta="1" aria-label={`${label}: +1`}>+</button></div><label class="unknown"><input type="checkbox" name={`unknown_${name}`} value="yes" data-unknown-for={name} />{unknown.label}</label></div>)}</div>
        </section>
        <section class="step" data-step="2" aria-label={steps[1]}>
          <h2 tabindex="-1">{steps[1]}</h2><p class="step-intro">{hu ? 'Minden kérdés kihagyható. A „Nem tudom” külön válasz.' : 'Alle vragen zijn optioneel. “Weet ik niet” wordt apart opgeslagen.'}</p>
          <div class="two"><label class="control">{hu ? 'Építés éve' : 'Bouwjaar'}<input name="yearBuilt" type="number" min="1500" max="2100" /></label><label class="control">{hu ? 'Felújítás éve' : 'Renovatiejaar'}<input name="renovatedIn" type="number" min="1500" max="2100" /></label></div>
          <fieldset class="chips"><legend>{hu ? 'Felújítás mértéke' : 'Omvang renovatie'}</legend>{[choice('full','Teljes','Volledig'),choice('partial','Részleges','Gedeeltelijk'),choice('none','Nem volt','Geen'),choice('unknown','Nem tudom','Weet ik niet')].map((item) => <label><input type="radio" name="renovationExtent" value={item.value} /><span>{item.label}</span></label>)}</fieldset>
          <fieldset class="chips"><legend>{hu ? 'Állapot' : 'Staat'}</legend>{conditions.map((item) => <label><input type="radio" name="conditionKey" value={item.key} /><span>{item.label}</span></label>)}<label><input type="radio" name="conditionKey" value="nem-tudom" /><span>{unknown.label}</span></label></fieldset>
          <fieldset class="chips"><legend>{hu ? 'Fűtés' : 'Verwarming'}</legend>{heatings.map((item) => <label><input type="radio" name="heatingKey" value={item.key} /><span>{item.label}</span></label>)}<label><input type="radio" name="heatingKey" value="nem-tudom" /><span>{unknown.label}</span></label></fieldset>
          <fieldset class="chips"><legend>{hu ? 'Energetikai osztály' : 'Energielabel'}</legend>{['A+++','A++','A+','A','B','C','D','E','F','G','H','I','nem-tudom'].map((key) => <label><input type="radio" name="epcClass" value={key} /><span>{key === 'nem-tudom' ? unknown.label : key}</span></label>)}</fieldset>
          {VALUATION_QUESTIONS.filter((q) => q.step === 2).map((q) => <fieldset class="chips"><legend>{q.label[locale]}</legend>{q.multiple ? <><input type="hidden" name={questionField(q.id)} data-multi-value={q.id} />{q.options.map((o) => <label><input type="checkbox" data-multi={q.id} value={o.value} /><span>{o.label[locale]}</span></label>)}</> : q.options.map((o) => <label><input type="radio" name={questionField(q.id)} value={o.value} /><span>{o.label[locale]}</span></label>)}</fieldset>)}
        </section>
        <section class="step" data-step="3" aria-label={steps[2]}>
          <h2 tabindex="-1">{steps[2]}</h2><p class="step-intro">{hu ? 'A környezet területhasználatát és épületeit kérdezzük.' : 'Deze vragen gaan over grondgebruik en gebouwen in de omgeving.'}</p>
          {VALUATION_QUESTIONS.filter((q) => q.step === 3).map((q) => <fieldset class="chips"><legend>{q.label[locale]}</legend>{q.options.map((o) => <label><input type="radio" name={questionField(q.id)} value={o.value} /><span>{o.label[locale]}</span></label>)}</fieldset>)}
        </section>
        <section class="step" data-step="4" aria-label={steps[3]}>
          <h2 tabindex="-1">{steps[3]}</h2><p class="step-intro">{hu ? 'Az extrák és korlátozások tájékoztató adatok; ezekből nem számítunk automatikus értékmódosítást.' : 'Extra’s en beperkingen zijn ter informatie; ze leiden niet automatisch tot een prijsaanpassing.'}</p>
          <fieldset class="chips"><legend>{hu ? 'Melléképületek és extrák' : 'Bijgebouwen en extra’s'}</legend>{featureKeys.map((key) => <label><input type="checkbox" name="features" value={key} /><span>{FEATURES[key]?.[locale] ?? key}</span></label>)}<label><input type="checkbox" name="features" value="nem-tudom" /><span>{unknown.label}</span></label></fieldset>
          {VALUATION_QUESTIONS.filter((q) => q.step === 4).map((q) => <fieldset class="chips"><legend>{q.label[locale]}</legend>{q.id === 'korlatozasok' && <p class="question-hint">{hu ? 'Csak az Ön által ismert körülményeket jelölje. Ez nem jogi tanács.' : 'Vink alleen aan wat u weet. Dit is geen juridisch advies.'}</p>}{q.multiple ? <><input type="hidden" name={questionField(q.id)} data-multi-value={q.id} />{q.options.map((o) => <label title={o.hint?.[locale]}><input type="checkbox" data-multi={q.id} value={o.value} /><span>{o.label[locale]}</span></label>)}</> : q.options.map((o) => <label><input type="radio" name={questionField(q.id)} value={o.value} /><span>{o.label[locale]}</span></label>)}</fieldset>)}
          {VALUATION_QUESTIONS.filter((q) => q.step === 4 && q.options.some((o) => o.hint)).map((q) => <dl class="legal-hints">{q.options.filter((o) => o.hint).map((o) => <div><dt>{o.label[locale]}</dt><dd>{o.hint?.[locale]}</dd></div>)}</dl>)}
          <label class="control">{hu ? 'Egyéb korlátozás vagy megjegyzés' : 'Andere beperking of opmerking'}<textarea name="restrictionsNote" rows="3" maxlength="1000"></textarea></label>
          <fieldset class="factors"><legend>{hu ? 'Egyéb értéket befolyásoló szempontok' : 'Andere factoren die de waarde beïnvloeden'}</legend><p class="question-hint">{hu ? 'Adjon hozzá külön sorokat. A besorolás tájékoztató, nem számítás.' : 'Voeg aparte regels toe. De richting is informatief, geen berekening.'}</p><div id="factors-list"></div><button type="button" id="add-factor">{hu ? '+ Szempont hozzáadása' : '+ Factor toevoegen'}</button><input type="hidden" name="factors" id="factors-json" /></fieldset>
        </section>
        <section class="step" data-step="5" aria-label={steps[4]}>
          <h2 tabindex="-1">{steps[4]}</h2>
          <label class="control">{hu ? 'Fényképek (legfeljebb 6)' : 'Foto’s (maximaal 6)'}<input id="f-photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple /><small>{hu ? 'JPG, PNG vagy WebP. A képeket küldés előtt kicsinyítjük; csak munkatársunk látja.' : 'JPG, PNG of WebP. Foto’s worden vóór verzending verkleind en zijn alleen zichtbaar voor ons team.'}</small></label><p id="photo-status" role="status"></p>
          <div class="control docs" id="docs">
            <span>{hu ? 'Dokumentumok (alaprajz, építési engedély, tulajdoni lap, energetikai tanúsítvány…)' : 'Documenten (plattegrond, bouwvergunning, eigendomsbewijs, energielabel…)'}</span>
            <input type="hidden" name="docSession" id="doc-session" />
            <input id="f-docs" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,.tif,.tiff,.doc,.docx,.xls,.xlsx,.zip,.dwg,.dxf" />
            <small>{hu ? 'Legfeljebb 15 fájl, egyenként 50 MB-ig. Közvetlenül, tömörítés nélkül töltődnek fel; csak munkatársunk látja őket.' : 'Maximaal 15 bestanden van elk 50 MB. Ze worden rechtstreeks en ongecomprimeerd geüpload en zijn alleen zichtbaar voor ons team.'}</small>
            <ul class="doc-list" id="doc-list" aria-live="polite"></ul>
          </div>
          <div class="two"><label class="control">{ui.form.name} <span aria-hidden="true">*</span><input name="name" required autocomplete="name" maxlength="120" /></label><label class="control">{ui.form.email} <span aria-hidden="true">*</span><input name="email" type="email" required autocomplete="email" maxlength="160" /></label></div>
          <label class="control">{ui.form.phone}<input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
          <fieldset class="chips"><legend>{hu ? 'Milyen értékmeghatározást kér?' : 'Welke waardebepaling wenst u?'}</legend>
            {packages.map((pkg) => <label><input type="radio" name="requestKind" value={pkg.kind} checked={pkg.kind === 'indicative'} /><span>{pkg.names[locale]}{pkg.kind === 'indicative' ? (company.services.valuationFreeConfirmed ? ` — ${priceLabel(pkg, locale)}` : '') : ` — ${priceLabel(pkg, locale)}`}</span></label>)}
          </fieldset>
          <p class="question-hint">{hu ? 'Helyszíni kérésnél munkatársunk felveszi Önnel a kapcsolatot az időpont egyeztetéséhez.' : 'Bij een bezoek nemen wij contact op om een afspraak te maken.'}{cardPayments ? (hu ? ' Fix árú csomagnál a kérés elküldése után azonnal bankkártyával is fizethet.' : ' Bij een pakket met vaste prijs kunt u na het versturen meteen met kaart betalen.') : ''}{hu ? ' Hivatalos kérésnél árat és határidőt csak árajánlat után vállalunk.' : ' Voor een officiële taxatie geven wij vooraf geen prijs of termijn.'}</p>
          <p class="notice">{notice}</p>
        </section>
      </FormShell>
      <div class="wizard-actions"><button type="button" id="wizard-back" hidden>{hu ? 'Vissza' : 'Terug'}</button><button type="button" id="wizard-next"><span>{hu ? 'Tovább' : 'Verder'}</span><ArrowChip size={30} /></button></div>
    </div>
  </section>
</Base>

<script>
  import { shrinkImage } from '~/scripts/shrink-image';
  const form = document.querySelector<HTMLFormElement>('#valuation');
  const wizard = document.querySelector<HTMLElement>('.wizard');
  const steps = [...document.querySelectorAll<HTMLElement>('#valuation .step')];
  const back = document.querySelector<HTMLButtonElement>('#wizard-back');
  const next = document.querySelector<HTMLButtonElement>('#wizard-next');
  const nextText = next?.querySelector('span');
  const actions = document.querySelector<HTMLElement>('.wizard-actions');
  const consent = form?.querySelector<HTMLElement>('.consent');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let current = 0;
  const storageKey = 'fodel-valuation-v2';
  wizard?.classList.add('is-ready');
  const show = (step: number) => {
    current = Math.max(0, Math.min(4, step));
    steps.forEach((node, index) => { node.hidden = index !== current; });
    document.querySelectorAll<HTMLElement>('[data-progress]').forEach((node, index) => {
      node.toggleAttribute('aria-current', index === current); node.classList.toggle('done', index < current);
    });
    if (back) back.hidden = current === 0;
    if (next) next.hidden = false;
    if (nextText) nextText.textContent = current === 4 ? (wizard?.dataset.submitLabel ?? '') : (wizard?.dataset.nextLabel ?? '');
    if (consent) consent.hidden = current !== 4;
    if (submit) submit.hidden = true;
    if (current > 0) steps[current]?.querySelector<HTMLElement>('h2')?.focus?.();
  };
  const validateStep = () => {
    const category = form?.querySelector<HTMLInputElement>('input[name="category"]:checked');
    const settlement = form?.querySelector<HTMLInputElement>('#settlement');
    const floor = form?.querySelector<HTMLInputElement>('input[name="floorM2"]');
    if (current === 0 && !category) { form?.querySelector<HTMLElement>('input[name="category"]')?.focus(); return false; }
    if (current === 0 && settlement && !settlement.value.trim()) { settlement.focus(); return false; }
    if (current === 0 && floor && !(Number(floor.value) > 0)) { floor.focus(); return false; }
    return true;
  };
  const goNext = () => {
    if (current === 4) { form?.requestSubmit(); return; }
    if (validateStep()) { show(current + 1); steps[current]?.scrollIntoView({ block: 'start', behavior: 'smooth' }); }
  };
  next?.addEventListener('click', goNext);
  back?.addEventListener('click', () => show(current - 1));
  form?.addEventListener('submit', (event) => {
    if (current !== 4) {
      event.preventDefault();
      event.stopImmediatePropagation();
      goNext();
    }
  }, true);
  form?.addEventListener('input', () => {
    try {
      const values: Record<string, string | string[]> = {};
      new FormData(form).forEach((value, key) => {
        if (['photos','docSession','consent','renderedAt','name','email','phone','addressPrivate'].includes(key)) return;
        if (typeof value !== 'string') return;
        const prior = values[key]; values[key] = prior === undefined ? value : Array.isArray(prior) ? [...prior, value] : [prior, value];
      });
      localStorage.setItem(storageKey, JSON.stringify({ values, step: current }));
    } catch { /* storage may be disabled */ }
  });
  try {
    const saved = JSON.parse(localStorage.getItem(storageKey) ?? 'null');
    if (saved?.values && form) {
      for (const [key, value] of Object.entries(saved.values)) {
        const wanted = Array.isArray(value) ? value : [value];
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[name="${CSS.escape(key)}"]`).forEach((input) => {
          if (input.type === 'radio' || input.type === 'checkbox') (input as HTMLInputElement).checked = wanted.includes(input.value);
          else if (typeof wanted[0] === 'string') input.value = wanted[0];
        });
      }
      show(Number(saved.step) || 0);
    }
  } catch { /* private browsing */ }
  show(current);
  const requested = new URLSearchParams(location.search).get('service');
  if (requested === 'onsite-visit' || requested === 'judicial') {
    const radio = form?.querySelector<HTMLInputElement>(`input[name="requestKind"][value="${requested === 'onsite-visit' ? 'expert_visit' : 'judicial'}"]`);
    if (radio) radio.checked = true;
  }
  let places: [string,string,string,number][] = [];
  const settlement = form?.querySelector<HTMLInputElement>('#settlement');
  settlement?.addEventListener('focus', async () => {
    if (places.length) return;
    try {
      const response = await fetch('/data/telepulesek.json');
      if (!response.ok) return;
      places = await response.json();
      const list = form?.querySelector<HTMLDataListElement>('#settlement-options');
      if (list) list.innerHTML = places.filter((p) => p[3] !== 0).map((p) => `<option value="${p[1].replaceAll('&','&amp;').replaceAll('"','&quot;')}"></option>`).join('');
    } catch { /* free text remains available */ }
  });
  const matchSettlement = () => {
    const match = places.find((place) => place[1].localeCompare(settlement?.value ?? '', 'hu', { sensitivity: 'base' }) === 0);
    const counties = places.filter((place) => place[3] === 0);
    const set = (id: string, value: string) => { const input = form?.querySelector<HTMLInputElement>(id); if (input) input.value = value; };
    set('#ksh-code', match?.[0] ?? ''); set('#county-code', match?.[2] ?? '');
    set('#county-name', counties.find((c) => c[0] === match?.[2])?.[1].replace(' vármegye','') ?? 'Ismeretlen');
  };
  settlement?.addEventListener('change', matchSettlement);
  form?.addEventListener('submit', matchSettlement);
  const plotInput = form?.querySelector<HTMLInputElement>('input[name="plotM2"]');
  const plotHa = document.querySelector<HTMLElement>('#plot-ha');
  const updatePlotHa = () => {
    const m2 = Number(plotInput?.value);
    if (plotHa && Number.isFinite(m2) && m2 >= 10000) {
      plotHa.hidden = false;
      plotHa.textContent = `≈ ${(m2 / 10000).toLocaleString(form?.dataset.locale === 'nl' ? 'nl-NL' : 'hu-HU', { maximumFractionDigits: 2 })} ha`;
    } else if (plotHa) plotHa.hidden = true;
  };
  plotInput?.addEventListener('input', updatePlotHa);
  updatePlotHa();
  form?.querySelectorAll<HTMLInputElement>('[data-multi]').forEach((input) => input.addEventListener('change', () => {
    const group = input.dataset.multi;
    if ((input.value === 'nem-tudom' || input.value === 'nincs') && input.checked) form?.querySelectorAll<HTMLInputElement>(`[data-multi="${group}"]`).forEach((other) => { if (other !== input) other.checked = false; });
    if (input.value !== 'nem-tudom' && input.value !== 'nincs' && input.checked) {
      form?.querySelectorAll<HTMLInputElement>(`[data-multi="${group}"]`).forEach((other) => { if (other.value === 'nem-tudom' || other.value === 'nincs') other.checked = false; });
    }
    const target = form?.querySelector<HTMLInputElement>(`[data-multi-value="${group}"]`);
    if (target) { target.value = [...(form?.querySelectorAll<HTMLInputElement>(`[data-multi="${group}"]:checked`) ?? [])].map((item) => item.value).join(','); target.dispatchEvent(new Event('input', { bubbles: true })); }
  }));
  form?.querySelectorAll<HTMLInputElement>('[data-multi-value]').forEach((hidden) => {
    for (const value of hidden.value.split(',').filter(Boolean)) {
      const chip = form.querySelector<HTMLInputElement>(`[data-multi="${hidden.dataset.multiValue}"][value="${CSS.escape(value)}"]`);
      if (chip) chip.checked = true;
    }
  });
  form?.querySelectorAll<HTMLInputElement>('input[name="features"]').forEach((input) => input.addEventListener('change', () => {
    const all = [...(form?.querySelectorAll<HTMLInputElement>('input[name="features"]') ?? [])];
    if (input.value === 'nem-tudom' && input.checked) all.forEach((other) => { if (other !== input) other.checked = false; });
    if (input.value !== 'nem-tudom' && input.checked) { const unknown = all.find((other) => other.value === 'nem-tudom'); if (unknown) unknown.checked = false; }
    form?.dispatchEvent(new Event('input'));
  }));
  form?.querySelectorAll<HTMLButtonElement>('[data-stepper]').forEach((button) => button.addEventListener('click', () => {
    const input = form.querySelector<HTMLInputElement>(`[name="${button.dataset.stepper}"]`);
    if (!input) return;
    input.value = String(Math.max(0, Math.min(100, Number(input.value || 0) + Number(button.dataset.delta || 0))));
    const unknown = form.querySelector<HTMLInputElement>(`[data-unknown-for="${button.dataset.stepper}"]`);
    if (unknown) unknown.checked = false;
    input.dispatchEvent(new Event('input', { bubbles: true }));
  }));
  form?.querySelectorAll<HTMLInputElement>('[data-unknown-for]').forEach((unknown) => unknown.addEventListener('change', () => {
    const input = form.querySelector<HTMLInputElement>(`[name="${unknown.dataset.unknownFor}"]`);
    if (unknown.checked && input) input.value = '';
  }));
  const factorList = document.querySelector<HTMLElement>('#factors-list');
  const factorJson = document.querySelector<HTMLInputElement>('#factors-json');
  const syncFactors = () => { if (factorJson) { factorJson.value = JSON.stringify([...(factorList?.querySelectorAll<HTMLElement>('.factor-row') ?? [])].map((row) => ({ text: row.querySelector<HTMLInputElement>('input')?.value.trim() ?? '', direction: row.querySelector<HTMLSelectElement>('select')?.value ?? 'unsure' })).filter((item) => item.text)); factorJson.dispatchEvent(new Event('input', { bubbles: true })); } };
  const appendFactor = (text = '', direction = 'unsure') => {
    const row = document.createElement('div'); row.className = 'factor-row';
    row.innerHTML = `<input type="text" maxlength="300" aria-label="Szempont / Factor"><select aria-label="Irány / Richting"><option value="unsure">Nem tudom / Onzeker</option><option value="plus">Értéknövelő / Verhogend</option><option value="minus">Értékcsökkentő / Verlagend</option></select><button type="button" aria-label="Sor törlése / Rij verwijderen">×</button>`;
    row.addEventListener('input', syncFactors); row.querySelector('button')?.addEventListener('click', () => { row.remove(); syncFactors(); });
    const input = row.querySelector<HTMLInputElement>('input'); if (input) input.value = text;
    const select = row.querySelector<HTMLSelectElement>('select'); if (select) select.value = direction;
    factorList?.append(row); return input;
  };
  document.querySelector('#add-factor')?.addEventListener('click', () => { appendFactor()?.focus(); syncFactors(); });
  try {
    const raw = JSON.parse(localStorage.getItem(storageKey) ?? 'null')?.values?.factors;
    const saved = JSON.parse(typeof raw === 'string' ? raw : '[]');
    if (Array.isArray(saved)) saved.forEach((item) => { if (item && typeof item.text === 'string') appendFactor(item.text, item.direction); });
  } catch { /* no saved factors */ }
  const photoInput = document.querySelector<HTMLInputElement>('#f-photos');
  photoInput?.addEventListener('change', async () => {
    const status = document.querySelector<HTMLElement>('#photo-status'); if (!photoInput.files) return;
    const files = [...photoInput.files].slice(0, 6); let prepared: File[] = [];
    for (const [edge, quality] of [[1600,.82],[1280,.75],[1024,.7]]) {
      prepared = await Promise.all(files.map((file) => shrinkImage(file, edge, quality)));
      if (prepared.reduce((sum, file) => sum + file.size, 0) <= 4 * 1024 * 1024) break;
    }
    const transfer = new DataTransfer(); let total = 0;
    for (const file of prepared) { if (total + file.size <= 4 * 1024 * 1024) { transfer.items.add(file); total += file.size; } }
    photoInput.files = transfer.files;
    if (status) status.textContent = `${transfer.files.length} / 6`;
  });

  // Large documents skip the form post: each file goes straight to private storage
  // through a one-off signed URL, and the form only carries the session id.
  const docInput = document.querySelector<HTMLInputElement>('#f-docs');
  const docList = document.querySelector<HTMLElement>('#doc-list');
  const docSession = form?.querySelector<HTMLInputElement>('#doc-session');
  const docText = (hu: string, nl: string) => (form?.dataset.locale === 'nl' ? nl : hu);
  const DOC_MAX = 15, DOC_BYTES = 50 * 1024 * 1024;
  let docCount = 0, docPending = 0;
  if (docSession) docSession.value = crypto.randomUUID();
  const docRow = (file: File) => {
    const row = document.createElement('li');
    const name = document.createElement('span'); name.textContent = file.name; name.className = 'doc-name';
    const state = document.createElement('span'); state.className = 'doc-state';
    row.append(name, state); docList?.append(row);
    return (message: string, failed = false) => { state.textContent = message; row.classList.toggle('failed', failed); };
  };
  const uploadDoc = async (file: File) => {
    const report = docRow(file);
    if (docCount >= DOC_MAX) return report(docText('Legfeljebb 15 fájl tölthető fel.', 'Maximaal 15 bestanden.'), true);
    if (file.size > DOC_BYTES) return report(docText('Túl nagy (legfeljebb 50 MB).', 'Te groot (maximaal 50 MB).'), true);
    docCount += 1; docPending += 1; report('0%');
    try {
      const response = await fetch(wizard?.dataset.docUrl ?? '/api/valuation/upload-url', { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ session: docSession?.value, name: file.name, size: file.size }) });
      const target = await response.json().catch(() => null);
      if (!response.ok || !target?.url) throw new Error('rejected');
      await new Promise<void>((resolve, reject) => {
        const body = new FormData(); body.append('cacheControl', '3600'); body.append('', file);
        const request = new XMLHttpRequest();
        request.open('PUT', target.url);
        request.setRequestHeader('x-upsert', 'false');
        request.upload.onprogress = (event) => { if (event.lengthComputable) report(`${Math.round((event.loaded / event.total) * 100)}%`); };
        request.onload = () => (request.status >= 200 && request.status < 300 ? resolve() : reject(new Error('upload-failed')));
        request.onerror = () => reject(new Error('upload-failed'));
        request.send(body);
      });
      report(docText('Feltöltve', 'Geüpload'));
    } catch {
      docCount -= 1;
      report(docText('Nem sikerült — ellenőrizze a fájltípust, vagy próbálja újra.', 'Mislukt — controleer het bestandstype of probeer opnieuw.'), true);
    } finally { docPending -= 1; }
  };
  docInput?.addEventListener('change', () => {
    const files = [...(docInput.files ?? [])];
    docInput.value = '';
    files.forEach((file) => void uploadDoc(file));
  });
  form?.addEventListener('submit', (event) => {
    if (docPending > 0) {
      event.preventDefault();
      event.stopImmediatePropagation();
      const status = document.querySelector<HTMLElement>('#photo-status');
      if (status) status.textContent = docText('A dokumentumok még töltődnek fel — kérjük, várjon.', 'De documenten worden nog geüpload — even geduld.');
    }
  }, true);

  // Pay-now: the server prices the package; the browser only names the request it just made.
  const payButton = (container: HTMLElement, id: string, token: string, label: string) => {
    const button = document.createElement('button'); button.type = 'button'; button.className = 'result-link'; button.textContent = label;
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const response = await fetch('/api/stripe/valuation-checkout', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id, token }) });
        const reply = await response.json().catch(() => null);
        if (!response.ok || !reply?.url) throw new Error('checkout-failed');
        location.href = reply.url;
      } catch { button.disabled = false; button.textContent = docText('Nem sikerült, próbálja újra', 'Mislukt, probeer opnieuw'); }
    });
    container.append(button);
  };
  if (new URLSearchParams(location.search).get('paid') === '1') {
    const banner = document.createElement('p'); banner.className = 'notice paid-banner'; banner.setAttribute('role', 'status');
    banner.textContent = docText('Köszönjük, a fizetés megérkezett. Visszaigazolást e-mailben küldünk.', 'Dank u, uw betaling is ontvangen. U ontvangt een bevestiging per e-mail.');
    wizard?.prepend(banner);
  }
  form?.addEventListener('fodel:success', (event) => {
    try { localStorage.removeItem(storageKey); } catch {}
    if (actions) actions.hidden = true;
    const data = (event as CustomEvent).detail;
    const successPanel = document.querySelector<HTMLElement>('#valuation-success');
    if (data?.pay && data.valuationId && data.actionToken && successPanel) {
      const wrap = document.createElement('div'); wrap.className = 'result-actions';
      payButton(wrap, data.valuationId, data.actionToken, data.pay.label); successPanel.append(wrap);
    }
    if (!data?.instant || !data.result?.baseline) return;
    const success = document.querySelector<HTMLElement>('#valuation-success');
    if (!success) return;
    const existing = success.querySelector('p'); if (existing) existing.hidden = true;
    const heading = success.querySelector('h3');
    const locale = form?.dataset.locale === 'nl' ? 'nl' : 'hu';
    if (heading) heading.textContent = locale === 'hu' ? 'Tájékoztató értékmeghatározás' : 'Indicatieve waardebepaling';
    const rate = Number(data.rate);
    const currency = locale === 'nl' && rate > 0 ? 'EUR' : 'HUF';
    const format = (value: number) => new Intl.NumberFormat(locale === 'nl' ? 'nl-NL' : 'hu-HU', { style: 'currency', currency, maximumFractionDigits: 0 }).format(currency === 'EUR' ? value / rate : value);
    const result = data.result;
    const add = (tag: string, message: string, className?: string) => { const node = document.createElement(tag); node.textContent = message; if (className) node.className = className; success.append(node); return node; };
    add('p', `${format(result.lowHuf)} – ${format(result.highHuf)}`, 'result-range');
    add('p', `${locale === 'hu' ? 'Középérték' : 'Middenwaarde'}: ${format(result.midHuf)}`, 'result-mid');
    const basis = result.baseline.kind === 'ksh'
      ? `KSH Ingatlanadattár, ${result.baseline.year} · ${result.baseline.level === 'county' ? (locale === 'hu' ? 'vármegyei adat' : 'provinciegegevens') : (locale === 'hu' ? 'települési adat' : 'plaatsgegevens')} · ${result.baseline.count}`
      : `${result.baseline.count} ${locale === 'hu' ? 'hasonló FODEL-hirdetés' : 'vergelijkbare FODEL-advertenties'}`;
    add('p', basis, 'result-basis');
    if (result.baseline.kind === 'ksh' && result.baseline.url) { const link = document.createElement('a'); link.href = result.baseline.url; link.textContent = `Forrás: KSH Ingatlanadattár, ${result.baseline.year}${result.baseline.retrievedAt ? ` · ${result.baseline.retrievedAt}` : ''} · CC BY 4.0`; link.target = '_blank'; link.rel = 'noopener'; link.className = 'result-source'; success.append(link); }
    if (currency === 'EUR' && data.rateDate) add('p', `${locale === 'hu' ? 'Árfolyam dátuma' : 'Wisselkoersdatum'}: ${data.rateDate}`);
    if (currency === 'HUF' && locale === 'nl') add('p', 'Geen actuele EUR/HUF koers ingesteld; bedragen worden in HUF getoond.');
    if (Array.isArray(data.factors) && data.factors.length) {
      add('h4', locale === 'hu' ? 'Értéket befolyásoló szempontok' : 'Factoren');
      for (const factor of data.factors) add('p', `${factor.direction === 'plus' ? (locale === 'hu' ? 'Értéknövelő' : 'Waardeverhogend') : factor.direction === 'minus' ? (locale === 'hu' ? 'Értékcsökkentő' : 'Waardeverlagend') : (locale === 'hu' ? 'Bizonytalan' : 'Onzeker')}: ${factor.text}`);
    }
    if (data.notice) add('p', data.notice, 'notice');
    const actionsWrap = document.createElement('div'); actionsWrap.className = 'result-actions';
    if (wizard?.dataset.submitUrl) { const link = document.createElement('a'); link.href = wizard.dataset.submitUrl; link.textContent = locale === 'hu' ? 'Hirdetés feladása' : 'Advertentie plaatsen'; link.className = 'result-link'; actionsWrap.append(link); }
    for (const [kind, label] of [
      ['expert_visit', locale === 'hu' ? `Gábor helyszíni látogatása (€ ${wizard?.dataset.visitPrice})` : `Bezoek van Gábor (€ ${wizard?.dataset.visitPrice})`],
      ['judicial', locale === 'hu' ? 'Igazságügyi értékbecslés kérése' : 'Officiële taxatie aanvragen'],
    ]) {
      const button = document.createElement('button'); button.type = 'button'; button.textContent = label; button.className = 'result-link';
      button.addEventListener('click', async () => {
        button.disabled = true;
        try {
          const response = await fetch('/api/valuation/next-step', { method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ id: data.valuationId, token: data.actionToken, kind }) });
          if (!response.ok) throw new Error('request-failed');
          button.textContent = locale === 'hu' ? 'Igényét rögzítettük' : 'Aanvraag ontvangen';
          const reply = await response.json().catch(() => null);
          if (reply?.pay) payButton(actionsWrap, data.valuationId, data.actionToken, reply.pay.label);
        } catch { button.disabled = false; button.textContent = locale === 'hu' ? 'Nem sikerült, próbálja újra' : 'Mislukt, probeer opnieuw'; }
      });
      actionsWrap.append(button);
    }
    success.append(actionsWrap);
  });
</script>
<style>
  .wizard-wrap { padding: 56px var(--pad-x) var(--section-y); }
  .wizard { max-width: 980px; margin: auto; background: var(--white); border-radius: var(--r-2xl); padding: clamp(20px,4vw,52px); box-shadow: var(--shadow-float); }
  .progress { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 8px; margin-bottom: 38px; }
  .progress-item { display: grid; gap: 7px; color: var(--taupe); font-size: 12px; }
  .progress-item b { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border); }
  .progress-item[aria-current], .progress-item.done { color: var(--ink); }
  .progress-item[aria-current] b, .progress-item.done b { background: var(--ink); color: white; }
  .step { grid-column: 1 / -1; display: grid; gap: 20px; }
  .step[hidden], [hidden] { display: none !important; }
  :global(#valuation .consent[hidden]), :global(#valuation button[type="submit"][hidden]) { display: none !important; }
  .wizard.is-ready :global(#valuation button[type="submit"]) { display: none !important; }
  .wizard-actions { display: none; }
  .wizard.is-ready .wizard-actions { display: flex; }
  h2 { font-family: var(--serif); font-size: clamp(26px,3vw,38px); font-weight: var(--fw-medium); scroll-margin-top: calc(var(--nav-h, 72px) + 12px); }
  .step-intro, .question-hint, .control small { font-size: var(--fs-small); color: var(--taupe); line-height: 1.6; }
  .two { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; }
  .control { display: grid; gap: 7px; font-size: var(--fs-small); color: var(--ink); }
  .control input, .control textarea, .factor-row input, .factor-row select { width: 100%; min-width: 0; border: 1px solid var(--border); border-radius: var(--r-sm); padding: 12px 14px; color: var(--ink); background: white; font: inherit; }
  .stepper { display: flex; border: 1px solid var(--border); border-radius: var(--r-sm); overflow: hidden; }
  .stepper input { text-align: center; border: 0; border-radius: 0; appearance: textfield; }
  .stepper input::-webkit-inner-spin-button { appearance: none; }
  .stepper button { width: 46px; flex: none; background: rgba(16,42,67,.05); color: var(--ink); font-size: 22px; cursor: pointer; }
  .unknown { display: inline-flex; align-items: center; gap: 8px; color: var(--taupe); }
  .unknown input { width: auto; }
  .unit { display: flex; align-items: center; border: 1px solid var(--border); border-radius: var(--r-sm); padding-right: 14px; }
  .unit input { border: 0; }
  fieldset { border: 0; min-width: 0; }
  legend { font-size: var(--fs-small); font-weight: 600; margin-bottom: 12px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chips legend { width: 100%; }
  .chips label { position: relative; cursor: pointer; }
  .chips input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .chips label span { display: block; border: 1px solid var(--border); border-radius: 999px; padding: 9px 15px; font-size: var(--fs-small); }
  .chips input:checked + span { background: var(--ink); border-color: var(--ink); color: white; }
  .chips input:focus-visible + span { outline: var(--focus-ring); outline-offset: 2px; }
  .factors { display: grid; gap: 12px; }
  .factor-row { display: grid; grid-template-columns: minmax(0,2fr) minmax(0,1fr) auto; gap: 8px; margin-bottom: 8px; }
  .factors button, .wizard-actions button { border-radius: 999px; border: 1px solid var(--ink); background: white; padding: 12px 20px; color: var(--ink); cursor: pointer; }
  .wizard.is-ready .wizard-actions { justify-content: space-between; margin-top: 24px; }
  #wizard-next { display: inline-flex; align-items: center; justify-content: space-between; gap: 10px; margin-left: auto; padding: 6px 6px 6px 20px; background: var(--ink); color: white; min-width: 150px; --chip-bg: var(--cream); --chip-fg: var(--ink); }
  .notice { padding: 14px 18px; border-radius: var(--r-md); background: rgba(16,42,67,.05); line-height: 1.6; }
  .legal-hints { display: grid; gap: 8px; margin: 0; padding: 12px 16px; border-radius: var(--r-md); background: rgba(16,42,67,.04); }
  .legal-hints div { display: grid; gap: 2px; }
  .legal-hints dt { font-size: var(--fs-small); font-weight: 600; color: var(--ink); }
  .legal-hints dd { font-size: var(--fs-small); color: var(--taupe); line-height: 1.5; }
  .result-range { font-family: var(--serif); font-size: clamp(28px, 4vw, 40px); color: var(--ink); max-width: none !important; }
  .result-mid, .result-basis { color: var(--ink); }
  .docs { display: grid; gap: 8px; }
  .doc-list { list-style: none; padding: 0; margin: 4px 0 0; display: grid; gap: 6px; }
  .doc-list :global(li) { display: flex; justify-content: space-between; gap: 12px; font-size: var(--fs-small); padding: 8px 14px; border-radius: var(--r-md); background: var(--cream); color: var(--ink); }
  .doc-list :global(li.failed) { color: #b3261e; background: rgba(179, 38, 30, 0.07); }
  .doc-list :global(.doc-name) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .doc-list :global(.doc-state) { flex: none; color: var(--taupe); }
  .doc-list :global(li.failed .doc-state) { color: inherit; }
  :global(.paid-banner) { margin-bottom: 24px; }
  .result-source { display: inline-block; margin: 8px 0 16px; text-decoration: underline; text-underline-offset: 3px; }
  .result-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 22px; }
  .result-link { display: inline-flex; align-items: center; border-radius: 999px; border: 1px solid var(--ink); background: var(--ink); color: white; padding: 12px 20px; font: inherit; font-size: var(--fs-small); cursor: pointer; text-decoration: none; }
  .result-actions a.result-link { background: white; color: var(--ink); }
  @media (max-width: 640px) { .progress-item span { display: none; } .two { grid-template-columns: 1fr; } .wizard.is-ready .wizard-actions { position: sticky; bottom: 0; background: var(--white); padding: 12px 0; z-index: 3; } .wizard.is-ready :global(#valuation .consent:not([hidden])) { margin-bottom: 88px; } .factor-row { grid-template-columns: 1fr auto; } .factor-row select { grid-column: 1; } }
</style>
