---
/**
 * Long-form content page — services, agricultural, guides and the legal pages.
 *
 * Sections are structured data rather than raw HTML so both locales share one
 * template and every heading level stays correct for screen readers.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import { path as routePath, type Locale, type RouteKey } from '~/i18n/ui';
import type { ContentPageData } from '~/lib/content-sections';
import { alternatesFor } from '~/lib/page';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  data: ContentPageData;
  noindex?: boolean;
}

const { locale, routeKey, data, noindex = false } = Astro.props;
const path = (key: RouteKey) => routePath(locale, key);

/** Stable anchors for every titled section, and the index built from them —
 *  shown beside the text on wide screens once a page has enough sections to
 *  need one. */
const slug = (value: string, i: number) =>
  `s${i + 1}-${value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
    .slice(0, 48)}`;
const anchors = data.sections.map((section, i) =>
  'title' in section && section.title && section.type !== 'callout' && section.type !== 'cta' ? slug(section.title, i) : null
);
const index = data.sections
  .map((section, i) => (anchors[i] && 'title' in section ? { id: anchors[i]!, title: section.title as string } : null))
  .filter(Boolean) as { id: string; title: string }[];
const showIndex = index.length >= 3;
---

<Base
  locale={locale}
  title={data.metaTitle}
  description={data.metaDescription}
  alternates={alternatesFor(routeKey)}
  noindex={noindex}
>
  <PageHeader
    eyebrow={data.eyebrow}
    title={data.title}
    titleEm={data.titleEm}
    body={data.intro}
    compact
  />

  <div class:list={['content-layout', { 'with-index': showIndex }]}>
  <div class="content">
    {
      data.updated && (
        <p class="updated">
          {locale === 'hu' ? 'Utolsó frissítés' : 'Laatst bijgewerkt'}: {data.updated}
        </p>
      )
    }

    {
      data.sections.map((section, i) => {
        switch (section.type) {
          case 'prose':
            return (
              <section class="sec" id={anchors[i] ?? undefined}>
                {section.title && <h2>{section.title}</h2>}
                {section.paragraphs.map((p) => <p>{p}</p>)}
              </section>
            );

          case 'list':
            return (
              <section class="sec" id={anchors[i] ?? undefined}>
                {section.title && <h2>{section.title}</h2>}
                {section.intro && <p>{section.intro}</p>}
                {section.ordered ? (
                  <ol class="bullets">{section.items.map((i) => <li>{i}</li>)}</ol>
                ) : (
                  <ul class="bullets">{section.items.map((i) => <li>{i}</li>)}</ul>
                )}
              </section>
            );

          case 'steps':
            return (
              <section class="sec" id={anchors[i] ?? undefined}>
                {section.title && <h2>{section.title}</h2>}
                <ol class="steps">
                  {section.items.map((s) => (
                    <li>
                      <span class="n">{s.n}</span>
                      <h3>{s.t}</h3>
                      <p>{s.b}</p>
                    </li>
                  ))}
                </ol>
              </section>
            );

          case 'table':
            return (
              <section class="sec" id={anchors[i] ?? undefined}>
                {section.title && <h2>{section.title}</h2>}
                {section.intro && <p>{section.intro}</p>}
                <div class="table-wrap">
                  <table>
                    <tbody>
                      {section.rows.map(([label, value]) => (
                        <tr>
                          <th scope="row">{label}</th>
                          <td>{value}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            );

          case 'callout':
            return (
              <aside class="callout">
                <span class="callout-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5" />
                    <path d="M10 9v5M10 6.2v.1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </span>
                <div>
                  <Eyebrow space="8px">{section.title}</Eyebrow>
                  <p>{section.body}</p>
                </div>
              </aside>
            );

          case 'cta':
            return (
              <section class="cta" data-bg="dark">
                <h2>{section.title}</h2>
                {section.body && <p>{section.body}</p>}
                <div class="cta-actions">
                  <Button variant="dark" light href={path(section.primary.to)}>{section.primary.label}</Button>
                  {section.secondary && (
                    <Button variant="outline" light href={path(section.secondary.to)}>
                      {section.secondary.label}
                    </Button>
                  )}
                </div>
              </section>
            );
        }
      })
    }
  </div>

  {
    showIndex && (
      <nav class="index no-print" aria-label={locale === 'hu' ? 'Ezen az oldalon' : 'Op deze pagina'}>
        <p class="index-label">{locale === 'hu' ? 'Ezen az oldalon' : 'Op deze pagina'}</p>
        <ol>
          {index.map((item) => (
            <li>
              <a href={`#${item.id}`} data-index={item.id}>{item.title}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  </div>
</Base>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-index]'));
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [a.dataset.index!, a]));
    let current: HTMLAnchorElement | null = null;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const link = byId.get(entry.target.id);
          if (!link || link === current) continue;
          current?.removeAttribute('aria-current');
          link.setAttribute('aria-current', 'true');
          current = link;
        }
      },
      { rootMargin: '-25% 0px -65% 0px' }
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  .content-layout {
    padding: 48px var(--pad-x) var(--section-y);
  }
  .content-layout.with-index {
    display: grid;
    grid-template-columns: minmax(0, 76ch) minmax(220px, 300px);
    justify-content: space-between;
    gap: 64px;
    align-items: start;
  }
  .content {
    max-width: 76ch;
  }

  .index {
    position: sticky;
    top: calc(var(--nav-h) + 16px);
    max-height: calc(100vh - var(--nav-h) - 40px);
    overflow-y: auto;
    padding: 20px 12px 20px 14px;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    scrollbar-width: thin;
  }
  .index-label {
    padding: 0 10px 10px;
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe);
  }
  .index ol {
    list-style: none;
  }
  .index a {
    display: block;
    padding: 8px 10px;
    border-radius: var(--r-sm);
    font-size: 14.5px;
    line-height: 1.4;
    color: var(--taupe);
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .index a:hover {
    background: rgba(16, 42, 67, 0.05);
    color: var(--ink);
  }
  .index a[aria-current] {
    background: var(--ink);
    color: var(--cream);
  }

  .updated {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.06);
    font-size: 13.5px;
    color: var(--taupe);
    margin-bottom: 40px;
  }

  .sec {
    margin-bottom: 56px;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  h2 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(24px, 2.4vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 18px;
  }
  h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: var(--fs-lead);
    color: var(--ink);
    margin-bottom: 8px;
  }
  p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 16px;
  }

  .bullets {
    list-style: none;
    margin: 4px 0 16px;
  }
  .bullets li {
    position: relative;
    padding-left: 26px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 10px;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.72em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }
  ol.bullets {
    counter-reset: item;
  }
  ol.bullets li {
    padding-left: 40px;
  }
  ol.bullets li::before {
    counter-increment: item;
    content: counter(item);
    left: 0;
    top: 0.1em;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.08);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 13px;
    font-weight: var(--fw-medium);
    line-height: 1;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    column-gap: 16px;
    padding: 22px 24px;
    border-radius: var(--r-lg);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
  }
  .n {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: var(--fw-medium);
    line-height: 1;
  }
  .steps h3 {
    margin-top: 2px;
  }
  .steps p {
    margin-bottom: 0;
    font-size: var(--fs-small);
  }

  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
  }
  th,
  td {
    text-align: left;
    padding: 15px 18px;
    background: var(--white);
    font-size: var(--fs-body);
    line-height: 1.6;
    font-weight: var(--fw-body);
    vertical-align: baseline;
  }
  th {
    color: var(--ink);
    width: 40%;
    border-radius: var(--r-md) 0 0 var(--r-md);
  }
  td {
    color: var(--taupe);
    border-radius: 0 var(--r-md) var(--r-md) 0;
  }

  .callout {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 28px;
    margin-bottom: 48px;
    border-radius: var(--r-xl);
    background: var(--linen);
  }
  .callout-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--white);
    color: var(--ink);
  }
  .callout p {
    margin-bottom: 0;
    font-size: var(--fs-small);
    line-height: var(--lh-body);
  }

  .cta {
    margin-top: 16px;
    padding: clamp(32px, 4vw, 52px);
    border-radius: var(--r-2xl);
    background:
      radial-gradient(110% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
  }
  .cta h2 {
    color: var(--cream);
  }
  .cta p {
    color: var(--on-dark-body);
  }
  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  @media (max-width: 1100px) {
    .content-layout.with-index {
      display: block;
    }
    .index {
      display: none;
    }
  }
  @media (max-width: 768px) {
    .content-layout {
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
    /* Legal and guide headings carry long Dutch and Hungarian compounds;
       on a phone they hyphenate (html lang drives the dictionary). */
    h2,
    h3 {
      hyphens: auto;
    }
    th {
      width: 45%;
    }
    th,
    td {
      padding: 14px 14px;
    }
    .steps li {
      padding: 20px 18px;
      grid-template-columns: 40px minmax(0, 1fr);
      column-gap: 14px;
    }
    .n {
      width: 40px;
      height: 40px;
    }
    .cta {
      border-radius: var(--r-xl);
    }
    .cta-actions {
      flex-direction: column;
    }
  }
</style>
