      ],
      packagesHead: 'Kies een pakket',
      recommended: 'Aanbevolen',
      packages: [
        {
          name: 'Voordelige advertentie',
          price: '€ 69',
          duration: '6 maanden',
          features: [
            'Maximaal 20 foto’s',
