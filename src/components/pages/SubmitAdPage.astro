            'Tekst wordt geplaatst zoals aangeleverd',
          ],
        },
        {
          name: 'Normale advertentie',
          price: '€ 129',
          priceAlt: '€ 179',
          priceAltNote: 'bij een vraagprijs boven 150 miljoen HUF',
          duration: '12 maanden',
          featured: true,
          features: [
            'Onbeperkt aantal foto’s',
            'Foto’s worden professioneel bewerkt',
            'Tekst wordt professioneel geredigeerd',
          ],
        },
      ],
      extrasHead: 'Aanvullende opties',
      extraCategoryHighlight: 'Uitlichten in de categorie',
      extraHomepageHighlight: 'Uitlichten op de homepage',
      extraVideo: 'Video plaatsen',
      perMonth: '/ mnd',
      minMonths: (n: number) => `min. ${n} mnd`,
      once: 'eenmalig',
      totalLabel: 'Geschat bedrag',
      totalNote: 'indicatief — het definitieve bedrag bevestigen wij bij goedkeuring',
      formHead: 'Aanmeldformulier',
      formNote:
        'Velden met een sterretje zijn verplicht. Loopt u ergens op vast? Bel ons gerust — wij vullen het formulier desgewenst samen met u in.',
      ownerVisible: 'Mogen wij uw contactgegevens bij de advertentie tonen?',
      ownerVisibleHint:
        'Zo ja, dan kan een buitenlandse geïnteresseerde u rechtstreeks benaderen. Regelt u de koop dan zelf, dan brengen wij geen courtage in rekening.',
      yes: 'Ja, toon mijn naam en telefoonnummer',
      no: 'Nee, toon alleen de gegevens van FODEL',
      bankHead: 'Onze bankrekeningen',
      bankNote: 'Na goedkeuring van uw advertentie kunt u naar deze rekeningen overmaken — of in uw eigen omgeving met creditcard betalen.',
      submit: 'Advertentie aanmelden',
      successTitle: 'Dank u wel!',
      successBody:
        'Wij hebben uw aanmelding ontvangen. Binnen enkele minuten ontvangt u een e-mail met een link om een wachtwoord in te stellen — daarna gaat u direct verder met uw advertentie en de foto’s. Kijk ook even in uw spammap.',
    };

const categoryOptions = (Object.keys(CATEGORIES) as CategoryKey[]).map((key) => ({
  value: key,
  label: CATEGORIES[key][locale].label,
}));

/**
 * Package cards, ids straight off the catalogue — this zip is what makes the
 * old id bug impossible: the value posted by the radio input can only ever
 * be a real LISTING_PACKAGES id, never a hand-typed string.
 */
const packageCards = LISTING_PACKAGES.map((cfg, i) => ({
  id: cfg.id,
  priceCents: cfg.priceEur * 100,
  ...t.packages[i],
}));

const categoryHighlight = LISTING_EXTRAS.find((e) => e.id === 'category-highlight')!;
const homepageHighlight = LISTING_EXTRAS.find((e) => e.id === 'homepage-highlight')!;
const videoExtra = LISTING_EXTRAS.find((e) => e.id === 'video')!;
const translationExtra = LISTING_EXTRAS.find((e) => e.id === 'translation')!;

const defaultPackage = packageCards.find((p) => p.featured) ?? packageCards[0];

const packageSchema = listingServiceSchema(locale, {
  name: t.packagesHead,
  description: t.metaDescription,
  url: path(locale, 'submitAd'),
  packages: packageCards.map((p) => ({ name: p.name, priceEur: p.priceCents / 100 })),
});
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('submitAd')}
  schema={[packageSchema]}
>
  <PageHeader
    eyebrow={t.eyebrow}
    title={t.title}
    titleEm={t.titleEm}
    body={t.body}
    compact
    secondary={{ label: ui.cta.priceList, href: path(locale, 'priceList') }}
  />

  <div class="stats">
    <div class="stat"><strong>{COMPANY.reach.countries}</strong><span>{t.statCountries}</span></div>
    <div class="stat"><strong>{COMPANY.reach.languages}</strong><span>{t.statLanguages}</span></div>
    <div class="stat"><strong>{COMPANY.founded}</strong><span>{t.statSince}</span></div>
  </div>

  <div class="layout">
    <div class="marketing">
      {/* ── Process ── */}
      <section class="process">
        <Eyebrow space="20px">{t.processHead}</Eyebrow>
        <ol>
          {
            t.steps.map((s) => (
              <li>
                <span class="n">{s.n}</span>
                <h2>{s.t}</h2>
                <p>{s.b}</p>
              </li>
            ))
          }
        </ol>
      </section>

      {/* ── Packages ── */}
      <section class="packages">
        <Eyebrow space="20px">{t.packagesHead}</Eyebrow>
        <div class="package-grid">
          {
            packageCards.map((card) => (
              <PackageCard
                pkg={card}
                mode="select"
                radioName="package"
                formId="listing-order"
                checked={card.id === defaultPackage.id}
                priceCents={card.priceCents}
                recommendedLabel={t.recommended}
              />
            ))
          }
        </div>
      </section>

      {/* ── Extras ── */}
      <section class="extras">
        <Eyebrow space="20px">{t.extrasHead}</Eyebrow>
        <div class="chips">
          {
            TRANSLATION_LANGUAGES.map((lang) => (
              <label class="chip">
                <input
                  type="checkbox"
                  data-extra="translation"
                  data-price-cents={translationExtra.priceEur * 100}
                  data-months="1"
                  data-label={LOCALE_META[lang].label}
                />
                <span class="chip-name">{LOCALE_META[lang].label}</span>
                <span class="chip-price">{formatCents(translationExtra.priceEur * 100)}</span>
              </label>
            ))
          }
          <label class="chip">
            <input
              type="checkbox"
              data-extra="category-highlight"
              data-price-cents={categoryHighlight.priceEur * 100}
              data-months={categoryHighlight.minMonths}
            />
            <span class="chip-name">{t.extraCategoryHighlight}</span>
            <span class="chip-price">
              {formatCents(categoryHighlight.priceEur * 100)} {t.perMonth} · {t.minMonths(categoryHighlight.minMonths!)}
            </span>
          </label>
          <label class="chip">
            <input
              type="checkbox"
              data-extra="homepage-highlight"
              data-price-cents={homepageHighlight.priceEur * 100}
              data-months={homepageHighlight.minMonths}
            />
            <span class="chip-name">{t.extraHomepageHighlight}</span>
            <span class="chip-price">
              {formatCents(homepageHighlight.priceEur * 100)} {t.perMonth} · {t.minMonths(homepageHighlight.minMonths!)}
            </span>
          </label>
          <label class="chip">
            <input type="checkbox" data-extra="video" data-price-cents={videoExtra.priceEur * 100} data-months="1" />
            <span class="chip-name">{t.extraVideo}</span>
            <span class="chip-price">{formatCents(videoExtra.priceEur * 100)} {t.once}</span>
          </label>
        </div>
        <p class="total">
          {t.totalLabel}: <strong id="order-total-amount">{formatCents(defaultPackage.priceCents)}</strong>
          <span class="total-note">({t.totalNote})</span>
        </p>
      </section>
    </div>

    <div class="form-col">
      <div class="form-card">
        <Eyebrow space="20px">{t.formHead}</Eyebrow>
        <p class="form-note">{t.formNote}</p>
        <p class="form-note">
          {locale === 'hu' ? 'Már hirdet nálunk? ' : 'Adverteert u al bij ons? '}
          <a href="/portal/login" rel="nofollow">
            {locale === 'hu' ? 'Lépjen be a hirdetői felületre' : 'Log in op het adverteerdersportaal'}
          </a>{locale === 'hu' ? ' — onnan új hirdetést is indíthat.' : ' — daar start u ook een nieuwe advertentie.'}
        </p>

        <FormShell
          locale={locale}
          endpoint="/api/listing-order"
          formId="listing-order"
          submitLabel={t.submit}
          successTitle={t.successTitle}
          successBody={t.successBody}
        >
          <input type="hidden" name="highlight" id="f-highlight-hidden" value="none" />
          <input type="hidden" name="translations" id="f-translations-hidden" value="" />
          <input type="hidden" name="video" id="f-video-hidden" value="" />

          <Field locale={locale} name="name" label={ui.form.name} required autocomplete="name" span="full" />
          <Field locale={locale} name="email" label={ui.form.email} type="email" required autocomplete="email" span="full" />
          <Field locale={locale} name="phone" label={ui.form.phone} type="tel" required autocomplete="tel" span="full" />

          <Field
            locale={locale}
            name="propertyType"
            label={hu ? 'Ingatlan típusa' : 'Type woning'}
            type="select"
            required
            options={categoryOptions}
            span="full"
          />
          <Field
            locale={locale}
            name="county"
            label={hu ? 'Megye' : 'Comitaat'}
            type="select"
            required
            options={COUNTIES.map((c) => ({ value: c, label: c }))}
            span="full"
          />
          <Field locale={locale} name="settlement" label={hu ? 'Település' : 'Plaats'} required span="full" />
          <Field
            locale={locale}
            name="priceHuf"
            label={hu ? 'Irányár (Ft)' : 'Vraagprijs (HUF)'}
            type="number"
            required
            min={0}
            span="full"
          />
          <Field
            locale={locale}
            name="floorM2"
            label={hu ? 'Alapterület (m²)' : 'Woonoppervlak (m²)'}
            type="number"
            min={0}
            span="full"
          />
          <Field
            locale={locale}
            name="plotM2"
            label={hu ? 'Telekterület (m²)' : 'Perceeloppervlak (m²)'}
            type="number"
            min={0}
            span="full"
          />

          <Field
            locale={locale}
            name="ownerVisible"
            label={t.ownerVisible}
            hint={t.ownerVisibleHint}
            type="select"
            required
            options={[
              { value: 'yes', label: t.yes },
              { value: 'no', label: t.no },
            ]}
            span="full"
          />
          <Field
            locale={locale}
            name="speaks"
            label={hu ? 'Milyen nyelven tud kommunikálni?' : 'Welke talen spreekt u?'}
            hint={
              hu
                ? 'Ezt feltüntetjük a hirdetésben, hogy a külföldi érdeklődő előre tudja.'
                : 'Wij vermelden dit bij de advertentie, zodat geïnteresseerden dit vooraf weten.'
            }
            placeholder={hu ? 'pl. magyar, német' : 'bijv. Hongaars, Duits'}
            span="full"
          />
          <Field
            locale={locale}
            name="description"
            label={hu ? 'Az ingatlan leírása' : 'Omschrijving van de woning'}
            type="textarea"
            rows={6}
            hint={
              hu
                ? 'Írja le a bővítési lehetőségeket és a közeli infrastruktúrát: víz, város, bevásárlás, orvos, autópálya, repülőtér távolsága.'
                : 'Beschrijf de uitbreidingsmogelijkheden en de omgeving: water, stad, winkels, huisarts, snelweg en luchthaven.'
            }
            span="full"
          />

          <Field locale={locale} name="billingName" label={hu ? 'Számlázási név' : 'Factuurnaam'} span="full" />
          <Field locale={locale} name="billingAddress" label={hu ? 'Számlázási cím' : 'Factuuradres'} span="full" />
        </FormShell>
      </div>

      <aside class="bank">
        <Eyebrow space="20px">{t.bankHead}</Eyebrow>
        <p class="bank-note">{t.bankNote}</p>
        <dl>
          <div>
            <dt>Nederland</dt>
            <dd>{COMPANY.banks.nl.iban}</dd>
            <dd class="bic">{COMPANY.banks.nl.bic}</dd>
          </div>
          <div>
            <dt>Magyarország</dt>
            <dd>{COMPANY.banks.hu.account}</dd>
          </div>
        </dl>

        <div class="help">
          <p>{hu ? 'Segítségre van szüksége?' : 'Hulp nodig?'}</p>
          {COMPANY.phones.slice(0, 2).map((p) => <a href={p.href}>{p.display}</a>)}
          <Button variant="text" href={path(locale, 'faq')}>
            {hu ? 'Gyakori kérdések' : 'Veelgestelde vragen'}
          </Button>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  const NBSP = ' ';
  function formatCents(cents: number): string {
    return `€${NBSP}${(cents / 100).toLocaleString('de-DE', {
      minimumFractionDigits: cents % 100 === 0 ? 0 : 2,
      maximumFractionDigits: 2,
    })}`;
  }

  const totalEl = document.getElementById('order-total-amount');
  const highlightHidden = document.getElementById('f-highlight-hidden') as HTMLInputElement | null;
  const translationsHidden = document.getElementById('f-translations-hidden') as HTMLInputElement | null;
  const videoHidden = document.getElementById('f-video-hidden') as HTMLInputElement | null;
  const packageInputs = document.querySelectorAll<HTMLInputElement>('input[name="package"]');
  const extraInputs = document.querySelectorAll<HTMLInputElement>('[data-extra]');

  function recalc() {
    let totalCents = 0;

    const checkedPackage = document.querySelector<HTMLInputElement>('input[name="package"]:checked');
    if (checkedPackage) totalCents += Number(checkedPackage.dataset.priceCents ?? 0);

    const languages: string[] = [];
    let highlightCategory = false;
    let highlightHomepage = false;
    let videoChecked = false;

    extraInputs.forEach((input) => {
      if (!input.checked) return;
      const priceCents = Number(input.dataset.priceCents ?? 0);
      const months = Number(input.dataset.months ?? 1);
      totalCents += priceCents * months;

      if (input.dataset.extra === 'translation') languages.push(input.dataset.label ?? '');
      if (input.dataset.extra === 'category-highlight') highlightCategory = true;
      if (input.dataset.extra === 'homepage-highlight') highlightHomepage = true;
      if (input.dataset.extra === 'video') videoChecked = true;
    });

    if (totalEl) totalEl.textContent = formatCents(totalCents);
    if (translationsHidden) translationsHidden.value = languages.join(', ');
    if (highlightHidden) {
      highlightHidden.value =
        highlightCategory && highlightHomepage
          ? 'both'
          : highlightCategory
            ? 'category'
            : highlightHomepage
              ? 'homepage'
              : 'none';
    }
    if (videoHidden) videoHidden.value = videoChecked ? 'yes' : '';
  }

  packageInputs.forEach((input) => input.addEventListener('change', recalc));
  extraInputs.forEach((input) => input.addEventListener('change', recalc));
  recalc();
</script>

<style>
  .stats {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    padding: 0 var(--pad-x) 44px;
  }
  .stat {
    border-top: 2px solid var(--accent);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .stat strong {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: 28px;
    color: var(--ink);
  }
  .stat span {
    font-size: var(--fs-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--taupe);
