          ],
        },
        {
          name: 'Normál hirdetés',
          price: '129 €',
          priceAlt: '179 €',
          priceAltNote: '150 millió Ft feletti ingatlan esetén',
          duration: '12 hónap',
          featured: true,
          features: [
            'Korlátlan számú kép',
            'A képeket szakszerűen feldolgozzuk',
            'A szöveget szakszerűen megszerkesztjük',
          ],
        },
      ],
      extrasHead: 'Kiegészítők',
      extraCategoryHighlight: 'Kiemelés a kategóriában',
      extraHomepageHighlight: 'Kiemelés a főoldalon',
      extraVideo: 'Videós bemutató',
      perMonth: '/ hó',
      minMonths: (n: number) => `min. ${n} hó`,
      once: 'egyszeri',
      totalLabel: 'Becsült összeg',
      totalNote: 'tájékoztató jellegű — a végleges díjat munkatársunk erősíti meg jóváhagyáskor',
      formHead: 'Hirdetésfeladási űrlap',
      formNote:
        'A csillaggal jelölt mezők kitöltése kötelező. Ha bármiben elakad, hívjon minket — szívesen segítünk az űrlap kitöltésében is.',
      ownerVisible: 'Megjelenjen az elérhetőségem a hirdetésben?',
      ownerVisibleHint:
        'Ha igen, a külföldi érdeklődő közvetlenül Önt is megkeresheti. Ilyen esetben — ha nincs szükség a segítségünkre — semmilyen jutalékot nem számítunk fel.',
      yes: 'Igen, jelenjen meg a nevem és a telefonszámom',
      no: 'Nem, csak a FODEL elérhetősége jelenjen meg',
      bankHead: 'Bankszámlaszámaink',
      bankNote: 'A hirdetés jóváhagyása után ezekre a számlákra utalhat — vagy fizethet bankkártyával a saját felületén.',
      submit: 'Hirdetés elküldése',
      successTitle: 'Köszönjük!',
      successBody:
