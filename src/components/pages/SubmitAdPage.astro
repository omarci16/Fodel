---
/**
 * Ad submission — the page that makes FODEL money.
 *
 * Rebuilt for FODEL 1.2: the package + price used to live on a separate
 * /arlista/ page the visitor had to leave and come back from, and the
 * package <select> posted ids (`normal-12m-129`/`normal-12m-179`) that don't
 * exist in the catalogue (src/config/company.ts only has `cheap-6m` /
 * `normal-12m`) — buildOrderLines() threw OrderError('unknown-package') on
 * the admin's review screen every time. Packages are now selected inline as
 * real PackageCard radio cards whose values come straight off
 * LISTING_PACKAGES, so a mismatch is no longer possible by construction; the
 * €179 tier is still decided server-side from the listing's own forint price
 * (isAboveThreshold(), in src/lib/orders.ts) — never something the client
 * asserts.
 *
 * The flow otherwise matches how the business already works
 * (fodel.hu/szolgaltatas): form → díjbekérő by email → bank transfer → photo
 * upload rights → translation → published in five languages.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import PackageCard from '~/components/PackageCard.astro';
import FormShell from '~/components/forms/FormShell.astro';
import Field from '~/components/forms/Field.astro';
import { UI, CATEGORIES, LOCALE_META, path, type Locale, type CategoryKey } from '~/i18n/ui';
import { COMPANY, LISTING_PACKAGES, LISTING_EXTRAS, TRANSLATION_LANGUAGES } from '~/config/company';
import { COUNTIES } from '~/data/features';
import { alternatesFor } from '~/lib/page';
import { formatCents } from '~/lib/orders';
import { listingServiceSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const hu = locale === 'hu';

const t = hu
  ? {
