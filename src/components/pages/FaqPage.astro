---
/**
 * FAQ — FODEL's own 22 questions, absent from the prototype.
 *
 * This is the highest-value SEO and answer-engine content they own: plainly
 * stated facts about prices, commission and process, which is exactly what
 * assistants quote. Emits FAQPage structured data over the same text that is
 * visible on the page.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Button from '~/components/Button.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { FAQ, faqAnswerText, type FaqAudience } from '~/data/faq';
import { alternatesFor } from '~/lib/page';
import { faqSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const hu = locale === 'hu';
const entries = FAQ[locale];

const t = hu
  ? {
      metaTitle: 'Gyakori kérdések — Hirdetés, jutalék, külföldi vevők',
      metaDescription:
        'Miért jó egy külföldi vevő? Mennyibe kerül a hirdetés? Mikor kell jutalékot fizetni? A FODEL 22 leggyakoribb kérdése és válasza.',
      eyebrow: 'Gyakori kérdések',
      title: 'Kérdések és',
      titleEm: 'válaszok',
      body: 'Az alábbiakban azokat a kérdéseket gyűjtöttük össze, amelyeket a leggyakrabban kapunk. Ha nem találja, amit keres, hívjon minket — vagy kérjen ingyenes visszahívást.',
      groups: [
        { id: 'seller' as FaqAudience, label: 'Eladóknak' },
        { id: 'both' as FaqAudience, label: 'Általános' },
      ],
      stillHead: 'Nem találta meg a választ?',
      stillBody: 'Hívjon minket munkanapokon 09:00 és 18:00 között, vagy kérjen ingyenes visszahívást.',
    }
  : {
      metaTitle: 'Veelgestelde vragen — Kopen in Hongarije',
      metaDescription:
        'Kan ik als EU-burger kopen in Hongarije? Wat kost uw bemiddeling? Moet ik erheen om te tekenen? De vragen die kopers ons het vaakst stellen.',
      eyebrow: 'Veelgestelde vragen',
      title: 'Vragen en',
      titleEm: 'antwoorden',
      body: 'Hieronder de vragen die wij het vaakst krijgen. Staat uw vraag er niet bij? Bel ons gerust, of vraag om teruggebeld te worden.',
      groups: [
        { id: 'buyer' as FaqAudience, label: 'Voor kopers' },
        { id: 'both' as FaqAudience, label: 'Algemeen' },
      ],
      stillHead: 'Geen antwoord gevonden?',
      stillBody: 'Bel ons op werkdagen tussen 09:00 en 18:00, of vraag om teruggebeld te worden.',
    };

const grouped = t.groups
  .map((g) => ({ ...g, items: entries.filter((e) => e.audience === g.id) }))
  .filter((g) => g.items.length > 0);
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('faq')}
  schema={[faqSchema(entries.map((e) => ({ question: e.question, answer: faqAnswerText(e) })))]}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.body} compact />

  <div class="faq-page">
    <nav class="toc no-print" aria-label={hu ? 'Kérdések' : 'Vragen'}>
      {
        grouped.map((group) => (
          <div class="toc-group">
            <Eyebrow space="10px" class="toc-label">{group.label}</Eyebrow>
            <ol>
              {group.items.map((e) => (
                <li><a href={`#${e.id}`} data-toc={e.id}>{e.question}</a></li>
              ))}
            </ol>
          </div>
        ))
      }
    </nav>

    <div class="faq-body">
      {
        grouped.map((group) => (
          <section class="group">
            <h2 class="group-head">
              {group.label}
              <span class="group-count num">{group.items.length}</span>
            </h2>
            {group.items.map((entry) => (
              <article class="entry" id={entry.id}>
                <h3>{entry.question}</h3>
                <div class="answer">
                  {entry.answer.map((para) =>
                    para.startsWith('- ') ? <p class="bullet">{para.slice(2)}</p> : <p>{para}</p>
                  )}
                </div>
              </article>
            ))}
          </section>
        ))
      }

      <aside class="still" data-bg="dark">
        <h2 class="still-head">{t.stillHead}</h2>
        <p>{t.stillBody}</p>
        <div class="still-actions">
          <Button variant="dark" light href={path(locale, 'contact')}>{ui.cta.callback}</Button>
          <Button variant="outline" light href={path(locale, hu ? 'submitAd' : 'searchRequest')}>
            {hu ? ui.cta.submitAd : ui.cta.searchRequest}
          </Button>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  /* Scroll-spy: the question being read is marked in the list beside it,
     and the list keeps it in view. */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const toc = document.querySelector<HTMLElement>('.toc');
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [a.dataset.toc!, a]));
    let current: HTMLAnchorElement | null = null;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const link = byId.get(entry.target.id);
          if (!link || link === current) continue;
          current?.removeAttribute('aria-current');
          link.setAttribute('aria-current', 'true');
          current = link;
          if (toc && getComputedStyle(toc).position === 'sticky') {
            const top = link.offsetTop - toc.clientHeight / 2;
            toc.scrollTo({ top, behavior: 'smooth' });
          }
        }
      },
      { rootMargin: '-30% 0px -60% 0px' }
    );
    document.querySelectorAll('.entry').forEach((el) => io.observe(el));
  }
</script>

<style>
  .faq-page {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 56px;
    padding: 56px var(--pad-x) var(--section-y);
    align-items: start;
  }

  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 16px);
    max-height: calc(100vh - var(--nav-h) - 40px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 22px 12px 22px 16px;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .toc :global(.toc-label) {
    padding-left: 12px;
    color: var(--taupe);
  }
  .toc-group + .toc-group {
    margin-top: 22px;
  }
  .toc ol {
    list-style: none;
  }
  .toc a {
    display: block;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--taupe);
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .toc a:hover {
    background: rgba(16, 42, 67, 0.05);
    color: var(--ink);
  }
  .toc a[aria-current] {
    background: var(--ink);
    color: var(--cream);
  }

  .group + .group {
    margin-top: 72px;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(28px, 2.8vw, 40px);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 20px;
  }
  .group-count {
    display: inline-grid;
    place-items: center;
    min-width: 34px;
    height: 34px;
    padding: 0 10px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.07);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: var(--fw-medium);
    letter-spacing: 0;
  }

  .entry {
    padding: 30px 34px 32px;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.06);
    scroll-margin-top: calc(var(--nav-h) + 20px);
  }
  .entry + .entry {
    margin-top: 10px;
  }
  .entry:target {
    box-shadow: 0 0 0 2px var(--ink);
  }
  .entry h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(19px, 1.7vw, 23px);
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .answer p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 14px;
    max-width: 72ch;
  }
  .answer p:last-child {
    margin-bottom: 0;
  }
  .bullet {
    padding-left: 22px;
    position: relative;
    margin-bottom: 8px;
  }
  .bullet::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
  }

  .still {
    margin-top: 72px;
    padding: clamp(32px, 4vw, 56px);
    border-radius: var(--r-2xl);
    background:
      radial-gradient(110% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
  }
  .still-head {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(26px, 2.6vw, 38px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--cream);
    margin-bottom: 14px;
  }
  .still p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--on-dark-body);
    margin-bottom: 28px;
    max-width: 56ch;
  }
  .still-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  @media (max-width: 1000px) {
    .faq-page {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
    .toc {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .entry {
      padding: 24px 22px;
    }
    .still-actions {
      flex-direction: column;
    }
    .still {
      border-radius: var(--r-xl);
    }
  }
</style>
