---
/**
 * Editorial index. FODEL publish long-form pieces on why Dutch buyers move to
 * Hungary; that content is a genuine organic-search asset for the Dutch market.
 *
 * Supabase-backed since FODEL 1.2 (previously two Markdown files) — see
 * src/lib/blog.ts. `cover_url`/`og_image_url` are stored as plain public
 * Storage URLs, not astro:assets ImageMetadata, so this uses a plain <img>
 * rather than <Image> for post covers; the images already go through the
 * sharp pipeline at upload time (src/lib/media.ts), just not through Astro's
 * build-time optimiser.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { alternatesFor } from '~/lib/page';
import { formatDate } from '~/lib/format';
import { publishedPosts } from '~/lib/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const hu = locale === 'hu';

const posts = await publishedPosts(locale);

const [lead, ...rest] = posts;

const t = hu
  ? {
      metaTitle: 'Hírek és cikkek — Piac, migráció, tanácsok',
      metaDescription:
        'Elemzések a magyar ingatlanpiacról és a nyugat-európai vevőkről: miért költöznek a hollandok Magyarországra, és mit jelent ez az eladóknak.',
      eyebrow: 'Hírek és cikkek',
      title: 'Piac,',
      titleEm: 'háttér, tanácsok',
      intro: 'Amit a magyar ingatlanpiacról és a nyugat-európai vevőkről érdemes tudni.',
      empty: 'Hamarosan új cikkekkel jelentkezünk.',
    }
  : {
      metaTitle: 'Nieuws en achtergrond — Markt, emigratie, advies',
      metaDescription:
        'Analyses over de Hongaarse vastgoedmarkt en West-Europese kopers: waarom Nederlanders naar Hongarije verhuizen, en wat dat betekent.',
      eyebrow: 'Nieuws',
      title: 'Markt,',
      titleEm: 'achtergrond, advies',
      intro: 'Wat u moet weten over de Hongaarse vastgoedmarkt en de kopers uit West-Europa.',
      empty: 'Binnenkort verschijnen hier nieuwe artikelen.',
    };
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('blog')}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.intro} compact />

  <div class="blog">
    {posts.length === 0 && <p class="empty">{t.empty}</p>}

    {
      lead && (
        <article class="lead">
          <a href={`${path(locale, 'blog')}${lead.slug}/`}>
            {lead.cover_url && (
              <div class="lead-media">
                <img src={lead.cover_url} alt={lead.cover_alt ?? ''} loading="eager" width="900" height="600" />
              </div>
            )}
            <div class="lead-copy">
              <Eyebrow space="12px">{lead.category}</Eyebrow>
              <h2>{lead.title}</h2>
              <p class="excerpt">{lead.excerpt}</p>
              <p class="meta">
                {lead.published_at && (
                  <time datetime={lead.published_at.toISOString()}>
                    {formatDate(lead.published_at, locale)}
                  </time>
                )}
                <span aria-hidden="true">·</span>
                <span>{lead.reading_minutes} {hu ? 'perc olvasás' : 'min. lezen'}</span>
              </p>
              <span class="more">{ui.cta.readMore} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((post) => (
            <article class="card reveal">
              <a href={`${path(locale, 'blog')}${post.slug}/`}>
                {post.cover_url && (
                  <div class="card-media">
                    <img src={post.cover_url} alt={post.cover_alt ?? ''} loading="lazy" width="700" height="525" />
                  </div>
                )}
                <Eyebrow space="12px">{post.category}</Eyebrow>
                <h3>{post.title}</h3>
                <p class="excerpt">{post.excerpt}</p>
                <p class="meta">
                  {post.published_at && (
                    <time datetime={post.published_at.toISOString()}>
                      {formatDate(post.published_at, locale)}
                    </time>
                  )}
                  <span aria-hidden="true">·</span>
                  <span>{post.reading_minutes} {hu ? 'perc' : 'min.'}</span>
                </p>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  .blog {
    padding: 8px var(--pad-x) var(--section-y);
  }
  .empty {
    font-size: var(--fs-body);
    color: var(--taupe);
    padding: 40px 0;
  }

  .lead {
    padding-bottom: 56px;
    margin-bottom: 56px;
    border-bottom: 1px solid var(--border);
  }
  .lead a {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .lead-media :global(img),
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lead-media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--mist);
  }
  .lead h2 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(26px, 3vw, 42px);
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .excerpt {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 16px;
  }
  .meta {
    display: flex;
    gap: 8px;
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--taupe);
    margin-bottom: 20px;
  }
  .more {
    display: inline-flex;
    gap: 10px;
    font-size: var(--fs-micro);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .lead a:hover .more {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px 36px;
  }
  .card-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--mist);
    margin-bottom: 18px;
  }
  .card h3 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: 21px;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 10px;
    transition: color var(--dur-fast) ease;
  }
  .card a:hover h3 {
    color: var(--taupe);
  }
  .card .excerpt {
    font-size: var(--fs-small);
  }

  @media (max-width: 900px) {
    .blog {
      padding: 8px var(--pad-x-mob) var(--section-y-mob);
    }
    .lead a {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
