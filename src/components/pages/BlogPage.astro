---
/**
 * Editorial index. FODEL publish long-form pieces on why Dutch buyers move to
 * Hungary; that content is a genuine organic-search asset for the Dutch market.
 *
 * Supabase-backed since FODEL 1.2 (previously two Markdown files) — see
 * src/lib/blog.ts. `cover_url`/`og_image_url` are stored as plain public
 * Storage URLs, not astro:assets ImageMetadata, so this uses a plain <img>
 * rather than <Image> for post covers; the images already go through the
 * sharp pipeline at upload time (src/lib/media.ts), just not through Astro's
 * build-time optimiser.
 *
 * 2.0: every article is a rounded card that reads as finished with or
 * without a cover photograph — the newest one set large on ink, the rest on
 * white — and each ends in the arrow chip that says it opens.
 */
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import ArrowChip from '~/components/ArrowChip.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { alternatesFor } from '~/lib/page';
import { formatDate } from '~/lib/format';
import { publishedPosts } from '~/lib/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = UI[locale];
const hu = locale === 'hu';

// Articles and case studies are listed separately (brief §5): the default view
// is articles, `?type=case-study` the case studies. The switch only appears
// once a case study exists in this language.
const showCases = Astro.url.searchParams.get('type') === 'case-study';
const [articles, cases] = await Promise.all([
  publishedPosts(locale, { kind: 'article' }),
  publishedPosts(locale, { kind: 'case_study' }),
]);
const posts = showCases ? cases : articles;

const [lead, ...rest] = posts;

const t = hu
  ? {
      metaTitle: 'Hírek és cikkek — Piac, migráció, tanácsok',
      metaDescription:
        'Elemzések a magyar ingatlanpiacról és a nyugat-európai vevőkről: miért költöznek a hollandok Magyarországra, és mit jelent ez az eladóknak.',
      eyebrow: 'Hírek és cikkek',
      title: 'Piac,',
      titleEm: 'háttér, tanácsok',
      intro: 'Amit a magyar ingatlanpiacról és a nyugat-európai vevőkről érdemes tudni.',
      empty: 'Hamarosan új cikkekkel jelentkezünk.',
    }
  : {
      metaTitle: 'Nieuws en achtergrond — Markt, emigratie, advies',
      metaDescription:
        'Analyses over de Hongaarse vastgoedmarkt en West-Europese kopers: waarom Nederlanders naar Hongarije verhuizen, en wat dat betekent.',
      eyebrow: 'Nieuws',
      title: 'Markt,',
      titleEm: 'achtergrond, advies',
      intro: 'Wat u moet weten over de Hongaarse vastgoedmarkt en de kopers uit West-Europa.',
      empty: 'Binnenkort verschijnen hier nieuwe artikelen.',
    };
---

<Base
  locale={locale}
  title={t.metaTitle}
  description={t.metaDescription}
  alternates={alternatesFor('blog')}
>
  <PageHeader eyebrow={t.eyebrow} title={t.title} titleEm={t.titleEm} body={t.intro} compact />

  <div class="blog">
    {cases.length > 0 && (
      <nav class="kinds" aria-label={hu ? 'Tartalomtípus' : 'Soort inhoud'}>
        <a href={path(locale, 'blog')} aria-current={!showCases ? 'page' : undefined}>{hu ? 'Cikkek' : 'Artikelen'}</a>
        <a href={`${path(locale, 'blog')}?type=case-study`} aria-current={showCases ? 'page' : undefined}>
          {hu ? 'Esettanulmányok' : 'Casestudies'}
        </a>
      </nav>
    )}
    {posts.length === 0 && <p class="empty">{t.empty}</p>}

    {
      lead && (
        <article class="lead reveal">
          <a href={`${path(locale, 'blog')}${lead.slug}/`} data-bg="dark" class:list={[{ 'has-media': !!lead.cover_url }]}>
            {lead.cover_url && (
              <div class="lead-media">
                <img src={lead.cover_url} alt={lead.cover_alt ?? ''} loading="eager" width="900" height="600" />
              </div>
            )}
            <div class="lead-copy">
              <span class="pill pill-dark">{lead.category}</span>
              <h2>{lead.title}</h2>
              <p class="excerpt">{lead.excerpt}</p>
              <div class="lead-foot">
                <p class="meta">
                  {lead.published_at && (
                    <time datetime={lead.published_at.toISOString()}>
                      {formatDate(lead.published_at, locale)}
                    </time>
                  )}
                  <span aria-hidden="true">·</span>
                  <span>{lead.reading_minutes} {hu ? 'perc olvasás' : 'min. lezen'}</span>
                </p>
                <span class="more">
                  <span>{ui.cta.readMore}</span>
                  <ArrowChip size={44} />
                </span>
              </div>
            </div>
          </a>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <div class="grid">
          {rest.map((post, i) => (
            <article class="card reveal" style={`--reveal-delay:${(i % 3) * 0.08}s`}>
              <a href={`${path(locale, 'blog')}${post.slug}/`}>
                {post.cover_url && (
                  <div class="card-media">
                    <img src={post.cover_url} alt={post.cover_alt ?? ''} loading="lazy" width="700" height="525" />
                  </div>
                )}
                <div class="card-copy">
                  <div class="card-top">
                    <span class="pill">{post.category}</span>
                    <ArrowChip size={40} class="card-chip" />
                  </div>
                  <h3>{post.title}</h3>
                  <p class="excerpt">{post.excerpt}</p>
                  <p class="meta">
                    {post.published_at && (
                      <time datetime={post.published_at.toISOString()}>
                        {formatDate(post.published_at, locale)}
                      </time>
                    )}
                    <span aria-hidden="true">·</span>
                    <span>{post.reading_minutes} {hu ? 'perc' : 'min.'}</span>
                  </p>
                </div>
              </a>
            </article>
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  .blog {
    padding: 48px var(--pad-x) var(--section-y);
  }
  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .kinds a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(16, 42, 67, 0.16);
    font-size: 15px;
    font-weight: var(--fw-medium);
    color: var(--ink);
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .kinds a:hover {
    border-color: var(--ink);
  }
  .kinds a[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .empty {
    font-size: var(--fs-body);
    color: var(--taupe);
    padding: 40px 0;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    height: 30px;
    padding: 0 13px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.07);
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .pill-dark {
    background: rgba(244, 244, 242, 0.12);
    color: var(--cream);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13.5px;
    color: var(--taupe);
  }

  /* ── The newest article, on ink ── */
  .lead {
    margin-bottom: 16px;
  }
  .lead a {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-radius: var(--r-2xl);
    background:
      radial-gradient(110% 90% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    color: var(--cream);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
    transition: box-shadow 0.6s var(--ease-out);
  }
  .lead a.has-media {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
  .lead a:hover {
    box-shadow: var(--shadow-float);
  }
  .lead-media {
    position: relative;
    min-height: 420px;
    overflow: hidden;
  }
  .lead-media :global(img),
  .card-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.4s var(--ease-out);
  }
  .lead a:hover .lead-media :global(img),
  .card a:hover .card-media :global(img) {
    transform: scale(1.04);
  }
  .lead-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(36px, 5vw, 72px);
  }
  .lead h2 {
    max-width: 18ch;
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(32px, 4vw, 60px);
    letter-spacing: var(--ls-display);
    line-height: 1.04;
    color: var(--cream);
  }
  .lead .excerpt {
    max-width: 52ch;
    font-size: var(--fs-body-lg);
    line-height: 1.6;
    color: var(--on-dark-body);
  }
  .lead-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin-top: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--on-dark-rule);
  }
  .lead .meta {
    color: var(--on-dark-muted);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 1rem;
    font-weight: var(--fw-medium);
    color: var(--cream);
  }

  /* ── The rest, on white ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    --chip-bg: rgba(16, 42, 67, 0.07);
    --chip-fg: var(--ink);
    transition:
      transform 0.6s var(--ease-out),
      box-shadow 0.6s var(--ease-out);
  }
  .card a:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }
  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--mist);
  }
  .card-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
    padding: 24px 26px 26px;
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .card h3 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(21px, 1.7vw, 25px);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
  }
  .card .excerpt {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--taupe);
  }
  .card .meta {
    margin-top: auto;
    padding-top: 12px;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .blog {
      padding: 36px var(--pad-x-mob) var(--section-y-mob);
    }
    .lead a.has-media {
      grid-template-columns: 1fr;
    }
    .lead-media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .lead a {
      border-radius: var(--r-xl);
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
