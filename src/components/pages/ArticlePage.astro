---
/**
 * Article detail — one shared component for both locales' [slug] routes,
 * which were byte-identical apart from a locale literal. Supabase-backed
 * since FODEL 1.2; see src/lib/blog.ts.
 *
 * Renders 404 itself (rather than the route file) so both thin wrappers stay
 * truly thin — locale in, a real Response or nothing else out.
 */
export const prerender = false;

import Button from '~/components/Button.astro';
import Base from '~/layouts/Base.astro';
import { UI, path, type Locale, LOCALES } from '~/i18n/ui';
import { crumbs } from '~/lib/page';
import { articleSchema, breadcrumbSchema } from '~/lib/seo';
import { formatDate } from '~/lib/format';
import { postBySlug, siblingPost } from '~/lib/blog';
import { renderMarkdown } from '~/lib/markdown';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const post = await postBySlug(locale, slug);
if (!post) return new Response('Cikk nem található.', { status: 404 });

const ui = UI[locale];
const url = `${path(locale, 'blog')}${post.slug}/`;
const html = renderMarkdown(post.body_md);

// hreflang only where a sibling actually exists — most posts have none, and
// asserting otherwise is exactly the bug the plan's architecture review
// flagged (Piacelemzés and Kopersgids are not translations of each other).
const otherLocale = LOCALES.find((l) => l !== locale)!;
const sibling = await siblingPost(post, otherLocale);
const alternates: Partial<Record<Locale, string>> = {
  [locale]: url,
  ...(sibling ? { [otherLocale]: `${path(otherLocale, 'blog')}${sibling.slug}/` } : {}),
};

const trail = crumbs(locale, [
  { name: ui.nav.blog, url: path(locale, 'blog') },
  { name: post.title, url },
]);
---

<Base
  locale={locale}
  title={post.seo_title || post.title}
  description={post.seo_description || post.excerpt}
  alternates={alternates}
  ogType="article"
  schema={[
    articleSchema({
      title: post.title,
      description: post.excerpt,
      url,
      image: post.og_image_url ?? post.cover_url ?? undefined,
      published: post.published_at ?? post.updated_at,
      updated: post.updated_at,
      locale,
      author: post.author,
    }),
    breadcrumbSchema(trail),
  ]}
>
  <nav class="crumbs" aria-label={ui.a11y.breadcrumb}>
    <ol>
      {trail.map((c, i) => (
        <li>{i < trail.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
      ))}
    </ol>
  </nav>

  <article class="article">
    <header>
      <span class="pill">{post.category}</span>
      <h1>{post.title}</h1>
      <p class="meta">
        {post.published_at && (
          <time datetime={post.published_at.toISOString()}>{formatDate(post.published_at, locale)}</time>
        )}
        <span aria-hidden="true">·</span>
        <span>{post.reading_minutes} {locale === 'hu' ? 'perc olvasás' : 'min. lezen'}</span>
        <span aria-hidden="true">·</span>
        <span>{post.author}</span>
      </p>
      <p class="excerpt">{post.excerpt}</p>
    </header>

    <div class="prose" set:html={html} />

    <footer class="foot">
      <Button variant="text" href={path(locale, 'blog')}>{ui.nav.blog}</Button>
      <Button variant="dark" href={path(locale, 'properties')}>{ui.cta.browseProperties}</Button>
    </footer>
  </article>
</Base>

<style>
  .crumbs {
    padding: 28px var(--pad-x) 0;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    list-style: none;
    font-size: 13.5px;
    color: var(--taupe);
  }
  .crumbs li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .crumbs li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--taupe);
    opacity: 0.5;
  }
  .crumbs a:hover,
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .article {
    max-width: calc(72ch + 2 * var(--pad-x));
    margin-inline: auto;
    padding: 56px var(--pad-x) var(--section-y);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 13px;
    margin-bottom: 24px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.07);
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(34px, 4.4vw, 64px);
    letter-spacing: var(--ls-display);
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 24px;
    animation: fx-fade-up 1.2s var(--ease-out) 0.2s both;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13.5px;
    color: var(--taupe);
    margin-bottom: 28px;
  }
  .excerpt {
    font-size: var(--fs-lead);
    line-height: 1.65;
    color: var(--ink);
    padding: 26px 30px;
    border-radius: var(--r-xl);
    background: rgba(16, 42, 67, 0.04);
    margin-bottom: 48px;
  }

  .prose :global(h2) {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(24px, 2.4vw, 32px);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--ink);
    margin: 48px 0 16px;
  }
  .prose :global(h3) {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: var(--fs-lead);
    color: var(--ink);
    margin: 32px 0 10px;
  }
  .prose :global(p) {
    font-size: var(--fs-body-lg);
    line-height: 1.75;
    color: var(--taupe);
    margin-bottom: 20px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 20px 22px;
  }
  .prose :global(li) {
    font-size: var(--fs-body-lg);
    line-height: 1.7;
    color: var(--taupe);
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .prose :global(hr) {
    border: none;
    height: 1px;
    background: var(--border);
    margin: 48px 0;
  }
  .prose :global(blockquote) {
    margin: 32px 0;
    padding: 24px 28px;
    border-radius: var(--r-lg);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.07);
    font-family: var(--serif);
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink);
  }
  .prose :global(blockquote p) {
    margin: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose :global(strong) {
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  .prose :global(img) {
    border-radius: var(--r-lg);
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .crumbs {
      padding: 20px var(--pad-x-mob) 0;
    }
    .article {
      padding: 32px var(--pad-x-mob) var(--section-y-mob);
    }
    .excerpt {
      padding: 20px 22px;
    }
  }
</style>
