---
/**
 * One English or German article or case study (brief §5): its own URL, its
 * own share image and metadata, and hreflang only to a live en/de sibling —
 * never a fallback to another language's text.
 */
export const prerender = false;

import { getImage } from 'astro:assets';
import Bridge from '~/layouts/Bridge.astro';
import { siblingPost, postPath, BLOG_PATH, type BlogPost } from '~/lib/blog';
import { renderMarkdown } from '~/lib/markdown';
import { abs } from '~/lib/seo';
import { BRAND } from '~/i18n/ui';
import '~/styles/prose.css';

interface Props {
  locale: 'en' | 'de';
  /** Looked up by the route file, which answers 404 when there is none. */
  post: BlogPost;
}

const { locale, post } = Astro.props;

const other = locale === 'en' ? 'de' : 'en';
const sibling = await siblingPost(post, other);
const url = postPath(post);
const alternates = sibling ? { [locale]: url, [other]: postPath(sibling) } : {};

const shareSource = post.og_image_url ?? post.cover_url;
let ogImage: string | undefined;
if (shareSource) {
  try {
    ogImage = (await getImage({ src: shareSource, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src;
  } catch (error) {
    console.error('[article] share image could not be prepared', error);
  }
}

const T = {
  en: { minutes: 'min read', back: 'All articles', caseStudy: 'Case study', method: 'Method', results: 'Results', sources: 'Sources' },
  de: { minutes: 'Min. Lesezeit', back: 'Alle Artikel', caseStudy: 'Fallstudie', method: 'Methodik', results: 'Ergebnisse', sources: 'Quellen' },
}[locale];
const LANG_TAG = { en: 'en-GB', de: 'de-DE' }[locale];
const isCase = post.kind === 'case_study';
const caseSections = isCase
  ? [
      { title: T.method, md: post.case_method },
      { title: T.results, md: post.case_results },
      { title: T.sources, md: post.case_sources },
    ].filter((section) => section.md?.trim())
  : [];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  url: abs(url),
  ...(ogImage ? { image: abs(ogImage) } : {}),
  datePublished: (post.published_at ?? post.updated_at).toISOString(),
  dateModified: post.updated_at.toISOString(),
  inLanguage: locale,
  author: { '@type': 'Organization', name: post.author },
  publisher: { '@type': 'Organization', name: BRAND[locale].name },
};
---

<Bridge
  locale={locale}
  title={post.seo_title || post.title}
  description={post.seo_description || post.excerpt}
  ogImage={ogImage}
  ogType="article"
  alternates={alternates}
  schema={[schema]}
>
  <article class="article">
    <header>
      <span class="pill">{isCase ? T.caseStudy : post.category}</span>
      <h1>{post.title}</h1>
      <p class="meta">
        {post.published_at && (
          <time datetime={post.published_at.toISOString()}>
            {new Intl.DateTimeFormat(LANG_TAG, { year: 'numeric', month: 'long', day: 'numeric' }).format(post.published_at)}
          </time>
        )}
        <span aria-hidden="true">·</span>
        <span>{post.reading_minutes} {T.minutes}</span>
        <span aria-hidden="true">·</span>
        <span>{post.author}</span>
      </p>
      <p class="excerpt">{post.excerpt}</p>
    </header>

    <div class="prose" set:html={renderMarkdown(post.body_md)} />

    {caseSections.map((section) => (
      <section class="case-section">
        <h2>{section.title}</h2>
        <div class="prose" set:html={renderMarkdown(section.md!)} />
      </section>
    ))}

    <footer class="foot">
      <a href={BLOG_PATH[locale]}>← {T.back}</a>
    </footer>
  </article>
</Bridge>

<style>
  .article {
    max-width: 72ch;
    margin-inline: auto;
    padding-top: 32px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 13px;
    margin-bottom: 24px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.07);
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--ink);
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(34px, 4.4vw, 60px);
    letter-spacing: var(--ls-display);
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 24px;
    text-wrap: balance;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13.5px;
    color: var(--taupe);
    margin-bottom: 28px;
  }
  .excerpt {
    font-size: var(--fs-lead);
    line-height: 1.65;
    color: var(--ink);
    padding: 26px 30px;
    border-radius: var(--r-xl);
    background: rgba(16, 42, 67, 0.04);
    margin-bottom: 48px;
  }
  .case-section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .case-section h2 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(22px, 2vw, 28px);
    color: var(--ink);
    margin-bottom: 16px;
  }
  .foot {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .foot a {
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 768px) {
    .excerpt {
      padding: 20px 22px;
    }
  }
</style>
