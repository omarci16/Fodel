    padding: 22px 0;
    font-size: var(--fs-small);
    line-height: 1.4;
    color: var(--ink);
    cursor: pointer;
  }
  .switch {
    position: relative;
    flex-shrink: 0;
    width: 42px;
    height: 24px;
    border: 1px solid var(--border);
    background: var(--cream);
    transition:
      background 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out);
  }
  .switch::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: 14px;
    height: 14px;
    background: var(--taupe);
    transition:
      transform 0.45s var(--ease-out),
