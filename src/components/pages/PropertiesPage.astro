  /* Chips — one tap chooses; the chosen one is filled. */
  .chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .opt,
  .seg {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .opt input,
  .seg input,
  .switch-row input {
