---
/**
 * Property search.
 *
 * Every card is rendered into the HTML at build time; filtering and sorting
 * happen by toggling `hidden` and reordering the pre-rendered nodes. So the
 * full inventory is crawlable and readable without JavaScript, and filtering
 * costs no network request. Filters read from the URL, so a search is a real
 * shareable link — the prototype kept all of this in React state at `/`.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import GoldRule from '~/components/GoldRule.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import { UI, CATEGORIES, path, type Locale, type CategoryKey } from '~/i18n/ui';
import { alternatesFor, crumbs } from '~/lib/page';
import { activeProperties, regionsOf, categoriesOf, PRICE_BANDS, priceBandLabel } from '~/lib/properties';
import { breadcrumbSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
  /** Pre-filtered subset for a region or category landing page. */
  subset?: Awaited<ReturnType<typeof activeProperties>>;
  heading?: string;
  intro?: string;
  metaTitle?: string;
  metaDescription?: string;
  canonicalKey?: 'properties';
}

const { locale, subset, heading, intro, metaTitle, metaDescription } = Astro.props;
const ui = UI[locale];

const all = await activeProperties();
const properties = subset ?? all;

const regions = regionsOf(all);
const categories = categoriesOf(all);

const title = heading ?? (locale === 'hu' ? 'Ingatlanok' : 'Ons aanbod');
const defaultDescription =
  locale === 'hu'
    ? `${properties.length} magyar ingatlan eladó — házak, tanyák, kúriák, nyaralók és birtokok. Szűrjön típus, régió és ár szerint.`
    : `${properties.length} woningen in Hongarije — huizen, boerderijen, landhuizen en vakantiehuizen. Filter op type, regio en prijs.`;

const trail = crumbs(locale, [{ name: title, url: path(locale, 'properties') }]);
---

<Base
  locale={locale}
  title={metaTitle ?? title}
  description={metaDescription ?? intro ?? defaultDescription}
  alternates={alternatesFor('properties')}
  schema={[breadcrumbSchema(trail)]}
>
  <nav class="crumbs" aria-label={ui.a11y.breadcrumb}>
    <ol>
      {
        trail.map((c, i) => (
          <li>
            {i < trail.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          </li>
        ))
      }
    </ol>
  </nav>

  <header class="head">
    <Eyebrow space="12px">{ui.filters.title}</Eyebrow>
    <h1>{title}</h1>
    <GoldRule space="24px" />
    {intro && <p class="intro">{intro}</p>}
  </header>

  <form class="filters" id="filters" method="GET" action={path(locale, 'properties')}>
    <div class="filter-row">
      <div class="fcell">
        <label for="f-type">{ui.filters.type}</label>
        <select id="f-type" name="type">
          <option value="">{ui.filters.all}</option>
          {categories.map((k) => <option value={k}>{CATEGORIES[k][locale].label}</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-region">{ui.filters.region}</label>
        <select id="f-region" name="region">
          <option value="">{ui.filters.all}</option>
          {regions.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-price">{ui.filters.price}</label>
        <select id="f-price" name="price">
          <option value="">{ui.filters.all}</option>
          {PRICE_BANDS.map((b) => <option value={b.id}>{priceBandLabel(b)}</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-beds">{ui.filters.beds}</label>
        <select id="f-beds" name="beds">
          <option value="">{ui.filters.any}</option>
          {[2, 3, 4, 5].map((n) => <option value={String(n)}>{n}+</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-sort">{ui.filters.sort}</label>
        <select id="f-sort" name="sort">
          <option value="featured">{ui.filters.sortFeatured}</option>
          <option value="price-asc">{ui.filters.sortPriceAsc}</option>
          <option value="price-desc">{ui.filters.sortPriceDesc}</option>
          <option value="area-desc">{ui.filters.sortAreaDesc}</option>
        </select>
      </div>
    </div>

    <div class="filter-foot">
      <p class="count" id="result-count" role="status">{ui.filters.results(properties.length)}</p>
      <div class="filter-actions">
        <button type="button" id="filter-reset" class="reset">{ui.filters.reset}</button>
        <noscript><button type="submit" class="reset">{ui.filters.search}</button></noscript>
      </div>
    </div>
  </form>

  <div class="grid" id="property-grid">
    {properties.map((p, i) => <PropertyCard property={p} locale={locale} eager={i < 3} />)}
  </div>

  <div class="empty" id="no-results" hidden>
    <GoldRule center space="28px" />
    <p class="empty-title">{ui.filters.noResults}</p>
    <p class="empty-hint">{ui.filters.noResultsHint}</p>
    <Button variant="dark" href={path(locale, 'searchRequest')}>{ui.cta.searchRequest}</Button>
  </div>
</Base>

<script>
  const form = document.getElementById('filters') as HTMLFormElement | null;
  const grid = document.getElementById('property-grid');
  const empty = document.getElementById('no-results');
  const count = document.getElementById('result-count');

  if (form && grid && empty && count) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-property]'));
    const template = count.textContent ?? '';

    const BANDS: Record<string, [number, number]> = {
      'to-75': [0, 75000],
      '75-150': [75000, 150000],
      '150-250': [150000, 250000],
      'from-250': [250000, Infinity],
    };

    const readParams = () => {
      const params = new URLSearchParams(location.search);
      for (const field of ['type', 'region', 'price', 'beds', 'sort']) {
        const value = params.get(field);
        const control = form.elements.namedItem(field) as HTMLSelectElement | null;
        if (value && control) control.value = value;
      }
    };

    const apply = (pushState: boolean) => {
      const data = new FormData(form);
      const type = String(data.get('type') ?? '');
      const region = String(data.get('region') ?? '');
      const price = String(data.get('price') ?? '');
      const beds = Number(data.get('beds') ?? 0);
      const sort = String(data.get('sort') ?? 'featured');

      let visible = 0;
      for (const card of cards) {
        const d = card.dataset;
        const cardPrice = Number(d.price);
        const band = price ? BANDS[price] : null;

        const match =
          (!type || d.category === type) &&
          (!region || d.region === region) &&
          (!beds || Number(d.beds) >= beds) &&
          (!band || (cardPrice >= band[0] && cardPrice < band[1]));

        card.hidden = !match;
        if (match) visible++;
      }

      const shown = cards.filter((c) => !c.hidden);
      shown.sort((a, b) => {
        switch (sort) {
          case 'price-asc':
            return Number(a.dataset.price) - Number(b.dataset.price);
          case 'price-desc':
            return Number(b.dataset.price) - Number(a.dataset.price);
          case 'area-desc':
            return Number(b.dataset.floor) - Number(a.dataset.floor);
          default:
            return (
              Number(b.dataset.featured) - Number(a.dataset.featured) ||
              Number(b.dataset.published) - Number(a.dataset.published)
            );
        }
      });
      shown.forEach((card) => grid.appendChild(card));

      // The label is "1 ingatlan" / "3 ingatlan" — swap the leading number.
      count.textContent = template.replace(/^\d+/, String(visible));
      empty.hidden = visible > 0;
      grid.hidden = visible === 0;

      if (pushState) {
        const params = new URLSearchParams();
        for (const [key, value] of data.entries()) {
          if (value && !(key === 'sort' && value === 'featured')) params.set(key, String(value));
        }
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
      }
    };

    readParams();
    apply(false);

    form.addEventListener('change', () => apply(true));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      apply(true);
    });

    document.getElementById('filter-reset')?.addEventListener('click', () => {
      form.reset();
      apply(true);
    });
  }
</script>

<style>
  .crumbs {
    padding: 18px var(--pad-x);
    border-bottom: 1px solid var(--border);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    font-size: var(--fs-micro);
    color: var(--taupe);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--border);
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .head {
    padding: 64px var(--pad-x) 36px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(38px, 4.4vw, 68px);
    line-height: 1.06;
    color: var(--ink);
    margin-bottom: 24px;
  }
  .intro {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-lead);
    color: var(--taupe);
    max-width: 62ch;
  }

  .filters {
    padding: 0 var(--pad-x) 36px;
  }
  .filter-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--border);
  }
  .fcell {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 22px;
    border-right: 1px solid var(--border);
    min-width: 0;
  }
  .fcell:last-child {
    border-right: none;
  }
  .fcell label {
    font-family: var(--sans);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--taupe);
  }
  .fcell select {
    width: 100%;
    appearance: none;
    border: none;
    background: transparent;
    font-size: var(--fs-body);
    font-weight: var(--fw-light);
    color: var(--ink);
    cursor: pointer;
    padding-right: 22px;
    background-image: linear-gradient(45deg, transparent 50%, var(--taupe) 50%),
      linear-gradient(135deg, var(--taupe) 50%, transparent 50%);
    background-position: 100% calc(50% + 2px), calc(100% + 5px) calc(50% + 2px);
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  .filter-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 18px;
  }
  .count {
    font-size: var(--fs-small);
    color: var(--taupe);
    letter-spacing: 0.04em;
  }
  .filter-actions {
    display: flex;
    gap: 16px;
  }
  .reset {
    font-size: var(--fs-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--taupe);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .reset:hover {
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px 36px;
    padding: 12px var(--pad-x) var(--section-y);
  }
  .grid [hidden] {
    display: none;
  }

  .empty {
    text-align: center;
    padding: 80px var(--pad-x) var(--section-y);
  }
  .empty[hidden] {
    display: none;
  }
  .empty-title {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .empty-hint {
    font-size: var(--fs-body);
    color: var(--taupe);
    margin-bottom: 28px;
  }

  @media (max-width: 1000px) {
    .filter-row {
      grid-template-columns: 1fr 1fr;
    }
    .fcell {
      border-bottom: 1px solid var(--border);
    }
    .fcell:nth-child(2n) {
      border-right: none;
    }
    .fcell:last-child {
      grid-column: 1 / -1;
      border-bottom: none;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
  }
  @media (max-width: 700px) {
    .head {
      padding: 36px var(--pad-x-mob) 24px;
    }
    .filters {
      padding: 0 var(--pad-x-mob) 28px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 12px var(--pad-x-mob) var(--section-y-mob);
    }
    .filter-foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
