    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    transition:
      background 0.35s var(--ease-out),
      color 0.35s var(--ease-out);
  }
  .filters-toggle:hover {
    background: var(--ink);
    color: var(--cream);
  }
  .filters-toggle:hover svg circle {
    fill: var(--ink);
  }
  .toggle-badge {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
