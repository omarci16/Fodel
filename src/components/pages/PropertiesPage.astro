    color: var(--cream);
    font-size: 11.5px;
    letter-spacing: 0;
  }
  .filters-toggle:hover .toggle-badge {
    background: var(--cream);
    color: var(--ink);
  }
  .sort {
    display: flex;
    align-items: center;
    gap: 12px;
