---
/**
 * Property search — Stage 6 rewrite.
 *
 * Used to load all active listings into the HTML at build time and filter by
 * toggling `hidden` client-side; that stopped being viable once the
 * inventory can be hundreds of rows instead of six. Filtering, sorting and
 * pagination are now a real Postgres query (searchProperties, which calls
 * the search_properties() function — see supabase/migrations/0004_search.sql)
 * run fresh on every request. The URL is still the single source of truth
 * for what's being viewed — changing a filter is a real navigation with new
 * query params, so a search result is still a plain, shareable, indexable
 * link, exactly as before.
 */
import Base from '~/layouts/Base.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { getTaxonomy, termLabel } from '~/lib/runtime-config';
import { countryLabel as labelCountry } from '~/config/countries';
import { alternatesFor, crumbs } from '~/lib/page';
import {
  activeProperties,
  searchProperties,
  regionsOf,
  countiesOf,
  categoriesOf,
  countriesOf,
  PRICE_BANDS,
  priceBandLabel,
} from '~/lib/properties';
import { breadcrumbSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
  heading?: string;
  intro?: string;
  metaTitle?: string;
  metaDescription?: string;
  fixedCategory?: string;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, heading, intro, metaTitle, metaDescription, fixedCategory, alternates } = Astro.props;
const ui = UI[locale];
const params = Astro.url.searchParams;

// Facet options always reflect the full active inventory, not just the
// current result set, so a search that returns zero results still lets the
// visitor pivot to a different filter instead of hitting a dead end.
const facetSource = await activeProperties();
const regions = regionsOf(facetSource);
const counties = countiesOf(facetSource);
const categories = categoriesOf(facetSource);
const countries = countriesOf(facetSource);
const taxonomy = await getTaxonomy();
const categoryLabel = (key: string) => termLabel(taxonomy.category.find((term) => term.key === key), locale) || key;

const q = params.get('q') ?? '';
const type = fixedCategory ?? params.get('type') ?? '';
const region = params.get('region') ?? '';
// County was supported by search_properties() and searchProperties() from
// Stage 6 but never had a control. Hungarian buyers navigate by county far
// more naturally than by FODEL's larger marketing regions.
const county = params.get('county') ?? '';
const country = params.get('country') ?? '';
const settlement = params.get('settlement') ?? '';
const priceBandId = params.get('price') ?? '';
const beds = params.get('beds') ?? '';
const floorMin = params.get('floor_min') ?? params.get('floor') ?? '';
const floorMax = params.get('floor_max') ?? '';
const plotMin = params.get('plot_min') ?? '';
const plotMax = params.get('plot_max') ?? '';
const bargain = params.get('bargain') === '1';
const sort = (params.get('sort') as 'featured' | 'price-asc' | 'price-desc' | 'area-desc' | 'bargain') || 'featured';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const priceBand = PRICE_BANDS.find((b) => b.id === priceBandId);

const bboxParam = params.get('bbox');
const bbox = bboxParam && bboxParam.split(',').length === 4
  ? (bboxParam.split(',').map(Number) as [number, number, number, number])
  : undefined;

const { properties, total, perPage } = await searchProperties({
  locale,
  q,
  category: type || undefined,
  country: country || undefined,
  region: region || undefined,
  county: county || undefined,
  settlement: settlement || undefined,
  priceMin: priceBand?.min,
  priceMax: priceBand?.max,
  floorMin: floorMin ? Number(floorMin) : undefined,
  floorMax: floorMax ? Number(floorMax) : undefined,
  plotMin: plotMin ? Number(plotMin) : undefined,
  plotMax: plotMax ? Number(plotMax) : undefined,
  bedroomsMin: beds ? Number(beds) : undefined,
  bargain: bargain || undefined,
  bbox,
  sort,
  page,
});
const totalPages = Math.max(1, Math.ceil(total / perPage));
const hu = locale === 'hu';

/** Where this listing lives: a category page (/hu/ingatlanok/haz/) or the
 *  general list. Pagination and filter removal stay on it. */
const currentPath = Astro.url.pathname;
const listPath = path(locale, 'properties');

/** Carries the current search onto the map, so switching view keeps the filters. */
const mapHref = (() => {
  const next = new URLSearchParams(params);
  next.delete('page');
  next.delete('bbox'); // the map sets its own bounds
  if (fixedCategory) next.set('type', fixedCategory);
  const query = next.toString();
  return query ? `${path(locale, 'map')}?${query}` : path(locale, 'map');
})();

const title = heading ?? (hu ? 'Ingatlanok' : 'Ons aanbod');
const defaultDescription = hu
  ? `${total} magyar ingatlan eladó — házak, tanyák, kúriák, nyaralók és birtokok. Szűrjön típus, régió és ár szerint.`
  : `${total} woningen in Hongarije — huizen, boerderijen, landhuizen en vakantiehuizen. Filter op type, regio en prijs.`;

const trail = crumbs(locale, [{ name: title, url: currentPath }]);

/** Rebuilds the current query string with one field overridden — used by
 *  pagination and by the removable filter chips. Removing the category of a
 *  category page leads to the general list; everything else stays put. */
function withParam(key: string, value: string): string {
  const next = new URLSearchParams(params);
  if (value) next.set(key, value);
  else next.delete(key);
  if (key !== 'page') next.delete('page');
  const base = fixedCategory && key === 'type' ? listPath : currentPath;
  const query = next.toString();
  return query ? `${base}?${query}` : base;
}

/** The filters in force, each with a link that removes just that one. */
const active = [
  q && { key: 'q', label: `„${q}”` },
  type && { key: 'type', label: categoryLabel(type) },
  country && { key: 'country', label: labelCountry(country, locale) },
  region && { key: 'region', label: region },
  county && { key: 'county', label: county },
  settlement && { key: 'settlement', label: settlement },
  priceBand && { key: 'price', label: priceBandLabel(priceBand) },
  beds && { key: 'beds', label: `${beds}+ ${hu ? 'szoba' : 'slaapkamers'}` },
  floorMin && { key: 'floor_min', label: `${ui.filters.area} ≥ ${floorMin} m²` },
  floorMax && { key: 'floor_max', label: `${ui.filters.area} ≤ ${floorMax} m²` },
  plotMin && { key: 'plot_min', label: `${ui.filters.land} ≥ ${plotMin} m²` },
  plotMax && { key: 'plot_max', label: `${ui.filters.land} ≤ ${plotMax} m²` },
  bargain && { key: 'bargain', label: ui.filters.bargain },
  bbox && { key: 'bbox', label: hu ? 'Térképterület' : 'Kaartgebied' },
].filter(Boolean) as { key: string; label: string }[];

/** A category page's own category is where the visitor is, not a filter
 *  they chose — it isn't counted, and isn't offered for removal. */
const chips = fixedCategory ? active.filter((f) => f.key !== 'type') : active;
const clearHref = currentPath;

// Collapsible groups open when they hold a value, so nothing in force is hidden.
const locationOpen = !!(country || region || county || settlement);
const floorOpen = !!(floorMin || floorMax);
const plotOpen = !!(plotMin || plotMax);

/** Numbered pagination: first, last, and a window around the current page. */
const pageItems = (() => {
  const set = new Set([1, totalPages, page - 1, page, page + 1].filter((n) => n >= 1 && n <= totalPages));
  const sorted = [...set].sort((a, b) => a - b);
  const out: (number | 'gap')[] = [];
  sorted.forEach((n, i) => {
    if (i > 0 && n - sorted[i - 1] > 1) out.push('gap');
    out.push(n);
  });
  return out;
})();

const countWord = ui.filters.results(total).replace(String(total), '').trim();
const labels = {
  filters: hu ? 'Szűrés' : 'Filters',
  openFilters: hu ? 'Szűrők' : 'Filters',
  location: hu ? 'Elhelyezkedés' : 'Locatie',
  keyword: hu ? 'Szabad szavas keresés' : 'Vrij zoeken',
  min: 'min.',
  max: 'max.',
  prev: hu ? 'Előző oldal' : 'Vorige pagina',
  next: hu ? 'Következő oldal' : 'Volgende pagina',
  pages: hu ? 'Lapozás' : 'Paginering',
  remove: hu ? 'Szűrő eltávolítása' : 'Filter verwijderen',
  apply: ui.filters.search,
};
---

<Base
  locale={locale}
  title={metaTitle ?? title}
  description={metaDescription ?? intro ?? defaultDescription}
  alternates={alternates ?? alternatesFor('properties')}
  schema={[breadcrumbSchema(trail)]}
>
  <header class="head">
    <nav class="crumbs" aria-label={ui.a11y.breadcrumb}>
      <ol>
        {
          trail.map((c, i) => (
            <li>
              {i < trail.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="head-row">
      <h1>
        <span class="line"><span>{title}</span></span>
      </h1>
      {intro && <p class="intro">{intro}</p>}
    </div>
  </header>

  <div class="layout" id="listing">
    {/* ── Sidebar: the whole filter form. On narrow screens the same element
        becomes a full-height drawer. ── */}
    <aside class="sidebar" id="filter-panel" aria-labelledby="filter-title">
      <form
        class="filters"
        id="filters"
        method="GET"
        action={listPath}
        data-fixed-type={fixedCategory}
        data-fixed-path={fixedCategory ? currentPath : undefined}
      >
        <div class="side-head">
          <h2 class="side-title" id="filter-title">
            {labels.filters}
            {chips.length > 0 && <span class="side-badge num">{chips.length}</span>}
          </h2>
          {chips.length > 0 && <a class="side-reset" href={clearHref}>{ui.filters.reset}</a>}
          <button type="button" class="side-close" data-filters-close aria-label={ui.close}>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </button>
        </div>

        <div class="side-body" id="filter-body">
          {/* Keyword */}
          <div class="field-search">
            <svg class="search-icon" width="18" height="18" viewBox="0 0 22 22" fill="none" aria-hidden="true">
              <circle cx="9.5" cy="9.5" r="7.25" stroke="currentColor" stroke-width="1.3" />
              <path d="M15 15l5.5 5.5" stroke="currentColor" stroke-width="1.3" />
            </svg>
            <input
              type="search"
              name="q"
              value={q}
              placeholder={hu ? 'Település, jellemző, azonosító…' : 'Plaats, kenmerk, referentie…'}
              aria-label={labels.keyword}
              enterkeyhint="search"
            />
          </div>

          {/* Type */}
          <fieldset class="group">
            <legend class="group-title">{ui.filters.type}</legend>
            <div class="chips">
              <label class="opt">
                <input type="radio" name="type" value="" checked={!type} data-auto />
                <span>{ui.filters.all}</span>
              </label>
              {
                categories.map((k) => (
                  <label class="opt">
                    <input type="radio" name="type" value={k} checked={k === type} data-auto />
                    <span>{categoryLabel(k)}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          {/* Price */}
          <fieldset class="group">
            <legend class="group-title">{ui.filters.price}</legend>
            <div class="chips">
              <label class="opt">
                <input type="radio" name="price" value="" checked={!priceBandId} data-auto />
                <span>{ui.filters.all}</span>
              </label>
              {
                PRICE_BANDS.map((b) => (
                  <label class="opt">
                    <input type="radio" name="price" value={b.id} checked={b.id === priceBandId} data-auto />
                    <span class="num">{priceBandLabel(b)}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          {/* Bedrooms — one row, one choice */}
          <fieldset class="group">
            <legend class="group-title">{ui.filters.beds}</legend>
            <div class="segmented">
              <label class="seg">
                <input type="radio" name="beds" value="" checked={!beds} data-auto />
                <span>{ui.filters.all}</span>
              </label>
              {
                [2, 3, 4, 5].map((n) => (
                  <label class="seg">
                    <input type="radio" name="beds" value={String(n)} checked={String(n) === beds} data-auto />
                    <span class="num">{n}+</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          {/* Location */}
          <details class="group group-fold" open={locationOpen}>
            <summary class="group-title">
              <span>{labels.location}</span>
              <span class="fold-icon" aria-hidden="true"></span>
            </summary>
            <div class="fold-body">
              {
                countries.length > 1 && (
                  <div class="field">
                    <label for="f-country">{ui.filters.country}</label>
                    <select id="f-country" name="country" data-auto>
                      <option value="">{hu ? 'Minden ország' : 'Alle landen'}</option>
                      {countries.map((code) => (
                        <option value={code} selected={code === country}>{labelCountry(code, locale)}</option>
                      ))}
                    </select>
                  </div>
                )
              }
              <div class="field">
                <label for="f-region">{ui.filters.region}</label>
                <select id="f-region" name="region" data-auto>
                  <option value="">{ui.filters.entireCountry}</option>
                  {regions.map((r) => <option value={r} selected={r === region}>{r}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="f-county">{ui.filters.county}</label>
                <select id="f-county" name="county" data-auto>
                  <option value="">{ui.filters.all}</option>
                  {counties.map((c) => <option value={c} selected={c === county}>{c}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="f-settlement">{ui.filters.settlement}</label>
                <input id="f-settlement" name="settlement" value={settlement} autocomplete="off" />
              </div>
            </div>
          </details>

          {/* Floor area */}
          <details class="group group-fold" open={floorOpen}>
            <summary class="group-title">
              <span>{ui.filters.area}</span>
              <span class="fold-icon" aria-hidden="true"></span>
            </summary>
            <div class="fold-body">
              <div class="range">
                <label class="range-field">
                  <span class="sr-only">{ui.filters.areaFrom}</span>
                  <input type="number" inputmode="numeric" min="0" step="10" name="floor_min" value={floorMin} placeholder={labels.min} />
                  <span class="unit" aria-hidden="true">m²</span>
                </label>
                <span class="range-dash" aria-hidden="true"></span>
                <label class="range-field">
                  <span class="sr-only">{ui.filters.areaTo}</span>
                  <input type="number" inputmode="numeric" min="0" step="10" name="floor_max" value={floorMax} placeholder={labels.max} />
                  <span class="unit" aria-hidden="true">m²</span>
                </label>
              </div>
            </div>
          </details>

          {/* Plot */}
          <details class="group group-fold" open={plotOpen}>
            <summary class="group-title">
              <span>{ui.filters.land}</span>
              <span class="fold-icon" aria-hidden="true"></span>
            </summary>
            <div class="fold-body">
              <div class="range">
                <label class="range-field">
                  <span class="sr-only">{ui.filters.landFrom}</span>
                  <input type="number" inputmode="numeric" min="0" step="100" name="plot_min" value={plotMin} placeholder={labels.min} />
                  <span class="unit" aria-hidden="true">m²</span>
                </label>
                <span class="range-dash" aria-hidden="true"></span>
                <label class="range-field">
                  <span class="sr-only">{ui.filters.landTo}</span>
                  <input type="number" inputmode="numeric" min="0" step="100" name="plot_max" value={plotMax} placeholder={labels.max} />
                  <span class="unit" aria-hidden="true">m²</span>
                </label>
              </div>
            </div>
          </details>

          {/* Bargains */}
          <label class="switch-row">
            <span>{ui.filters.bargain}</span>
            <input type="checkbox" role="switch" name="bargain" value="1" checked={bargain} data-auto />
            <span class="switch" aria-hidden="true"></span>
          </label>

          {
            bbox && (
              <>
                {/* Preserved across a filter change: without this the hidden bbox is
                    dropped the moment someone touches a filter, and "search this
                    area" silently stops applying. */}
                <input type="hidden" name="bbox" value={bboxParam} />
                <p class="area-note">
                  {ui.filters.areaFiltered} ·{' '}
                  <a href={withParam('bbox', '')}>{hu ? 'Szűrés törlése' : 'Filter wissen'}</a>
                </p>
              </>
            )
          }
        </div>

        <div class="side-foot">
          <button type="submit" class="apply">
            <span>{labels.apply}</span>
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
              <path d="M0 5h16.5M12.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
            </svg>
          </button>
        </div>
      </form>
    </aside>
    <div class="scrim" data-filters-close aria-hidden="true"></div>

    {/* ── Results ── */}
    <section class="results" aria-labelledby="result-count">
      <div class="toolbar">
        <div class="toolbar-top">
          <p class="count" id="result-count" role="status">
            <span class="count-n num">{total}</span>
            <span class="count-word">{countWord}</span>
          </p>

          <div class="toolbar-end">
            <button type="button" class="filters-toggle" data-filters-open aria-controls="filter-panel" aria-expanded="false">
              <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
                <path d="M0 2h16M0 6h16M0 10h16" stroke="currentColor" stroke-width="1.1" />
                <circle cx="5" cy="2" r="1.6" fill="var(--cream)" stroke="currentColor" stroke-width="1.1" />
                <circle cx="11" cy="6" r="1.6" fill="var(--cream)" stroke="currentColor" stroke-width="1.1" />
                <circle cx="7" cy="10" r="1.6" fill="var(--cream)" stroke="currentColor" stroke-width="1.1" />
              </svg>
              <span>{labels.openFilters}</span>
              {chips.length > 0 && <span class="toggle-badge num">{chips.length}</span>}
            </button>

            <label class="sort">
              <span class="sort-label">{ui.filters.sort}</span>
              <select name="sort" form="filters" data-auto>
                <option value="featured" selected={sort === 'featured'}>{ui.filters.sortFeatured}</option>
                <option value="price-asc" selected={sort === 'price-asc'}>{ui.filters.sortPriceAsc}</option>
                <option value="price-desc" selected={sort === 'price-desc'}>{ui.filters.sortPriceDesc}</option>
                <option value="area-desc" selected={sort === 'area-desc'}>{ui.filters.sortAreaDesc}</option>
                <option value="bargain" selected={sort === 'bargain'}>{ui.filters.bargain}</option>
              </select>
            </label>

            <a href={mapHref} class="map-link" aria-label={ui.filters.viewMap}>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M1 3.5l4.5-2 5 2 4.5-2v11l-4.5 2-5-2-4.5 2z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
                <path d="M5.5 1.5v11M10.5 3.5v11" stroke="currentColor" stroke-width="1.1" />
              </svg>
              <span>{ui.filters.viewMap}</span>
            </a>
          </div>
        </div>

        {
          chips.length > 0 && (
            <ul class="active" aria-label={hu ? 'Aktív szűrők' : 'Actieve filters'}>
              {chips.map((f) => (
                <li>
                  <a href={withParam(f.key, '')} aria-label={`${labels.remove}: ${f.label}`}>
                    <span>{f.label}</span>
                    <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                      <path d="M1.5 1.5l7 7M8.5 1.5l-7 7" stroke="currentColor" stroke-width="1.1" />
                    </svg>
                  </a>
                </li>
              ))}
              {chips.length > 1 && (
                <li class="active-clear">
                  <a href={clearHref}>{ui.filters.reset}</a>
                </li>
              )}
            </ul>
          )
        }
        <span class="loading-bar" aria-hidden="true"></span>
      </div>

      {
        properties.length > 0 ? (
          <div class="grid">
            {properties.map((p, i) => (
              <PropertyCard
                property={p}
                locale={locale}
                eager={i < 2}
                reveal={false}
                sizes="(max-width: 700px) 100vw, (max-width: 1100px) 45vw, (max-width: 1600px) 34vw, 26vw"
              />
            ))}
          </div>
        ) : (
          <div class="empty">
            <span class="empty-rule" aria-hidden="true"></span>
            <p class="empty-title">{ui.filters.noResults}</p>
            <p class="empty-hint">{ui.filters.noResultsHint}</p>
            <div class="empty-actions">
              <Button variant="dark" href={path(locale, 'searchRequest')}>{ui.cta.searchRequest}</Button>
              {chips.length > 0 && <Button variant="text" href={clearHref}>{ui.filters.reset}</Button>}
            </div>
          </div>
        )
      }

      {
        totalPages > 1 && (
          <nav class="pagination" aria-label={labels.pages}>
            {page > 1 ? (
              <a class="page-step" href={withParam('page', String(page - 1))} aria-label={labels.prev}>
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                  <path d="M18 5H1.5M5.5 1l-4 4 4 4" stroke="currentColor" stroke-width="1.1" />
                </svg>
              </a>
            ) : (
              <span class="page-step" aria-hidden="true" data-disabled />
            )}
            <ol>
              {pageItems.map((item) =>
                item === 'gap' ? (
                  <li class="page-gap" aria-hidden="true">…</li>
                ) : (
                  <li>
                    {item === page ? (
                      <span class="page-num num" aria-current="page">{item}</span>
                    ) : (
                      <a class="page-num num" href={withParam('page', String(item))}>{item}</a>
                    )}
                  </li>
                )
              )}
            </ol>
            {page < totalPages ? (
              <a class="page-step" href={withParam('page', String(page + 1))} aria-label={labels.next}>
                <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true">
                  <path d="M0 5h16.5M12.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
                </svg>
              </a>
            ) : (
              <span class="page-step" aria-hidden="true" data-disabled />
            )}
          </nav>
        )
      }
    </section>
  </div>
</Base>

<script>
  const form = document.getElementById('filters') as HTMLFormElement | null;
  const panel = document.getElementById('filter-panel');
  const body = document.getElementById('filter-body');
  const listing = document.getElementById('listing');
  const toggle = document.querySelector<HTMLButtonElement>('[data-filters-open]');
  const drawer = window.matchMedia('(max-width: 1100px)');
  const KEY = 'fodel:listing';

  if (form && panel && listing) {
    const fixedType = form.dataset.fixedType;
    const fixedPath = form.dataset.fixedPath;
    let filterNavigation = false;

    /* ── Leaving: remember where the visitor was ──
       Every filter change is a real navigation (the URL is the source of
       truth). Remember whether they were already down among the results and
       how far the panel was scrolled, so the next page picks up there
       instead of throwing them back to the top. */
    const remember = () => {
      filterNavigation = true;
      const pastHead = window.scrollY > listing.offsetTop - 140;
      try {
        sessionStorage.setItem(KEY, JSON.stringify({ results: pastHead, panel: body?.scrollTop ?? 0 }));
      } catch {
        /* storage unavailable — the page simply opens at the top */
      }
      listing.setAttribute('data-loading', '');
    };

    // Same listing, new results: skip the page-level slide transition.
    window.addEventListener('pageswap', (e: Event) => {
      const transition = (e as Event & { viewTransition?: { skipTransition(): void } }).viewTransition;
      if (filterNavigation && transition) transition.skipTransition();
    });

    /* ── Arriving ── */
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) ?? 'null');
      sessionStorage.removeItem(KEY);
      if (saved) {
        if (saved.results) {
          const nav = document.getElementById('site-nav')?.offsetHeight ?? 0;
          window.scrollTo({ top: listing.offsetTop - nav - 24, behavior: 'instant' as ScrollBehavior });
        }
        if (body && saved.panel) body.scrollTop = saved.panel;
      }
    } catch {
      /* nothing saved, or storage unavailable */
    }

    /* ── Clean, shareable URLs ──
       Empty fields and the default sort are left out of the query. On a
       category page, keeping its own category keeps the visitor on that
       page, rather than sending them to the general list with ?type=. */
    let stayOnCategory = false;
    form.addEventListener('submit', () => {
      const chosen = form.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value ?? '';
      stayOnCategory = !!(fixedType && fixedPath && chosen === fixedType);
      form.action = stayOnCategory && fixedPath ? fixedPath : form.getAttribute('action') ?? '';
      remember();
    });
    form.addEventListener('formdata', (e) => {
      const data = e.formData;
      for (const [name, value] of [...data.entries()]) {
        if (value === '') data.delete(name);
      }
      if (data.get('sort') === 'featured') data.delete('sort');
      if (stayOnCategory) data.delete('type');
    });

    /* ── Applying ──
       Beside the results, a chosen chip, switch or menu applies at once.
       Typed values (keyword, settlement, areas) apply on Enter or with the
       button, which fills in to say something is waiting. In the drawer
       nothing applies until the visitor asks. The sort menu sits in the
       toolbar, outside the drawer, and always applies at once. */
    const apply = () => form.requestSubmit();
    form.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if (target.matches('[data-auto]') && !drawer.matches) apply();
      else form.setAttribute('data-dirty', '');
    });
    form.addEventListener('input', (e) => {
      if ((e.target as HTMLElement).matches('input[type="search"], input[type="number"], input:not([type])')) {
        form.setAttribute('data-dirty', '');
      }
    });
    document.querySelector<HTMLSelectElement>('select[form="filters"]')?.addEventListener('change', apply);

    // Links that re-query the same listing (chips, paging, reset) keep the place too.
    listing.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest(
        '.active a, .pagination a, .side-reset, .empty-actions a, .area-note a'
      );
      if (link) remember();
    });

    /* ── Drawer (narrow screens) ── */
    const focusables = () =>
      Array.from(panel.querySelectorAll<HTMLElement>('a[href], button, input, select, summary')).filter(
        (el) => !el.hasAttribute('disabled') && el.getClientRects().length > 0 && !(el as HTMLInputElement).type?.match(/^(radio|checkbox)$/)
      );
    const setOpen = (open: boolean) => {
      panel.toggleAttribute('data-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      panel.inert = drawer.matches && !open;
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) panel.querySelector<HTMLElement>('.side-close')?.focus();
      else if (drawer.matches) toggle?.focus();
    };
    const sync = () => {
      panel.removeAttribute('data-open');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      panel.inert = drawer.matches;
      if (drawer.matches) {
        panel.setAttribute('role', 'dialog');
        panel.setAttribute('aria-modal', 'true');
      } else {
        panel.removeAttribute('role');
        panel.removeAttribute('aria-modal');
      }
    };
    sync();
    drawer.addEventListener('change', sync);
    toggle?.addEventListener('click', () => setOpen(true));
    document.querySelectorAll('[data-filters-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (!panel.hasAttribute('data-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Back from a property page out of the back/forward cache: undo the
    // loading state and any open drawer.
    window.addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      filterNavigation = false;
      listing.removeAttribute('data-loading');
      form.removeAttribute('data-dirty');
      sync();
    });
  }
</script>

<style>
  /* ══ Head ═════════════════════════════════════════════════════════════ */
  .head {
    padding: 36px var(--pad-x) 44px;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    list-style: none;
    margin-bottom: 40px;
    font-size: var(--fs-micro);
    letter-spacing: 0.06em;
    line-height: 1.5;
