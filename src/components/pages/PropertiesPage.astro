---
/**
 * Property search — Stage 6 rewrite.
 *
 * Used to load all active listings into the HTML at build time and filter by
 * toggling `hidden` client-side; that stopped being viable once the
 * inventory can be hundreds of rows instead of six. Filtering, sorting and
 * pagination are now a real Postgres query (searchProperties, which calls
 * the search_properties() function — see supabase/migrations/0004_search.sql)
 * run fresh on every request. The URL is still the single source of truth
 * for what's being viewed — changing a filter is a real navigation with new
 * query params, so a search result is still a plain, shareable, indexable
 * link, exactly as before.
 */
import Base from '~/layouts/Base.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import GoldRule from '~/components/GoldRule.astro';
import Button from '~/components/Button.astro';
import PropertyCard from '~/components/PropertyCard.astro';
import { UI, CATEGORIES, path, type Locale, type CategoryKey } from '~/i18n/ui';
import { alternatesFor, crumbs } from '~/lib/page';
import {
  activeProperties,
  searchProperties,
  regionsOf,
  categoriesOf,
  PRICE_BANDS,
  priceBandLabel,
} from '~/lib/properties';
import { breadcrumbSchema } from '~/lib/seo';

interface Props {
  locale: Locale;
  heading?: string;
  intro?: string;
  metaTitle?: string;
  metaDescription?: string;
}

const { locale, heading, intro, metaTitle, metaDescription } = Astro.props;
const ui = UI[locale];
const params = Astro.url.searchParams;

// Facet options always reflect the full active inventory, not just the
// current result set, so a search that returns zero results still lets the
// visitor pivot to a different filter instead of hitting a dead end.
const facetSource = await activeProperties();
const regions = regionsOf(facetSource);
const categories = categoriesOf(facetSource);

const q = params.get('q') ?? '';
const type = params.get('type') ?? '';
const region = params.get('region') ?? '';
const priceBandId = params.get('price') ?? '';
const beds = params.get('beds') ?? '';
const sort = (params.get('sort') as 'featured' | 'price-asc' | 'price-desc' | 'area-desc') || 'featured';
const page = Math.max(1, Number(params.get('page') ?? '1') || 1);

const priceBand = PRICE_BANDS.find((b) => b.id === priceBandId);

const bboxParam = params.get('bbox');
const bbox = bboxParam && bboxParam.split(',').length === 4
  ? (bboxParam.split(',').map(Number) as [number, number, number, number])
  : undefined;

const { properties, total, perPage } = await searchProperties({
  locale,
  q,
  category: type || undefined,
  region: region || undefined,
  priceMin: priceBand?.min,
  priceMax: priceBand?.max,
  bedroomsMin: beds ? Number(beds) : undefined,
  bbox,
  sort,
  page,
});
const totalPages = Math.max(1, Math.ceil(total / perPage));

const title = heading ?? (locale === 'hu' ? 'Ingatlanok' : 'Ons aanbod');
const defaultDescription =
  locale === 'hu'
    ? `${total} magyar ingatlan eladó — házak, tanyák, kúriák, nyaralók és birtokok. Szűrjön típus, régió és ár szerint.`
    : `${total} woningen in Hongarije — huizen, boerderijen, landhuizen en vakantiehuizen. Filter op type, regio en prijs.`;

const trail = crumbs(locale, [{ name: title, url: path(locale, 'properties') }]);

/** Rebuilds the current query string with one field overridden — used by pagination links. */
function withParam(key: string, value: string): string {
  const next = new URLSearchParams(params);
  if (value) next.set(key, value);
  else next.delete(key);
  if (key !== 'page') next.delete('page');
  const query = next.toString();
  return query ? `${path(locale, 'properties')}?${query}` : path(locale, 'properties');
}
---

<Base
  locale={locale}
  title={metaTitle ?? title}
  description={metaDescription ?? intro ?? defaultDescription}
  alternates={alternatesFor('properties')}
  schema={[breadcrumbSchema(trail)]}
>
  <nav class="crumbs" aria-label={ui.a11y.breadcrumb}>
    <ol>
      {
        trail.map((c, i) => (
          <li>
            {i < trail.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
          </li>
        ))
      }
    </ol>
  </nav>

  <header class="head">
    <Eyebrow space="12px">{ui.filters.title}</Eyebrow>
    <h1>{title}</h1>
    <GoldRule space="24px" />
    {intro && <p class="intro">{intro}</p>}
  </header>

  <form class="filters" id="filters" method="GET" action={path(locale, 'properties')}>
    <div class="search-row">
      <input
        type="search"
        name="q"
        value={q}
        placeholder={locale === 'hu' ? 'Keresés — pl. Balaton, présház, panoráma…' : 'Zoeken — bijv. Balaton, wijnkelder, uitzicht…'}
        aria-label={locale === 'hu' ? 'Szabad szavas keresés' : 'Vrij zoeken'}
      />
    </div>

    <div class="filter-row">
      <div class="fcell">
        <label for="f-type">{ui.filters.type}</label>
        <select id="f-type" name="type">
          <option value="">{ui.filters.all}</option>
          {categories.map((k) => <option value={k} selected={k === type}>{CATEGORIES[k][locale].label}</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-region">{ui.filters.region}</label>
        <select id="f-region" name="region">
          <option value="">{ui.filters.all}</option>
          {regions.map((r) => <option value={r} selected={r === region}>{r}</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-price">{ui.filters.price}</label>
        <select id="f-price" name="price">
          <option value="">{ui.filters.all}</option>
          {PRICE_BANDS.map((b) => <option value={b.id} selected={b.id === priceBandId}>{priceBandLabel(b)}</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-beds">{ui.filters.beds}</label>
        <select id="f-beds" name="beds">
          <option value="">{ui.filters.any}</option>
          {[2, 3, 4, 5].map((n) => <option value={String(n)} selected={String(n) === beds}>{n}+</option>)}
        </select>
      </div>

      <div class="fcell">
        <label for="f-sort">{ui.filters.sort}</label>
        <select id="f-sort" name="sort">
          <option value="featured" selected={sort === 'featured'}>{ui.filters.sortFeatured}</option>
          <option value="price-asc" selected={sort === 'price-asc'}>{ui.filters.sortPriceAsc}</option>
          <option value="price-desc" selected={sort === 'price-desc'}>{ui.filters.sortPriceDesc}</option>
          <option value="area-desc" selected={sort === 'area-desc'}>{ui.filters.sortAreaDesc}</option>
        </select>
      </div>
    </div>

    <div class="filter-foot">
      <p class="count" role="status">{ui.filters.results(total)}</p>
      <div class="filter-actions">
        <a href={path(locale, 'properties')} class="reset">{ui.filters.reset}</a>
        <button type="submit" class="reset submit-btn">{ui.filters.search}</button>
      </div>
    </div>
  </form>

  {
    properties.length > 0 ? (
      <div class="grid">
        {properties.map((p, i) => <PropertyCard property={p} locale={locale} eager={i < 3} />)}
      </div>
    ) : (
      <div class="empty">
        <GoldRule center space="28px" />
        <p class="empty-title">{ui.filters.noResults}</p>
        <p class="empty-hint">{ui.filters.noResultsHint}</p>
        <Button variant="dark" href={path(locale, 'searchRequest')}>{ui.cta.searchRequest}</Button>
      </div>
    )
  }

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label={locale === 'hu' ? 'Lapozás' : 'Paginering'}>
        {page > 1 && <a href={withParam('page', String(page - 1))}>&larr; {locale === 'hu' ? 'Előző' : 'Vorige'}</a>}
        <span class="page-of">
          {locale === 'hu' ? `${page}. oldal / ${totalPages}` : `Pagina ${page} van ${totalPages}`}
        </span>
        {page < totalPages && <a href={withParam('page', String(page + 1))}>{locale === 'hu' ? 'Következő' : 'Volgende'} &rarr;</a>}
      </nav>
    )
  }
</Base>

<script>
  // Filters now drive a real server-side search, so a change is a real
  // navigation — this just removes the extra click on "Keresés" for anyone
  // with JS, while the <noscript>-safe submit button covers everyone else.
  const form = document.getElementById('filters');
  if (form instanceof HTMLFormElement) {
    form.querySelectorAll('select').forEach((select) => {
      select.addEventListener('change', () => form.submit());
    });
  }
</script>

<style>
  .crumbs {
    padding: 18px var(--pad-x);
    border-bottom: 1px solid var(--border);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    font-size: var(--fs-micro);
    color: var(--taupe);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--border);
  }
  .crumbs [aria-current] {
    color: var(--ink);
  }

  .head {
    padding: 64px var(--pad-x) 36px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: clamp(38px, 4.4vw, 68px);
    line-height: 1.06;
    color: var(--ink);
    margin-bottom: 24px;
  }
  .intro {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-lead);
    color: var(--taupe);
    max-width: 62ch;
  }

  .filters {
    padding: 0 var(--pad-x) 36px;
  }
  .search-row {
    margin-bottom: 14px;
  }
  .search-row input {
    width: 100%;
    border: 1px solid var(--border);
    background: transparent;
    padding: 14px 16px;
    font-size: var(--fs-body);
    font-weight: var(--fw-light);
    color: var(--ink);
  }
  .search-row input:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  .filter-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--border);
  }
  .fcell {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 22px;
    border-right: 1px solid var(--border);
    min-width: 0;
  }
  .fcell:last-child {
    border-right: none;
  }
  .fcell label {
    font-family: var(--sans);
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--taupe);
  }
  .fcell select {
    width: 100%;
    appearance: none;
    border: none;
    background: transparent;
    font-size: var(--fs-body);
    font-weight: var(--fw-light);
    color: var(--ink);
    cursor: pointer;
    padding-right: 22px;
    background-image: linear-gradient(45deg, transparent 50%, var(--taupe) 50%),
      linear-gradient(135deg, var(--taupe) 50%, transparent 50%);
    background-position: 100% calc(50% + 2px), calc(100% + 5px) calc(50% + 2px);
    background-size: 5px 5px;
    background-repeat: no-repeat;
  }

  .filter-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 18px;
  }
  .count {
    font-size: var(--fs-small);
    color: var(--taupe);
    letter-spacing: 0.04em;
  }
  .filter-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .reset {
    font-size: var(--fs-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--taupe);
    text-decoration: underline;
    text-underline-offset: 4px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .reset:hover {
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 44px 36px;
    padding: 12px var(--pad-x) 60px;
  }

  .empty {
    text-align: center;
    padding: 80px var(--pad-x) var(--section-y);
  }
  .empty-title {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .empty-hint {
    font-size: var(--fs-body);
    color: var(--taupe);
    margin-bottom: 28px;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 0 var(--pad-x) var(--section-y);
    font-size: var(--fs-small);
  }
  .pagination a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .page-of {
    color: var(--taupe);
  }

  @media (max-width: 1000px) {
    .filter-row {
      grid-template-columns: 1fr 1fr;
    }
    .fcell {
      border-bottom: 1px solid var(--border);
    }
    .fcell:nth-child(2n) {
      border-right: none;
    }
    .fcell:last-child {
      grid-column: 1 / -1;
      border-bottom: none;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px 24px;
    }
  }
  @media (max-width: 700px) {
    .head {
      padding: 36px var(--pad-x-mob) 24px;
    }
    .filters {
      padding: 0 var(--pad-x-mob) 28px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 12px var(--pad-x-mob) var(--section-y-mob);
    }
    .filter-foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
