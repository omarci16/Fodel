    animation: fx-rise 1.3s var(--ease-out) 0.25s both;
  }
  .intro {
    max-width: 48ch;
    padding-bottom: 0.4em;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    animation: fx-fade-up 1.2s var(--ease-out) 0.5s both;
  }

  /* ══ Layout ═══════════════════════════════════════════════════════════ */
  .layout {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    padding: 0 var(--pad-x) var(--section-y);
  }

  /* ══ Sidebar ══════════════════════════════════════════════════════════ */
  /* It only sticks once the page has scrolled, by which point the nav has
     settled at its compact 72px — hence 72 + 20, not --nav-h. */
  .sidebar {
    position: sticky;
    top: 92px;
    animation: fx-fade-up 1.2s var(--ease-out) 0.35s both;
  }
  .filters {
    display: flex;
    flex-direction: column;
