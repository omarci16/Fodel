---
/**
 * Sticky nav, ported from the prototype.
 *
 * Fixed here: links are anchors, so they are crawlable and openable in a new
 * tab; the language switcher actually switches (in the prototype it rendered
 * HU|EN|NL spans with a pointer cursor and no click handler); the mobile
 * drawer reports aria-expanded, traps focus, and is removed from the tab
 * order when closed.
 *
 * 1.4: the bar sits on the page grid (--pad-x, same as every section below
 * it), links roll on hover, the login is a quiet text link beside the one
 * filled button, and the bottom hairline doubles as a reading-progress line.
 * The mobile drawer is a full-height sheet with large, numbered links.
 */
import Logo from './Logo.astro';
import Button from './Button.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { UI, path, type Locale } from '~/i18n/ui';
import { getCompany } from '~/lib/runtime-config';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates = {} } = Astro.props;
const ui = UI[locale];
const current = Astro.url.pathname;
const COMPANY = await getCompany();

const links = [
  { key: 'properties', label: ui.nav.properties },
  { key: 'sellers', label: ui.nav.sellers },
  { key: 'buyers', label: ui.nav.buyers },
  { key: 'about', label: ui.nav.about },
  { key: 'blog', label: ui.nav.blog },
] as const;

const isCurrent = (href: string) =>
  href === `/${locale}/` ? current === href : current.startsWith(href);
---

<nav class="nav" id="site-nav" aria-label={ui.a11y.mainNav}>
  <div class="nav-inner">
    <Logo locale={locale} href={`/${locale}/`} />

    <ul class="nav-links">
      {
        links.map((l) => {
          const href = path(locale, l.key);
          return (
            <li>
              <a
                class="nav-link"
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
              >
                <span class="roll">
                  <span>{l.label}</span>
                  <span aria-hidden="true">{l.label}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="nav-end">
      <LanguageSwitcher locale={locale} alternates={alternates} align="right" />

      <a class="nav-login" href="/portal/login" rel="nofollow" aria-label={ui.cta.login}>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="7" cy="4.5" r="2.75" stroke="currentColor" stroke-width="1.1" />
          <path d="M1.75 13c.6-2.7 2.7-4.25 5.25-4.25S11.65 10.3 12.25 13" stroke="currentColor" stroke-width="1.1" />
        </svg>
        <span>{ui.cta.login}</span>
      </a>
      <Button variant="dark" href={path(locale, 'contact')} class="nav-cta">
        {ui.cta.contact}
      </Button>
    </div>

    <div class="nav-mobile-only">
      <LanguageSwitcher locale={locale} alternates={alternates} align="right" />

      <button
        class="burger"
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label={ui.menu}
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <span class="nav-progress" aria-hidden="true"></span>
</nav>

<div class="drawer" id="nav-drawer" inert>
  <div class="drawer-clip">
    <div class="drawer-panel">
      <ul class="drawer-links">
        {
          links.map((l, i) => {
            const href = path(locale, l.key);
            return (
              <li style={`--i:${i}`}>
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  <span class="drawer-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  {l.label}
                </a>
              </li>
            );
          })
        }
        <li style={`--i:${links.length}`}>
          <a href={path(locale, 'contact')} aria-current={isCurrent(path(locale, 'contact')) ? 'page' : undefined}>
            <span class="drawer-num" aria-hidden="true">{String(links.length + 1).padStart(2, '0')}</span>
            {ui.nav.contact}
          </a>
        </li>
      </ul>

      <div class="drawer-foot" style={`--i:${links.length + 1}`}>
        <Button variant="dark" href={path(locale, 'contact')} block>{ui.cta.callback}</Button>
        <Button variant="outline" href="/portal/login" rel="nofollow" block>{ui.cta.login}</Button>
        <p class="drawer-contact">
          {COMPANY.phones.filter((p) => p.public).slice(0, 2).map((p) => <a href={p.href}>{p.display}</a>)}
          <a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const nav = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const drawer = document.getElementById('nav-drawer')!;

  // Shrink on scroll, as the prototype did at 120px — and feed the hairline
  // along the bottom edge, which fills as the page is read.
  let ticking = false;
  const onScroll = () => {
    ticking = false;
    const y = window.scrollY;
    nav.toggleAttribute('data-scrolled', y > 120);
    const max = document.documentElement.scrollHeight - window.innerHeight;
    nav.style.setProperty('--progress', max > 0 ? String(Math.min(1, y / max)) : '0');
  };
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(onScroll);
    },
    { passive: true }
  );
  onScroll();

  const focusable = () =>
    Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    drawer.toggleAttribute('data-open', open);
    nav.toggleAttribute('data-menu-open', open);
    // inert (not `hidden`) so the drawer can still animate while it's
    // closing — `hidden` would rip it out of layout mid-transition.
    drawer.inert = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) focusable()[0]?.focus();
  };

  toggle.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (!drawer.hasAttribute('data-open')) return;

    if (e.key === 'Escape') {
      setOpen(false);
      toggle.focus();
      return;
    }

    if (e.key === 'Tab') {
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    background: rgba(244, 244, 242, 0.9);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    border-bottom: 1px solid var(--border);
    view-transition-name: site-nav;
  }
  /* The bar's height IS --nav-h (minus its 1px border), rather than falling
     out of padding + content and being measured afterwards. Eight sticky
     offsets and every page's top padding read that token; tying the bar to
     it means the two can no longer drift apart. */
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: calc(var(--nav-h) - 1px);
    padding: 0 var(--pad-x);
    transition: min-height 0.6s var(--ease-out);
  }
  .nav[data-scrolled] .nav-inner {
    min-height: 72px;
  }

  /* The bottom border, filling from the left as the page is read. */
  .nav-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(22px, 2.6vw, 42px);
    list-style: none;
  }
  .nav-link {
    display: block;
    font-family: var(--sans);
    font-weight: var(--fw-regular);
    /* ADJUSTED: 10.5px in the prototype. */
    font-size: var(--fs-micro);
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 4px 0;
  }
  .nav-link[aria-current='page'] {
    font-weight: var(--fw-medium);
  }

  /* Rolling label: the word slides up and its copy follows from below. */
  .roll {
    position: relative;
    display: block;
    overflow: hidden;
    line-height: 1.5;
  }
  .roll > span {
    display: block;
    transition: transform 0.55s var(--ease-out);
  }
  .roll > span + span {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }
  .nav-link:hover .roll > span:first-child,
  .nav-link:focus-visible .roll > span:first-child {
    transform: translateY(-100%);
  }
  .nav-link:hover .roll > span + span,
  .nav-link:focus-visible .roll > span + span {
    transform: none;
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-login {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: var(--fs-micro);
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--taupe);
    transition: color var(--dur-fast) ease;
  }
  .nav-login:hover {
    color: var(--ink);
  }
  .nav-end :global(.nav-cta) {
    padding: 13px 28px;
  }

  .nav-mobile-only {
    display: none;
    align-items: center;
    gap: 8px;
  }
  .burger {
    position: relative;
    width: 44px;
    height: 44px;
  }
  .burger span {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.55s var(--ease-out), top 0.55s var(--ease-out);
  }
  .burger span:nth-child(1) {
    top: 18px;
  }
  .burger span:nth-child(2) {
    top: 25px;
    left: 19px;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    top: 21.5px;
    transform: rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    top: 21.5px;
    left: 11px;
    transform: rotate(-45deg);
  }

  .drawer {
    position: fixed;
    inset: var(--nav-h-mob) 0 auto;
    z-index: calc(var(--z-nav) - 2);
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.7s var(--ease-in-out);
  }
  .drawer[data-open] {
    grid-template-rows: 1fr;
  }
  /* Clips the panel while the grid track animates — and does NOTHING else.
     Padding and borders do not shrink with the track: with border-box
     sizing a used height of 0 still resolves to max(0, padding + border),
     so any decoration put here survives the collapse as a permanent strip
     welded under the navbar. Keep this element free of padding, border,
     background and min-height, or the stray bar comes back. */
  .drawer-clip {
    overflow: hidden;
    min-height: 0;
  }
  /* Everything painted lives here, safely inside the clipper. */
  .drawer-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--cream);
    height: calc(100dvh - var(--nav-h-mob));
    overflow-y: auto;
    padding: 12px 0 28px;
  }
  .drawer-links {
    list-style: none;
  }
  .drawer-links li,
  .drawer-foot {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .drawer[data-open] .drawer-links li,
  .drawer[data-open] .drawer-foot {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.8s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: calc(0.18s + var(--i, 0) * 0.05s);
  }
  .drawer-links a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 12px 24px;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(30px, 8.4vw, 44px);
    letter-spacing: var(--ls-display);
    line-height: 1.1;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
  }
  .drawer-links a[aria-current='page'] {
    font-style: italic;
    font-weight: var(--fw-regular);
  }
  .drawer-num {
    font-family: var(--sans);
    font-size: var(--fs-micro);
    font-style: normal;
    letter-spacing: 0.1em;
    color: var(--taupe);
    min-width: 22px;
  }
  .drawer-foot {
    padding: 28px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .drawer-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
    font-size: var(--fs-small);
    color: var(--taupe);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer-links li,
    .drawer-foot {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
  }

  @media (max-width: 1280px) {
    .nav-login span {
      display: none;
    }
    .nav-end {
      gap: 20px;
    }
  }

  @media (max-width: 1080px) {
    .nav-inner,
    .nav[data-scrolled] .nav-inner {
      min-height: calc(var(--nav-h-mob) - 1px);
      /* On the page margin, like the content below. The burger's lines sit
         11px inside its 44px hit area, so the right padding gives those
         back and the lines end exactly on the margin too. */
      padding: 0 calc(var(--pad-x) - 11px) 0 var(--pad-x);
    }
    .nav-links,
    .nav-end {
      display: none;
    }
    .nav-mobile-only {
      display: flex;
    }
  }
</style>
