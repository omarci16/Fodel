---
/**
 * Replaces the flat HU | NL text list with a flag + code dropdown that can
 * carry all seven markets FODEL sells in, without widening LOCALES —
 * hu/nl link to their real alternate, en/de/fr point at the existing
 * bridge pages, it/es render disabled with a "coming soon" chip.
 *
 * Used twice per page (desktop nav + mobile drawer), so ids are randomised
 * per render rather than hardcoded, and the toggle script below is written
 * to set up every `[data-switcher]` instance it finds.
 */
import Flag from './Flag.astro';
import { LOCALE_META, SWITCHER_LOCALES, UI, type Locale } from '~/i18n/ui';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
  align?: 'left' | 'right';
}

const { locale, alternates = {}, align = 'right' } = Astro.props;
const ui = UI[locale];
const current = LOCALE_META[locale];
const uid = Math.random().toString(36).slice(2, 8);
const menuId = `lang-menu-${uid}`;

const hrefFor = (code: keyof typeof LOCALE_META, status: (typeof SWITCHER_LOCALES)[number]['status']) => {
  if (status === 'soon') return undefined;
  if (code === 'hu' || code === 'nl') return alternates[code] ?? `/${code}/`;
  return `/${code}/`;
};
---

<div class="switcher" data-switcher data-align={align}>
  <button
    type="button"
    class="switcher-toggle"
    aria-expanded="false"
    aria-controls={menuId}
  >
    <Flag code={current.flag} />
    <span aria-hidden="true">{current.short}</span>
    <span class="sr-only">{ui.a11y.langSwitch}</span>
    <svg class="switcher-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
      <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <ul class="switcher-menu" id={menuId} inert>
    {
      SWITCHER_LOCALES.map(({ code, status }) => {
        const meta = LOCALE_META[code];
        const href = hrefFor(code, status);
        const active = code === locale;
        return (
          <li>
            {href ? (
              <a
                href={href}
                hreflang={code === 'hu' || code === 'nl' ? meta.hreflang : undefined}
                lang={meta.htmlLang}
                class:list={['switcher-row', { active }]}
                aria-current={active ? 'true' : undefined}
              >
                <Flag code={meta.flag} />
                <span class="switcher-name">{meta.label}</span>
                <span class="switcher-code" aria-hidden="true">
                  {meta.short}
                </span>
              </a>
            ) : (
              <span class="switcher-row switcher-row-disabled" aria-disabled="true">
                <Flag code={meta.flag} />
                <span class="switcher-name">{meta.label}</span>
                <span class="switcher-soon">{ui.comingSoon}</span>
              </span>
            )}
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  function setupSwitcher(root: HTMLElement) {
    const toggle = root.querySelector<HTMLButtonElement>('.switcher-toggle');
    const menu = root.querySelector<HTMLElement>('.switcher-menu');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      root.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.inert = !open;
      if (open) menu.querySelector<HTMLElement>('a, [tabindex]')?.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });

    root.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (!root.contains(document.activeElement)) setOpen(false);
      });
    });

    root.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-switcher]').forEach(setupSwitcher);
</script>

<style>
  .switcher {
    position: relative;
  }
  .switcher-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    font-family: var(--sans);
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    color: var(--ink);
    background: none;
    border: none;
    cursor: pointer;
    transition: background-color var(--dur-fast) ease;
  }
  .switcher-toggle:hover,
  .switcher[data-open] .switcher-toggle {
    background: rgba(16, 42, 67, 0.065);
  }
  .switcher-caret {
    color: var(--taupe);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .switcher[data-open] .switcher-caret {
    transform: rotate(180deg);
  }

  .switcher-menu {
    position: absolute;
    top: calc(100% + 10px);
    min-width: 232px;
    background: var(--paper);
    border: 1px solid rgba(16, 42, 67, 0.08);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-float);
    list-style: none;
    padding: 6px;
    z-index: 1100;
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transform-origin: top right;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .switcher[data-align='right'] .switcher-menu {
    right: 0;
  }
  .switcher[data-align='left'] .switcher-menu {
    left: 0;
    transform-origin: top left;
  }
  .switcher[data-open] .switcher-menu {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .switcher-row,
  .switcher-row-disabled {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    font-family: var(--sans);
    font-size: var(--fs-small);
    color: var(--ink);
  }
  a.switcher-row {
    transition: background-color 0.25s ease;
  }
  a.switcher-row:hover {
    background: rgba(16, 42, 67, 0.06);
  }
  a.switcher-row.active {
    background: rgba(16, 42, 67, 0.08);
    font-weight: var(--fw-medium);
  }
  .switcher-name {
    flex: 1;
  }
  .switcher-code {
    color: var(--taupe);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .switcher-row-disabled {
    color: var(--taupe);
    cursor: default;
  }
  .switcher-soon {
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
    background: rgba(16, 42, 67, 0.07);
    border-radius: var(--r-pill);
    padding: 3px 9px;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .switcher-caret,
    .switcher-menu {
      transition: none;
    }
    .switcher[data-open] .switcher-menu {
      transform: none;
    }
  }
</style>
