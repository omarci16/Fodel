---
/**
 * One listing package, in two modes — extracted from PriceListPage so the
 * submit-ad page can offer the same cards as a real, keyboard-navigable
 * radio group instead of sending people to /arlista/ and back.
 *
 * mode="link"   — today's price-list behaviour: a card ending in a button
 *                 that goes to the submit page. SEO/copy unchanged.
 * mode="select" — the whole card is a <label> wrapping a visually-hidden
 *                 radio input; :has(:checked) carries the selected look.
 *                 `pkg.id` must be a real catalogue id (src/lib/orders.ts) —
 *                 this is what gets posted, never a price.
 */
import Button from './Button.astro';

interface PackageCardData {
  id?: string;
  name: string;
  price: string;
  priceAlt?: string;
  priceAltNote?: string;
  duration: string;
  featured?: boolean;
  features: string[];
}

interface Props {
  pkg: PackageCardData;
  mode: 'link' | 'select';
  ctaLabel?: string;
  ctaHref?: string;
  radioName?: string;
  checked?: boolean;
  recommendedLabel?: string;
  /** mode="select" only: the id of the <form> this radio posts to — it lives
   *  outside the form element, in the marketing column. */
  formId?: string;
  /** mode="select" only: cents, read by the page's running-total script. */
  priceCents?: number;
}

const {
  pkg,
  mode,
  ctaLabel,
  ctaHref,
  radioName = 'package',
  checked = false,
  recommendedLabel,
  formId,
  priceCents,
} = Astro.props;

const inputId = `pkg-${radioName}-${pkg.id ?? pkg.name}`;
---

{
  mode === 'link' ? (
    <article class:list={['package', { featured: pkg.featured }]} data-bg={pkg.featured ? 'dark' : undefined}>
      <header>
        <h2>{pkg.name}</h2>
        <p class="duration">{pkg.duration}</p>
      </header>
      <p class="price">{pkg.price}</p>
      {pkg.priceAlt && (
        <p class="price-alt">
          <strong>{pkg.priceAlt}</strong> — {pkg.priceAltNote}
        </p>
      )}
      <span class="pkg-rule" aria-hidden="true" />
      <ul>
        {pkg.features.map((f) => (
          <li>
            <span class="tick" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.25 5 8.75l4.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
      <Button variant={pkg.featured ? 'dark' : 'outline'} light={pkg.featured} arrow href={ctaHref} block>
        {ctaLabel}
      </Button>
    </article>
  ) : (
    <label class="package package-select" for={inputId}>
      <input
        type="radio"
        name={radioName}
        id={inputId}
        value={pkg.id}
        checked={checked}
        required
        form={formId}
        data-price-cents={priceCents}
      />
      {pkg.featured && recommendedLabel && <span class="badge">{recommendedLabel}</span>}
      <header>
        <h2>{pkg.name}</h2>
        <p class="duration">{pkg.duration}</p>
      </header>
      <p class="price">{pkg.price}</p>
      {pkg.priceAlt && (
        <p class="price-alt">
          <strong>{pkg.priceAlt}</strong> — {pkg.priceAltNote}
        </p>
      )}
      <span class="pkg-rule" aria-hidden="true" />
      <ul>
        {pkg.features.map((f) => (
          <li>
            <span class="tick" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.25 5 8.75l4.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
      <span class="select-state" aria-hidden="true"><span class="select-dot"></span></span>
    </label>
  )
}

<style>
  .package {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 44px;
    border-radius: var(--r-2xl);
    background: var(--white);
    border: 1px solid rgba(16, 42, 67, 0.08);
    color: var(--ink);
    transition:
      transform 0.7s var(--ease-out),
      box-shadow 0.7s var(--ease-out),
      background-color 0.5s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }
  article.package:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  /* The recommended package is the inverted one: ink, with cream type. */
  .package.featured {
    background:
      radial-gradient(120% 80% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }
  .package h2 {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 26px;
    letter-spacing: var(--ls-heading);
    color: inherit;
  }
  .duration {
    display: inline-flex;
    margin-top: 12px;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.07);
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: inherit;
  }
  .featured .duration {
    background: rgba(244, 244, 242, 0.12);
  }
  .price {
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(48px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: inherit;
    margin: 28px 0 10px;
  }
  .price-alt {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--taupe);
    /* Reserved on both cards so the rules and feature lists line up, whether
       or not the package has a second price tier. */
    min-height: 48px;
  }
  .featured .price-alt {
    color: var(--on-dark-body);
  }
  .pkg-rule {
    display: block;
    height: 1px;
    margin: 20px 0 24px;
    background: currentColor;
    opacity: 0.12;
  }
  .package:not(:has(.price-alt)) .pkg-rule {
    margin-top: calc(20px + 48px);
  }
  .package ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    flex: 1;
    margin-bottom: 36px;
  }
  .package li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--taupe);
  }
  .featured li {
    color: var(--on-dark-body);
  }
  .tick {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.08);
    color: var(--ink);
  }
  .featured .tick {
    background: rgba(244, 244, 242, 0.14);
    color: var(--cream);
  }

  /* mode="select" */
  .package-select {
    cursor: pointer;
  }
  .package-select input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .package-select:hover {
    border-color: rgba(16, 42, 67, 0.3);
  }
  .package-select:has(input:checked) {
    border-color: var(--ink);
    background:
      radial-gradient(120% 80% at 100% 0%, var(--ink-soft) 0%, transparent 60%),
      var(--ink);
    color: var(--on-dark-strong);
    box-shadow: var(--shadow-md);
  }
  .package-select:has(input:checked) :is(.price-alt, li) {
    color: var(--on-dark-body);
  }
  .package-select:has(input:checked) .duration {
    background: rgba(244, 244, 242, 0.12);
  }
  .package-select:has(input:checked) .tick {
    background: rgba(244, 244, 242, 0.14);
    color: var(--cream);
  }
  .package-select:has(input:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
  /* The radio itself, drawn: a ring that fills when chosen. */
  .select-state {
    position: absolute;
    top: 40px;
    right: 40px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid rgba(16, 42, 67, 0.3);
    transition: border-color 0.4s var(--ease-out);
  }
  .select-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--cream);
    transform: scale(0);
    transition: transform 0.45s var(--ease-out);
  }
  .package-select:has(input:checked) .select-state {
    border-color: var(--cream);
  }
  .package-select:has(input:checked) .select-dot {
    transform: scale(1);
  }
  /* The badge's row is reserved on every selectable card, so titles, prices
     and lists line up across the pair whether or not a card carries it. */
  .package-select:not(:has(.badge))::before {
    content: '';
    display: block;
    height: 46px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    height: 28px;
    margin-bottom: 18px;
    padding: 0 12px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--cream);
    font-size: 12.5px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }
  .package-select:has(input:checked) .badge {
    background: var(--cream);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .package {
      padding: 32px 24px;
      border-radius: var(--r-xl);
    }
    .select-state {
      top: 28px;
      right: 24px;
    }
  }
</style>
