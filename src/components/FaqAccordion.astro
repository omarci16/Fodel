---
/**
 * The questions sellers and buyers ask, as an accordion. One treatment for
 * every page that shows a slice of the FAQ.
 *
 * Editorial layout: the heading and the way to the full FAQ on the left, the
 * questions on the right. Each answer opens with a height animation where the
 * browser supports animating to `auto` (::details-content + interpolate-size)
 * and simply opens everywhere else. Native <details>, so it works without JS
 * and the browser's find-in-page opens the answer that matches. Renders
 * nothing when a locale has no questions for the audience.
 */
import SectionHead from './SectionHead.astro';
import Button from './Button.astro';
import type { FaqEntry } from '~/data/faq';

interface Props {
  eyebrow: string;
  title: string;
  entries: FaqEntry[];
  moreHref: string;
  moreLabel: string;
}

const { eyebrow, title, entries, moreHref, moreLabel } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="faq">
      <div class="faq-aside">
        <SectionHead eyebrow={eyebrow} title={title} class="reveal" />
        <div class="faq-more">
          <Button variant="text" href={moreHref}>{moreLabel}</Button>
        </div>
      </div>

      <div class="faq-list reveal">
        {
          entries.map((entry, i) => (
            <details class="faq-item">
              <summary>
                <span class="q-num num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="q">{entry.question}</span>
                <span class="icon" aria-hidden="true" />
              </summary>
              <div class="answer">
                {entry.answer.map((para) =>
                  para.startsWith('- ') ? <p class="bullet">{para.slice(2)}</p> : <p>{para}</p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </section>
  )
}

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    align-items: start;
    padding: var(--section-y) var(--pad-x);
  }
  .faq-aside {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
  }
  .faq-more {
    margin-top: 4px;
  }

  /* 2.0: every question is its own rounded row; the open one lifts onto a
     white surface. */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .faq-item {
    border-radius: var(--r-lg);
    background: rgba(16, 42, 67, 0.035);
    border: 1px solid transparent;
    interpolate-size: allow-keywords;
    transition:
      background-color 0.5s var(--ease-out),
      box-shadow 0.6s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }
  .faq-item:hover {
    background: rgba(16, 42, 67, 0.06);
  }
  .faq-item[open] {
    background: var(--white);
    border-color: rgba(16, 42, 67, 0.06);
    box-shadow: var(--shadow-md);
  }
  .faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.6s var(--ease-out),
      content-visibility 0.6s allow-discrete;
  }
  .faq-item[open]::details-content {
    block-size: auto;
  }

  summary {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) 36px;
    align-items: center;
    gap: 12px;
    padding: 20px 20px 20px 24px;
    border-radius: var(--r-lg);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }
  .q-num {
    font-size: 13px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    color: var(--taupe);
  }
  .q {
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: clamp(18px, 1.4vw, 21px);
    letter-spacing: -0.005em;
    line-height: 1.35;
    color: var(--ink);
  }

  /* A plus in a disc; the upright stroke turns flat when open. */
  .icon {
    position: relative;
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: inset 0 0 0 1px rgba(16, 42, 67, 0.1);
    transition:
      background-color 0.4s var(--ease-out),
      transform 0.6s var(--ease-out);
  }
  .faq-item[open] .icon {
    background: var(--ink);
    transform: rotate(180deg);
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    border-radius: 1px;
    background: var(--ink);
    transition:
      transform 0.5s var(--ease-out),
      background-color 0.4s var(--ease-out);
  }
  .icon::after {
    transform: rotate(90deg);
  }
  .faq-item[open] .icon::before,
  .faq-item[open] .icon::after {
    background: var(--cream);
  }
  .faq-item[open] .icon::after {
    transform: rotate(0deg);
  }

  .answer {
    padding: 0 32px 28px 72px;
  }
  .answer p {
    max-width: 62ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
    margin-bottom: 12px;
  }
  .answer p:last-child {
    margin-bottom: 0;
  }
  .bullet {
    position: relative;
    padding-left: 22px;
  }
  .bullet::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink);
  }

  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: var(--section-y-mob) var(--pad-x-mob);
    }
    /* The heading, the questions, then the way to the full FAQ. */
    .faq-aside {
      display: contents;
    }
    .faq-more {
      order: 3;
      margin-top: 0;
    }
    summary {
      grid-template-columns: minmax(0, 1fr) 32px;
      gap: 12px;
      padding: 18px 16px 18px 20px;
    }
    .q-num {
      display: none;
    }
    .icon {
      width: 32px;
      height: 32px;
    }
    .answer {
      padding: 0 20px 22px;
    }
  }
</style>
