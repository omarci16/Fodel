---
/**
 * A list of short statements, each led by the site's rule. Used for the
 * seller benefits, the buyer services and wishes, and FODEL's approach.
 * Hairlines between items; each lead rule draws on as the list reveals.
 */
interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['points', className]}>
  {
    items.map((item, i) => (
      <li style={`--reveal-delay:${(0.15 + i * 0.07).toFixed(2)}s`}>
        <span class="mark" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2.5 6.25 5 8.75l4.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .points {
    list-style: none;
    border-top: 1px solid var(--points-rule, var(--border));
  }
  :global([data-bg='dark']) .points {
    --points-rule: var(--on-dark-rule);
  }
  li {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: start;
    padding: 18px 0;
    border-bottom: 1px solid var(--points-rule, var(--border));
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--taupe);
  }
  /* A small disc with a tick, centred on the first line (1.6em / 2). */
  .mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-top: calc(0.8em - 13px);
    border-radius: 50%;
    background: rgba(16, 42, 67, 0.08);
    color: var(--ink);
  }
  :global([data-bg='dark']) .mark {
    background: rgba(244, 244, 242, 0.12);
    color: var(--cream);
  }
  :global([data-reveal-ready]) .mark {
    transform: scale(0);
    transition: transform 0.8s var(--ease-out) var(--reveal-delay, 0s);
  }
  :global([data-reveal-ready][data-visible]) .mark {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global([data-reveal-ready]) .mark {
      transform: none;
    }
  }
</style>
