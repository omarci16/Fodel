---
/**
 * The prototype's BtnDark / BtnOutline / TextBtn, unified.
 *
 * Renders <a> when given an href and <button> otherwise. The prototype used
 * <button onClick> for navigation everywhere, which meant no crawlable links,
 * no middle-click, and no hover preview.
 *
 * 1.4: filled and outline buttons fill with the opposite colour from the
 * bottom edge on hover, and the label rolls up with it; every variant
 * answers a press. Still square — the site has no radius anywhere.
 */
interface Props {
  variant?: 'dark' | 'outline' | 'text';
  href?: string;
  rel?: string;
  type?: 'button' | 'submit';
  light?: boolean;
  block?: boolean;
  class?: string;
  id?: string;
  'data-testid'?: string;
}

const {
  variant = 'dark',
  href,
  type = 'button',
  light = false,
  block = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn-${variant}`, { light, block }, className];
---

<Tag class:list={classes} href={href} type={href ? undefined : type} {...rest}>
  {
    variant === 'text' ? (
      <>
        <slot />
        <span class="arrow" aria-hidden="true">
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none">
            <path d="M0 5h16.5M12.5 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
          </svg>
        </span>
      </>
    ) : (
      <span class="label">
        <slot />
      </span>
    )
  }
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-block;
    font-family: var(--sans);
    font-weight: var(--fw-regular);
    /* ADJUSTED: 10.5px in the prototype. */
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    isolation: isolate;
    overflow: hidden;
    transition:
      color 0.6s var(--ease-out),
      border-color 0.6s var(--ease-out),
      transform 0.2s var(--ease);
  }
  .btn:active {
    transform: translateY(1px) scale(0.99);
  }

  .btn-dark,
  .btn-outline {
    padding: 15px 38px;
  }

  /* The fill: a panel that rises from the bottom edge on hover. */
  .btn-dark::before,
  .btn-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: translateY(101%);
    transition: transform 0.6s var(--ease-out);
  }
  .btn-dark:hover::before,
  .btn-outline:hover::before,
  .btn-dark:focus-visible::before,
  .btn-outline:focus-visible::before {
    transform: none;
  }
  .label {
    display: inline-block;
  }

  .btn-dark {
    background: var(--ink);
    color: var(--cream);
    border: 1px solid var(--ink);
  }
  .btn-dark::before {
    background: var(--cream);
  }
  .btn-dark:hover,
  .btn-dark:focus-visible {
    color: var(--ink);
  }
  .btn-dark.light {
    background: var(--cream);
    color: var(--ink);
    border-color: var(--cream);
  }
  .btn-dark.light::before {
    background: var(--ink);
  }
  .btn-dark.light:hover,
  .btn-dark.light:focus-visible {
    color: var(--cream);
  }

  .btn-outline {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }
  .btn-outline::before {
    background: var(--ink);
  }
  .btn-outline:hover,
  .btn-outline:focus-visible {
    color: var(--cream);
  }
  .btn-outline.light {
    color: var(--cream);
    border-color: rgba(244, 244, 242, 0.55);
  }
  .btn-outline.light::before {
    background: var(--cream);
  }
  .btn-outline.light:hover,
  .btn-outline.light:focus-visible {
    color: var(--ink);
    border-color: var(--cream);
  }

  .btn-text {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 6px 0;
    background: none;
    border: none;
    overflow: visible;
    letter-spacing: 0.22em;
    color: var(--taupe);
    /* The underline draws in under the label on hover. */
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition:
      color var(--dur-fast) ease,
      background-size 0.6s var(--ease-out);
  }
  .btn-text:hover,
  .btn-text:focus-visible {
    color: var(--ink);
    background-size: 100% 1px;
  }
  /* ADJUSTED: was rgba(cream,.7) on ink — this clears AA. */
  .btn-text.light {
    color: var(--on-dark-body);
  }
  .btn-text.light:hover,
  .btn-text.light:focus-visible {
    color: var(--cream);
  }
  .arrow {
    display: inline-flex;
    transition: transform 0.6s var(--ease-out);
  }
  .btn-text:hover .arrow,
  .btn-text:focus-visible .arrow {
    transform: translateX(6px);
  }

  .block {
    display: block;
    width: 100%;
  }
  .btn-text.block {
    display: flex;
    justify-content: center;
  }

  /* Tablets: header copy columns narrow to ~368px, where 38px sides left
     "Vegye fel velünk a kapcsolatot" wrapping by a fraction of a pixel. */
  @media (max-width: 1100px) {
    .btn-dark,
    .btn-outline {
      padding-inline: 28px;
    }
  }

  /* Phones: buttons run full width, so the width left for the label is the
     column less the padding. At 0.26em the longest labels ("Vegye fel velünk
     a kapcsolatot", 292px) wrap in a 360px viewport; 0.18em and 20px sides
     keep every current label on one line down to 360. */
  @media (max-width: 480px) {
    .btn {
      letter-spacing: 0.18em;
    }
    .btn-dark,
    .btn-outline {
      padding-inline: 20px;
    }
  }
</style>
