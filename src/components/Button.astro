---
/**
 * The prototype's BtnDark / BtnOutline / TextBtn, unified.
 *
 * Renders <a> when given an href and <button> otherwise. The prototype used
 * <button onClick> for navigation everywhere, which meant no crawlable links,
 * no middle-click, and no hover preview.
 *
 * 2.0: pill-shaped, and the label is set in sentence case at reading size —
 * the 12px letter-spaced capitals were the hardest text on the site to read
 * for the audience it serves. Primary actions carry the arrow chip, which
 * animates on hover instead of the whole button flooding with colour.
 */
import ArrowChip from './ArrowChip.astro';

interface Props {
  variant?: 'dark' | 'outline' | 'text';
  href?: string;
  rel?: string;
  target?: string;
  type?: 'button' | 'submit';
  light?: boolean;
  block?: boolean;
  /** Show the arrow chip. Defaults to on for the filled variant. */
  arrow?: boolean;
  size?: 'md' | 'sm';
  class?: string;
  id?: string;
  'data-testid'?: string;
  'aria-label'?: string;
}

const {
  variant = 'dark',
  href,
  type = 'button',
  light = false,
  block = false,
  arrow,
  size = 'md',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const withChip = variant !== 'text' && (arrow ?? variant === 'dark');
const classes = ['btn', `btn-${variant}`, `btn-${size}`, { light, block, 'has-chip': withChip }, className];
---

<Tag class:list={classes} href={href} type={href ? undefined : type} {...rest}>
  {
    variant === 'text' ? (
      <>
        <span class="label">
          <slot />
        </span>
        <span class="arrow" aria-hidden="true">
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
            <path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </>
    ) : (
      <>
        <span class="label">
          <slot />
        </span>
        {withChip && <ArrowChip size={size === 'sm' ? 30 : 40} />}
      </>
    )
  }
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-family: var(--sans);
    font-weight: var(--fw-medium);
    font-size: 1rem;
    letter-spacing: 0.005em;
    line-height: 1.2;
    text-align: center;
    text-transform: none;
    cursor: pointer;
    isolation: isolate;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 0.45s var(--ease-out),
      color 0.45s var(--ease-out),
      border-color 0.45s var(--ease-out),
      box-shadow 0.6s var(--ease-out),
      transform 0.25s var(--ease-out);
  }
  .btn:active {
    transform: scale(0.975);
  }
  .btn[disabled] {
    cursor: progress;
    opacity: 0.7;
  }

  /* ── Filled and outline: the pill ── */
  .btn-dark,
  .btn-outline {
    min-height: 56px;
    padding: 0 30px;
    border-radius: var(--r-pill);
    border: 1px solid transparent;
  }
  .btn-sm.btn-dark,
  .btn-sm.btn-outline {
    min-height: 44px;
    padding: 0 22px;
    font-size: 0.9375rem;
  }
  /* With the chip the right padding is what centres the disc in the pill. */
  .btn-dark.has-chip,
  .btn-outline.has-chip {
    padding-right: 7px;
    padding-left: 28px;
  }
  .btn-sm.has-chip {
    padding-right: 6px;
    padding-left: 20px;
    gap: 12px;
  }

  .btn-dark {
    background: var(--ink);
    color: var(--cream);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
  }
  .btn-dark:hover,
  .btn-dark:focus-visible {
    background: var(--ink-soft);
    box-shadow: 0 14px 30px -14px rgba(var(--shadow-ink), 0.6);
  }
  .btn-dark:hover :global(.arrow-chip),
  .btn-dark:focus-visible :global(.arrow-chip) {
    transform: scale(1.06);
  }
  .btn-dark.light {
    background: var(--cream);
    color: var(--ink);
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }
  .btn-dark.light:hover,
  .btn-dark.light:focus-visible {
    background: var(--white);
    box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.5);
  }

  .btn-outline {
    background: transparent;
    color: var(--ink);
    border-color: rgba(16, 42, 67, 0.24);
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }
  .btn-outline:hover,
  .btn-outline:focus-visible {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
  }
  .btn-outline.light {
    color: var(--cream);
    border-color: rgba(244, 244, 242, 0.36);
    --chip-bg: var(--cream);
    --chip-fg: var(--ink);
  }
  .btn-outline.light:hover,
  .btn-outline.light:focus-visible {
    background: var(--cream);
    border-color: var(--cream);
    color: var(--ink);
    --chip-bg: var(--ink);
    --chip-fg: var(--cream);
  }

  .label {
    display: inline-block;
  }

  /* ── Text: a quiet link with a drawn underline ── */
  .btn-text {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
    background: none;
    border: none;
    color: var(--ink);
  }
  .btn-text .label {
    background-image: linear-gradient(currentColor, currentColor), linear-gradient(rgba(16, 42, 67, 0.2), rgba(16, 42, 67, 0.2));
    background-size:
      0% 1px,
      100% 1px;
    background-position:
      0 100%,
      0 100%;
    background-repeat: no-repeat;
    padding-bottom: 3px;
    transition: background-size 0.6s var(--ease-out);
  }
  .btn-text:hover .label,
  .btn-text:focus-visible .label {
    background-size:
      100% 1px,
      100% 1px;
  }
  .btn-text.light {
    color: var(--cream);
  }
  .btn-text.light .label {
    background-image: linear-gradient(currentColor, currentColor), linear-gradient(rgba(244, 244, 242, 0.3), rgba(244, 244, 242, 0.3));
  }
  .arrow {
    display: inline-flex;
    transition: transform 0.6s var(--ease-out);
  }
  .btn-text:hover .arrow,
  .btn-text:focus-visible .arrow {
    transform: translateX(5px);
  }

  .block {
    display: flex;
    width: 100%;
  }
  /* A full-width pill keeps its label centred and its chip on the far end. */
  .block.has-chip {
    justify-content: space-between;
  }
  .block.has-chip .label {
    flex: 1;
    padding-left: 34px;
  }
  .btn-sm.block.has-chip .label {
    padding-left: 24px;
  }

  @media (max-width: 480px) {
    .btn-dark,
    .btn-outline {
      padding-inline: 24px;
    }
    .btn-dark.has-chip,
    .btn-outline.has-chip {
      padding-left: 24px;
    }
  }
</style>
