---
// Reads property data from Supabase (via PropertiesPage.astro), so this
// renders on request rather than once at build time. Cached at the CDN for
// 5 minutes.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 's-maxage=300, stale-while-revalidate=86400');

import PropertiesPage from '~/components/pages/PropertiesPage.astro';
---

<PropertiesPage locale="nl" />
