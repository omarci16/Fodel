---
export const prerender = false;
import PropertiesPage from '~/components/pages/PropertiesPage.astro';
import { categoryBySlug, getTaxonomy, termLabel } from '~/lib/runtime-config';
import { path } from '~/i18n/ui';
const term = categoryBySlug(await getTaxonomy(), 'nl', Astro.params.type ?? '');
if (!term) return new Response('Niet gevonden.', { status: 404 });
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=86400');
---
<PropertiesPage locale="nl" heading={termLabel(term, 'nl')} fixedCategory={term.key} alternates={{
  hu: `${path('hu', 'properties')}${term.slugs.hu}/`,
  nl: `${path('nl', 'properties')}${term.slugs.nl}/`,
}} />
