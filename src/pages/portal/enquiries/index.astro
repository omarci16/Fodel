---
/**
 * Érdeklődők — people who asked about a listing.
 *
 * The call to action on the public form is a callback ("hívjuk vissza 24
 * órán belül"), so this screen is built around the phone: a large Hívás
 * button on every card, a clock that turns red once the 24 hours are gone,
 * and two tabs — Új (still to handle) and Kezelt (handled, kept for lookup).
 *
 * No role check on purpose: the query returns what RLS permits — every
 * enquiry for an admin, only their own listings' for an owner.
 *
 * `select('*')` so the columns added by migration 0016 (contact_pref,
 * crm_synced_at, handled_at …) are simply absent until it runs, never an error.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { icon } from '~/lib/portal/icons';
import { timeAgo, hoursSince } from '~/lib/portal/time';

const { supabase, profile } = Astro.locals;
const isAdmin = profile?.role === 'admin';

const tab = Astro.url.searchParams.get('show') === 'handled' ? 'handled' : 'open';

const [{ data: enquiries }, openCount, handledCount] = await Promise.all([
  supabase
    .from('enquiries')
    .select('*')
    .eq('handled', tab === 'handled')
    .order('created_at', { ascending: false })
    .limit(200),
  supabase.from('enquiries').select('id', { count: 'exact', head: true }).eq('handled', false),
  supabase.from('enquiries').select('id', { count: 'exact', head: true }).eq('handled', true),
]);

const propertyIds = [...new Set((enquiries ?? []).map((e: any) => e.property_id).filter(Boolean))];
const { data: properties } = propertyIds.length
  ? await supabase
      .from('properties')
      .select('id, ref, settlement, property_translations(locale, title)')
      .in('id', propertyIds)
  : { data: [] };
const propertyById = new Map(
  (properties ?? []).map((p: any) => [
    p.id,
    {
      ref: p.ref,
      settlement: p.settlement,
      title: p.property_translations?.find((t: any) => t.locale === 'hu')?.title ?? `#${p.ref}`,
    },
  ])
);

const crmConfigured = Boolean(import.meta.env.CRM_WEBHOOK_URL);
const dateFmt = new Intl.DateTimeFormat('hu-HU', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
const telHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
const initials = (name: string) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]?.toUpperCase()).join('') || '?';
---

<Portal title="Érdeklődők">
  <header class="head">
    <p class="eyebrow">Teendők</p>
    <h1>Érdeklődők</h1>
    <p class="lead">
      {tab === 'open'
        ? 'Akik visszahívást kértek, 24 órán belül várják a hívását. Hívás után jelölje elintézettnek, és átkerül a Kezelt fülre.'
        : 'A már kezelt érdeklődők — itt visszanézheti, ki jelentkezett és mikor.'}
    </p>
  </header>

  <div class="tabs" role="tablist">
    <a href="/portal/enquiries" aria-current={tab === 'open' ? 'page' : undefined}>
      Új <span class="n">{openCount.count ?? 0}</span>
    </a>
    <a href="/portal/enquiries?show=handled" aria-current={tab === 'handled' ? 'page' : undefined}>
      Kezelt <span class="n">{handledCount.count ?? 0}</span>
    </a>
  </div>

  <p class="status" id="status" role="status" aria-live="polite"></p>

  {
    enquiries && enquiries.length > 0 ? (
      <ul class="cards">
        {enquiries.map((e: any) => {
          const property = e.property_id ? propertyById.get(e.property_id) : null;
          const wantsCall = e.contact_pref !== 'email' && Boolean(e.phone);
          const overdue = tab === 'open' && wantsCall && hoursSince(e.created_at) > 24;
          const crm = e.crm_synced_at
            ? { tone: 'ok', text: `CRM-ben · ${dateFmt.format(new Date(e.crm_synced_at))}` }
            : e.crm_error
              ? { tone: 'err', text: 'CRM: átküldés sikertelen' }
              : crmConfigured
                ? { tone: 'wait', text: 'CRM: átküldésre vár' }
                : { tone: 'off', text: 'CRM: nincs bekötve' };
          return (
            <li class:list={['card', tab === 'handled' && 'done', overdue && 'overdue']}>
              <div class="who">
                <span class="av" aria-hidden="true">{initials(e.name)}</span>
                <div class="id">
                  <b>{e.name}</b>
                  <span class="when">
                    {dateFmt.format(new Date(e.created_at))} · {timeAgo(e.created_at)}
                    {e.locale === 'nl' ? ' · holland' : ''}
                  </span>
                </div>
                <div class="badges">
                  {e.contact_pref === 'email' ? (
                    <span class="tag">E-mailben kér választ</span>
                  ) : e.phone ? (
                    <span class="tag call">Visszahívást kér</span>
                  ) : null}
                  {overdue && <span class="tag late">Lejárt a 24 óra</span>}
                  {isAdmin && <span class={`tag crm ${crm.tone}`}>{crm.text}</span>}
                </div>
              </div>

              {property && (
                <p class="about">
                  <Fragment set:html={icon('building', 16)} />
                  <a href={`/portal/properties/${e.property_id}`}>#{property.ref} — {property.title}</a>
                  <span> · {property.settlement}</span>
                </p>
              )}

              {e.message && <blockquote>{e.message}</blockquote>}

              <div class="foot">
                {e.phone && (
                  <a class="dial" href={telHref(e.phone)}>
                    <Fragment set:html={icon('phone', 20)} />
                    <span>
                      <small>Hívás</small>
                      {e.phone}
                    </span>
                  </a>
                )}
                <a
                  class:list={['mail', !e.phone && 'primary']}
                  href={`mailto:${e.email}?subject=${encodeURIComponent(property ? `FODEL #${property.ref}` : 'FODEL')}`}
                >
                  <Fragment set:html={icon('mail', 17)} />
                  {e.email}
                </a>
                <button type="button" class="toggle" data-enquiry={e.id} data-handled={String(tab === 'open')}>
                  {tab === 'open' ? (
                    <>
                      <Fragment set:html={icon('check', 17)} />
                      Elintézettnek jelölöm
                    </>
                  ) : (
                    'Vissza az újak közé'
                  )}
                </button>
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="empty">
        {tab === 'open'
          ? 'Nincs elintézetlen érdeklődés. Szép munka.'
          : isAdmin
            ? 'Még nincs kezelt érdeklődés.'
            : 'Még nem kezelt egyetlen érdeklődést sem.'}
      </p>
    )
  }
</Portal>

<script>
  const status = document.getElementById('status')!;
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button[data-enquiry]');
    if (!btn) return;
    btn.disabled = true;
    status.textContent = 'Mentés…';
    const res = await fetch(`/api/portal/enquiries/${btn.dataset.enquiry}`, {
      method: 'PATCH',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ handled: btn.dataset.handled === 'true' }),
    });
    if (!res.ok) {
      btn.disabled = false;
      status.textContent = 'Nem sikerült menteni.';
      return;
    }
    const card = btn.closest('.card') as HTMLElement | null;
    if (card) {
      card.style.transition = 'opacity .35s, transform .35s';
      card.style.opacity = '0';
      card.style.transform = 'translateX(16px)';
      setTimeout(() => location.reload(), 300);
    } else location.reload();
  });
</script>

<style>
  .head {
    margin-bottom: 22px;
  }
  .head h1 {
    margin-top: 10px;
  }
  .lead {
    max-width: 64ch;
    margin-top: 10px;
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--taupe);
  }
  .tabs {
    display: flex;
    margin-bottom: 18px;
  }
  .n {
    margin-left: 8px;
    padding: 1px 9px;
    border-radius: var(--r-pill);
    background: rgba(16, 42, 67, 0.08);
    font-size: 12.5px;
    font-weight: var(--fw-semibold);
  }
  .status {
    min-height: 1.4em;
    margin-bottom: 6px;
    font-size: 14.5px;
    color: var(--ink-quiet);
  }
  .empty {
    padding: 48px 0;
    color: var(--taupe);
  }

  .cards {
    list-style: none;
    display: grid;
    gap: 14px;
  }
  .card {
    padding: 22px 24px;
    border-radius: var(--r-xl);
    transition:
      box-shadow 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .card:hover {
    box-shadow: var(--shadow-md);
  }
  .card.overdue {
    border-color: rgba(179, 38, 30, 0.35);
    box-shadow:
      0 0 0 4px rgba(179, 38, 30, 0.06),
      var(--shadow-xs);
  }
  .card.done {
    background: var(--paper);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .av {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    font-weight: var(--fw-semibold);
    font-size: 15px;
  }
  .done .av {
    background: var(--linen);
    color: var(--ink-quiet);
  }
  .id {
    flex: 1;
    min-width: 180px;
  }
  .id b {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-semibold);
    font-size: 18px;
    color: var(--ink);
  }
  .when {
    font-size: 14px;
    color: var(--ink-quiet);
  }
  .badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tag {
    padding: 4px 12px;
    border-radius: var(--r-pill);
    background: var(--linen);
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--taupe);
  }
  .tag.call {
    background: var(--pt-amber-bg);
    color: var(--pt-amber);
  }
  .tag.late {
    background: var(--pt-red);
    color: #fff;
  }
  .tag.crm.ok {
    background: var(--pt-green-bg);
    color: var(--pt-green);
  }
  .tag.crm.err {
    background: var(--pt-red-bg);
    color: var(--pt-red);
  }
  .tag.crm.wait {
    background: var(--pt-amber-bg);
    color: var(--pt-amber);
  }
  .about {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 14.5px;
    color: var(--ink-quiet);
  }
  .about a {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }
  .about a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  blockquote {
    margin: 14px 0 0;
    padding: 14px 18px;
    border-radius: var(--r-md);
    background: var(--paper);
    font-size: var(--fs-body);
    line-height: 1.65;
    color: var(--taupe);
    white-space: pre-line;
  }
  .foot {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 18px;
  }
  .dial {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 11px 24px 11px 18px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--cream);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .dial:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    background: var(--ink-soft);
  }
  .dial span {
    font-family: var(--serif);
    font-weight: var(--fw-semibold);
    font-size: 17px;
    line-height: 1.15;
  }
  .dial small {
    display: block;
    font-size: 12px;
    font-weight: var(--fw-regular);
    color: var(--on-dark-muted);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 18px;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px rgba(16, 42, 67, 0.2);
    font-size: 14.5px;
    color: var(--ink);
    transition: box-shadow 0.3s var(--ease-out);
  }
  .mail:hover {
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .mail.primary {
    background: var(--ink);
    color: var(--cream);
    box-shadow: none;
  }
  .toggle {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: var(--r-pill);
    background: var(--linen);
    font-size: 14.5px;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.3s var(--ease-out);
  }
  .toggle:hover:not(:disabled) {
    background: var(--mist);
  }

  @media (max-width: 640px) {
    .card {
      padding: 18px;
    }
    .toggle {
      margin-left: 0;
      width: 100%;
      justify-content: center;
    }
    .dial {
      width: 100%;
    }
  }
</style>
