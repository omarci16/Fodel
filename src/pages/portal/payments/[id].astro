---
/**
 * One order: who, what listing, the itemised lines, status, a timeline
 * assembled from activity_events (Stage D), the referral discount if any,
 * and admin actions — issue an invoice or credit note, resend the payment
 * email, cancel, edit billing details.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { type OrderLine } from '~/lib/orders';
import { eventLabel, PAYMENT_STATUS_LABEL as STATUS_LABEL, PAYMENT_METHOD_LABEL } from '~/lib/portal/labels';
import { money } from '~/lib/portal/payments';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const { id } = Astro.params;

const { data: order } = await supabase
  .from('payments')
  .select(
    '*'
  )
  .eq('id', id)
  .maybeSingle();
if (!order) return new Response('Rendelés nem található.', { status: 404 });

const { data: property } = order.property_id
  ? await supabase.from('properties').select('id, ref, settlement, status').eq('id', order.property_id).maybeSingle()
  : { data: null };
const { data: owner } = order.owner_id
  ? await supabase.from('profiles').select('id, full_name, email').eq('id', order.owner_id).maybeSingle()
  : { data: null };

const { data: invoices } = await supabase
  .from('invoices')
  .select('id, number, kind, corrects_id, gross_cents, issued_at, view_token')
  .eq('payment_id', id)
  .order('issued_at', { ascending: true });

const latestInvoice = (invoices ?? []).filter((i) => i.kind === 'invoice').at(-1);
const hasCredit = (invoices ?? []).some((i) => i.kind === 'credit_note' && i.corrects_id === latestInvoice?.id);

const { data: timeline } = order.property_id
  ? await supabase
      .from('activity_events')
      .select('id, occurred_at, kind, actor_email, source')
      .eq('property_id', order.property_id)
      .order('occurred_at', { ascending: false })
      .limit(50)
  : { data: [] };

const { data: referral } = await supabase
  .from('referrals')
  .select('id, referrer_name, status')
  .or(`discount_applied_to.eq.${id},credited_to.eq.${id}`)
  .maybeSingle();

const dateFmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'short', day: 'numeric' });
const dateTimeFmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

const currency = String(order.currency ?? 'eur').toUpperCase();
const formatCents = (cents: number) => money(cents, currency);
const lines = (Array.isArray(order.line_items) ? order.line_items : []) as OrderLine[];
---

<Portal title={`Rendelés — #${property?.ref ?? '—'}`}>
  <header class="head">
    <p class="eyebrow"><a href="/portal/payments">← Fizetések</a></p>
    <h1>#{property?.ref ?? '—'} rendelése</h1>
    <span class:list={['pill', `pill-${order.status}`]}>{STATUS_LABEL[order.status] ?? order.status}</span>
  </header>

  <section class="grid">
    <div class="col">
      <h2>Tételek</h2>
      <table class="lines">
        <tbody>
          {lines.length === 0 && (
            <tr><td class="missing" colspan="2">Hiányzó tételadat — ez a rendelés a tételes nyilvántartás előttről származik.</td></tr>
          )}
          {lines.map((l) => (
            <tr>
              <td>{l.quantity > 1 ? `${l.label} ×${l.quantity}` : l.label}</td>
              <td class="right">{formatCents(l.unitCents * l.quantity)}</td>
            </tr>
          ))}
          {order.discount_cents > 0 && (
            <tr class="discount">
              <td>Ajánlói kedvezmény (10%){referral && ` — ${referral.referrer_name ?? ''}`}</td>
              <td class="right">−{formatCents(order.discount_cents)}</td>
            </tr>
          )}
          <tr class="total">
            <td>Összesen</td>
            <td class="right">{formatCents(order.amount_cents)}</td>
          </tr>
        </tbody>
      </table>

      <dl class="facts">
        <div><dt>Hirdető</dt><dd>{owner?.full_name ?? owner?.email ?? '—'}</dd></div>
        <div><dt>Hirdetés</dt><dd>{property ? <a href={`/portal/properties/${property.id}`}>#{property.ref} · {property.settlement}</a> : 'Nincs kapcsolódó hirdetés'}</dd></div>
        <div><dt>Fizetési mód</dt><dd>{PAYMENT_METHOD_LABEL[order.status] ?? '—'}</dd></div>
        <div><dt>Pénznem</dt><dd>{currency}</dd></div>
        <div><dt>Létrehozva</dt><dd>{dateFmt.format(new Date(order.created_at))}</dd></div>
        <div><dt>Esedékes</dt><dd>{order.due_at ? dateFmt.format(new Date(order.due_at)) : '—'}</dd></div>
        <div><dt>Fizetve</dt><dd>{order.paid_at ? dateFmt.format(new Date(order.paid_at)) : '—'}</dd></div>
        {order.refunded_at && <div><dt>Visszatérítve</dt><dd>{dateFmt.format(new Date(order.refunded_at))}{order.refund_note && ` — ${order.refund_note}`}</dd></div>}
      </dl>

      {order.refund_required && order.status !== 'refunded' && (
        <p class="refund-flag">
          Visszatérítés szükséges (elutasításkor vagy késve érkezett fizetésnél rögzítve). A rendszer
          pénzt nem utal vissza — az átutalás után itt rögzítse.
        </p>
      )}

      <form class="billing" id="billing-form">
        <h2>Számlázási adatok</h2>
        <label>Név <input name="billingName" value={order.billing_name ?? ''} required /></label>
        <label>Cím <input name="billingAddress" value={order.billing_address ?? ''} required /></label>
        <button type="submit" class="btn ghost">Mentés</button>
        <p class="action-status" id="billing-status" role="status"></p>
      </form>

      <section class="actions">
        <h2>Műveletek</h2>
        {latestInvoice ? (
          <p class="invoice-line">
            Számla: <a href={`/portal/invoices/${latestInvoice.number}`}>{latestInvoice.number}</a>
            {!hasCredit && (
              <button type="button" class="btn ghost small" id="credit-note-btn" data-corrects={latestInvoice.id}>
                Jóváírás kiállítása
              </button>
            )}
          </p>
        ) : (
          <button type="button" class="btn" id="invoice-btn">Számla kiállítása</button>
        )}
        <button type="button" class="btn ghost" id="resend-btn">Díjbekérő e-mail újraküldése</button>
        {order.status === 'pending' && (
          <><button type="button" class="btn" id="mark-paid-btn">Átutalás beérkezett</button>
          <button type="button" class="btn ghost" id="cancel-btn">Rendelés visszavonása</button></>
        )}
        {(order.status === 'paid' || order.status === 'manual') && (
          <div class="refund">
            <label>Visszatérítés rögzítése (a pénz már visszament)
              <input id="refund-note" placeholder="pl. 2026-10-02, átutalás a hirdető számlájára" maxlength="500" />
            </label>
            <button type="button" class="btn ghost" id="refund-btn">Visszatérítés rögzítése</button>
          </div>
        )}
        <p class="action-status" id="action-status" role="status"></p>
      </section>
    </div>

    <div class="col">
      <h2>Előzmények</h2>
      {timeline && timeline.length > 0 ? (
        <ul class="timeline">
          {timeline.map((e) => (
            <li>
              <span class="t-time">{dateTimeFmt.format(new Date(e.occurred_at))}</span>
              <span class="t-kind">{eventLabel(e.kind)}</span>
              {e.actor_email && <span class="t-actor">{e.actor_email}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">Nincs rögzített esemény.</p>
      )}
    </div>
  </section>
</Portal>

<script define:vars={{ orderId: order.id }}>
  const actionStatus = document.getElementById('action-status');
  const billingStatus = document.getElementById('billing-status');

  async function post(action, payload) {
    const res = await fetch(`/api/portal/payments/${orderId}/action`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ action, ...payload }),
    });
    return { ok: res.ok, json: await res.json().catch(() => ({})) };
  }

  document.getElementById('billing-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    billingStatus.textContent = 'Mentés…';
    const { ok, json } = await post('update_billing', {
      billingName: form.billingName.value,
      billingAddress: form.billingAddress.value,
    });
    billingStatus.textContent = '';
    window.pf.toast(ok && json.ok ? 'Számlázási adatok mentve.' : 'Nem sikerült menteni.', ok && json.ok ? 'ok' : 'error');
  });

  document.getElementById('invoice-btn')?.addEventListener('click', async () => {
    actionStatus.textContent = 'Számla kiállítása…';
    const { ok, json } = await post('issue_invoice');
    if (ok && json.ok) location.reload();
    else actionStatus.textContent = json.error === 'billing-missing' ? 'Előbb adja meg a számlázási adatokat.' : 'Nem sikerült kiállítani.';
  });

  document.getElementById('credit-note-btn')?.addEventListener('click', async (e) => {
    const correctsId = e.currentTarget.dataset.corrects;
    if (!(await window.pf.confirm({ title: 'Jóváíró számla kiállítása', body: 'Biztosan kiállítja a jóváíró számlát? A számlát ez nem törli, csak ellentételezi.', confirmLabel: 'Kiállítás' }))) return;
    actionStatus.textContent = 'Jóváírás kiállítása…';
    const { ok, json } = await post('issue_credit_note', { correctsId });
    if (ok && json.ok) location.reload();
    else actionStatus.textContent = 'Nem sikerült kiállítani.';
  });

  document.getElementById('resend-btn')?.addEventListener('click', async () => {
    actionStatus.textContent = 'Küldés…';
    const { ok } = await post('resend_email');
    actionStatus.textContent = '';
    window.pf.toast(ok ? 'Elküldve.' : 'Nem sikerült elküldeni.', ok ? 'ok' : 'error');
  });

  document.getElementById('cancel-btn')?.addEventListener('click', async () => {
    if (!(await window.pf.confirm({ title: 'Rendelés visszavonása', body: 'Biztosan visszavonja ezt a rendelést? A hirdető nem fizethet rá tovább.', confirmLabel: 'Visszavonás', danger: true }))) return;
    const { ok, json } = await post('cancel');
    if (ok && json.ok) location.reload();
    else actionStatus.textContent = 'Nem sikerült visszavonni.';
  });
  document.getElementById('refund-btn')?.addEventListener('click', async () => {
    const note = document.getElementById('refund-note').value.trim();
    if (!note) { actionStatus.textContent = 'Írja be, mikor és hogyan történt a visszatérítés.'; return; }
    if (!(await window.pf.confirm({ title: 'Visszatérítés rögzítése', body: 'Rögzíti, hogy az összeget visszatérítették? Ez nem indít utalást — csak a nyilvántartást frissíti.', confirmLabel: 'Rögzítés' }))) return;
    const { ok, json } = await post('mark_refunded', { note });
    if (ok && json.ok) location.reload();
    else actionStatus.textContent = 'Nem sikerült rögzíteni.';
  });

  document.getElementById('mark-paid-btn')?.addEventListener('click', async () => {
    if (!(await window.pf.confirm({ title: 'Átutalás beérkezett', body: 'Biztosan beérkezett az átutalás? A rendelés fizetettre áll, és a hirdetés élesedhet.', confirmLabel: 'Igen, beérkezett' }))) return;
    actionStatus.textContent = 'Rögzítés…';
    const { ok, json } = await post('mark_paid');
    if (ok && json.ok) location.reload();
    else actionStatus.textContent = 'Nem sikerült rögzíteni.';
  });
</script>

<style>
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-bottom: 30px; }
  .eyebrow { flex-basis: 100%; margin-bottom: 6px; }
  .eyebrow a { text-decoration: none; }
  .eyebrow a:hover { text-decoration: underline; text-underline-offset: 3px; }
  h2 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 19px; letter-spacing: var(--ls-heading); color: var(--ink); margin-bottom: 16px; }

  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(20px, 3vw, 40px); align-items: start; }
  .grid > .col:first-child { display: grid; gap: 28px; padding: clamp(22px, 3vw, 36px); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); min-width: 0; }
  .grid > .col:last-child { padding: 26px; border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); position: sticky; top: 24px; }

  .lines { width: 100%; border-collapse: collapse; }
  .lines td { padding: 14px 0; border-bottom: 1px solid var(--pt-hair); font-size: var(--fs-body); color: var(--ink); }
  .lines tr.discount td { color: var(--pt-green); }
  .lines tr.total td { padding-top: 20px; border-bottom: 0; font-family: var(--serif); font-weight: var(--fw-display); font-size: 26px; letter-spacing: var(--ls-heading); }
  .right { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .missing { color: var(--pt-red); font-size: var(--fs-small); }

  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .facts > div { padding: 13px 16px; border-radius: var(--r-md); background: var(--paper); min-width: 0; }
  .facts dt { font-size: 12.5px; color: var(--ink-quiet); margin-bottom: 3px; }
  .facts dd { font-size: var(--fs-small); color: var(--ink); overflow-wrap: anywhere; }
  .facts a { text-decoration: underline; text-underline-offset: 3px; }
  .refund-flag { padding: 14px 18px; border-radius: var(--r-md); background: var(--pt-red-bg); color: var(--pt-red); font-size: var(--fs-small); line-height: 1.65; }

  .billing { display: grid; gap: 4px; padding: 22px; border-radius: var(--r-lg); background: var(--paper); }
  .billing h2 { font-size: 17px; margin-bottom: 8px; }
  .billing label { display: grid; gap: 7px; margin-top: 12px; font-size: 13.5px; color: var(--ink-quiet); }
  .billing input { width: 100%; padding: 11px 14px; font-size: var(--fs-small); color: var(--ink); }
  .billing .btn { justify-self: start; margin-top: 14px; }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .actions h2 { flex-basis: 100%; margin-bottom: 6px; }
  .btn { margin: 0; }
  .btn.small { margin-left: 10px; }
  .invoice-line { flex-basis: 100%; font-size: var(--fs-small); display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .invoice-line a { text-decoration: underline; text-underline-offset: 3px; font-weight: var(--fw-medium); }
  .refund { flex-basis: 100%; display: grid; gap: 10px; margin-top: 8px; max-width: 460px; }
  .refund label { display: grid; gap: 7px; font-size: 13.5px; color: var(--ink-quiet); }
  .refund input { width: 100%; padding: 11px 14px; font-size: var(--fs-small); color: var(--ink); }
  .refund .btn { justify-self: start; }
  .action-status { flex-basis: 100%; min-height: 0; font-size: 14px; color: var(--ink-quiet); }

  /* The order's history, as a quiet vertical line. */
  .timeline { list-style: none; position: relative; display: grid; gap: 18px; padding-left: 22px; }
  .timeline::before { content: ''; position: absolute; left: 4px; top: 6px; bottom: 6px; width: 1.5px; background: var(--pt-hair); }
  .timeline li { position: relative; display: grid; gap: 2px; }
  .timeline li::before { content: ''; position: absolute; left: -22px; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--ink); box-shadow: 0 0 0 4px var(--white); }
  .t-time { font-size: 13px; color: var(--ink-quiet); }
  .t-kind { font-size: var(--fs-small); color: var(--ink); }
  .t-actor { font-size: 13px; color: var(--ink-quiet); }
  .empty { padding: 16px; border-radius: var(--r-md); background: var(--paper); color: var(--ink-quiet); font-size: var(--fs-small); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .grid > .col:last-child { position: static; }
  }
  @media (max-width: 600px) { .facts { grid-template-columns: 1fr; } }
</style>
