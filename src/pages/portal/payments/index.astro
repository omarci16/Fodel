---
/**
 * Admin ledger — every order FODEL has raised, and where each one stands.
 *
 * "Manual" is not an anomaly on this screen, it is the normal case: bank
 * transfer is FODEL's published payment method and card is the addition. The
 * status column distinguishes how money arrived, not whether it did.
 *
 * FODEL 1.2 adds a month/package/owner filter and a `?view=calendar` grid by
 * due_at — server-rendered, so the "no client state" rule that already holds
 * for this screen stays true of the calendar too.
 *
 * Deliberately not linked for owners — they see their own outstanding amount
 * on the listing itself, which is where the pay button lives.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { loadLedger, ledgerFilters, totalsByCurrency, money } from '~/lib/portal/payments';
import { PAYMENT_STATUS_LABEL as STATUS_LABEL, friendlyError } from '~/lib/portal/labels';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const params = Astro.url.searchParams;
const filters = ledgerFilters(params);
const filter = filters.status;
const month = params.get('month') ?? '';
const packageFilter = filters.packageId;
const ownerFilter = filters.owner;
const view = params.get('view') ?? 'list';

let orderRows: Awaited<ReturnType<typeof loadLedger>> = [];
let loadError: string | null = null;
try {
  // The calendar picks its own month from `month`; the list honours every filter.
  orderRows = await loadLedger(supabase, view === 'calendar' ? { ...filters, status: '', packageId: '', owner: '', month: '' } : filters);
} catch (error) {
  loadError = friendlyError((error as Error).message);
}

const totals = totalsByCurrency(orderRows);
const filtered = Boolean(filter || month || packageFilter || ownerFilter || view === 'overdue');

// The export mirrors the filter on screen.
const exportQuery = new URLSearchParams(params);
exportQuery.delete('view');
if (view === 'overdue') exportQuery.set('view', 'overdue');
const exportHref = `/api/portal/payments/export${exportQuery.size ? `?${exportQuery}` : ''}`;

const dateFmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'short', day: 'numeric' });

/* ── Calendar grid ─────────────────────────────────────────────────────── */
const calendarMonth = /^\d{4}-\d{2}$/.test(month) ? month : new Date().toISOString().slice(0, 7);
const [calYear, calMon] = calendarMonth.split('-').map(Number);
const firstOfMonth = new Date(Date.UTC(calYear, calMon - 1, 1));
const daysInMonth = new Date(Date.UTC(calYear, calMon, 0)).getUTCDate();
// Monday-first grid, matching the rest of the site's hu/nl locales.
const leadingBlanks = (firstOfMonth.getUTCDay() + 6) % 7;

const now = new Date();
const byDay = new Map<number, { order: (typeof orderRows)[number]; overdue: boolean }[]>();
if (view === 'calendar') {
  for (const o of orderRows) {
    const anchor = o.status === 'pending' ? o.dueAt : o.paidAt;
    if (!anchor) continue;
    const d = new Date(anchor);
    if (d.getUTCFullYear() !== calYear || d.getUTCMonth() !== calMon - 1) continue;
    const day = d.getUTCDate();
    const overdue = o.status === 'pending' && d < now;
    byDay.set(day, [...(byDay.get(day) ?? []), { order: o, overdue }]);
  }
}

const prevMonth = new Date(Date.UTC(calYear, calMon - 2, 1)).toISOString().slice(0, 7);
const nextMonth = new Date(Date.UTC(calYear, calMon, 1)).toISOString().slice(0, 7);
---

<Portal title="Fizetések">
  <header class="head">
    <p class="eyebrow">Fizetések</p>
    <h1>{orderRows.length} tétel</h1>
    <div class="view-toggle">
      <a href={`/portal/payments?${new URLSearchParams({ ...(filter && { status: filter }) })}`} aria-current={view === 'list' ? 'page' : undefined}>Lista</a>
      <a href="/portal/payments?view=overdue" aria-current={view === 'overdue' ? 'page' : undefined}>Lejárt</a>
      <a href={`/portal/payments?view=calendar&month=${calendarMonth}`} aria-current={view === 'calendar' ? 'page' : undefined}>Naptár</a>
    </div>
  </header>

  {loadError && <p class="notice error">{loadError}</p>}

  <section class="totals" aria-label="Összesítés pénznemenként">
    {totals.length === 0 && (
      <div class="total"><span class="n">—</span><span class="label">Nincs tétel{filtered ? ' ehhez a szűréshez' : ''}</span></div>
    )}
    {totals.map((t) => (
      <>
        <div class="total">
          <span class="n">{money(t.settled, t.currency)}</span>
          <span class="label">Beérkezett ({t.currency}){filtered ? ' · szűrve' : ''}</span>
        </div>
        <div class="total">
          <span class="n">{money(t.outstanding, t.currency)}</span>
          <span class="label">Kintlévőség ({t.currency})</span>
        </div>
        {t.refunded > 0 && (
          <div class="total">
            <span class="n">{money(t.refunded, t.currency)}</span>
            <span class="label">Visszatérítve ({t.currency})</span>
          </div>
        )}
      </>
    ))}
  </section>
  {totals.length > 1 && (
    <p class="hint">Eltérő pénznemek — az összegeket pénznemenként külön mutatjuk, átváltás nélkül.</p>
  )}

  {view === 'calendar' ? (
    <section class="calendar">
      <div class="cal-head">
        <a href={`/portal/payments?view=calendar&month=${prevMonth}`}>← Előző</a>
        <strong>{calendarMonth}</strong>
        <a href={`/portal/payments?view=calendar&month=${nextMonth}`}>Következő →</a>
      </div>
      <div class="cal-grid">
        {['H', 'K', 'Sze', 'Cs', 'P', 'Szo', 'V'].map((d) => <div class="cal-dow">{d}</div>)}
        {Array.from({ length: leadingBlanks }).map(() => <div class="cal-cell blank"></div>)}
        {Array.from({ length: daysInMonth }).map((_, i) => {
          const day = i + 1;
          const entries = byDay.get(day) ?? [];
          return (
            <div class="cal-cell">
              <span class="cal-day">{day}</span>
              {entries.map(({ order, overdue }) => (
                <a href={`/portal/payments/${order.id}`} class:list={['cal-entry', { overdue }]}>
                  {money(order.amountCents, order.currency)} · {order.ownerName ?? order.ownerEmail ?? '—'}
                </a>
              ))}
            </div>
          );
        })}
      </div>
    </section>
  ) : (
    <>
      <form method="GET" class="filters">
        <div class="chips">
          <a href="/portal/payments" aria-current={!filter ? 'page' : undefined}>Mind</a>
          {Object.entries(STATUS_LABEL).map(([value, label]) => (
            <a href={`/portal/payments?status=${value}`} aria-current={filter === value ? 'page' : undefined}>{label}</a>
          ))}
        </div>
        <div class="row">
          <input type="hidden" name="status" value={filter} />
          <label>Hónap <input type="month" name="month" value={month} /></label>
          <label>
            Csomag
            <select name="package">
              <option value="" selected={!packageFilter}>Mind</option>
              <option value="cheap-6m" selected={packageFilter === 'cheap-6m'}>Olcsó — 6 hónap</option>
              <option value="normal-12m" selected={packageFilter === 'normal-12m'}>Normál — 12 hónap</option>
            </select>
          </label>
          <label>Hirdető <input name="owner" value={ownerFilter} placeholder="név vagy e-mail" /></label>
          <button type="submit" class="btn">Szűrés</button>
          <a class="btn ghost" href={exportHref}>Excel export ({orderRows.length} tétel)</a>
        </div>
      </form>

      {orderRows.length > 0 ? (
        <table class="list">
          <thead>
            <tr><th>Dátum</th><th>Fizetés tárgya</th><th>Ügyfél</th><th>Fizetési mód</th><th class="right">Összeg</th><th>Állapot</th></tr>
          </thead>
          <tbody>
            {orderRows.map((o) => (
              <tr class:list={{ muted: o.status === 'cancelled' }}>
                <td>
                  {dateFmt.format(new Date(o.createdAt))}
                  {o.paidAt && <><br /><span class="sub">Fizetve: {dateFmt.format(new Date(o.paidAt))}</span></>}
                  {o.refundedAt && <><br /><span class="sub">Visszatérítve: {dateFmt.format(new Date(o.refundedAt))}</span></>}
                </td>
                <td class="items">
                  {o.items ?? <span class="missing">Hiányzó tételadat (régi rendelés)</span>}
                  <br />
                  {o.propertyId ? (
                    <a href={`/portal/properties/${o.propertyId}`}>#{o.propertyRef ?? '—'}{o.propertyTitle ? ` · ${o.propertyTitle}` : ''}</a>
                  ) : (
                    <span class="missing">Nincs kapcsolódó hirdetés</span>
                  )}
                </td>
                <td>
                  {o.ownerName ?? o.ownerEmail ?? '—'}
                  {o.billingName && o.billingName !== o.ownerName && <><br /><span class="sub">Számlázás: {o.billingName}</span></>}
                </td>
                <td class="sub">{o.method}</td>
                <td class="right amount">{money(o.amountCents, o.currency)}</td>
                <td>
                  <span class:list={['pill', `pill-${o.status}`]}>{o.statusLabel}</span>
                  {o.refundRequired && o.status !== 'refunded' && <><br /><span class="pill pill-refund">Visszatérítés szükséges</span></>}
                  <br /><a href={`/portal/payments/${o.id}`} class="detail-link">Részletek →</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="empty">Ehhez a szűréshez nincs tétel.</p>
      )}
    </>
  )}
</Portal>

<style>
  .head { margin-bottom: 20px; display: flex; align-items: baseline; gap: 20px; flex-wrap: wrap; }
  .eyebrow { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--taupe); margin-bottom: 8px; flex-basis: 100%; }
  h1 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 26px; color: var(--ink); }
  .view-toggle { display: flex; gap: 4px; }
  .view-toggle a { padding: 6px 14px; font-size: var(--fs-micro); letter-spacing: 0.04em; color: var(--taupe); border: 1px solid var(--border); }
  .view-toggle a[aria-current='page'] { background: var(--ink); color: var(--cream); border-color: var(--ink); }

  .totals { display: flex; flex-wrap: wrap; gap: 1px; background: var(--border); border: 1px solid var(--border); margin-bottom: 12px; max-width: 700px; }
  .total { min-width: 200px; }
  .hint { font-size: var(--fs-micro); color: var(--taupe); margin-bottom: 20px; }
  .notice.error { padding: 12px 16px; font-size: var(--fs-small); background: rgba(179, 38, 30, 0.06); border-left: 2px solid #b3261e; color: #b3261e; margin-bottom: 20px; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); display: inline-flex; align-items: center; }
  .missing { color: #b3261e; }
  .pill-refunded { background: rgba(179, 38, 30, 0.06); border-color: #b3261e; color: #b3261e; }
  .pill-refund { margin-top: 4px; background: rgba(179, 38, 30, 0.06); border-color: #b3261e; color: #b3261e; }
  .total { flex: 1; background: var(--cream); padding: 18px 20px; }
  .total .n { display: block; font-family: var(--serif); font-weight: var(--fw-medium); font-size: 22px; color: var(--ink); }
  .total .label { display: block; margin-top: 4px; font-size: var(--fs-micro); color: var(--taupe); }

  .filters { margin-bottom: 22px; }
  .chips { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 14px; }
  .chips a { padding: 7px 14px; font-size: var(--fs-micro); letter-spacing: 0.04em; color: var(--taupe); border: 1px solid var(--border); }
  .chips a[aria-current='page'] { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .row { display: flex; gap: 16px; flex-wrap: wrap; align-items: end; }
  .row label { display: flex; flex-direction: column; gap: 6px; font-size: var(--fs-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--taupe); }
  .row input, .row select { border: 1px solid var(--border); background: #fff; padding: 8px 10px; font-size: var(--fs-small); color: var(--ink); min-width: 120px; }
  .btn { padding: 9px 20px; background: var(--ink); color: var(--cream); font-size: var(--fs-micro); letter-spacing: var(--ls-button); text-transform: uppercase; height: 37px; }

  .empty { color: var(--taupe); font-size: var(--fs-small); padding: 32px 0; }

  .list { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .list th { text-align: left; font-size: var(--fs-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--taupe); padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .list td { padding: 12px; border-bottom: 1px solid var(--border); color: var(--ink); vertical-align: top; }
  .list tr.muted td { opacity: 0.5; }
  .list a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .detail-link { font-size: var(--fs-micro); }
  .sub { font-size: var(--fs-micro); color: var(--taupe); }
  .items { font-size: var(--fs-micro); color: var(--taupe); max-width: 40ch; }
  .right { text-align: right; }
  .amount { white-space: nowrap; font-variant-numeric: tabular-nums; }

  .pill { display: inline-block; font-size: var(--fs-micro); padding: 3px 10px; border: 1px solid var(--border); white-space: nowrap; }
  .pill-paid, .pill-manual { background: rgba(16, 42, 67, 0.08); border-color: var(--ink); }
  .pill-pending { background: rgba(200, 150, 0, 0.1); border-color: #96700b; color: #6b4f08; }

  .calendar { margin-top: 8px; }
  .cal-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; font-size: var(--fs-small); }
  .cal-head a { text-decoration: underline; text-underline-offset: 2px; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .cal-dow { background: var(--linen); padding: 6px; font-size: var(--fs-micro); text-align: center; color: var(--taupe); }
  .cal-cell { background: var(--cream); min-height: 84px; padding: 6px; display: flex; flex-direction: column; gap: 3px; }
  .cal-cell.blank { background: var(--linen); }
  .cal-day { font-size: var(--fs-micro); color: var(--taupe); }
  .cal-entry { display: block; font-size: 10px; line-height: 1.4; padding: 2px 4px; background: rgba(16, 42, 67, 0.08); color: var(--ink); }
  .cal-entry.overdue { background: rgba(179, 38, 30, 0.12); color: #b3261e; }

  @media (max-width: 860px) {
    .list { display: block; overflow-x: auto; }
    .cal-grid { font-size: 11px; }
    .cal-cell { min-height: 60px; }
  }
</style>
