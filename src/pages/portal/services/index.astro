---
/**
 * Admin — on-site service requests (brief 3 §F.4): €150 photo/video/drone and
 * €200 Gábor's visit, from the submit form, the listing editor or a
 * valuation. Filter by status, set the date, mark done or cancelled, jump to
 * the listing or valuation it belongs to.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { icon } from '~/lib/portal/icons';
import { timeAgo } from '~/lib/portal/time';
import {
  SERVICE_STATUS_LABEL,
  SERVICE_SOURCE_LABEL,
  serviceName,
  servicePrice,
  type ServiceStatus,
  type ServiceSource,
} from '~/lib/portal/service-requests';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const filter = Astro.url.searchParams.get('status') ?? 'open';

let query = supabase
  .from('service_requests')
  .select('id, service_id, status, source, property_id, valuation_id, contact_name, contact_email, contact_phone, locale, note, admin_note, scheduled_for, created_at, properties(ref)')
  .order('created_at', { ascending: false })
  .limit(300);
if (filter === 'open') query = query.in('status', ['requested', 'scheduled']);
else if (filter !== 'all') query = query.eq('status', filter);

const { data: rows, error } = await query;
const migrated = !error;

const dateFmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'short', day: 'numeric' });
const FILTERS: [string, string][] = [
  ['open', 'Folyamatban'],
  ['requested', SERVICE_STATUS_LABEL.requested],
  ['scheduled', SERVICE_STATUS_LABEL.scheduled],
  ['done', SERVICE_STATUS_LABEL.done],
  ['cancelled', SERVICE_STATUS_LABEL.cancelled],
  ['all', 'Mind'],
];
---

<Portal title="Helyszíni szolgáltatások">
  <header class="ph">
    <div>
      <p class="eyebrow">Helyszíni szolgáltatások</p>
      <h1>Kinek kell <em>szakember?</em></h1>
      <p class="lede">
        Profi fotózás, videó és drón (€ 150), illetve Gábor helyszíni látogatása értékbecsléssel (€ 200).
        A díj a hirdetés jóváhagyásakor a díjbekérőre kerül (előre bejelölve); az előre fizetésről még
        döntés szükséges.
      </p>
    </div>
    <p class="count"><b>{rows?.length ?? 0}</b><span>tétel</span></p>
  </header>

  {!migrated && <p class="notice error">Ehhez az oldalhoz futtassa le a 0015-ös migrációt.</p>}

  <div class="filters">
    {FILTERS.map(([value, label]) => (
      <a href={`/portal/services?status=${value}`} aria-current={filter === value ? 'page' : undefined}>{label}</a>
    ))}
  </div>

  {rows && rows.length > 0 ? (
    <ul class="list">
      {rows.map((row: any) => (
        <li class="item" data-id={row.id}>
          <div class="item-main">
            <p class="item-top">
              <span class:list={['pill', `pill-${row.status}`]}>{SERVICE_STATUS_LABEL[row.status as ServiceStatus] ?? row.status}</span>
              <span class="date" title={dateFmt.format(new Date(row.created_at))}>{timeAgo(row.created_at)}</span>
              <span class="source">{SERVICE_SOURCE_LABEL[row.source as ServiceSource] ?? row.source}</span>
            </p>
            <h2>{serviceName(row.service_id)} <span class="price">{servicePrice(row.service_id)}</span></h2>
            <p class="contact"><b>{row.contact_name ?? 'Névtelen'}</b> <span class="muted">· {row.locale === 'nl' ? 'holland' : 'magyar'}</span></p>
            <div class="reach">
              {row.contact_phone && <a class="chip" href={`tel:${row.contact_phone}`}><Fragment set:html={icon('phone', 16)} />{row.contact_phone}</a>}
              {row.contact_email && <a class="chip" href={`mailto:${row.contact_email}`}><Fragment set:html={icon('mail', 16)} />{row.contact_email}</a>}
            </div>
            {row.note && <p class="note">„{row.note}”</p>}
            <p class="links">
              {row.property_id && <a href={`/portal/properties/${row.property_id}`}>Hirdetés #{row.properties?.ref ?? ''} →</a>}
              {row.valuation_id && <a href={`/portal/valuations/${row.valuation_id}`}>Értékbecslés →</a>}
              {!row.property_id && !row.valuation_id && <span class="muted">Még nincs hozzá hirdetés (a regisztráció után kapcsolódik).</span>}
            </p>
          </div>
          <form class="item-edit" data-service-form>
            <label>Állapot
              <select name="status">
                {Object.entries(SERVICE_STATUS_LABEL).map(([value, label]) => (
                  <option value={value} selected={row.status === value}>{label}</option>
                ))}
              </select>
            </label>
            <label>Időpont <input type="date" name="scheduled_for" value={row.scheduled_for ?? ''} /></label>
            <label>Belső megjegyzés <textarea name="admin_note" rows="2" maxlength="2000">{row.admin_note ?? ''}</textarea></label>
            <button type="submit" class="btn">Mentés</button>
            <p class="status-line" role="status"></p>
          </form>
        </li>
      ))}
    </ul>
  ) : (
    migrated && (
      <div class="empty">
        <span class="empty-ic" set:html={icon('camera', 26)} />
        <p>Ehhez a szűréshez nincs tétel.</p>
      </div>
    )
  )}
</Portal>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-service-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const id = form.closest<HTMLElement>('[data-id]')?.dataset.id;
      const line = form.querySelector<HTMLElement>('.status-line');
      if (!id || !line) return;
      line.textContent = 'Mentés…';
      const data = new FormData(form);
      const res = await fetch(`/api/portal/services/${id}`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          status: data.get('status'),
          scheduledFor: data.get('scheduled_for') || null,
          adminNote: data.get('admin_note'),
        }),
      });
      const json = await res.json().catch(() => ({}));
      const ok = res.ok && json.ok;
      line.textContent = '';
      window.pf?.toast(ok ? 'Mentve.' : json.error || 'Nem sikerült menteni.', ok ? 'ok' : 'error');
    });
  });
</script>

<style>
  .ph { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 48px; margin-bottom: 30px; }
  .eyebrow { margin-bottom: 14px; }
  h1 em { font-style: normal; font-weight: inherit; color: var(--ink-quiet); }
  .lede { max-width: 66ch; margin-top: 14px; font-size: var(--fs-body); line-height: 1.7; color: var(--ink-quiet); }
  .count { display: flex; align-items: baseline; gap: 8px; }
  .count b { font-family: var(--serif); font-weight: var(--fw-display); font-size: 44px; line-height: 1; color: var(--ink); }
  .count span { color: var(--ink-quiet); }
  .filters { margin-bottom: 24px; }

  .list { list-style: none; padding: 0; display: grid; gap: 14px; }
  .item { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 28px; padding: clamp(20px, 2.4vw, 30px); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); overflow: clip; transition: box-shadow 0.35s var(--ease-out); }
  .item:hover { box-shadow: var(--shadow-md), 0 0 0 1px rgba(16, 42, 67, 0.14); }
  .item::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--ink); opacity: 0.18; }
  .item:has(.pill-requested)::before { background: #c99a1b; opacity: 1; }
  .item:has(.pill-scheduled)::before { background: var(--ink); opacity: 1; }
  .item:has(.pill-done)::before { background: var(--pt-green); opacity: 1; }
  .item-top { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; font-size: 13.5px; color: var(--ink-quiet); margin-bottom: 10px; }
  .item h2 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 20px; letter-spacing: var(--ls-heading); color: var(--ink); margin-bottom: 10px; line-height: 1.3; text-wrap: balance; }
  .price { color: var(--ink-quiet); font-weight: var(--fw-regular); white-space: nowrap; font-size: 17px; }
  .contact { font-size: var(--fs-body); color: var(--ink); }
  .muted { color: var(--ink-quiet); }
  .reach { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0 4px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px 7px 12px; border-radius: var(--r-pill); background: var(--paper); box-shadow: 0 0 0 1px var(--pt-hair); font-size: 14px; color: var(--ink); text-decoration: none; transition: background-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out); }
  .chip:hover { background: var(--white); box-shadow: 0 0 0 1px var(--ink); }
  .chip :global(svg) { width: 16px; height: 16px; color: var(--ink-quiet); }
  .links { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 14px; font-size: var(--fs-small); }
  .links a { text-decoration: underline; text-underline-offset: 3px; }
  .note { margin-top: 14px; padding: 12px 16px; border-radius: var(--r-md); background: var(--paper); font-size: var(--fs-small); color: var(--ink-quiet); white-space: pre-wrap; line-height: 1.65; }

  .item-edit { display: grid; gap: 12px; align-content: start; padding: 20px; border-radius: var(--r-lg); background: var(--paper); }
  .item-edit label { display: grid; gap: 6px; font-size: 13.5px; color: var(--ink-quiet); }
  .item-edit select, .item-edit input, .item-edit textarea { width: 100%; padding: 10px 14px; font-size: var(--fs-small); color: var(--ink); }
  .item-edit .btn { justify-self: start; }
  .status-line { min-height: 0; }

  .pill { padding: 4px 13px; border-radius: var(--r-pill); font-size: 13px; }
  .empty { display: grid; justify-items: center; gap: 14px; padding: 56px 20px; border-radius: var(--r-xl); background: var(--paper); box-shadow: 0 0 0 1px var(--pt-hair); text-align: center; color: var(--ink-quiet); }
  .empty-ic { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--white); color: var(--ink); box-shadow: var(--shadow-sm); }

  @media (max-width: 960px) {
    .item { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .item { transition: none; } }
</style>
