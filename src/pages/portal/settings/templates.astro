---
/**
 * Invite wording per language (brief §7). The final text comes from Gábor and
 * Éva; until a language has an approved version, Hungarian and Dutch use the
 * built-in text and English/German cannot be sent at all.
 *
 * Each saved version is previewed exactly as the recipient will see it,
 * including the fixed link-fallback and expiry lines, so approving it means
 * approving the whole email.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { SITE_URL } from '~/config/site.mjs';
import { INVITE_LOCALES, inviteTemplates } from '~/lib/portal/invites';
import { templates } from '~/lib/email/templates';
import { LOCALE_LABEL } from '~/lib/portal/labels';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const saved = Astro.url.searchParams.get('saved');
const err = Astro.url.searchParams.get('error');
const rows = await inviteTemplates(supabase);
const SAMPLE_URL = `${SITE_URL}/portal/invite/minta-link`;
---

<Portal title="Meghívólevelek">
  <header class="ph"><div>
    <p class="eyebrow"><a href="/portal/settings">← Beállítások</a></p>
    <h1>Meghívó<em>levelek</em></h1>
    <p class="lede">
      A hirdetőknek (tulajdonosoknak) szóló meghívó szövege nyelvenként. Élesben csak jóváhagyott
      szöveg megy ki: magyarul és hollandul addig az eddigi alapértelmezett szöveg, angolul és
      németül jóváhagyott szöveg nélkül meghívó nem küldhető.
    </p>
    <p class="lede">
      Admin meghívóra ezek a sablonok nem vonatkoznak: kollégák mindig a beépített admin szöveget
      kapják.
    </p>
  </div></header>

  {saved && <p class="notice ok" data-toast="ok">Mentve ({LOCALE_LABEL[saved] ?? saved}).</p>}
  {err && <p class="notice error">{decodeURIComponent(err)}</p>}

  <div class="set-stack">
  {INVITE_LOCALES.map((locale) => {
    const row = rows.get(locale);
    const builtIn = locale === 'hu' || locale === 'nl';
    const preview = row ? templates.inviteFromTemplate(locale, row, SAMPLE_URL) : null;
    return (
      <section class="lang set-card" id={locale}>
        <div class="lang-head">
          <h2>{LOCALE_LABEL[locale]}</h2>
          <span class:list={['pill', row?.approved ? 'pill-ok' : row ? 'pill-warn' : builtIn ? '' : 'pill-off']}>
            {row?.approved
              ? 'Jóváhagyva — ez megy ki'
              : row
                ? 'Piszkozat — nem megy ki'
                : builtIn
                  ? 'Alapértelmezett szöveg van használatban'
                  : 'Nincs szöveg — nem küldhető'}
          </span>
        </div>
        <form method="POST" action="/api/portal/settings/templates" class="tpl">
          <input type="hidden" name="locale" value={locale} />
          <label>Tárgy <input name="subject" value={row?.subject ?? ''} maxlength="150" required /></label>
          <label>Címsor <input name="heading" value={row?.heading ?? ''} maxlength="150" required /></label>
          <label>Szöveg <textarea name="body" rows="5" maxlength="3000" required>{row?.body ?? ''}</textarea></label>
          <label>Gomb felirata <input name="cta" value={row?.cta ?? ''} maxlength="60" required /></label>
          <label class="check">
            <input type="checkbox" name="approved" value="yes" checked={row?.approved} />
            Jóváhagyom: ez a szöveg mehet éles ügyfeleknek
          </label>
          <div class="actions">
            <button type="submit" class="btn">Mentés</button>
            {row && (
              <button type="submit" name="action" value="delete" class="btn ghost">
                {builtIn ? 'Visszaállítás az alapértelmezettre' : 'Törlés'}
              </button>
            )}
          </div>
        </form>
        {preview && (
          <details class="preview">
            <summary>Előnézet: „{preview.subject}”</summary>
            <iframe title={`Előnézet — ${LOCALE_LABEL[locale]}`} srcdoc={preview.html} loading="lazy"></iframe>
          </details>
        )}
      </section>
    );
  })}
  </div>
</Portal>

<style>
  .lang-head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; }
  .lang-head h2 { margin: 0; }
  .pill { padding: 4px 13px; border-radius: var(--r-pill); font-size: 13px; background: var(--linen); color: var(--ink-quiet); }
  .pill-ok { background: var(--pt-green-bg); color: var(--pt-green); }
  .pill-warn { background: var(--pt-amber-bg); color: var(--pt-amber); }
  .pill-off { background: var(--pt-red-bg); color: var(--pt-red); }

  .tpl { display: grid; gap: 18px; }
  .tpl label { display: grid; gap: 8px; font-size: var(--fs-small); font-weight: var(--fw-medium); color: var(--ink); }
  .tpl input:not([type='checkbox']), .tpl textarea { width: 100%; min-height: 50px; padding: 12px 16px; font-family: inherit; font-weight: var(--fw-body); font-size: var(--fs-body); color: var(--ink); }
  .tpl textarea { resize: vertical; line-height: 1.65; }
  .tpl .check { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: var(--r-md); background: var(--paper); font-weight: var(--fw-regular); cursor: pointer; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .preview { margin-top: 22px; border-radius: var(--r-lg); background: var(--paper); }
  .preview summary { cursor: pointer; padding: 14px 18px; font-size: var(--fs-small); color: var(--ink); list-style: none; }
  .preview summary::-webkit-details-marker { display: none; }
  .preview summary::after { content: '+'; float: right; font-size: 20px; line-height: 1; color: var(--ink-quiet); transition: transform 0.3s var(--ease-out); }
  .preview[open] summary::after { transform: rotate(45deg); }
  .preview iframe { display: block; width: calc(100% - 24px); height: 620px; margin: 0 12px 12px; border: 0; border-radius: var(--r-md); background: #fff; box-shadow: 0 0 0 1px var(--pt-hair); }
</style>
