---
export const prerender = false;
import Portal from '~/layouts/Portal.astro';
const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');
const { data: company } = await supabase.from('site_settings').select('*').eq('id', 1).single();
if (!company) return new Response('Futtassa a 0012 migrációt.', { status: 503 });
---
<Portal title="Cégadatok">
  <header class="ph">
    <div>
      <p class="eyebrow"><a href="/portal/settings">← Beállítások</a></p>
      <h1>Cég<em>adatok</em></h1>
      <p class="lede">A nyilvános oldalak legfeljebb 1 percen belül frissülnek.</p>
    </div>
  </header>
  {Astro.url.searchParams.has('saved') && <p class="notice ok" data-toast="ok">Mentve.</p>}
  {Astro.url.searchParams.get('error') && <p class="notice error">{Astro.url.searchParams.get('error')}</p>}
  <form method="POST" action="/api/portal/settings/company" class="set-stack" id="company-form">
    <section class="set-card"><h2>Azonosítás</h2><div class="set-grid">
    <label>Jogi név<input name="name_legal" value={company.names.legal} required /></label>
    <label>Magyar márkanév<input name="name_hu" value={company.names.hu} required /></label>
    <label>Holland márkanév<input name="name_nl" value={company.names.nl} required /></label>
    <label>Kapcsolattartó<input name="principal" value={company.principal} required /></label>
    <label>Alapítás éve<input name="founded" type="number" value={company.founded} required /></label>
    <label>Alapítás helye<input name="founded_in" value={company.founded_in} required /><small>A magyar felületen a Den Haag név „Hága” alakban jelenik meg; a jogi cím változatlan marad.</small></label>
    </div></section>
    <section class="set-card"><h2>Elérhetőségek</h2><div class="set-grid">
    {(company.phones ?? []).map((phone: any, index: number) => <div class="phone"><label>Telefon {index + 1}<input name={`phone_${index}`} value={phone.display} /></label><label><input type="checkbox" name={`phone_${index}_public`} value="yes" checked={phone.public} /> Nyilvános</label></div>)}
    <label>E-mail<input name="email" type="email" value={company.emails.primary} required /></label>
    <label>WhatsApp-szám<input name="whatsapp" type="tel" value={company.whatsapp ?? ''} placeholder="+36301234567" disabled={!('whatsapp' in company)} /><small>{'whatsapp' in company
      ? 'Nemzetközi formátumban. Üresen hagyva a WhatsApp-gombok nem jelennek meg. Csak valós, ellenőrzött számot adjon meg.'
      : 'A mezőhöz futtassa le a 0014-es migrációt.'}</small></label>
    </div></section>
    <section class="set-card"><h2>Cím és nyilvántartás</h2><div class="set-grid">
    <label>Utca<input name="street" value={company.address.street} /></label><label>Irányítószám<input name="postal_code" value={company.address.postalCode} /></label><label>Város<input name="city" value={company.address.city} /></label><label>Teljes jogi cím<input name="address_one_line" value={company.address.oneLine} /></label><label>KvK<input name="kvk" value={company.registration.kvk ?? ''} /></label>
    <label>VAT / BTW<input name="vat" value={company.registration.vat ?? ''} /></label>
    <label class="check"><input type="checkbox" name="vat_verified" value="yes" checked={company.registration.vatVerified} /> VAT ellenőrizve</label>
    </div></section>
    <section class="set-card"><h2>Nyitvatartás és pénzügy</h2><div class="set-grid">
    <label>Hétköznap kezdés<input name="hours_from" type="time" value={company.hours.weekdays.from} /></label>
    <label>Hétköznap zárás<input name="hours_to" type="time" value={company.hours.weekdays.to} /></label>
    <label>Visszahívás eddig<input name="callback_to" type="time" value={company.hours.callback.to} /></label>
    <label class="check"><input type="checkbox" name="callback_weekends" value="yes" checked={company.hours.callback.includesWeekends} /> Hétvégén is</label>
    <label>NL IBAN<input name="iban" value={company.banks.nl.iban} /></label>
    <label>BIC<input name="bic" value={company.banks.nl.bic} /></label>
    <label>HU bankszámla<input name="hu_account" value={company.banks.hu.account} /></label>
    </div></section>
    <section class="set-card"><h2>Közösségi és elérés</h2><div class="set-grid">
    <label>YouTube<input name="youtube" type="url" value={company.social.youtube} /></label>
    <label>Facebook NL<input name="facebook_nl" type="url" value={company.social.facebookNl} /></label>
    <label>Facebook HU<input name="facebook_hu" type="url" value={company.social.facebookHu} /></label>
    <label>Országok száma<input name="reach_countries" type="number" min="1" value={company.reach.countries} /></label>
    <label>Nyelvek száma<input name="reach_languages" type="number" min="1" value={company.reach.languages} /></label>
    </div></section>
    <div class="pt-savebar" id="savebar" data-state="clean"><div class="pt-savebar-in"><p class="pt-savebar-msg"><span class="dot"></span><span id="savebar-txt">Minden módosítás mentve</span></p><button type="submit" class="btn">Mentés</button></div></div>
  </form>
</Portal>
<script>
  const form = document.getElementById('company-form');
  const bar = document.getElementById('savebar');
  const txt = document.getElementById('savebar-txt');
  if (form && bar && txt) {
    form.addEventListener('input', () => {
      bar.dataset.state = 'dirty';
      txt.textContent = 'Nem mentett módosítások';
    });
  }
</script>

<style>
  .phone { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 18px 20px; align-items: end; grid-column: 1 / -1; }
  .phone label.check { padding-bottom: 14px; }
  .set-grid > label { margin: 0; }
  .set-grid > h3 { grid-column: 1 / -1; }
  .set-grid .phone label { margin: 0; }
  @media (max-width: 720px) { .phone { grid-template-columns: 1fr; } }
</style>
