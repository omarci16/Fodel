---
/**
 * Service and automation switches (brief §1/A, §4, §7, §8).
 *
 * The valuation switches are live settings. The two automations are shown so
 * the team can see they exist and what they are waiting for, but cannot be
 * turned on here — see /api/portal/settings/services.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { valuationPackages } from '~/lib/valuation/packages';
import { SERVICES_DEFAULT, AUTOMATION_DEFAULT, type Services, type Automation } from '~/lib/runtime-config';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const { data: row } = await supabase.from('site_settings').select('*').eq('id', 1).maybeSingle();
const migrated = Boolean(row && 'services' in row);
const services: Services = { ...SERVICES_DEFAULT, ...(row?.services ?? {}) };
const automation: Automation = { ...AUTOMATION_DEFAULT, ...(row?.automation ?? {}) };
const packages = valuationPackages(services);
const packageHint: Record<string, string> = {
  indicative: 'Az ingyenes, AI-támogatott tájékoztató becslés. Az ára nem módosítható.',
  expert_visit: 'Helyszíni látogatás. Üresen hagyott ár esetén „árajánlat alapján” jelenik meg.',
  judicial: 'Hivatalos / igazságügyi értékbecslés. Üresen hagyott ár esetén „árajánlat alapján” jelenik meg.',
};
const saved = Astro.url.searchParams.has('saved');
const err = Astro.url.searchParams.get('error');
---

<Portal title="Szolgáltatások">
  <header class="ph">
    <div>
      <p class="eyebrow"><a href="/portal/settings">← Beállítások</a></p>
      <h1>Szolgáltatások és <em>automatizmusok</em></h1>
      <p class="lede">A nyilvános oldalak a mentés után legfeljebb néhány percen belül frissülnek.</p>
    </div>
  </header>

  {!migrated && <p class="notice error">Ezekhez a beállításokhoz futtassa le a 0014-es migrációt.</p>}
  {saved && <p class="notice ok" data-toast="ok">Mentve.</p>}
  {err && <p class="notice error">{err}</p>}

  <form method="POST" action="/api/portal/settings/services" class="set-stack" id="services-form">
    <fieldset disabled={!migrated}>
      <section class="set-card">
      <h2>Értékbecslés</h2>
      <label class="check">
        <input type="checkbox" name="valuation_entry" value="yes" checked={services.valuationEntry} />
        <span>
          <strong>Belépési pont a főoldalon és a láblécben</strong>
          Csak akkor kapcsolja be, ha a beérkező kéréseket munkatárs ténylegesen feldolgozza
          (Értékbecslések menü). Kikapcsolva az űrlap közvetlen címen elérhető marad, de a főoldal nem
          irányít rá forgalmat.
        </span>
      </label>
      <label class="check">
        <input type="checkbox" name="valuation_free" value="yes" checked={services.valuationFreeConfirmed} />
        <span>
          <strong>Az alapbecslés díjmentessége megerősítve</strong>
          Amíg nincs bejelölve, a weboldal sehol nem nevezi a becslést „ingyenesnek”.
        </span>
      </label>

      <h3>Tájékoztatás a becslés jellegéről</h3>
      <p class="hint">
        Az értékbecslési űrlap alatt megjelenő szöveg. Üresen hagyva az eddigi szöveg marad érvényben.
        Csak jóváhagyott megfogalmazást mentsen: ne ígérjen pontosságot, azonnali eredményt vagy hivatalos
        szakvéleményt.
      </p>
      <label class="text">Magyar<textarea name="notice_hu" rows="3" maxlength="800">{services.valuationNotice?.hu ?? ''}</textarea></label>
      <label class="text">Holland<textarea name="notice_nl" rows="3" maxlength="800">{services.valuationNotice?.nl ?? ''}</textarea></label>

      <h3>Becslési csomagok</h3>
      <p class="hint">A három csomag neve és ára a nyilvános űrlapon, az e-mailekben és a fizetésnél is ezekből jön. Bankkártyás fizetés csak akkor jelenik meg, ha a Stripe be van kapcsolva és a csomagnak van fix ára.</p>
      {packages.map((pkg) => (
        <div class="pkg">
          <p class="pkg-title"><strong>{pkg.names.hu}</strong> <span>{packageHint[pkg.kind]}</span></p>
          <div class="pkg-row">
            <label class="text">Név (magyar)<input type="text" name={`pkg_${pkg.kind}_name_hu`} maxlength="120" value={pkg.names.hu} /></label>
            <label class="text">Név (holland)<input type="text" name={`pkg_${pkg.kind}_name_nl`} maxlength="120" value={pkg.names.nl} /></label>
            <label class="text">Ár (€)<input type="number" name={`pkg_${pkg.kind}_price`} min="0" max="100000" step="1" value={pkg.priceEur ?? ''} disabled={pkg.priceLocked} placeholder="árajánlat" /></label>
          </div>
          {pkg.kind !== 'indicative' && <label class="check"><input type="checkbox" name={`pkg_${pkg.kind}_enabled`} value="yes" checked={pkg.enabled} /><span><strong>Elérhető az űrlapon</strong></span></label>}
        </div>
      ))}

      <h3>Becslési adatok és megjelenítés</h3>
      <p class="hint">Az azonnali megjelenítés csak akkor kapcsolható be, ha a statisztikai sáv és a minimális adatszám is meg van adva. A módszert Gábornak valós eseteken ellenőriznie kell.</p>
      <label class="text">Statisztikai sáv ± (%)<input type="number" name="valuation_band_percent" min="1" max="100" step="0.1" value={services.valuationBandPercent ?? ''} /></label>
      <label class="text">Minimum adatszám<input type="number" name="valuation_min_count" min="3" step="1" value={services.valuationMinCount ?? ''} /></label>
      <label class="text">EUR/HUF árfolyam (1 EUR = HUF)<input type="number" name="eur_huf_rate" min="1" step="0.01" value={services.eurHufRate ?? ''} /></label>
      <label class="text">Árfolyam dátuma<input type="date" name="eur_huf_rate_date" value={services.eurHufRateDate ?? ''} /></label>
      <label class="check"><input type="checkbox" name="instant_valuation" value="yes" checked={services.instantValuation} /><span><strong>Azonnali becslés megjelenítése</strong>Alapállapotban kikapcsolva. Csak megfelelő adatbázis és szakmai jóváhagyás után kapcsolja be.</span></label>
      </section>
      <section class="set-card">
      <h2>Becslési szempontok</h2>
      <p class="hint">A plusz/mínusz tényezők ma csak szövegesen jelennek meg a kérésen és az eredményen. Százalékos módosítás nincs, a tábla üres. Bekapcsolás előtt Gábornak ki kell töltenie a százalékokat valós esetek alapján.</p>
      <label class="check locked">
        <input type="checkbox" disabled />
        <span>
          <strong>Százalékos kiigazítás — előkészítve, kikapcsolva</strong>
          Üres tábla: minden szempont semleges. Automatikus szorzót a kód nem alkalmaz.
        </span>
      </label>
      </section>
      <section class="set-card">
      <h2>Visszatérítési szabály</h2>
      <p class="hint">Csak jóváhagyott szabályt írjon ide. Üresen hagyva sehol nem jelenik meg.</p>
      <label class="text">Magyar<textarea name="refund_hu" rows="4" maxlength="2000">{services.refundPolicy?.hu ?? ''}</textarea></label>
      <label class="text">Holland<textarea name="refund_nl" rows="4" maxlength="2000">{services.refundPolicy?.nl ?? ''}</textarea></label>
      </section>
      <section class="set-card">
      <h2>Automatizmusok</h2>
      <label class="check locked">
        <input type="checkbox" disabled checked={automation.registrationReminder} />
        <span>
          <strong>Emlékeztető félbehagyott regisztráció után — előkészítve, kikapcsolva</strong>
          Bekapcsolás előtt szükséges: végleges levélszöveg, időzítés, feladó, és az adatkezelési alap
          (az általános adatkezelési elfogadás nem marketinghozzájárulás). A küldés ismétlésbiztos, és a
          befejezett regisztráció törli a függő emlékeztetőt.
        </span>
      </label>
      <label class="check locked">
        <input type="checkbox" disabled checked={automation.inviteAutomation} />
        <span>
          <strong>Automatikus meghívás / hirdetői engedélyezés — előkészítve, kikapcsolva</strong>
          Bekapcsolás előtt szükségesek az automatikus engedélyezés feltételei. A kapcsoló kizárólag a
          meghívásra vonatkozhat: a hirdetések közzététele mindig munkatársi jóváhagyáshoz kötött marad.
        </span>
      </label>
      </section>
      <div class="pt-savebar" id="savebar" data-state="clean"><div class="pt-savebar-in"><p class="pt-savebar-msg"><span class="dot"></span><span id="savebar-txt">Minden módosítás mentve</span></p><button type="submit" class="btn">Mentés</button></div></div>
    </fieldset>
  </form>
</Portal>

<script>
  const form = document.getElementById('services-form');
  const bar = document.getElementById('savebar');
  const txt = document.getElementById('savebar-txt');
  if (form && bar && txt) {
    form.addEventListener('input', () => {
      bar.dataset.state = 'dirty';
      txt.textContent = 'Nem mentett módosítások';
    });
  }
</script>

<style>
  .set-stack fieldset { display: grid; gap: 20px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .set-card { display: grid; gap: 16px; align-content: start; }
  h2 { margin-bottom: 0; }
  h3 { margin-top: 12px; font-size: 12.5px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: var(--fw-medium); color: var(--ink-quiet); }
  .hint { font-size: 14.5px; line-height: 1.7; color: var(--ink-quiet); max-width: 64ch; }
  .check { display: grid; grid-template-columns: 22px 1fr; gap: 14px; align-items: start; padding: 14px 16px; border-radius: var(--r-md); background: var(--paper); font-size: var(--fs-small); line-height: 1.6; color: var(--ink-quiet); cursor: pointer; transition: background-color 0.2s var(--ease-out); }
  .check:hover { background: var(--linen); }
  .check input { margin-top: 2px; }
  .check strong { display: block; color: var(--ink); font-weight: var(--fw-medium); }
  .check.locked { opacity: 0.7; cursor: default; }
  .text { display: grid; gap: 8px; font-size: var(--fs-small); font-weight: var(--fw-medium); color: var(--ink); }
  .text input, .text textarea { width: 100%; min-height: 50px; padding: 12px 16px; font-family: inherit; font-weight: var(--fw-body); font-size: var(--fs-body); color: var(--ink); }
  .text textarea { min-height: 110px; resize: vertical; line-height: 1.6; }
  .pkg { display: grid; gap: 14px; padding: 18px 20px; border-radius: var(--r-lg); background: var(--paper); }
  .pkg-title { font-size: var(--fs-small); color: var(--ink); line-height: 1.6; }
  .pkg-title span { display: block; color: var(--ink-quiet); font-size: 14px; }
  .pkg-row { display: grid; grid-template-columns: 1fr 1fr 130px; gap: 14px; }
  .pkg-row input { width: 100%; }
  .pkg .check { background: var(--white); }
  @media (max-width: 720px) { .pkg-row { grid-template-columns: 1fr; } }
</style>
