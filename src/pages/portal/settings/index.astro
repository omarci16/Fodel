---
export const prerender = false;

import Portal from '~/layouts/Portal.astro';

const { profile } = Astro.locals;
const saved = Astro.url.searchParams.get('saved');
const err = Astro.url.searchParams.get('error');
---

<Portal title="Beállítások">
  <header class="head">
    <p class="eyebrow">Beállítások</p>
    <h1>Profil</h1>
  </header>

  {saved === 'profile' && <p class="notice ok">Profil mentve.</p>}
  {saved === 'password' && <p class="notice ok">Jelszó megváltoztatva.</p>}
  {err && <p class="notice error">{decodeURIComponent(err)}</p>}

  <form method="POST" action="/api/portal/settings/profile" class="panel">
    <h2>Adatok</h2>
    <div class="field">
      <label for="full_name">Teljes név</label>
      <input id="full_name" name="full_name" value={profile?.full_name ?? ''} />
    </div>
    <div class="field">
      <label for="phone">Telefonszám</label>
      <input id="phone" name="phone" value={profile?.phone ?? ''} />
    </div>
    <div class="field">
      <label>E-mail cím</label>
      <p class="readonly">{profile?.email}</p>
    </div>
    <button type="submit" class="btn">Mentés</button>
  </form>

  <form method="POST" action="/api/portal/settings/password" class="panel">
    <h2>Jelszó megváltoztatása</h2>
    <div class="field">
      <label for="password">Új jelszó</label>
      <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password" />
    </div>
    <div class="field">
      <label for="password2">Új jelszó ismét</label>
      <input id="password2" name="password2" type="password" required minlength="8" autocomplete="new-password" />
    </div>
    <button type="submit" class="btn">Jelszó módosítása</button>
  </form>
</Portal>

<style>
  .head { margin-bottom: 24px; }
  .eyebrow { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--taupe); margin-bottom: 8px; }
  h1 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 28px; color: var(--ink); }
  h2 { font-family: var(--serif); font-size: 18px; color: var(--ink); margin-bottom: 18px; }

  .notice { padding: 12px 16px; font-size: var(--fs-small); margin-bottom: 20px; }
  .notice.ok { background: rgba(16, 42, 67, 0.06); border-left: 2px solid var(--ink); }
  .notice.error { background: rgba(179, 38, 30, 0.06); border-left: 2px solid #b3261e; color: #b3261e; }

  .panel { max-width: 420px; padding: 28px 0; border-top: 1px solid var(--border); }
  .field { display: flex; flex-direction: column; margin-bottom: 18px; }
  label { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--taupe); margin-bottom: 8px; }
  .readonly { font-size: var(--fs-body); color: var(--ink); padding: 11px 0; }
  input { border: 1px solid var(--border); background: #fff; padding: 11px 12px; font-size: var(--fs-body); color: var(--ink); }
  input:focus-visible { outline: var(--focus-ring); outline-offset: 2px; }

  .btn { padding: 12px 24px; background: var(--ink); color: var(--cream); font-size: var(--fs-micro); letter-spacing: var(--ls-button); text-transform: uppercase; }
</style>
