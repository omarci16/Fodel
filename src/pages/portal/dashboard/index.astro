---
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { STATUS_LABEL } from '~/lib/portal/properties';
import { formatCents } from '~/lib/orders';

const { supabase, profile } = Astro.locals;
const isAdmin = profile?.role === 'admin';

// Row-Level Security already scopes this to "my own properties" for an owner
// and "everything" for an admin — the query itself doesn't need to know which.
const { data: rows } = await supabase.from('properties').select('id, status, ref');

const counts: Record<string, number> = {
  draft: 0,
  submitted: 0,
  awaiting_payment: 0,
  changes_requested: 0,
  published: 0,
  sold: 0,
};
for (const row of rows ?? []) {
  if (row.status in counts) counts[row.status]++;
}

// Enquiries needing a reply — scoped by RLS the same way, so this is "mine"
// for an owner and "everyone's" for an admin.
const { count: openEnquiries } = await supabase
  .from('enquiries')
  .select('id', { count: 'exact', head: true })
  .eq('handled', false);

let pendingReview = 0;
let ownerCount = 0;
let outstandingCents = 0;
if (isAdmin) {
  const { count } = await supabase
    .from('properties')
    .select('id', { count: 'exact', head: true })
    .eq('status', 'submitted');
  pendingReview = count ?? 0;

  const { count: owners } = await supabase
    .from('profiles')
    .select('id', { count: 'exact', head: true })
    .eq('role', 'owner');
  ownerCount = owners ?? 0;

  const { data: openOrders } = await supabase
    .from('payments')
    .select('amount_cents')
    .eq('status', 'pending');
  outstandingCents = (openOrders ?? []).reduce((sum, o) => sum + o.amount_cents, 0);
}

/** An owner's own listing waiting on them to pay — the one thing they must act on. */
const myAwaitingPayment = !isAdmin ? counts.awaiting_payment : 0;
---

<Portal title="Áttekintés">
  <header class="head">
    <p class="eyebrow">Áttekintés</p>
    <h1>Üdvözöljük, {profile?.full_name ?? profile?.email}</h1>
  </header>

  {
    isAdmin && pendingReview > 0 && (
      <a class="callout" href="/portal/properties?status=submitted">
        <strong>{pendingReview}</strong> hirdetés vár elbírálásra →
      </a>
    )
  }

  {
    myAwaitingPayment > 0 && (
      <a class="callout" href="/portal/properties?status=awaiting_payment">
        <strong>{myAwaitingPayment}</strong> jóváhagyott hirdetése fizetésre vár — a díj
        rendezése után azonnal megjelenik →
      </a>
    )
  }

  {
    (openEnquiries ?? 0) > 0 && (
      <a class="callout ghost" href="/portal/enquiries">
        <strong>{openEnquiries}</strong> elintézetlen érdeklődés →
      </a>
    )
  }

  <section class="stats">
    {
      Object.entries(counts).map(([status, n]) => (
        <a class="stat" href={`/portal/properties?status=${status}`}>
          <span class="n">{n}</span>
          <span class="label">{STATUS_LABEL[status]}</span>
        </a>
      ))
    }
  </section>

  {
    isAdmin && (
      <section class="admin-row">
        <a class="stat" href="/portal/users">
          <span class="n">{ownerCount}</span>
          <span class="label">Regisztrált hirdető</span>
        </a>
        <a class="stat" href="/portal/payments?status=pending">
          <span class="n">{formatCents(outstandingCents)}</span>
          <span class="label">Kintlévőség</span>
        </a>
      </section>
    )
  }

  <div class="actions">
    <a class="btn" href="/portal/properties/new">+ Új ingatlan</a>
    <a class="btn ghost" href="/portal/properties">Összes ingatlan</a>
  </div>
</Portal>

<style>
  .head {
    margin-bottom: 32px;
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--taupe);
    margin-bottom: 8px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: var(--fw-display);
    font-size: 32px;
    color: var(--ink);
  }

  .callout {
    display: block;
    background: var(--ink);
    color: var(--cream);
    padding: 16px 20px;
    margin-bottom: 12px;
    font-size: var(--fs-body);
    line-height: 1.6;
  }
  .callout:hover {
    opacity: 0.92;
  }
  .callout.ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--border);
  }
  .callout.ghost:hover {
    border-color: var(--ink);
    opacity: 1;
  }

  .stats,
  .admin-row {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .stats {
    grid-template-columns: repeat(6, 1fr);
    margin-top: 20px;
  }
  .admin-row {
    grid-template-columns: repeat(2, 1fr);
    max-width: 420px;
  }
  .stat {
    background: var(--cream);
    padding: 20px 16px;
    text-align: center;
  }
  .stat:hover {
    background: var(--linen);
  }
  .stat .n {
    display: block;
    font-family: var(--serif);
    font-weight: var(--fw-medium);
    font-size: 26px;
    color: var(--ink);
  }
  .stat .label {
    display: block;
    margin-top: 4px;
    font-size: var(--fs-micro);
    line-height: 1.4;
    color: var(--taupe);
  }

  .actions {
    display: flex;
    gap: 14px;
    margin-top: 32px;
  }
  .btn {
    padding: 12px 24px;
    background: var(--ink);
    color: var(--cream);
    font-size: var(--fs-micro);
    letter-spacing: var(--ls-button);
    text-transform: uppercase;
  }
  .btn.ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
