---
/**
 * Property editor — one long sectioned form, not tabs (per the build plan:
 * friendlier for a non-technical Hungarian seller, simpler to build).
 * Sections: basics · location · details · features · media · translations.
 *
 * Saving here only ever touches field values. Moving the listing through the
 * workflow (submit for review, approve, request changes, mark sold) is a
 * separate action with its own endpoint — see /api/portal/properties/[id]/status.ts
 * (Stage 4) — so "save my edits" and "change what state this listing is in"
 * can never be accidentally conflated in one submit.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import Field from '~/components/forms/Field.astro';
import { getProperty, STATUS_LABEL, CATEGORY_LABEL, EPC_OPTIONS, LOCALE_OPTIONS } from '~/lib/portal/properties';
import { FEATURES, COUNTIES } from '~/data/features';
import { resolveImage } from '~/lib/property-images';

/** A demo photo (bare filename) needs Astro's asset pipeline to become a real URL; a real upload already is one. */
function mediaSrc(storagePath: string): string {
  if (storagePath.startsWith('http')) return storagePath;
  return resolveImage(storagePath).src;
}

const { supabase, profile, user } = Astro.locals;
const { id } = Astro.params;
const isAdmin = profile?.role === 'admin';

const property = await getProperty(supabase, id!);
if (!property) {
  return new Response('Ingatlan nem található, vagy nincs hozzáférése.', { status: 404 });
}

const isOwnProperty = property.owner_id === user?.id;
if (!isAdmin && !isOwnProperty) {
  return new Response('Nincs hozzáférése ehhez az ingatlanhoz.', { status: 403 });
}

const editable = isAdmin || ['draft', 'changes_requested'].includes(property.status);

const saved = Astro.url.searchParams.get('saved') === '1';
const err = Astro.url.searchParams.get('error');

const trByLocale = Object.fromEntries(property.translations.map((t) => [t.locale, t]));
const hero = property.media.find((m) => m.is_hero) ?? property.media[0];
const gallery = property.media.filter((m) => m !== hero);
---

<Portal title={`Ingatlan #${property.ref}`}>
  <header class="head">
    <p class="eyebrow">
      #{property.ref} · <span class="status">{STATUS_LABEL[property.status] ?? property.status}</span>
    </p>
    <h1>{trByLocale.hu?.title || 'Névtelen hirdetés'}</h1>
    {isAdmin && property.status === 'submitted' && (
      <a class="review-link" href={`/portal/review/${property.id}`}>Elbírálás megnyitása →</a>
    )}
  </header>

  {saved && <p class="notice ok">Mentve.</p>}
  {err && <p class="notice error">Nem sikerült menteni: {err}</p>}

  {!editable && (
    <p class="notice warn">
      Ez a hirdetés jelenleg <strong>{STATUS_LABEL[property.status]}</strong> állapotban van, ezért
      a mezők nem szerkeszthetők. {property.status === 'submitted' && 'Amint elbírálásra kerül, ismét szerkesztheti, ha javítás szükséges.'}
    </p>
  )}

  <form method="POST" action={`/api/portal/properties/${property.id}/update`} class="editor">
    <fieldset disabled={!editable}>

      <section id="basics">
        <h2>Alapadatok</h2>
        <div class="grid-2">
          <Field locale="hu" name="category" label="Típus" type="select" required
            options={Object.entries(CATEGORY_LABEL).map(([value, label]) => ({ value, label }))}
            value={property.category} />
          <div class="field">
            <label>Azonosító</label>
            <p class="readonly">#{property.ref}</p>
          </div>
        </div>
      </section>

      <section id="location">
        <h2>Elhelyezkedés</h2>
        <div class="grid-2">
          <Field locale="hu" name="settlement" label="Település" required value={property.settlement} />
          <Field locale="hu" name="county" label="Megye" type="select" required value={property.county}
            options={COUNTIES.map((c) => ({ value: c, label: c }))} />
          <Field locale="hu" name="region" label="Régió" required value={property.region} />
          <Field locale="hu" name="precision" label="Pontosság" type="select" value={property.precision}
            options={[{ value: 'approximate', label: 'Közelítő (a pontos cím rejtve marad)' }, { value: 'exact', label: 'Pontos' }]} />
          <Field locale="hu" name="lat" label="Szélesség (lat)" type="number" required value={String(property.lat)}
            hint="Pl. 46.79 — Google Maps-en jobb klikk a helyre megadja." />
          <Field locale="hu" name="lng" label="Hosszúság (lng)" type="number" required value={String(property.lng)} />
        </div>
      </section>

      <section id="details">
        <h2>Részletek</h2>
        <div class="grid-2">
          <Field locale="hu" name="price_eur" label="Ár (EUR)" type="number" required value={String(property.price_eur)} />
          <Field locale="hu" name="price_huf" label="Ár (HUF)" type="number" required value={String(property.price_huf)} />
          <Field locale="hu" name="price_asof" label="Árfolyam dátuma" type="text" value={property.price_asof}
            hint="ÉÉÉÉ-HH-NN formátumban" />
          <Field locale="hu" name="floor_m2" label="Alapterület (m²)" type="number" value={property.floor_m2 != null ? String(property.floor_m2) : ''} />
          <Field locale="hu" name="plot_m2" label="Telekterület (m²)" type="number" required value={String(property.plot_m2)} />
          <Field locale="hu" name="bedrooms" label="Hálószobák" type="number" value={property.bedrooms != null ? String(property.bedrooms) : ''} />
          <Field locale="hu" name="bathrooms" label="Fürdőszobák" type="number" value={property.bathrooms != null ? String(property.bathrooms) : ''} />
          <Field locale="hu" name="year_built" label="Építés éve" type="number" value={property.year_built != null ? String(property.year_built) : ''} />
          <Field locale="hu" name="renovated_in" label="Felújítás éve" type="number" value={property.renovated_in != null ? String(property.renovated_in) : ''} />
          <Field locale="hu" name="epc_class" label="Energetikai besorolás" type="select" value={property.epc_class}
            options={EPC_OPTIONS.map((v) => ({ value: v, label: v === 'pending' ? 'Folyamatban' : v === 'exempt' ? 'Nem kötelező' : v }))} />
          <Field locale="hu" name="video_url" label="Videó URL (YouTube)" type="url" value={property.video_url ?? ''} />
        </div>
        <label class="checkbox">
          <input type="checkbox" name="price_negotiable" value="yes" checked={property.price_negotiable} />
          Az ár alkuképes
        </label>
        {property.status === 'published' && (
          <label class="checkbox">
            <input type="checkbox" name="reserved" value="yes" checked={property.reserved} />
            Foglalt (ideiglenesen levéve a piacról, de a hirdetés élő marad)
          </label>
        )}
      </section>

      <section id="features">
        <h2>Jellemzők</h2>
        <div class="checkbox-grid">
          {Object.entries(FEATURES).map(([key, labels]) => (
            <label class="checkbox">
              <input type="checkbox" name="features" value={key} checked={property.features.includes(key)} />
              {labels.hu}
            </label>
          ))}
        </div>
      </section>

      <section id="seller">
        <h2>Eladó elérhetősége</h2>
        <p class="hint">
          A FODEL egyedi modellje: ha ehhez hozzájárul, a neve és telefonszáma megjelenik a
          hirdetésen, hogy a vevő közvetlenül is felvehesse Önnel a kapcsolatot.
        </p>
        <label class="checkbox">
          <input type="checkbox" name="seller_contact_visible" value="yes" checked={property.seller_contact_visible} />
          Nevem és telefonszámom megjelenítése a hirdetésben
        </label>
        <div class="grid-2">
          <Field locale="hu" name="seller_name" label="Név" value={property.seller_name ?? ''} />
          <Field locale="hu" name="seller_phone" label="Telefonszám" type="tel" value={property.seller_phone ?? ''} />
        </div>
        <div class="checkbox-grid">
          {LOCALE_OPTIONS.map((l) => (
            <label class="checkbox">
              <input type="checkbox" name="seller_speaks" value={l.value} checked={property.seller_speaks.includes(l.value)} />
              {l.label}
            </label>
          ))}
        </div>
      </section>

      <section id="translations">
        <h2>Szövegek</h2>
        <div class="locale-tabs" role="tablist">
          {LOCALE_OPTIONS.map((l, i) => (
            <button type="button" class="locale-tab" data-locale-tab={l.value} aria-selected={i === 0}>
              {l.label}
            </button>
          ))}
        </div>
        {LOCALE_OPTIONS.map((l, i) => {
          const t = trByLocale[l.value];
          const required = l.value === 'hu';
          return (
            <div class="locale-panel" data-locale-panel={l.value} hidden={i !== 0}>
              <Field locale="hu" name={`title_${l.value}`} label="Cím" required={required} value={t?.title ?? ''} />
              <Field locale="hu" name={`subtitle_${l.value}`} label="Alcím" value={t?.subtitle ?? ''} />
              <Field locale="hu" name={`description_${l.value}`} label="Rövid leírás" type="textarea" rows={3} required={required} value={t?.description ?? ''} />
              <Field locale="hu" name={`body_${l.value}`} label="Részletes leírás" type="textarea" rows={8} value={t?.body ?? ''}
                hint="Bekezdéseket üres sorral válasszon el." />
              <div class="grid-2">
                <Field locale="hu" name={`condition_${l.value}`} label="Állapot" value={t?.condition ?? ''} />
                <Field locale="hu" name={`heating_${l.value}`} label="Fűtés" value={t?.heating ?? ''} />
                <Field locale="hu" name={`tag_${l.value}`} label="Kiemelő címke (pl. Kiemelt, Vízpart)" value={t?.tag ?? ''} />
              </div>
            </div>
          );
        })}
      </section>

      <div class="save-row">
        <button type="submit" class="btn">Mentés</button>
      </div>
    </fieldset>
  </form>

  <section class="workflow">
    {['draft', 'changes_requested'].includes(property.status) && (
      <button type="button" class="btn" id="submit-btn">Beküldés elbírálásra</button>
    )}
    {property.status === 'published' && (
      <button type="button" class="btn ghost" id="sold-btn">Megjelölés eladottként</button>
    )}
    <p class="workflow-status" id="workflow-status" role="status"></p>
  </section>

  <section id="media" class="media-section">
    <h2>Fényképek</h2>
    <p class="hint">Húzza ide a képeket, vagy kattintson a tallózáshoz. JPG, PNG vagy WebP, max. 12 MB.</p>

    <div class="media-grid" id="media-grid" data-property-id={property.id}>
      {hero && (
        <figure class="media-item" data-media-id={hero.id} data-hero="true">
          <img src={mediaSrc(hero.storage_path)} alt="" />
          <span class="hero-badge">Címlapkép</span>
          <button type="button" class="remove" data-remove-media={hero.id} aria-label="Törlés">×</button>
        </figure>
      )}
      {gallery.map((m) => (
        <figure class="media-item" data-media-id={m.id}>
          <img src={mediaSrc(m.storage_path)} alt="" />
          <button type="button" class="set-hero" data-set-hero={m.id}>Címlapképnek</button>
          <button type="button" class="remove" data-remove-media={m.id} aria-label="Törlés">×</button>
        </figure>
      ))}
    </div>

    <label class="dropzone" id="dropzone">
      <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp" multiple hidden />
      <span>+ Fotók hozzáadása</span>
    </label>
    <p class="upload-status" id="upload-status" role="status"></p>
  </section>
</Portal>

<script define:vars={{ propertyId: property.id }}>
  // Locale tabs — plain show/hide, no framework.
  document.querySelectorAll('[data-locale-tab]').forEach((tab) => {
    tab.addEventListener('click', () => {
      const locale = tab.getAttribute('data-locale-tab');
      document.querySelectorAll('[data-locale-tab]').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      document.querySelectorAll('[data-locale-panel]').forEach((p) => {
        p.hidden = p.getAttribute('data-locale-panel') !== locale;
      });
    });
  });

  // Media upload: drag-drop, click-to-browse, progress, reorder, set-hero, delete.
  const grid = document.getElementById('media-grid');
  const dropzone = document.getElementById('dropzone');
  const fileInput = document.getElementById('file-input');
  const status = document.getElementById('upload-status');

  async function uploadFiles(files) {
    for (const file of files) {
      status.textContent = `Feltöltés: ${file.name}…`;
      const body = new FormData();
      body.append('file', file);
      try {
        const res = await fetch(`/api/portal/properties/${propertyId}/media`, { method: 'POST', body });
        const json = await res.json();
        if (!res.ok || !json.ok) throw new Error(json.error ?? 'upload-failed');
      } catch {
        status.textContent = `Nem sikerült feltölteni: ${file.name}`;
        return;
      }
    }
    status.textContent = 'Kész — az oldal frissül…';
    location.reload();
  }

  dropzone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => fileInput.files && uploadFiles([...fileInput.files]));
  ['dragover', 'dragenter'].forEach((evt) =>
    dropzone?.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.add('drag'); })
  );
  ['dragleave', 'drop'].forEach((evt) =>
    dropzone?.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.remove('drag'); })
  );
  dropzone?.addEventListener('drop', (e) => {
    if (e.dataTransfer?.files) uploadFiles([...e.dataTransfer.files]);
  });

  const workflowStatus = document.getElementById('workflow-status');

  async function doAction(action, note) {
    const res = await fetch(`/api/portal/properties/${propertyId}/status`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ action, note }),
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.ok) {
      const messages = {
        'no-photos': 'Legalább egy fényképet fel kell tölteni a beküldés előtt.',
      };
      workflowStatus.textContent = messages[json.error] || 'Nem sikerült végrehajtani.';
      return;
    }
    location.reload();
  }

  document.getElementById('submit-btn')?.addEventListener('click', () => {
    if (confirm('Biztosan beküldi ezt a hirdetést elbírálásra?')) doAction('submit');
  });
  document.getElementById('sold-btn')?.addEventListener('click', () => {
    if (confirm('Megjelöli ezt a hirdetést eladottként? A hirdetés lekerül az élő listáról.')) doAction('mark_sold');
  });

  grid?.addEventListener('click', async (e) => {
    const target = e.target;
    if (!(target instanceof HTMLElement)) return;

    const removeId = target.getAttribute('data-remove-media');
    if (removeId) {
      if (!confirm('Biztosan törli ezt a képet?')) return;
      await fetch(`/api/portal/properties/${propertyId}/media/${removeId}`, { method: 'DELETE' });
      location.reload();
      return;
    }

    const heroId = target.getAttribute('data-set-hero');
    if (heroId) {
      await fetch(`/api/portal/properties/${propertyId}/media/${heroId}`, {
        method: 'PATCH',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ isHero: true }),
      });
      location.reload();
    }
  });
</script>

<style>
  .head { margin-bottom: 20px; }
  .eyebrow { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--taupe); margin-bottom: 8px; }
  .status { color: var(--ink); font-weight: 500; }
  h1 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 28px; color: var(--ink); }
  .review-link { display: inline-block; margin-top: 10px; font-size: var(--fs-small); text-decoration: underline; }

  .notice { padding: 12px 16px; font-size: var(--fs-small); margin-bottom: 20px; }
  .notice.ok { background: rgba(16, 42, 67, 0.06); border-left: 2px solid var(--ink); }
  .notice.error { background: rgba(179, 38, 30, 0.06); border-left: 2px solid #b3261e; color: #b3261e; }
  .notice.warn { background: rgba(200, 150, 0, 0.08); border-left: 2px solid #96700b; color: #6b4f08; }

  fieldset { border: none; padding: 0; margin: 0; }
  fieldset:disabled { opacity: 0.6; }

  section { padding: 28px 0; border-top: 1px solid var(--border); }
  section:first-of-type { border-top: none; }
  h2 { font-family: var(--serif); font-size: 19px; color: var(--ink); margin-bottom: 18px; }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  .field { display: flex; flex-direction: column; margin-bottom: 22px; }
  .field label { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-label); text-transform: uppercase; color: var(--taupe); margin-bottom: 9px; }
  .readonly { font-size: var(--fs-body); color: var(--ink); padding: 13px 0; }

  .hint { font-size: var(--fs-small); color: var(--taupe); line-height: 1.7; margin-bottom: 14px; }

  .checkbox { display: flex; align-items: center; gap: 8px; font-size: var(--fs-small); color: var(--ink); margin-bottom: 10px; }
  .checkbox-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 16px; }

  .locale-tabs { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
  .locale-tab { padding: 8px 16px; font-size: var(--fs-micro); letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid var(--border); background: transparent; color: var(--taupe); }
  .locale-tab[aria-selected='true'] { background: var(--ink); color: var(--cream); border-color: var(--ink); }

  .save-row { padding: 28px 0; }
  .btn { padding: 13px 32px; background: var(--ink); color: var(--cream); font-size: var(--fs-micro); letter-spacing: var(--ls-button); text-transform: uppercase; margin-right: 12px; }
  .btn:hover { opacity: 0.9; }
  .btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }

  .workflow { padding: 24px 0; border-top: 1px solid var(--border); }
  .workflow-status { font-size: var(--fs-small); color: var(--taupe); margin-top: 12px; }

  .media-section { padding-top: 28px; border-top: 1px solid var(--border); margin-top: 8px; }
  .media-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; margin: 18px 0; }
  .media-item { position: relative; aspect-ratio: 4/3; background: var(--mist); overflow: hidden; }
  .media-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-badge { position: absolute; top: 6px; left: 6px; background: var(--ink); color: var(--cream); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; }
  .set-hero { position: absolute; bottom: 6px; left: 6px; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; background: rgba(244,244,242,0.92); color: var(--ink); padding: 4px 8px; }
  .remove { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; background: rgba(16,42,67,0.85); color: var(--cream); border-radius: 50%; line-height: 1; }

  .dropzone { display: flex; align-items: center; justify-content: center; padding: 32px; border: 1px dashed var(--border); cursor: pointer; font-size: var(--fs-small); color: var(--taupe); }
  .dropzone.drag { border-color: var(--ink); color: var(--ink); background: var(--linen); }
  .upload-status { font-size: var(--fs-small); color: var(--taupe); margin-top: 10px; min-height: 1.5em; }

  @media (max-width: 720px) {
    .grid-2 { grid-template-columns: 1fr; }
    .checkbox-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
