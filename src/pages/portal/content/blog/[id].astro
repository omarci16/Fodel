---
/**
 * Blog post editor: Markdown body + live preview, an SEO panel (SERP
 * preview, length meters, heading-outline and internal-link checks, reading
 * time), cover/OG upload through the existing sharp pipeline, a Facebook
 * share preview, a copy-link button, a translation-link control, and the
 * publish toggle.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { SITE_URL } from '~/config/site.mjs';
import { BLOG_LOCALES, BLOG_PATH, PLACEHOLDER_PREFIX, isBlogLocale, type BlogLocale } from '~/lib/blog';
import { MAX_UPLOAD_MB } from '~/lib/media';
import { icon } from '~/lib/portal/icons';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const { id } = Astro.params;
const { data: post } = await supabase.from('blog_posts').select('*').eq('id', id).maybeSingle();
if (!post) return new Response('Cikk nem található.', { status: 404 });
const locale: BlogLocale = isBlogLocale(post.locale) ? post.locale : 'hu';
const kind = post.kind === 'case_study' ? 'case_study' : 'article';
const migrated = 'kind' in post;

const { data: categoryTerms } = await supabase
  .from('taxonomy_terms')
  .select('key, labels')
  .eq('group_key', 'blog_category')
  .eq('enabled', true)
  .order('sort_order');
const labelFor = (term: any, lang: string) => term.labels?.[lang] || term.labels?.hu;

// Every language version linked to this one.
const { data: groupRows } = post.group_id
  ? await supabase.from('blog_posts').select('id, locale, title, published, published_at').eq('group_id', post.group_id).neq('id', id)
  : { data: [] };
const versions = groupRows ?? [];
const versionLocales = new Set([locale, ...versions.map((v: any) => v.locale)]);
const missingLocales = BLOG_LOCALES.filter((l) => !versionLocales.has(l));
const missingForeign = missingLocales.filter((l) => l !== 'hu');

// Posts in other languages that could be linked as this one's translation.
const { data: candidates } = await supabase
  .from('blog_posts')
  .select('id, title, locale, group_id')
  .neq('locale', locale)
  .neq('id', id)
  .order('updated_at', { ascending: false })
  .limit(100);
const linkable = (candidates ?? []).filter((c: any) => !versionLocales.has(c.locale) && (!c.group_id || c.group_id !== post.group_id));

const isLive = post.published && post.published_at && new Date(post.published_at).getTime() <= Date.now();
const publicUrl = isLive ? `${SITE_URL}${BLOG_PATH[locale]}${post.slug}/` : null;
const placeholder = String(post.title).startsWith(PLACEHOLDER_PREFIX);
const LANG = { hu: 'Magyar', nl: 'Holland', en: 'Angol', de: 'Német' } as const;
---

<Portal title={post.title || 'Új cikk'}>
  <header class="ph">
    <p class="crumbs"><a href="/portal/content/blog">← Blog</a><span>{kind === 'case_study' ? 'Esettanulmány' : 'Cikk'} · {locale.toUpperCase()}</span></p>
    <div class="ph-row">
      <h1 id="page-title">{post.title || '(névtelen)'}</h1>
      <span class:list={['state', { live: post.published }]} id="status-pill">{post.published ? 'Publikus' : 'Piszkozat'}</span>
    </div>
  </header>

  {placeholder && (
    <p class="notice">
      Ez egy üresen létrehozott nyelvi változat. Írja meg a címet és a szöveget ezen a nyelven — amíg
      a cím „{PLACEHOLDER_PREFIX}” előtaggal kezdődik, a cikk nem publikálható.
    </p>
  )}

  <form id="editor" class="editor">
    <div class="col main">
      <section class="ed-card writer">
      <label class="title-field">Cím <input name="title" value={post.title} required placeholder="Mi a cikk címe?" /></label>
      <div class="row">
        <label>URL (slug) <input name="slug" value={post.slug} required /></label>
        <label>Nyelv
          <select name="locale" disabled={post.published} title={post.published ? 'Publikus cikk nyelve nem módosítható' : undefined}>
            {BLOG_LOCALES.map((l) => (
              <option value={l} selected={l === locale} disabled={l !== locale && versionLocales.has(l)}>{l.toUpperCase()}</option>
            ))}
          </select>
        </label>
        <label>Típus
          <select name="kind" id="kind" disabled={!migrated}>
            <option value="article" selected={kind === 'article'}>Cikk</option>
            <option value="case_study" selected={kind === 'case_study'}>Esettanulmány</option>
          </select>
        </label>
        <label>Kategória
          <select name="category" id="blog-category">
            <option value="" selected={!post.category}>Válasszon…</option>
            {post.category && !(categoryTerms ?? []).some((term: any) => labelFor(term, locale) === post.category) && <option value={post.category} selected>{post.category}</option>}
            {(categoryTerms ?? []).map((term: any) => <option
              value={labelFor(term, locale)}
              data-hu={labelFor(term, 'hu')}
              data-nl={labelFor(term, 'nl')}
              data-en={labelFor(term, 'en')}
              data-de={labelFor(term, 'de')}
              selected={labelFor(term, locale) === post.category}
            >{labelFor(term, locale)}</option>)}
          </select>
        </label>
      </div>
      <p class="hint">Új kategória a <a href="/portal/taxonomy#blog_category">Szótár</a> oldalon vehető fel.</p>
      <label>Kivonat <textarea name="excerpt" rows="2">{post.excerpt}</textarea></label>

      <div class="toolbar" role="toolbar" aria-label="Beszúrás a szövegbe">
        <label class="tool">
          <input type="file" id="inline-file" accept="image/jpeg,image/png,image/webp" hidden />
          <span><Fragment set:html={icon('image', 16)} /> Kép beszúrása</span>
        </label>
        <button type="button" class="tool" id="insert-link"><Fragment set:html={icon('link', 16)} /> Link beszúrása</button>
        <span class="hint" id="toolbar-status">JPG, PNG vagy WebP, legfeljebb {MAX_UPLOAD_MB} MB.</span>
      </div>

      <div class="body-grid">
        <label class="body-label">Szöveg (Markdown)
          <textarea name="bodyMd" id="body-md" rows="24">{post.body_md}</textarea>
        </label>
        <div class="preview-pane">
          <p class="preview-label">Előnézet</p>
          <div class="prose" id="preview"></div>
        </div>
      </div>

      </section>

      <fieldset class="case-fields ed-card" id="case-fields" hidden={kind !== 'case_study'} disabled={!migrated}>
        <legend>Esettanulmány</legend>
        <p class="hint">
          Csak valós, ellenőrizhető adatot írjon ide. A kitöltött részek külön fejezetként jelennek meg a
          cikk alatt; az üresen hagyottak nem.
        </p>
        <label>Módszertan <textarea name="caseMethod" rows="4">{post.case_method ?? ''}</textarea></label>
        <label>Eredmények <textarea name="caseResults" rows="4">{post.case_results ?? ''}</textarea></label>
        <label>Források <textarea name="caseSources" rows="3" placeholder="Egy forrás soronként, lehetőleg linkkel">{post.case_sources ?? ''}</textarea></label>
      </fieldset>

      <div class="seo-panel ed-card">
        <h2>Keresőbarát megjelenés (SEO)</h2>
        <label>SEO cím <input name="seoTitle" id="seo-title" value={post.seo_title ?? ''} maxlength="70" /></label>
        <p class="meter" id="seo-title-meter"></p>
        <label>SEO leírás <textarea name="seoDescription" id="seo-desc" rows="2" maxlength="160">{post.seo_description ?? ''}</textarea></label>
        <p class="meter" id="seo-desc-meter"></p>

        <div class="serp">
          <p class="serp-title" id="serp-title"></p>
          <p class="serp-url"><span id="serp-prefix">{SITE_URL}{BLOG_PATH[locale]}</span><span id="serp-slug">{post.slug}</span>/</p>
          <p class="serp-desc" id="serp-desc"></p>
        </div>

        <ul class="seo-checks" id="seo-checks">
          <li id="check-h1">—</li>
          <li id="check-links">—</li>
          <li id="check-reading">—</li>
        </ul>
      </div>

    </div>

    <div class="col side">
      <section class="panel ed-card">
        <h2>Megjelenés</h2>
        <label class="checkbox"><input type="checkbox" name="featured" checked={post.featured} /> Kiemelt írás</label>
        <p class="hint">A kiemelt írások előrébb jelennek meg a blog főoldalán.</p>
      </section>

      <section class="panel ed-card">
        <h2>Borítókép</h2>
        {post.cover_url && <img src={post.cover_url} alt="" class="thumb" />}
        <input type="file" id="cover-file" accept="image/jpeg,image/png,image/webp" />
        <p class="hint" id="cover-status"></p>
      </section>

      <section class="panel ed-card">
        <h2>OG kép (megosztáshoz)</h2>
        {post.og_image_url && <img src={post.og_image_url} alt="" class="thumb" />}
        <input type="file" id="og-file" accept="image/jpeg,image/png,image/webp" />
        <p class="hint" id="og-status"></p>

        <div class="fb-preview">
          <div class="fb-media">{(post.og_image_url || post.cover_url) && <img src={post.og_image_url || post.cover_url} alt="" />}</div>
          <div class="fb-body">
            <p class="fb-domain">FODEL.NL</p>
            <p class="fb-title" id="fb-title">{post.title}</p>
            <p class="fb-desc" id="fb-desc">{post.excerpt}</p>
          </div>
        </div>
      </section>

      <section class="panel ed-card">
        <h2>Nyelvi változatok</h2>
        <ul class="versions">
          <li><strong>{locale.toUpperCase()}</strong> — ez a változat</li>
          {versions.map((v: any) => (
            <li>
              <a href={`/portal/content/blog/${v.id}`}>{String(v.locale).toUpperCase()}</a> —
              {v.published ? ' publikus' : String(v.title).startsWith(PLACEHOLDER_PREFIX) ? ' fordításra vár' : ' piszkozat'}
            </li>
          ))}
        </ul>
        {missingLocales.length > 0 && (
          <div class="version-actions">
            <p class="hint">
              Üres, összekapcsolt piszkozatot hoz létre. Ez nem fordítás: minden nyelvi változatot külön kell
              megírni és publikálni.
            </p>
            {missingLocales.length > 1 && (
              <button type="button" class="btn ghost small" data-versions={missingLocales.join(',')}>Összes nyelv</button>
            )}
            {missingForeign.length > 1 && missingForeign.length !== missingLocales.length && (
              <button type="button" class="btn ghost small" data-versions={missingForeign.join(',')}>Összes külföldi nyelv</button>
            )}
            {missingLocales.map((l) => (
              <button type="button" class="btn ghost small" data-versions={l}>+ {LANG[l]}</button>
            ))}
          </div>
        )}
        {linkable.length > 0 && (
          <label class="link-existing">Meglévő cikk összekapcsolása
            <select id="link-target">
              <option value="">Válasszon…</option>
              {linkable.map((c: any) => <option value={c.id}>{String(c.locale).toUpperCase()} · {c.title}</option>)}
            </select>
          </label>
        )}
        {versions.length > 0 && <button type="button" class="btn ghost small" id="unlink-btn">Leválasztás a csoportról</button>}
        <p class="hint" id="versions-status" role="status"></p>
      </section>

      {publicUrl && (
        <section class="panel ed-card">
          <h2>Publikus link</h2>
          <input class="readonly-input" id="public-link" value={publicUrl} readonly />
          <button type="button" class="btn ghost small" id="copy-link-btn">Másolás</button>
        </section>
      )}
    </div>
    <div class="pt-savebar" id="savebar" data-state="clean">
      <div class="pt-savebar-in">
        <p class="pt-savebar-msg" role="status"><span class="dot"></span><span id="action-status" class="action-status">Minden módosítás mentve</span></p>
        <button type="button" class="btn ghost" id="publish-btn" data-published={post.published ? 'yes' : 'no'}>{post.published ? 'Visszavonás' : 'Publikálás'}</button>
        <button type="submit" class="btn">Mentés <kbd>⌘S</kbd></button>
      </div>
    </div>
  </form>

  <section class="danger-zone">
    <div>
      <h2>Írás törlése</h2>
      <p>A törlés végleges: a cikk és ennek a nyelvi változatnak a tartalma elvész.</p>
    </div>
    <button type="button" class="btn ghost danger" id="delete-btn">Törlés</button>
  </section>
</Portal>

<script>
  import { exposeShrinkImage } from '~/scripts/shrink-image';
  exposeShrinkImage();
</script>

<script define:vars={{ postId: post.id, blogPaths: BLOG_PATH }}>
  const form = document.getElementById('editor');
  form.addEventListener('input', () => {
    dirty = true;
    setBar('dirty', 'Nem mentett módosítások');
  });
  window.addEventListener('beforeunload', (event) => {
    if (dirty) event.preventDefault();
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
      event.preventDefault();
      form.requestSubmit();
    }
  });
  const actionStatus = document.getElementById('action-status');
  const bar = document.getElementById('savebar');
  let dirty = false;
  function setBar(state, text) {
    bar.dataset.state = state;
    actionStatus.textContent = text;
  }
  const bodyMd = document.getElementById('body-md');
  const preview = document.getElementById('preview');
  const seoTitle = document.getElementById('seo-title');
  const seoDesc = document.getElementById('seo-desc');
  const slugInput = form.querySelector('[name="slug"]');
  const titleInput = form.querySelector('[name="title"]');
  const localeInput = form.querySelector('[name="locale"]');
  const categoryInput = document.getElementById('blog-category');

  async function post(url, body, isJson = true) {
    const res = await fetch(url, {
      method: 'POST',
      ...(isJson
        ? { headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }
        : { body }),
    });
    return { ok: res.ok, json: await res.json().catch(() => ({})) };
  }

  let previewTimer;
  async function renderPreview() {
    clearTimeout(previewTimer);
    previewTimer = setTimeout(async () => {
      const { json } = await post('/api/portal/content/blog/preview', { bodyMd: bodyMd.value });
      preview.innerHTML = json.html ?? '';
      runSeoChecks();
    }, 400);
  }

  function runSeoChecks() {
    const md = bodyMd.value;
    const h1Count = (md.match(/^#\s/gm) ?? []).length;
    const h2Count = (md.match(/^##\s/gm) ?? []).length;
    document.getElementById('check-h1').textContent = `Kiemelések: ${h2Count} H2 (a cím a H1, ne ismételje a szövegben)${h1Count > 0 ? ' — ⚠ # a szövegben' : ''}`;

    const linkCount = (md.match(/\]\(\/(hu|nl)\//g) ?? []).length;
    document.getElementById('check-links').textContent = `Belső linkek: ${linkCount}`;

    const words = md.split(/\s+/).filter(Boolean).length;
    document.getElementById('check-reading').textContent = `Olvasási idő: ~${Math.max(1, Math.round(words / 200))} perc (${words} szó)`;

    document.getElementById('seo-title-meter').textContent = `${seoTitle.value.length} / 70 karakter`;
    document.getElementById('seo-desc-meter').textContent = `${seoDesc.value.length} / 160 karakter`;
    document.getElementById('serp-title').textContent = seoTitle.value || titleInput.value || '(cím)';
    document.getElementById('serp-desc').textContent = seoDesc.value || form.querySelector('[name="excerpt"]').value || '(leírás)';
    document.getElementById('serp-slug').textContent = slugInput.value;
    const locale = form.querySelector('[name="locale"]').value;
    document.getElementById('serp-prefix').textContent = `${location.origin}${blogPaths[locale] ?? '/'}`;
    document.getElementById('fb-title').textContent = titleInput.value;
    document.getElementById('fb-desc').textContent = form.querySelector('[name="excerpt"]').value;
  }

  bodyMd.addEventListener('input', renderPreview);
  [seoTitle, seoDesc, slugInput, titleInput].forEach((el) => el.addEventListener('input', runSeoChecks));
  localeInput.addEventListener('change', () => {
    const locale = localeInput.value;
    categoryInput?.querySelectorAll('option[data-hu]').forEach((option) => {
      const label = option.dataset[locale] || option.dataset.hu;
      option.value = label;
      option.textContent = label;
    });
    runSeoChecks();
  });
  renderPreview();

  slugInput.addEventListener('blur', () => {
    slugInput.value = slugInput.value.trim().toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-+|-+$/g, '');
  });

  const kindInput = document.getElementById('kind');
  const caseFields = document.getElementById('case-fields');
  kindInput?.addEventListener('change', () => {
    if (caseFields) caseFields.hidden = kindInput.value !== 'case_study';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    setBar('saving', 'Mentés…');
    const fd = new FormData(form);
    const { ok, json } = await post(`/api/portal/content/blog/${postId}`, {
      action: 'save',
      locale: localeInput.value,
      kind: kindInput?.value ?? 'article',
      slug: fd.get('slug'),
      title: fd.get('title'),
      category: fd.get('category'),
      excerpt: fd.get('excerpt'),
      bodyMd: fd.get('bodyMd'),
      seoTitle: fd.get('seoTitle'),
      seoDescription: fd.get('seoDescription'),
      caseMethod: fd.get('caseMethod') ?? '',
      caseResults: fd.get('caseResults') ?? '',
      caseSources: fd.get('caseSources') ?? '',
      featured: fd.get('featured') === 'on',
    });
    if (ok && json.ok) {
      dirty = false;
      setBar('clean', 'Minden módosítás mentve');
      window.pf.toast('Mentve.');
    } else {
      setBar('dirty', json.error || 'Nem sikerült menteni.');
      window.pf.toast(json.error || 'Nem sikerült menteni.', 'error');
    }
  });

  document.getElementById('publish-btn')?.addEventListener('click', async (event) => {
    const willPublish = event.currentTarget.dataset.published !== 'yes';
    if (willPublish && !(await window.pf.confirm({
      title: 'Publikálja az írást?',
      body: dirty ? 'Vannak még nem mentett módosítások — a publikálás csak a legutóbb mentett változatot teszi közzé. Előbb mentsen.' : 'A mentett változat azonnal nyilvános lesz a weboldalon.',
      confirmLabel: 'Publikálás',
    }))) return;
    actionStatus.textContent = willPublish ? 'Publikálás…' : 'Visszavonás…';
    const { ok, json } = await post(`/api/portal/content/blog/${postId}`, { action: willPublish ? 'publish' : 'unpublish' });
    if (ok && json.ok) location.reload();
    else actionStatus.textContent = json.error || 'Nem sikerült.';
  });

  document.getElementById('delete-btn')?.addEventListener('click', async () => {
    const typed = (document.querySelector('input[name="title"]'))?.value?.trim() || '';
    const confirmed = typed
      ? await window.pf.confirmType({
          title: 'Nyelvi változat végleges törlése',
          body: 'Ez a változat véglegesen törlődik, nem vonható vissza.',
          expected: typed,
        })
      : await window.pf.confirm({ title: 'Törli ezt a nyelvi változatot?', body: 'Ez nem vonható vissza.', confirmLabel: 'Törlés', danger: true });
    if (!confirmed) return;
    const { ok } = await post(`/api/portal/content/blog/${postId}`, { action: 'delete' });
    if (ok) location.href = '/portal/content/blog';
  });

  const versionsStatus = document.getElementById('versions-status');
  document.querySelectorAll('[data-versions]').forEach((button) => {
    button.addEventListener('click', async () => {
      const locales = button.dataset.versions.split(',');
      versionsStatus.textContent = 'Létrehozás…';
      const { ok, json } = await post(`/api/portal/content/blog/${postId}`, { action: 'create_versions', locales });
      if (ok && json.ok) location.reload();
      else versionsStatus.textContent = json.error || 'Nem sikerült létrehozni.';
    });
  });

  document.getElementById('link-target')?.addEventListener('change', async (e) => {
    const targetId = e.target.value;
    if (!targetId) return;
    const { ok, json } = await post(`/api/portal/content/blog/${postId}`, { action: 'link_translation', targetId });
    if (ok && json.ok) location.reload();
    else versionsStatus.textContent = json.error || 'Nem sikerült összekapcsolni.';
  });

  document.getElementById('unlink-btn')?.addEventListener('click', async () => {
    if (!(await window.pf.confirm({ title: 'Leválasztja a nyelvi változatot?', body: 'Ez a változat önálló írás lesz, a többi nyelvi változattól függetlenül.', confirmLabel: 'Leválasztás', danger: true }))) return;
    await post(`/api/portal/content/blog/${postId}`, { action: 'link_translation', targetId: null });
    location.reload();
  });

  /** Inserts text at the cursor in the body and refreshes the preview. */
  function insertAtCursor(text) {
    const start = bodyMd.selectionStart ?? bodyMd.value.length;
    const end = bodyMd.selectionEnd ?? start;
    bodyMd.value = bodyMd.value.slice(0, start) + text + bodyMd.value.slice(end);
    bodyMd.focus();
    bodyMd.selectionStart = bodyMd.selectionEnd = start + text.length;
    renderPreview();
  }

  const toolbarStatus = document.getElementById('toolbar-status');
  const inlineFile = document.getElementById('inline-file');
  inlineFile?.addEventListener('change', async () => {
    const file = inlineFile.files?.[0];
    if (!file) return;
    const alt = (await window.pf.prompt({ title: 'Mi látható a képen?', body: 'Rövid leírás a képernyőolvasóknak és a keresőknek. Üresen is hagyhatja.', label: 'Képleírás', required: false, confirmLabel: 'Kép beszúrása' })) ?? '';
    toolbarStatus.textContent = 'Kép feltöltése…';
    // Phone photos are scaled down first: the server accepts ~4.5 MB per request.
    const prepared = window.fodelShrinkImage ? await window.fodelShrinkImage(file) : file;
    const fd = new FormData();
    fd.append('file', prepared);
    fd.append('field', 'inline');
    const { ok, json } = await post(`/api/portal/content/blog/${postId}/media`, fd, false);
    inlineFile.value = '';
    if (!ok || !json.ok) {
      toolbarStatus.textContent = 'Nem sikerült feltölteni a képet (JPG, PNG vagy WebP lehet).';
      return;
    }
    insertAtCursor(`\n\n![${alt.replace(/[\[\]]/g, '')}](${json.url})\n\n`);
    toolbarStatus.textContent = 'Kép beszúrva — ne felejtsen el menteni.';
  });

  document.getElementById('insert-link')?.addEventListener('click', async () => {
    const selected = bodyMd.value.slice(bodyMd.selectionStart, bodyMd.selectionEnd);
    const href = await window.pf.prompt({ title: 'Link beszúrása', body: 'Teljes cím (https://…) vagy a weboldalon belüli útvonal (/hu/ingatlanok/).', label: 'Link címe', value: 'https://', confirmLabel: 'Tovább' });
    if (!href || href === 'https://') return;
    const label = selected || (await window.pf.prompt({ title: 'A link szövege', body: 'Ezt látja majd az olvasó.', label: 'Szöveg', required: false, confirmLabel: 'Beszúrás' })) || href;
    insertAtCursor(`[${label.replace(/[\[\]]/g, '')}](${href.trim()})`);
  });

  async function upload(inputId, field, statusId) {
    const input = document.getElementById(inputId);
    input?.addEventListener('change', async () => {
      const file = input.files?.[0];
      if (!file) return;
      const status = document.getElementById(statusId);
      status.textContent = 'Feltöltés…';
      const prepared = window.fodelShrinkImage ? await window.fodelShrinkImage(file) : file;
      const fd = new FormData();
      fd.append('file', prepared);
      fd.append('field', field);
      const { ok, json } = await post(`/api/portal/content/blog/${postId}/media`, fd, false);
      status.textContent = ok && json.ok ? 'Feltöltve.' : 'Nem sikerült feltölteni.';
      if (ok && json.ok) location.reload();
    });
  }
  upload('cover-file', 'cover', 'cover-status');
  upload('og-file', 'og', 'og-status');

  document.getElementById('copy-link-btn')?.addEventListener('click', async () => {
    const input = document.getElementById('public-link');
    try {
      await navigator.clipboard.writeText(input.value);
    } catch {
      input.select();
    }
  });
</script>

