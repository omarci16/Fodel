---
// Same "create then redirect into the editor" pattern as
// /portal/properties/new.astro — a blank draft, not a separate empty form.
export const prerender = false;

const { supabase, user } = Astro.locals;
if (!user) return Astro.redirect('/portal/login');

const locale = Astro.url.searchParams.get('locale') === 'nl' ? 'nl' : Astro.url.searchParams.get('locale') === 'hu' ? 'hu' : null;
if (!locale) return Astro.redirect('/portal/content/blog');
const slug = `${locale === 'hu' ? 'uj-cikk' : 'nieuw-artikel'}-${Date.now().toString(36)}`;
const { data, error } = await supabase
  .from('blog_posts')
  .insert({
    locale,
    slug,
    title: locale === 'hu' ? 'Új cikk' : 'Nieuw artikel',
    excerpt: '',
    body_md: '',
    category: '',
    published: false,
    created_by: user.id,
  })
  .select('id')
  .single();

if (error || !data) return new Response(error?.message ?? 'failed', { status: 500 });
return Astro.redirect(`/portal/content/blog/${data.id}`);
---
