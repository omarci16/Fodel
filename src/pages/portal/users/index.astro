---
/** Admin-only. Guarded by src/middleware.ts and independently by RLS. */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { createSupabaseAdminClient } from '~/lib/supabase-server';
import { LOCALE_LABEL } from '~/lib/portal/labels';
import { icon } from '~/lib/portal/icons';
import { timeAgo } from '~/lib/portal/time';

const { supabase, user } = Astro.locals;
const tab = Astro.url.searchParams.get('tab') === 'abandoned' ? 'abandoned' : 'registered';

const { data: profiles } = await supabase
  .from('profiles')
  .select('id, role, full_name, email, phone, created_at, locale')
  .order('created_at', { ascending: false });

const { data: openInvites } = await supabase
  .from('invites')
  .select('id, email, role, expires_at, created_at, invited_by, payload')
  .is('accepted_at', null)
  .order('created_at', { ascending: false });

// Two different things share the invites table. An admin's invite is a
// pending invitation. A row with no inviter was created by the public ad form
// — the visitor submitted it (with the privacy consent that form requires)
// and was sent a confirmation link: that is a registration in progress, and
// once the link lapses unused, an abandoned one. Nothing typed into a form
// without submitting it is ever stored.
const pendingInvites = (openInvites ?? []).filter((invite) => invite.invited_by);

const registeredEmails = new Set((profiles ?? []).map((profile) => profile.email.toLowerCase()));
type Attempt = NonNullable<typeof openInvites>[number];
const byEmail = new Map<string, Attempt[]>();
for (const invite of openInvites ?? []) {
  if (invite.invited_by) continue;
  const email = invite.email.toLowerCase();
  // Finished later under another link: registered, not abandoned.
  if (registeredEmails.has(email)) continue;
  byEmail.set(email, [...(byEmail.get(email) ?? []), invite]);
}
const abandoned = [...byEmail.entries()].map(([email, attempts]) => {
  const latest = attempts[0]; // ordered newest first
  const payload = (latest.payload ?? {}) as { phone?: string; settlement?: string; county?: string; locale?: string };
  return {
    email,
    latest,
    attempts: attempts.length,
    phone: payload.phone ?? '',
    place: [payload.settlement, payload.county].filter(Boolean).join(', '),
    locale: payload.locale ?? 'hu',
    linkValid: new Date(latest.expires_at).getTime() > Date.now(),
  };
});

// How many listings each person has, so an admin can see at a glance who is
// actually using the portal before deactivating anyone.
const { data: ownedCounts } = await supabase.from('properties').select('owner_id');
const listingsByOwner = new Map<string, number>();
for (const row of ownedCounts ?? []) {
  if (row.owner_id) listingsByOwner.set(row.owner_id, (listingsByOwner.get(row.owner_id) ?? 0) + 1);
}

/**
 * Who is currently locked out.
 *
 * `banned_until` lives on the auth user, not the profile, so this needs the
 * admin client — RLS has no view of auth.users at all. Listing is capped at
 * the same page size as the profile query; FODEL will not have thousands of
 * accounts, and a real paging story can wait until it does.
 */
let bannedIds = new Set<string>();
try {
  const admin = createSupabaseAdminClient();
  const { data: authUsers } = await admin.auth.admin.listUsers({ page: 1, perPage: 200 });
  bannedIds = new Set(
    (authUsers?.users ?? [])
      .filter((u: any) => u.banned_until && new Date(u.banned_until) > new Date())
      .map((u: any) => u.id)
  );
} catch (error) {
  // A missing service-role key must not take the whole screen down — the list
  // is still useful without the active/inactive column.
  console.error('[users] could not read auth status', error);
}

const now = Date.now();
const initialsOf = (name: string | null, email: string) =>
  (name || email).split(/[\s@.]+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || '?';
const admins = (profiles ?? []).filter((p) => p.role === 'admin').length;
const lockedOut = (profiles ?? []).filter((p) => bannedIds.has(p.id)).length;
---

<Portal title="Felhasználók">
  <header class="ph">
    <div>
      <p class="eyebrow">Felhasználók</p>
      <h1>{tab === 'abandoned' ? <>Félbehagyott <em>regisztrációk</em></> : <>Kik használják a <em>portált</em></>}</h1>
    </div>
    <div class="ph-side">
      <ul class="stats" aria-label="Összesítés">
        <li><b>{profiles?.length ?? 0}</b><span>Fiók</span></li>
        <li><b>{admins}</b><span>Admin</span></li>
        <li data-tone={lockedOut ? 'warn' : ''}><b>{lockedOut}</b><span>Letiltva</span></li>
      </ul>
      <a class="btn" href="/portal/users/invite"><Fragment set:html={icon('plus', 16)} /> Meghívás</a>
    </div>
  </header>

  <nav class="tabs" aria-label="Felhasználói listák">
    <a href="/portal/users" aria-current={tab === 'registered' ? 'page' : undefined}>
      Regisztrált felhasználók <span>{profiles?.length ?? 0}</span>
    </a>
    <a href="/portal/users?tab=abandoned" aria-current={tab === 'abandoned' ? 'page' : undefined}>
      Félbehagyott regisztrációk <span>{abandoned.length}</span>
    </a>
  </nav>

  <p class="status-line" id="status" role="status"></p>

  {tab === 'abandoned' ? (
    <>
      <p class="intro">
        A nyilvános hirdetésfeladó űrlapot elküldték (az adatkezelési tájékoztató elfogadásával), de a
        megerősítő linkkel a fiókot nem hozták létre. E-mail címenként egy sor; a később befejezett
        regisztrációk automatikusan átkerülnek a regisztrált felhasználók közé. Automatikus emlékeztető
        nem megy ki — lásd Beállítások → Szolgáltatások és automatizmusok.
      </p>
      {abandoned.length > 0 ? (
        <table class="list">
          <thead>
            <tr><th>E-mail</th><th>Telefon</th><th>Ingatlan</th><th>Utolsó próbálkozás</th><th>Állapot</th><th class="actions-col">Műveletek</th></tr>
          </thead>
          <tbody>
            {abandoned.map((row) => (
              <tr>
                <td>
                  <a href={`/portal/database/people/${encodeURIComponent(row.email)}`}>{row.email}</a>
                  <br /><span class="sub">{LOCALE_LABEL[row.locale] ?? row.locale}</span>
                </td>
                <td>{row.phone || '—'}</td>
                <td>{row.place || '—'}</td>
                <td>
                  {new Date(row.latest.created_at).toLocaleDateString('hu-HU')}
                  {row.attempts > 1 && <><br /><span class="sub">{row.attempts} próbálkozás</span></>}
                </td>
                <td>{row.linkValid ? <span class="pill">Folyamatban (link érvényes)</span> : <span class="pill pill-off">Félbehagyva (link lejárt)</span>}</td>
                <td class="actions-col">
                  <div class="row-actions">
                    <button type="button" data-invite={row.latest.id} data-action="resend">Új link küldése</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="empty">Nincs félbehagyott regisztráció.</p>
      )}
    </>
  ) : (
  <>
  <ul class="people">
    {(profiles ?? []).map((p) => {
      const isSelf = p.id === user?.id;
      const banned = bannedIds.has(p.id);
      const count = listingsByOwner.get(p.id) ?? 0;
      return (
        <li class:list={['person', { inactive: banned }]}>
          <span class="avatar" data-role={p.role} aria-hidden="true">{initialsOf(p.full_name, p.email)}</span>
          <div class="who">
            <b>{p.full_name ?? p.email}{isSelf && <em class="me">Ön</em>}</b>
            <span>{p.full_name ? p.email : ''}{p.phone ? ` · ${p.phone}` : ''}</span>
          </div>
          <span class:list={['role', p.role === 'admin' && 'role-admin']}>{p.role === 'admin' ? 'Admin' : 'Hirdető'}</span>
          <span class="meta">{count} hirdetés<small>{LOCALE_LABEL[p.locale] ?? p.locale} · regisztrált {timeAgo(p.created_at)}</small></span>
          <span class="state" data-off={banned ? 'true' : undefined}>{banned ? 'Letiltva' : 'Aktív'}</span>
          {isSelf ? (
            <span class="menu-slot" />
          ) : (
            <div class="pt-menu">
              <button type="button" class="pt-icon-btn" data-menu aria-haspopup="menu" aria-expanded="false" aria-label={`Műveletek: ${p.full_name ?? p.email}`}>
                <Fragment set:html={icon('dots', 18)} />
              </button>
              <div class="pt-menu-pop" role="menu" hidden>
                <button type="button" role="menuitem" data-user={p.id} data-action="set_role" data-role={p.role === 'admin' ? 'owner' : 'admin'}>
                  <Fragment set:html={icon('users', 17)} />
                  {p.role === 'admin' ? 'Hirdetővé fokozás' : 'Kinevezés adminná'}
                </button>
                <hr />
                <button type="button" role="menuitem" class={banned ? '' : 'danger'} data-user={p.id} data-action={banned ? 'reactivate' : 'deactivate'}>
                  <Fragment set:html={icon(banned ? 'check' : 'alert', 17)} />
                  {banned ? 'Fiók visszaállítása' : 'Fiók letiltása'}
                </button>
              </div>
            </div>
          )}
        </li>
      );
    })}
  </ul>

  <h2 class="sub-head">Függőben lévő meghívók</h2>
  {pendingInvites && pendingInvites.length > 0 ? (
    <table class="list">
      <thead>
        <tr><th>E-mail</th><th>Szerep</th><th>Lejár</th><th class="actions-col">Műveletek</th></tr>
      </thead>
      <tbody>
        {pendingInvites.map((i) => {
          const expired = new Date(i.expires_at).getTime() < now;
          return (
            <tr class:list={{ inactive: expired }}>
              <td>{i.email}</td>
              <td>{i.role === 'admin' ? 'Admin' : 'Hirdető'}</td>
              <td>
                {new Date(i.expires_at).toLocaleDateString('hu-HU')}
                {expired && <span class="pill pill-off">Lejárt</span>}
              </td>
              <td class="actions-col">
                <div class="row-actions">
                  <button type="button" data-invite={i.id} data-action="resend">Újraküldés</button>
                  <button type="button" data-invite={i.id} data-action="revoke">Visszavonás</button>
                </div>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  ) : (
    <p class="empty">Nincs függőben lévő meghívó.</p>
  )}
  </>
  )}
</Portal>

<script>
  const status = document.getElementById('status');

  const MESSAGES: Record<string, string> = {
    self: 'A saját fiókját nem módosíthatja innen.',
    'last-admin': 'Ez az utolsó adminisztrátori fiók — előbb nevezzen ki egy másik admint.',
    'already-accepted': 'Ezt a meghívót már elfogadták — frissítse az oldalt.',
    'no-template': 'Ezen a nyelven nincs jóváhagyott meghívószöveg (Beállítások → Meghívólevelek).',
    forbidden: 'Ehhez nincs jogosultsága.',
  };

  async function call(url: string, body: Record<string, unknown>, confirmText: string) {
    const danger = ['deactivate', 'revoke'].includes(String(body.action));
    const ok = await (window as any).pf.confirm({
      title: danger ? 'Biztosan?' : 'Megerősítés',
      body: confirmText,
      confirmLabel: 'Igen, mehet',
      danger,
    });
    if (!ok) return;
    status!.textContent = 'Feldolgozás…';
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    const json = await res.json().catch(() => ({}));
    if (!res.ok || !json.ok) {
      status!.textContent = MESSAGES[json.error] ?? 'Nem sikerült végrehajtani.';
      return;
    }
    location.reload();
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('button');
    if (!(btn instanceof HTMLButtonElement)) return;
    const action = btn.dataset.action;
    if (!action) return;

    const userId = btn.dataset.user;
    if (userId) {
      const prompts: Record<string, string> = {
        set_role:
          btn.dataset.role === 'admin'
            ? 'Adminná nevezi ki ezt a felhasználót? Ezután minden hirdetést lát és jóváhagyhat.'
            : 'Hirdetővé fokozza le ezt a felhasználót? Elveszíti az adminisztrátori jogokat.',
        deactivate: 'Letiltja ezt a fiókot? A felhasználó azonnal nem tud belépni. A hirdetései megmaradnak.',
        reactivate: 'Visszaállítja ezt a fiókot? A felhasználó ismét be tud lépni.',
      };
      call(`/api/portal/users/${userId}`, { action, role: btn.dataset.role }, prompts[action]);
      return;
    }

    const inviteId = btn.dataset.invite;
    if (inviteId) {
      const prompts: Record<string, string> = {
        resend: 'Újraküldi a meghívót? A korábbi link ezzel érvénytelenné válik.',
        revoke: 'Visszavonja ezt a meghívót? A link azonnal használhatatlan lesz.',
      };
      call(`/api/portal/users/invites/${inviteId}`, { action }, prompts[action]);
    }
  });
</script>

<style>
  .ph { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 40px; margin-bottom: 30px; }
  .eyebrow { margin-bottom: 14px; }
  h1 em { font-style: normal; font-weight: inherit; color: var(--ink-quiet); }
  .ph-side { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; }
  .stats { list-style: none; display: flex; gap: 10px; }
  .stats li { display: grid; gap: 2px; min-width: 92px; padding: 12px 18px; border-radius: var(--r-lg); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); }
  .stats b { font-family: var(--serif); font-weight: var(--fw-display); font-size: 26px; line-height: 1; color: var(--ink); }
  .stats span { font-size: 12.5px; color: var(--ink-quiet); }
  .stats li[data-tone='warn'] b { color: var(--pt-red); }
  .btn :global(svg) { width: 16px; height: 16px; }

  .tabs { display: inline-flex; gap: 4px; padding: 4px; margin-bottom: 24px; border-radius: var(--r-pill); background: var(--linen); flex-wrap: wrap; }
  .tabs a { padding: 8px 18px; border-radius: var(--r-pill); font-size: 14.5px; color: var(--ink-quiet); text-decoration: none; transition: background-color 0.25s var(--ease-out), color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out); }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-current='page'] { background: var(--white); color: var(--ink); font-weight: var(--fw-medium); box-shadow: var(--shadow-xs); }
  .tabs span { margin-left: 6px; padding: 1px 8px; border-radius: var(--r-pill); background: rgba(16, 42, 67, 0.07); font-size: 12.5px; }
  .intro { max-width: 72ch; font-size: var(--fs-small); line-height: 1.75; color: var(--ink-quiet); margin-bottom: 22px; }
  .status-line { font-size: 14px; color: var(--ink-quiet); min-height: 1.4em; margin-bottom: 10px; }
  .empty { padding: 36px 24px; border-radius: var(--r-lg); background: var(--paper); text-align: center; color: var(--ink-quiet); font-size: var(--fs-small); }
  .sub-head { font-family: var(--serif); font-weight: var(--fw-display); font-size: 21px; letter-spacing: var(--ls-heading); color: var(--ink); margin: 48px 0 16px; }
  .sub { font-size: 13px; color: var(--ink-quiet); }
  .list a { text-decoration: underline; text-underline-offset: 3px; }
  .list tr.inactive td { opacity: 0.55; }
  .actions-col { width: 1%; white-space: nowrap; }
  .row-actions { display: flex; gap: 6px; }
  .row-actions button { padding: 7px 14px; border-radius: var(--r-pill); border: 1px solid var(--pt-hair); background: var(--white); font-size: 13.5px; color: var(--ink-quiet); cursor: pointer; transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out), transform 0.2s var(--ease-out); }
  .row-actions button:hover { border-color: var(--ink); color: var(--ink); }
  .pill-off { margin-left: 8px; background: var(--pt-red-bg); color: var(--pt-red); }

  /* People: one soft row each, actions behind a menu. */
  .people { list-style: none; display: grid; gap: 10px; }
  .person { display: grid; grid-template-columns: 48px minmax(0, 1.6fr) auto minmax(110px, 0.7fr) 84px 40px; align-items: center; gap: 18px; padding: 14px 18px 14px 16px; border-radius: var(--r-lg); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); transition: box-shadow 0.3s var(--ease-out), transform 0.3s var(--ease-out); }
  .person:hover { box-shadow: var(--shadow-md), 0 0 0 1px rgba(16, 42, 67, 0.14); transform: translateY(-1px); }
  .person.inactive { background: var(--paper); }
  .person.inactive .who, .person.inactive .avatar { opacity: 0.55; }
  .avatar { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--linen); color: var(--ink); font-family: var(--serif); font-weight: var(--fw-display); font-size: 16px; letter-spacing: 0.02em; }
  .avatar[data-role='admin'] { background: var(--ink); color: var(--cream); }
  .who { display: grid; gap: 2px; min-width: 0; }
  .who b { display: flex; align-items: center; gap: 10px; font-weight: var(--fw-medium); font-size: 16px; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .who span { font-size: 14px; color: var(--ink-quiet); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .me { font-style: normal; padding: 1px 9px; border-radius: var(--r-pill); background: var(--linen); font-size: 12px; font-weight: var(--fw-regular); color: var(--ink-quiet); }
  .role { padding: 4px 13px; border-radius: var(--r-pill); background: var(--linen); font-size: 13.5px; color: var(--ink); }
  .role-admin { background: rgba(16, 42, 67, 0.1); font-weight: var(--fw-medium); }
  .meta { display: grid; font-size: 14.5px; color: var(--ink); }
  .meta small { font-size: 12.5px; color: var(--ink-quiet); }
  .state { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--pt-green); }
  .state::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .state[data-off='true'] { color: var(--pt-red); }
  .menu-slot { width: 36px; }

  @media (max-width: 960px) {
    .person { grid-template-columns: 48px minmax(0, 1fr) 40px; row-gap: 10px; }
    .role, .meta, .state { grid-column: 2; }
    .person > .pt-menu, .person > .menu-slot { grid-column: 3; grid-row: 1; }
    .meta { display: flex; gap: 10px; align-items: baseline; }
  }
  @media (max-width: 860px) {
    .list { display: block; overflow-x: auto; white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) { .person { transition: none; } .person:hover { transform: none; } }
</style>
