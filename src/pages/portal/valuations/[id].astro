---
/**
 * One valuation: the facts it was run against, the comparables and
 * statistics, the AI adjustment/rationale if AI_ENABLED, and the admin
 * decision — edit the band, approve (emails the public lead, if any) or
 * reject ("we'll call you"). "Számítás" runs the comps+stats(+AI) pass; it
 * is the one place the AI call happens, never inside the public form.
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { eur } from '~/lib/format';
import type { Comp } from '~/lib/ai/valuation';
import { VALUATION_STATUS_LABEL as STATUS_LABEL, LOCALE_LABEL } from '~/lib/portal/labels';
import { describeAnswer } from '~/data/valuation-questions';
import { getTaxonomy, getCompany, termLabel } from '~/lib/runtime-config';
import { createSupabaseAdminClient } from '~/lib/supabase-server';
import { isAiEnabled } from '~/lib/ai/client';
import { valuationPackage } from '~/lib/valuation/packages';
import { DOCUMENT_BUCKET, type ValuationDocument } from '~/lib/valuation/documents';
import type { Nearby } from '~/lib/valuation/nearby';
import type { ValuationAnalysis } from '~/lib/ai/valuation-analysis';
import { formatCents } from '~/lib/orders';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const { id } = Astro.params;
const { data: v } = await supabase.from('valuations').select('*').eq('id', id).maybeSingle();
if (!v) return new Response('Nem található.', { status: 404 });

const comps = (v.comps ?? []) as Comp[];

const taxonomy = await getTaxonomy();
const categoryName = termLabel(taxonomy.category.find((term) => term.key === v.category), 'hu') || v.category;

// Columns from migration 0014; absent (undefined) until it has been run.
const answers = Object.entries((v.answers ?? {}) as Record<string, string>).map(([key, value]) => describeAnswer(key, String(value)));
const answerGroups = [1,2,3,4].map((step) => ({ step, title: ['', 'Ingatlan', 'Épület és műszaki állapot', 'Környezet', 'Extrák és korlátok'][step], rows: answers.filter((answer) => answer.step === step) }));
const unknownHu = (value: string | null | undefined) => value === 'nem-tudom' || value === 'unknown' ? 'Nem tudom' : null;
const extentLabel: Record<string, string> = { partial: 'Részleges', full: 'Teljes', none: 'Nem volt', unknown: 'Nem tudom' };
const company = await getCompany();
const baseline = v.baseline as { kind?: string; source?: string; year?: number; count?: number; level?: string; dispersionPercent?: number; url?: string; retrievedAt?: string } | null;
const factors = (Array.isArray(v.factors) ? v.factors : []) as { text: string; direction: string }[];
const requestKind = v.request_kind ?? 'indicative';
const kindLabel = valuationPackage(company.services, requestKind)?.names.hu ?? requestKind;
const photoRows = (Array.isArray(v.photos) ? v.photos : []) as { path: string }[];
const isLead = v.source === 'public_lead' && Boolean(v.contact_email);

// The photos sit in a private bucket; an admin sees them through links that
// expire after an hour, so a copied URL does not stay public.
let photos: { url: string }[] = [];
if (photoRows.length > 0) {
  const { data: signed } = await createSupabaseAdminClient()
    .storage.from('valuation-media')
    .createSignedUrls(photoRows.map((photo) => photo.path), 60 * 60);
  photos = (signed ?? []).flatMap((row) => (row.signedUrl ? [{ url: row.signedUrl }] : []));
}

// Customer documents: private bucket, links that expire after an hour.
const documents = (Array.isArray(v.documents) ? v.documents : []) as ValuationDocument[];
let documentLinks: { name: string; size: number; url: string | null }[] = [];
if (documents.length > 0) {
  const { data: signed } = await createSupabaseAdminClient().storage.from(DOCUMENT_BUCKET).createSignedUrls(documents.map((doc) => doc.path), 60 * 60);
  documentLinks = documents.map((doc, index) => ({ name: doc.name, size: doc.size, url: signed?.[index]?.signedUrl ?? null }));
}
const megabytes = (bytes: number) => (bytes ? `${(bytes / (1024 * 1024)).toFixed(bytes < 1024 * 1024 ? 2 : 1)} MB` : '—');

const nearby = (v.nearby ?? null) as Nearby | null;
const analysis = (v.ai_analysis ?? null) as ValuationAnalysis | null;
const aiOn = isAiEnabled();
const directionLabel: Record<string, string> = { plus: 'Értéknövelő', minus: 'Értékcsökkentő', unsure: 'Bizonytalan' };
const sourceLabel: Record<string, string> = { customer: 'ügyfél', photos: 'fotók', documents: 'dokumentumok', location: 'környék', statistics: 'statisztika' };
const positionLabel: Record<string, string> = { lower: 'a sáv alsó részén', middle: 'a sáv közepén', upper: 'a sáv felső részén', unclear: 'nem eldönthető' };
const rangeLabel = (meters: number) => (meters >= 1000 ? `${(meters / 1000).toFixed(1).replace('.', ',')} km` : `${meters} m`);

// What was paid for this request, if anything (payments.valuation_id, migration 0017).
const { data: paymentRows } = await createSupabaseAdminClient().from('payments').select('status, amount_cents, paid_at').eq('valuation_id', v.id).order('created_at', { ascending: false });
const payment = paymentRows?.[0] ?? null;
const paymentLabel: Record<string, string> = { pending: 'Fizetésre vár', paid: 'Kártyával fizetve', cancelled: 'Megszakítva', refunded: 'Visszatérítve', manual: 'Átutalással rendezve' };

const canCompute = ['queued', 'needs_info', 'insufficient_data'].includes(v.status);
const canDecide = v.status !== 'queued';
---

<Portal title="Értékbecslés">
  <header class="head">
    <p class="eyebrow"><a href="/portal/valuations">← Értékbecslések</a></p>
    <h1>{categoryName} · {v.county}{v.settlement ? `, ${v.settlement}` : ''}</h1>
    <span class="pill">{STATUS_LABEL[v.status] ?? v.status}</span>
  </header>

  <section class="grid">
    <div class="col">
      <h2>Adatok</h2>
      <dl class="facts">
        <div><dt>Forrás</dt><dd>{v.source === 'public_lead' ? 'Nyilvános űrlap' : 'Admin (hirdetés)'}</dd></div>
        <div><dt>Típus</dt><dd>{categoryName}</dd></div>
        <div><dt>Kérés</dt><dd>{kindLabel}</dd></div>
        {payment && <div><dt>Fizetés</dt><dd>{paymentLabel[payment.status] ?? payment.status} · {formatCents(payment.amount_cents)}</dd></div>}
        {v.address_private && <div><dt>Pontos cím (nem nyilvános)</dt><dd>{v.address_private}</dd></div>}
        {v.locale && <div><dt>Nyelv</dt><dd>{LOCALE_LABEL[v.locale] ?? v.locale}</dd></div>}
        <div><dt>Alapterület</dt><dd>{v.floor_m2 ?? '—'} m²</dd></div>
        <div><dt>Telek</dt><dd>{v.plot_m2 ?? '—'} m²</dd></div>
        <div><dt>Épült</dt><dd>{v.year_built ?? '—'}</dd></div>
        <div><dt>Állapot</dt><dd>{v.condition ?? '—'}</dd></div>
        {v.bedrooms != null && <div><dt>Szobák</dt><dd>{v.bedrooms}</dd></div>}
        {v.bathrooms != null && <div><dt>Fürdőszobák</dt><dd>{v.bathrooms}</dd></div>}
        {v.parcel_count != null && <div><dt>Helyrajzi számok</dt><dd>{v.parcel_count}</dd></div>}
        {(v.renovated_in || v.renovation_extent) && <div><dt>Felújítva</dt><dd>{[v.renovated_in, extentLabel[v.renovation_extent] ?? v.renovation_extent].filter(Boolean).join(' · ') || '—'}</dd></div>}
        {v.condition_key && <div><dt>Állapotbesorolás</dt><dd>{unknownHu(v.condition_key) || termLabel(taxonomy.condition.find((term) => term.key === v.condition_key), 'hu') || v.condition_key}</dd></div>}
        {v.heating_key && <div><dt>Fűtés</dt><dd>{unknownHu(v.heating_key) || termLabel(taxonomy.heating.find((term) => term.key === v.heating_key), 'hu') || v.heating_key}</dd></div>}
        {v.epc_class && <div><dt>Energetika</dt><dd>{unknownHu(v.epc_class) || v.epc_class}</dd></div>}
        {Array.isArray(v.features) && v.features.length > 0 && <div><dt>Extrák</dt><dd>{v.features.map((key: string) => termLabel(taxonomy.feature.find((term) => term.key === key), 'hu') || key).join(', ')}</dd></div>}
        {v.contact_name && <div><dt>Kapcsolat</dt><dd>{v.contact_name} · {v.contact_email} · {v.contact_phone ?? '—'}</dd></div>}
      </dl>

      {answers.length > 0 && (
        <>
          {answerGroups.filter((group) => group.rows.length).map((group) => <><h2>{group.title}</h2><dl class="answers">{group.rows.map((a) => <div><dt>{a.question}</dt><dd>{a.answer}</dd></div>)}</dl></>)}
        </>
      )}
      {factors.length > 0 && <><h2>Értéket befolyásoló szempontok</h2><ul class="ai-factors">{factors.map((factor) => <li>{factor.direction === 'plus' ? 'Értéknövelő' : factor.direction === 'minus' ? 'Értékcsökkentő' : 'Bizonytalan'}: {factor.text}</li>)}</ul></>}
      {baseline && <><h2>Adatalap</h2><p class="hint">{baseline.kind === 'ksh' ? `KSH Ingatlanadattár, ${baseline.year} · ${baseline.level === 'county' ? 'vármegyei helyettesítés' : 'települési adat'} · ${baseline.count} ügylet` : `${baseline.count} hasonló FODEL-hirdetés`}</p>{baseline.dispersionPercent != null && <p class="hint">KSH szórás: {baseline.dispersionPercent}% (tájékoztató statisztikai adat).</p>}{baseline.url && <a href={baseline.url} target="_blank" rel="noopener">Forrás: KSH Ingatlanadattár, {baseline.year}{baseline.retrievedAt ? ` (letöltve: ${baseline.retrievedAt})` : ''} · CC BY 4.0</a>}</>}

      {photoRows.length > 0 && (
        <>
          <h2>Fényképek ({photoRows.length})</h2>
          {photos.length > 0 ? (
            <ul class="photos">
              {photos.map((photo, i) => (
                <li><a href={photo.url} target="_blank" rel="noopener"><img src={photo.url} alt={`Beküldött kép ${i + 1}`} loading="lazy" /></a></li>
              ))}
            </ul>
          ) : (
            <p class="notice">A képeket most nem sikerült betölteni. Frissítse az oldalt.</p>
          )}
        </>
      )}

      {documentLinks.length > 0 && (
        <>
          <h2>Dokumentumok ({documentLinks.length})</h2>
          <ul class="docs">
            {documentLinks.map((doc) => (
              <li>{doc.url ? <a href={doc.url} target="_blank" rel="noopener">{doc.name}</a> : <span>{doc.name}</span>}<span class="size">{megabytes(doc.size)}</span></li>
            ))}
          </ul>
          <p class="hint">A letöltési linkek egy óráig érvényesek.</p>
        </>
      )}

      <h2>Környék (OpenStreetMap)</h2>
      {nearby ? (
        <>
          <p class="hint">{nearby.center.precise ? 'A megadott pontos cím alapján' : 'A település közepe alapján'}: {nearby.center.label}</p>
          <table class="comps">
            <thead><tr><th>Mi</th><th class="right">Darab</th><th class="right">Legközelebbi</th></tr></thead>
            <tbody>
              {nearby.groups.map((group) => (
                <tr>
                  <td>{group.labelHu} <span class="size">({group.radiusM / 1000} km-en belül)</span></td>
                  <td class="right">{group.count}</td>
                  <td class="right">{group.nearestM != null ? `${rangeLabel(group.nearestM)}${group.nearestName ? ` · ${group.nearestName}` : ''}` : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="hint">{nearby.source} · lekérve: {nearby.retrievedAt}. Tájékoztató adat, az ár sávját nem módosítja.</p>
        </>
      ) : (
        <p class="hint">Még nincs lekérve. A település közepe körüli üzleteket, iskolákat, egészségügyet és közlekedést kéri le az OpenStreetMap szolgáltatásaiból.</p>
      )}
      <div class="inline-actions">
        <button type="button" class="btn ghost" id="nearby-btn">{nearby ? 'Környék frissítése' : 'Környék lekérése'}</button>
        {v.address_private && <label class="inline-check"><input type="checkbox" id="nearby-address" /> Pontos cím használata (a cím az OpenStreetMapnek is elmegy)</label>}
      </div>
      <p class="action-status" id="nearby-status" role="status"></p>

      <h2>AI elemzés</h2>
      {analysis ? (
        <>
          <p class="ai-rationale">{analysis.summaryHu}</p>
          <p class="ai-adjustment">Az ingatlan várhatóan {positionLabel[analysis.bandPosition]} helyezkedik el · biztonság: {analysis.confidence}</p>
          {analysis.valueDrivers.length > 0 && <ul class="ai-factors">{analysis.valueDrivers.map((driver) => <li>{directionLabel[driver.direction]} ({sourceLabel[driver.source] ?? driver.source}): {driver.text}</li>)}</ul>}
          {analysis.inconsistencies.length > 0 && <><h3>Ellentmondások</h3><ul class="ai-factors">{analysis.inconsistencies.map((item) => <li>{item}</li>)}</ul></>}
          {analysis.missingInfo.length > 0 && <><h3>Hiányzó információ</h3><ul class="ai-factors">{analysis.missingInfo.map((item) => <li>{item}</li>)}</ul></>}
          {analysis.documentsReviewed.length > 0 && <><h3>Dokumentumok</h3><ul class="ai-factors">{analysis.documentsReviewed.map((doc) => <li><strong>{doc.name}:</strong> {doc.finding}</li>)}</ul></>}
          {analysis.photoObservations.length > 0 && <><h3>Fotók</h3><ul class="ai-factors">{analysis.photoObservations.map((item) => <li>{item}</li>)}</ul></>}
          <p class="hint">Az elemzés {analysis.inputs.photos} képet és {analysis.inputs.documents.length} dokumentumot olvasott{analysis.inputs.documentsNotRead.length > 0 ? `; nem olvasta: ${analysis.inputs.documentsNotRead.join(', ')}` : ''}. Belső munkaanyag: nem tartalmaz árat, az ügyfél nem látja, és nem hivatalos értékbecslés.</p>
        </>
      ) : (
        <p class="hint">{aiOn ? 'Még nincs lefuttatva. Az ügyfél adatait, fotóit és dokumentumait, a statisztikai sávot és a környéket együtt értékeli. Árat nem javasol: a sávot Ön állítja be.' : 'Az AI nincs bekapcsolva (AI_ENABLED és OPENAI_API_KEY szükséges).'}</p>
      )}
      <div class="inline-actions">
        <button type="button" class="btn ghost" id="analyse-btn" disabled={!aiOn}>{analysis ? 'AI elemzés újrafuttatása' : 'AI elemzés futtatása'}</button>
      </div>
      <p class="action-status" id="analyse-status" role="status"></p>

      {v.info_request && (
        <>
          <h2>Kért hiánypótlás</h2>
          <p class="info-request">{v.info_request}</p>
        </>
      )}

      {canCompute && (
        <button type="button" class="btn" id="compute-btn">{v.status === 'queued' ? 'Számítás futtatása' : 'Számítás újrafuttatása'}</button>
      )}

      {comps.length > 0 && (
        <>
          <h2>Összehasonlító ingatlanok ({comps.length})</h2>
          <table class="comps">
            <thead><tr><th>Ref</th><th class="right">Ár</th><th class="right">Alapterület</th><th class="right">€/m²</th></tr></thead>
            <tbody>
              {comps.map((c) => (
                <tr>
                  <td><a href={`/portal/properties?ref=${c.ref}`}>#{c.ref}</a></td>
                  <td class="right">{eur(c.priceEur)}</td>
                  <td class="right">{c.floorM2} m²</td>
                  <td class="right">{eur(Math.round(c.pricePerM2))}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}

      {v.status === 'insufficient_data' && (
        <p class="notice">Nincs automatikus adatalap ehhez a kéréshez (kevesebb mint 8 FODEL-összehasonlító, és a kategóriához nincs használható KSH-adat). A sávot kézzel lehet megadni.</p>
      )}

      {(v.ai_rationale_hu || v.ai_adjustment_percent != null) && (
        <>
          <h2>AI kiigazítás</h2>
          <p class="ai-adjustment">Javasolt korrekció: {v.ai_adjustment_percent > 0 ? '+' : ''}{v.ai_adjustment_percent}% ({v.ai_confidence})</p>
          <p class="ai-rationale">{v.ai_rationale_hu}</p>
          {v.ai_factors && (v.ai_factors as string[]).length > 0 && (
            <ul class="ai-factors">{(v.ai_factors as string[]).map((f) => <li>{f}</li>)}</ul>
          )}
        </>
      )}
    </div>

    <div class="col">
      {canDecide && (
        <form id="band-form" class="panel">
          <h2>Ár-sáv</h2>
          {'low_huf' in v && <><label>Alsó (HUF) <input type="number" name="lowHuf" min="1" value={v.low_huf ?? ''} /></label><label>Közép (HUF) <input type="number" name="midHuf" min="1" value={v.mid_huf ?? ''} /></label><label>Felső (HUF) <input type="number" name="highHuf" min="1" value={v.high_huf ?? ''} /></label></>}
          {company.services.eurHufRate && company.services.eurHufRateDate && <p class="hint">Árfolyam: 1 EUR = {company.services.eurHufRate} HUF ({company.services.eurHufRateDate}).</p>}
          {v.low_eur == null && (
            <p class="hint">Nincs számított sáv. Jóváhagyni csak kitöltött sávval lehet — ha kézzel árazza, adja meg mindhárom értéket.</p>
          )}
          <label>Alsó (€) <input type="number" name="lowEur" min="1" value={v.low_eur ?? ''} /></label>
          <label>Közép (€) <input type="number" name="midEur" min="1" value={v.mid_eur ?? ''} /></label>
          <label>Felső (€) <input type="number" name="highEur" min="1" value={v.high_eur ?? ''} /></label>
          <label>Belső megjegyzés <textarea name="note" rows="3">{v.admin_note ?? ''}</textarea></label>

          <div class="actions">
            <button type="button" class="btn" id="approve-btn">{isLead ? 'Jóváhagyás és e-mail küldése' : 'Jóváhagyás'}</button>
            <button type="button" class="btn ghost" id="reject-btn">Elvetés</button>
          </div>
          <p class="action-status" id="action-status" role="status"></p>
        </form>
      )}

      {isLead && v.status !== 'approved' && v.status !== 'rejected' && (
        <form id="info-form" class="panel">
          <h2>Hiánypótlás kérése</h2>
          <p class="hint">Az ügyfél e-mailt kap {v.locale === 'nl' ? 'hollandul' : 'magyarul'}, benne az Ön szövegével. Írja le pontosan, milyen adatot vagy képet kér.</p>
          <label>Mit kér az ügyféltől? <textarea name="infoNote" rows="4">{v.info_request ?? ''}</textarea></label>
          <div class="actions">
            <button type="button" class="btn" id="info-btn">Hiánypótlás kérése</button>
          </div>
          <p class="action-status" id="info-status" role="status"></p>
        </form>
      )}
    </div>
  </section>
</Portal>

<script define:vars={{ valuationId: v.id }}>
  const actionStatus = document.getElementById('action-status');
  const form = document.getElementById('band-form');

  async function post(action, extra = {}) {
    const payload = { action, ...extra };
    if (form && action !== 'request_info') {
      payload.lowEur = Number(form.lowEur?.value) || undefined;
      payload.midEur = Number(form.midEur?.value) || undefined;
      payload.highEur = Number(form.highEur?.value) || undefined;
      payload.lowHuf = Number(form.lowHuf?.value) || undefined;
      payload.midHuf = Number(form.midHuf?.value) || undefined;
      payload.highHuf = Number(form.highHuf?.value) || undefined;
      payload.note = form.note?.value;
    }
    const res = await fetch(`/api/portal/valuations/${valuationId}/action`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    });
    return { ok: res.ok, json: await res.json().catch(() => ({})) };
  }

  const failed = (json) => json.error || 'Nem sikerült. Próbálja újra.';

  async function simple(buttonId, statusId, action, busy, extra = {}) {
    const button = document.getElementById(buttonId);
    const status = document.getElementById(statusId);
    if (!button) return;
    button.addEventListener('click', async () => {
      button.disabled = true;
      status.textContent = busy;
      const { ok, json } = await post(action, typeof extra === 'function' ? extra() : extra);
      if (ok) { status.textContent = 'Kész.'; location.reload(); }
      else { button.disabled = false; status.textContent = failed(json); }
    });
  }
  simple('nearby-btn', 'nearby-status', 'nearby', 'Lekérés az OpenStreetMapből…', () => ({ useAddress: Boolean(document.getElementById('nearby-address')?.checked) }));
  simple('analyse-btn', 'analyse-status', 'analyse', 'Az AI elemzi az anyagot, ez akár fél percig is tarthat…');

  document.getElementById('compute-btn')?.addEventListener('click', async (e) => {
    e.target.disabled = true;
    e.target.textContent = 'Számítás…';
    const { ok } = await post('compute');
    if (ok) location.reload();
    else {
      e.target.disabled = false;
      e.target.textContent = 'Számítás sikertelen — újra';
    }
  });

  document.getElementById('approve-btn')?.addEventListener('click', async () => {
    const hufMode = Boolean(form?.lowHuf);
    const low = Number(hufMode ? form?.lowHuf?.value : form?.lowEur?.value);
    const mid = Number(hufMode ? form?.midHuf?.value : form?.midEur?.value);
    const high = Number(hufMode ? form?.highHuf?.value : form?.highEur?.value);
    if (!(low > 0 && mid > 0 && high > 0) || low > mid || mid > high) {
      actionStatus.textContent = 'Jóváhagyás előtt adjon meg érvényes ár-sávot (alsó ≤ közép ≤ felső).';
      return;
    }
    actionStatus.textContent = 'Feldolgozás…';
    const { ok, json } = await post('approve');
    actionStatus.textContent = ok ? 'Jóváhagyva.' : failed(json);
    if (ok) setTimeout(() => location.reload(), 600);
  });

  document.getElementById('reject-btn')?.addEventListener('click', async () => {
    if (!confirm('Biztosan elveti ezt a becslést?')) return;
    actionStatus.textContent = 'Feldolgozás…';
    const { ok, json } = await post('reject');
    actionStatus.textContent = ok ? 'Elvetve.' : failed(json);
    if (ok) setTimeout(() => location.reload(), 600);
  });

  document.getElementById('info-btn')?.addEventListener('click', async () => {
    const infoForm = document.getElementById('info-form');
    const status = document.getElementById('info-status');
    const note = infoForm.infoNote.value.trim();
    if (!note) {
      status.textContent = 'Írja le, milyen adatot vagy képet kér.';
      return;
    }
    if (!confirm('Elküldi a hiánypótlási kérést az ügyfélnek?')) return;
    status.textContent = 'Küldés…';
    const { ok, json } = await post('request_info', { note });
    status.textContent = ok ? 'Elküldve.' : failed(json);
    if (ok) setTimeout(() => location.reload(), 600);
  });
</script>

<style>
  .head { margin-bottom: 24px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
