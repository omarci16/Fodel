---
/** Admin — every valuation request, either surface (public lead or an
 * admin re-pricing an existing listing), same filter-chip pattern as the
 * rest of the admin screens. */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { icon } from '~/lib/portal/icons';
import { timeAgo } from '~/lib/portal/time';
import { eur } from '~/lib/format';
import { VALUATION_STATUS_LABEL as STATUS_LABEL } from '~/lib/portal/labels';
import { getTaxonomy, getCompany, termLabel } from '~/lib/runtime-config';
import { valuationPackages } from '~/lib/valuation/packages';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const filter = Astro.url.searchParams.get('status') ?? '';
const kindFilter = Astro.url.searchParams.get('kind') ?? '';

let query = supabase
  .from('valuations')
  .select('*')
  .order('created_at', { ascending: false })
  .limit(200);
if (filter) query = query.eq('status', filter);

const { data: valuations } = await query;
const shown = (valuations ?? []).filter((v) => !kindFilter || (v.request_kind ?? 'indicative') === kindFilter);
// Names come from the packages an admin edits in Beállítások → Szolgáltatások.
const kindLabel: Record<string, string> = Object.fromEntries(valuationPackages((await getCompany()).services).map((pkg) => [pkg.kind, pkg.names.hu]));
const huf = (amount: number) => new Intl.NumberFormat('hu-HU', { style: 'currency', currency: 'HUF', maximumFractionDigits: 0 }).format(amount);

// The form stores the category key; an admin reads its Hungarian name.
const taxonomy = await getTaxonomy();
const categoryName = (key: string) => termLabel(taxonomy.category.find((term) => term.key === key), 'hu') || key;

const dateFmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Portal title="Értékbecslések">
  <header class="ph">
    <div>
      <p class="eyebrow">Értékbecslések</p>
      <h1>Mit <em>érnek</em> az ingatlanok</h1>
    </div>
    <p class="count"><b>{shown.length}</b><span>tétel</span></p>
  </header>

  <div class="filters">
    <a href="/portal/valuations" aria-current={!filter ? 'page' : undefined}>Mind</a>
    {Object.entries(STATUS_LABEL).map(([value, label]) => (
      <a href={`/portal/valuations?status=${value}`} aria-current={filter === value ? 'page' : undefined}>{label}</a>
    ))}
  </div>
  <div class="filters">
    <a href={`/portal/valuations${filter ? `?status=${filter}` : ''}`} aria-current={!kindFilter ? 'page' : undefined}>Minden kérés</a>
    {Object.entries(kindLabel).map(([key,label]) => <a href={`/portal/valuations?kind=${key}${filter ? `&status=${filter}` : ''}`} aria-current={kindFilter === key ? 'page' : undefined}>{label}</a>)}
  </div>

  {shown.length > 0 ? (
    <ul class="vals">
      {shown.map((v) => (
        <li>
          <a class="val" href={`/portal/valuations/${v.id}`}>
            <div class="val-main">
              <p class="val-top">
                <span class:list={['pill', `pill-${v.status}`]}>{STATUS_LABEL[v.status] ?? v.status}</span>
                <span class="chip">{kindLabel[v.request_kind ?? 'indicative'] ?? 'Tájékoztató'}</span>
                <span class="when" title={dateFmt.format(new Date(v.created_at))}>{timeAgo(v.created_at)}</span>
              </p>
              <h2>{categoryName(v.category)} <span>· {v.county}{v.settlement ? `, ${v.settlement}` : ''}</span></h2>
              <p class="who">{v.contact_name ?? 'Admin becslés'}{v.source !== 'public_lead' && v.contact_name ? ' · admin' : ''}</p>
            </div>
            <div class="band">
              {v.low_huf ? (
                <><b>{huf(v.low_huf)}</b><span>– {huf(v.high_huf)}</span></>
              ) : v.low_eur ? (
                <><b>{eur(v.low_eur)}</b><span>– {eur(v.high_eur)}</span></>
              ) : (
                <span class="none">Még nincs sáv</span>
              )}
            </div>
            <span class="go" aria-hidden="true" set:html={icon('move', 18)} />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div class="empty">
      <span class="empty-ic" set:html={icon('calc', 26)} />
      <p>Ehhez a szűréshez nincs tétel.</p>
      <a class="btn ghost" href="/portal/valuations">Szűrők törlése</a>
    </div>
  )}
</Portal>

<style>
  .ph .count { display: flex; align-items: baseline; gap: 8px; }
  .count b { font-family: var(--serif); font-weight: var(--fw-display); font-size: 44px; line-height: 1; color: var(--ink); }
  .count span { color: var(--ink-quiet); }
  .filters { margin-bottom: 12px; }
  .filters + .filters { margin-bottom: 26px; }

  .vals { list-style: none; display: grid; gap: 10px; }
  .val { display: grid; grid-template-columns: minmax(0, 1fr) auto 28px; align-items: center; gap: 24px; padding: 20px 24px; border-radius: var(--r-lg); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); color: inherit; text-decoration: none; transition: box-shadow 0.35s var(--ease-out), transform 0.35s var(--ease-out); }
  .val:hover { box-shadow: var(--shadow-md), 0 0 0 1px rgba(16, 42, 67, 0.16); transform: translateY(-2px); }
  .val-top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 10px; font-size: 13.5px; color: var(--ink-quiet); }
  .pill { padding: 4px 13px; border-radius: var(--r-pill); font-size: 13px; }
  .chip { padding: 3px 11px; border-radius: var(--r-pill); background: var(--linen); font-size: 13px; color: var(--ink); }
  .val h2 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 19px; letter-spacing: var(--ls-heading); color: var(--ink); line-height: 1.3; }
  .val h2 span { font-weight: var(--fw-regular); color: var(--ink-quiet); }
  .who { margin-top: 4px; font-size: 14.5px; color: var(--ink-quiet); }
  .band { display: grid; justify-items: end; gap: 2px; font-variant-numeric: tabular-nums; }
  .band b { font-family: var(--serif); font-weight: var(--fw-display); font-size: 20px; color: var(--ink); }
  .band span { font-size: 14.5px; color: var(--ink-quiet); }
  .band .none { font-size: 14px; }
  .go { color: var(--ink-quiet); transition: transform 0.3s var(--ease-out), color 0.3s var(--ease-out); }
  .go :global(svg) { width: 18px; height: 18px; }
  .val:hover .go { color: var(--ink); transform: translateX(4px); }

  .empty { display: grid; justify-items: center; gap: 14px; padding: 56px 20px; border-radius: var(--r-xl); background: var(--paper); box-shadow: 0 0 0 1px var(--pt-hair); text-align: center; color: var(--ink-quiet); }
  .empty-ic { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--white); color: var(--ink); box-shadow: var(--shadow-sm); }

  @media (max-width: 720px) {
    .val { grid-template-columns: minmax(0, 1fr) 28px; gap: 12px 16px; }
    .band { grid-column: 1; justify-items: start; grid-row: 2; }
    .go { grid-row: 1; grid-column: 2; }
  }
  @media (prefers-reduced-motion: reduce) { .val, .go { transition: none; } .val:hover { transform: none; } }
</style>
