---
/** Admin — every valuation request, either surface (public lead or an
 * admin re-pricing an existing listing), same filter-chip pattern as the
 * rest of the admin screens. */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { eur } from '~/lib/format';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const filter = Astro.url.searchParams.get('status') ?? '';

let query = supabase
  .from('valuations')
  .select('id, source, category, county, settlement, contact_name, comp_count, low_eur, high_eur, status, created_at')
  .order('created_at', { ascending: false })
  .limit(200);
if (filter) query = query.eq('status', filter);

const { data: valuations } = await query;

const STATUS_LABEL: Record<string, string> = {
  queued: 'Feldolgozásra vár',
  insufficient_data: 'Kevés összehasonlító adat',
  needs_review: 'Ellenőrzésre vár',
  approved: 'Jóváhagyva',
  rejected: 'Elvetve',
};

const dateFmt = new Intl.DateTimeFormat('hu-HU', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Portal title="Értékbecslések">
  <header class="head">
    <p class="eyebrow">Értékbecslések</p>
    <h1>{valuations?.length ?? 0} tétel</h1>
  </header>

  <div class="filters">
    <a href="/portal/valuations" aria-current={!filter ? 'page' : undefined}>Mind</a>
    {Object.entries(STATUS_LABEL).map(([value, label]) => (
      <a href={`/portal/valuations?status=${value}`} aria-current={filter === value ? 'page' : undefined}>{label}</a>
    ))}
  </div>

  {valuations && valuations.length > 0 ? (
    <table class="list">
      <thead><tr><th>Dátum</th><th>Forrás</th><th>Ingatlan</th><th>Kapcsolat</th><th class="right">Sáv</th><th>Állapot</th></tr></thead>
      <tbody>
        {valuations.map((v) => (
          <tr>
            <td class="nowrap">{dateFmt.format(new Date(v.created_at))}</td>
            <td>{v.source === 'public_lead' ? 'Nyilvános' : 'Admin'}</td>
            <td>{v.category} · {v.county}{v.settlement ? `, ${v.settlement}` : ''}</td>
            <td>{v.contact_name ?? '—'}</td>
            <td class="right">{v.low_eur ? `${eur(v.low_eur)} – ${eur(v.high_eur)}` : '—'}</td>
            <td>
              <span class:list={['pill', `pill-${v.status}`]}>{STATUS_LABEL[v.status] ?? v.status}</span>
              <br /><a href={`/portal/valuations/${v.id}`} class="detail-link">Részletek →</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p class="empty">Ehhez a szűréshez nincs tétel.</p>
  )}
</Portal>

<style>
  .head { margin-bottom: 20px; }
  .eyebrow { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--taupe); margin-bottom: 8px; }
  h1 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 26px; color: var(--ink); }

  .filters { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 22px; }
  .filters a { padding: 7px 14px; font-size: var(--fs-micro); letter-spacing: 0.04em; color: var(--taupe); border: 1px solid var(--border); }
  .filters a[aria-current='page'] { background: var(--ink); color: var(--cream); border-color: var(--ink); }

  .empty { color: var(--taupe); font-size: var(--fs-small); padding: 32px 0; }

  .list { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .list th { text-align: left; font-size: var(--fs-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--taupe); padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .list td { padding: 12px; border-bottom: 1px solid var(--border); color: var(--ink); vertical-align: top; }
  .list a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .detail-link { font-size: var(--fs-micro); }
  .nowrap { white-space: nowrap; }
  .right { text-align: right; }

  .pill { display: inline-block; font-size: var(--fs-micro); padding: 3px 10px; border: 1px solid var(--border); white-space: nowrap; }
  .pill-approved { background: rgba(16, 42, 67, 0.08); border-color: var(--ink); }
  .pill-needs_review, .pill-queued { background: rgba(200, 150, 0, 0.1); border-color: #96700b; color: #6b4f08; }
  .pill-rejected, .pill-insufficient_data { opacity: 0.6; }

  @media (max-width: 860px) {
    .list { display: block; overflow-x: auto; }
  }
</style>
