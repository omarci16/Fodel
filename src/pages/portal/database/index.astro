---
/**
 * The admin "Database" — every recorded event, filterable and paginated.
 *
 * Server-rendered, zero client state, same posture as /portal/payments:
 * facet filters are plain `<a href="?…">` chips, pagination is keyset (the
 * `before` param is the oldest row's `occurred_at` on the current page) so it
 * stays correct even while new events are still being written.
 *
 * Admin-only — enforced by src/middleware.ts's ADMIN_ONLY_PREFIXES, and
 * independently by RLS (activity_events has no policy at all for anon or
 * authenticated non-admins).
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';
import { EVENT_LABEL, eventLabel } from '~/lib/portal/labels';
import { icon } from '~/lib/portal/icons';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const params = Astro.url.searchParams;
const kind = params.get('kind') ?? '';
const locale = params.get('locale') ?? '';
const source = params.get('source') ?? '';
const actor = params.get('actor') ?? '';
const from = params.get('from') ?? '';
const to = params.get('to') ?? '';
const before = params.get('before') ?? '';

const PAGE_SIZE = 50;

let query = supabase
  .from('activity_events')
  .select('id, occurred_at, kind, actor_email, subject_type, subject_id, property_id, locale, source, payload')
  .order('occurred_at', { ascending: false })
  .limit(PAGE_SIZE);

if (kind) query = query.eq('kind', kind);
if (locale) query = query.eq('locale', locale);
if (source) query = query.eq('source', source);
if (actor) query = query.ilike('actor_email', `%${actor}%`);
if (from) query = query.gte('occurred_at', new Date(from).toISOString());
if (to) query = query.lte('occurred_at', new Date(`${to}T23:59:59`).toISOString());
if (before) query = query.lt('occurred_at', before);

const { data: events } = await query;

// The property refs referenced on this page, resolved in one round trip
// rather than N+1 — this table intentionally has no FK-join convenience
// because a logged property can have been deleted since.
const propertyIds = [...new Set((events ?? []).map((e) => e.property_id).filter(Boolean))];
const { data: properties } = propertyIds.length
  ? await supabase.from('properties').select('id, ref').in('id', propertyIds)
  : { data: [] };
const refById = new Map((properties ?? []).map((p: any) => [p.id, p.ref]));

// The kinds are a known set written only by application code (every
// src/lib/activity.ts call site), so the filter chips come from the same
// label table that names them — one list, not two that can drift apart.
const KNOWN_KINDS = Object.keys(EVENT_LABEL);

const nextCursor = events && events.length === PAGE_SIZE ? events[events.length - 1].occurred_at : null;

const dateFmt = new Intl.DateTimeFormat('hu-HU', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

// The export follows exactly the filter on screen (minus the page cursor —
// it exports every matching row, not just this page).
const exportParams = new URLSearchParams(params);
exportParams.delete('before');
const exportHref = `/api/portal/database/export${exportParams.size ? `?${exportParams}` : ''}`;

// Events grouped by calendar day, newest first — an activity log reads as a timeline.
const dayFmt = new Intl.DateTimeFormat('hu-HU', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
const timeFmt = new Intl.DateTimeFormat('hu-HU', { hour: '2-digit', minute: '2-digit' });
const dayKey = (iso: string) => new Date(iso).toLocaleDateString('sv-SE');
const todayKey = new Date().toLocaleDateString('sv-SE');
const yesterdayKey = new Date(Date.now() - 86400_000).toLocaleDateString('sv-SE');
const days: { key: string; label: string; items: NonNullable<typeof events> }[] = [];
for (const event of events ?? []) {
  const key = dayKey(event.occurred_at);
  let day = days.find((entry) => entry.key === key);
  if (!day) {
    day = { key, label: key === todayKey ? 'Ma' : key === yesterdayKey ? 'Tegnap' : dayFmt.format(new Date(event.occurred_at)), items: [] };
    days.push(day);
  }
  day.items.push(event);
}
const filtered = Boolean(kind || locale || source || actor || from || to);

const withParam = (key: string, value: string) => {
  const next = new URLSearchParams(params);
  next.delete('before');
  if (value) next.set(key, value);
  else next.delete(key);
  return `/portal/database?${next.toString()}`;
};
---

<Portal title="Adatbázis">
  <header class="ph">
    <div>
      <p class="eyebrow">Adatbázis</p>
      <h1>Aktivitási <em>napló</em></h1>
    </div>
    <a href={exportHref} class="btn ghost" data-no-progress>
      <Fragment set:html={icon('archive', 17)} /> CSV export
    </a>
  </header>

  <form method="GET" class="filter-card">
    <input type="hidden" name="kind" value={kind} />
    <div class="chips" aria-label="Esemény típusa">
      <a href={withParam('kind', '')} aria-current={!kind ? 'page' : undefined}>Mind</a>
      {KNOWN_KINDS.map((k) => (
        <a href={withParam('kind', k)} aria-current={kind === k ? 'page' : undefined}>{eventLabel(k)}</a>
      ))}
    </div>
    <div class="row">
      <label>
        Nyelv
        <select name="locale">
          <option value="" selected={!locale}>Mind</option>
          <option value="hu" selected={locale === 'hu'}>HU</option>
          <option value="nl" selected={locale === 'nl'}>NL</option>
          <option value="en" selected={locale === 'en'}>EN</option>
          <option value="de" selected={locale === 'de'}>DE</option>
        </select>
      </label>
      <label>
        Forrás
        <input name="source" value={source} placeholder="pl. portal, /hu/kapcsolat/" />
      </label>
      <label>
        E-mail
        <input name="actor" value={actor} placeholder="részleges egyezés" />
      </label>
      <label>
        Tól
        <input type="date" name="from" value={from} />
      </label>
      <label>
        Ig
        <input type="date" name="to" value={to} />
      </label>
      <div class="row-go">
        <button type="submit" class="btn">Szűrés</button>
        {filtered && <a class="clear" href="/portal/database">Törlés</a>}
      </div>
    </div>
  </form>

  {days.length > 0 ? (
    <div class="timeline">
      {days.map((day) => (
        <section class="day">
          <h2><span>{day.label}</span><small>{day.items.length} esemény</small></h2>
          <ul>
            {day.items.map((e) => (
              <li class="ev">
                <time datetime={e.occurred_at}>{timeFmt.format(new Date(e.occurred_at))}</time>
                <span class="node" aria-hidden="true"></span>
                <div class="ev-body">
                  <span class="pill" title={e.kind}>{eventLabel(e.kind)}</span>
                  <span class="ev-who">
                    {e.actor_email ? <a href={`/portal/database/people/${encodeURIComponent(e.actor_email)}`}>{e.actor_email}</a> : <span class="sub">Rendszer / látogató</span>}
                    {e.property_id && <> · <a class="ref" href={`/portal/properties/${e.property_id}`}>#{refById.get(e.property_id) ?? '—'}</a></>}
                  </span>
                </div>
                <span class="ev-src" title={e.source ?? ''}>{e.source ?? ''}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  ) : (
    <div class="empty">
      <p>Ehhez a szűréshez nincs esemény.</p>
      <a class="btn ghost" href="/portal/database">Szűrők törlése</a>
    </div>
  )}

  {nextCursor && (
    <a class="more btn ghost" href={withParam('before', nextCursor)}>Régebbi események <Fragment set:html={icon('move', 16)} /></a>
  )}
</Portal>

<style>
  .ph { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 40px; margin-bottom: 30px; }
  .eyebrow { margin-bottom: 14px; }
  h1 em { font-style: normal; font-weight: inherit; color: var(--ink-quiet); }
  .btn :global(svg) { width: 17px; height: 17px; }

  .filter-card { display: grid; gap: 18px; margin-bottom: 36px; padding: clamp(18px, 2.4vw, 26px); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chips a { padding: 7px 16px; border-radius: var(--r-pill); border: 1px solid var(--pt-hair); background: var(--white); font-size: 14px; color: var(--ink-quiet); text-decoration: none; transition: background-color 0.25s var(--ease-out), border-color 0.25s var(--ease-out), color 0.25s var(--ease-out); }
  .chips a:hover { border-color: var(--ink); color: var(--ink); }
  .chips a[aria-current='page'] { background: var(--ink); border-color: var(--ink); color: var(--cream); }
  .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; align-items: end; }
  .row label { display: grid; gap: 7px; font-size: 13.5px; color: var(--ink-quiet); }
  .row input, .row select { width: 100%; min-height: 46px; padding: 10px 14px; font-size: var(--fs-small); color: var(--ink); }
  .row-go { display: flex; align-items: center; gap: 16px; }
  .clear { font-size: 14px; color: var(--ink-quiet); text-decoration: underline; text-underline-offset: 3px; }

  /* A timeline: day by day, newest first. */
  .timeline { display: grid; gap: 36px; }
  .day h2 { display: flex; align-items: baseline; gap: 14px; margin-bottom: 14px; font-family: var(--serif); font-weight: var(--fw-display); font-size: 20px; letter-spacing: var(--ls-heading); color: var(--ink); text-transform: capitalize; }
  .day h2 small { font-size: 13.5px; font-weight: var(--fw-regular); color: var(--ink-quiet); text-transform: none; letter-spacing: 0; }
  .day ul { list-style: none; position: relative; border-radius: var(--r-lg); background: var(--white); box-shadow: var(--shadow-xs), 0 0 0 1px var(--pt-hair); }
  .ev { display: grid; grid-template-columns: 56px 14px minmax(0, 1fr) minmax(0, 220px); align-items: center; gap: 14px; padding: 13px 20px; transition: background-color 0.2s var(--ease-out); }
  .ev:first-child { border-radius: var(--r-lg) var(--r-lg) 0 0; }
  .ev:last-child { border-radius: 0 0 var(--r-lg) var(--r-lg); }
  .ev + .ev { border-top: 1px solid var(--pt-hair); }
  .ev:hover { background: var(--paper); }
  .ev time { font-size: 14px; color: var(--ink-quiet); font-variant-numeric: tabular-nums; }
  .node { width: 9px; height: 9px; border-radius: 50%; background: var(--ink); opacity: 0.7; box-shadow: 0 0 0 4px rgba(16, 42, 67, 0.08); }
  .ev-body { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; min-width: 0; }
  .ev-who { font-size: 14.5px; color: var(--ink); overflow-wrap: anywhere; }
  .ev-who a { text-decoration: underline; text-underline-offset: 3px; }
  .ref { font-weight: var(--fw-medium); }
  .ev-src { font-size: 13px; color: var(--ink-quiet); text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sub { font-size: 14px; color: var(--ink-quiet); }

  .empty { display: grid; justify-items: center; gap: 14px; padding: 56px 20px; border-radius: var(--r-xl); background: var(--paper); box-shadow: 0 0 0 1px var(--pt-hair); text-align: center; color: var(--ink-quiet); }
  .more { margin-top: 28px; }
  .more :global(svg) { width: 16px; height: 16px; }

  @media (max-width: 720px) {
    .ev { grid-template-columns: 48px minmax(0, 1fr); gap: 4px 12px; }
    .node { display: none; }
    .ev-src { grid-column: 2; text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .ev { transition: none; } }
</style>
