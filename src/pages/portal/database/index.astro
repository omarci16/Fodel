---
/**
 * The admin "Database" — every recorded event, filterable and paginated.
 *
 * Server-rendered, zero client state, same posture as /portal/payments:
 * facet filters are plain `<a href="?…">` chips, pagination is keyset (the
 * `before` param is the oldest row's `occurred_at` on the current page) so it
 * stays correct even while new events are still being written.
 *
 * Admin-only — enforced by src/middleware.ts's ADMIN_ONLY_PREFIXES, and
 * independently by RLS (activity_events has no policy at all for anon or
 * authenticated non-admins).
 */
export const prerender = false;

import Portal from '~/layouts/Portal.astro';

const { supabase, profile } = Astro.locals;
if (profile?.role !== 'admin') return Astro.redirect('/portal/dashboard');

const params = Astro.url.searchParams;
const kind = params.get('kind') ?? '';
const locale = params.get('locale') ?? '';
const source = params.get('source') ?? '';
const actor = params.get('actor') ?? '';
const from = params.get('from') ?? '';
const to = params.get('to') ?? '';
const before = params.get('before') ?? '';

const PAGE_SIZE = 50;

let query = supabase
  .from('activity_events')
  .select('id, occurred_at, kind, actor_email, subject_type, subject_id, property_id, locale, source, payload')
  .order('occurred_at', { ascending: false })
  .limit(PAGE_SIZE);

if (kind) query = query.eq('kind', kind);
if (locale) query = query.eq('locale', locale);
if (source) query = query.eq('source', source);
if (actor) query = query.ilike('actor_email', `%${actor}%`);
if (from) query = query.gte('occurred_at', new Date(from).toISOString());
if (to) query = query.lte('occurred_at', new Date(`${to}T23:59:59`).toISOString());
if (before) query = query.lt('occurred_at', before);

const { data: events } = await query;

// The property refs referenced on this page, resolved in one round trip
// rather than N+1 — this table intentionally has no FK-join convenience
// because a logged property can have been deleted since.
const propertyIds = [...new Set((events ?? []).map((e) => e.property_id).filter(Boolean))];
const { data: properties } = propertyIds.length
  ? await supabase.from('properties').select('id, ref').in('id', propertyIds)
  : { data: [] };
const refById = new Map((properties ?? []).map((p: any) => [p.id, p.ref]));

// Supabase has no cheap "distinct kind" helper without a view, and this
// table's kinds are a small, known set defined entirely in application code
// (every src/lib/activity.ts call site). Listed by hand rather than queried.
const KNOWN_KINDS = [
  'enquiry.created',
  'search_request.created',
  'listing.intake',
  'callback.requested',
  'referral.created',
  'listing.submit',
  'listing.approve',
  'listing.request_changes',
  'listing.mark_sold',
  'listing.archive',
  'listing.edited',
  'listing.published',
  'media.uploaded',
  'payment.manual',
  'auth.login',
  'auth.registered',
];

const nextCursor = events && events.length === PAGE_SIZE ? events[events.length - 1].occurred_at : null;

const dateFmt = new Intl.DateTimeFormat('hu-HU', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});

const withParam = (key: string, value: string) => {
  const next = new URLSearchParams(params);
  next.delete('before');
  if (value) next.set(key, value);
  else next.delete(key);
  return `/portal/database?${next.toString()}`;
};
---

<Portal title="Adatbázis">
  <header class="head">
    <p class="eyebrow">Adatbázis</p>
    <h1>Aktivitási napló</h1>
    <a href="/api/portal/database/export" class="export-link">CSV export (aktuális szűrés, max. 10 000 sor) →</a>
  </header>

  <form method="GET" class="filters">
    <input type="hidden" name="kind" value={kind} />
    <div class="chips">
      <a href={withParam('kind', '')} aria-current={!kind ? 'page' : undefined}>Mind</a>
      {KNOWN_KINDS.map((k) => (
        <a href={withParam('kind', k)} aria-current={kind === k ? 'page' : undefined}>{k}</a>
      ))}
    </div>
    <div class="row">
      <label>
        Nyelv
        <select name="locale">
          <option value="" selected={!locale}>Mind</option>
          <option value="hu" selected={locale === 'hu'}>HU</option>
          <option value="nl" selected={locale === 'nl'}>NL</option>
        </select>
      </label>
      <label>
        Forrás
        <input name="source" value={source} placeholder="pl. portal, /hu/kapcsolat/" />
      </label>
      <label>
        E-mail
        <input name="actor" value={actor} placeholder="részleges egyezés" />
      </label>
      <label>
        Tól
        <input type="date" name="from" value={from} />
      </label>
      <label>
        Ig
        <input type="date" name="to" value={to} />
      </label>
      <button type="submit" class="btn">Szűrés</button>
    </div>
  </form>

  {events && events.length > 0 ? (
    <table class="list">
      <thead>
        <tr><th>Időpont</th><th>Esemény</th><th>Ki</th><th>Hirdetés</th><th>Forrás</th></tr>
      </thead>
      <tbody>
        {events.map((e) => (
          <tr>
            <td class="nowrap">{dateFmt.format(new Date(e.occurred_at))}</td>
            <td><span class="pill">{e.kind}</span></td>
            <td>
              {e.actor_email ? <a href={`/portal/database/people/${encodeURIComponent(e.actor_email)}`}>{e.actor_email}</a> : '—'}
            </td>
            <td>{e.property_id ? <a href={`/portal/properties/${e.property_id}`}>#{refById.get(e.property_id) ?? '—'}</a> : '—'}</td>
            <td class="sub">{e.source ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <p class="empty">Ehhez a szűréshez nincs esemény.</p>
  )}

  {nextCursor && (
    <a class="more" href={withParam('before', nextCursor)}>Régebbi események →</a>
  )}
</Portal>

<style>
  .head { margin-bottom: 20px; }
  .eyebrow { font-size: var(--fs-eyebrow); letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--taupe); margin-bottom: 8px; }
  h1 { font-family: var(--serif); font-weight: var(--fw-display); font-size: 26px; color: var(--ink); display: inline-block; margin-right: 16px; }
  .export-link { font-size: var(--fs-small); text-decoration: underline; text-underline-offset: 2px; }

  .filters { margin-bottom: 24px; }
  .chips { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 14px; }
  .chips a { padding: 6px 12px; font-size: var(--fs-micro); letter-spacing: 0.03em; color: var(--taupe); border: 1px solid var(--border); }
  .chips a[aria-current='page'] { background: var(--ink); color: var(--cream); border-color: var(--ink); }

  .row { display: flex; gap: 16px; flex-wrap: wrap; align-items: end; }
  .row label { display: flex; flex-direction: column; gap: 6px; font-size: var(--fs-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--taupe); }
  .row input, .row select { border: 1px solid var(--border); background: #fff; padding: 8px 10px; font-size: var(--fs-small); color: var(--ink); min-width: 120px; }
  .btn { padding: 9px 20px; background: var(--ink); color: var(--cream); font-size: var(--fs-micro); letter-spacing: var(--ls-button); text-transform: uppercase; height: 37px; }

  .empty { color: var(--taupe); font-size: var(--fs-small); padding: 32px 0; }

  .list { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .list th { text-align: left; font-size: var(--fs-micro); letter-spacing: 0.06em; text-transform: uppercase; color: var(--taupe); padding: 10px 12px; border-bottom: 1px solid var(--border); }
  .list td { padding: 10px 12px; border-bottom: 1px solid var(--border); color: var(--ink); vertical-align: top; }
  .list a { color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .nowrap { white-space: nowrap; }
  .sub { font-size: var(--fs-micro); color: var(--taupe); }
  .pill { display: inline-block; font-size: var(--fs-micro); padding: 3px 10px; border: 1px solid var(--border); white-space: nowrap; background: rgba(16, 42, 67, 0.05); }

  .more { display: block; margin-top: 20px; font-size: var(--fs-small); text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 860px) {
    .list { display: block; overflow-x: auto; }
  }
</style>
