---
// Rendered on demand: [slug].astro rewrites unknown slugs here, and Astro
// forbids rewriting an on-demand route to a prerendered one (ForbiddenRewrite
// — every unknown /hu/ or /nl/ URL answered 500 instead of this page).
export const prerender = false;
/**
 * 404. Bilingual, because a visitor arriving on a dead link may be coming from
 * either market — and because the old fodel.nl URLs will send traffic here
 * until the redirect map is in place.
 */
import Base from '~/layouts/Base.astro';
import Button from '~/components/Button.astro';
import { path } from '~/i18n/ui';
import { COMPANY } from '~/config/company';
---

<Base
  locale="nl"
  title="404 — Pagina niet gevonden / Az oldal nem található"
  description="De opgevraagde pagina bestaat niet. A keresett oldal nem található."
  noindex
>
  <section class="notfound">
    <p class="code num" aria-hidden="true">404</p>

    <div class="copy">
      <h1>
        <span lang="nl">Pagina niet gevonden</span>
        <em lang="hu">Az oldal nem található</em>
      </h1>

      <div class="cols">
        <div class="col" lang="nl">
          <p class="col-lang">Nederlands</p>
          <p class="col-body">
            De pagina die u zocht bestaat niet of is verplaatst. Bekijk ons aanbod,
            of neem contact met ons op.
          </p>
          <div class="actions">
            <Button variant="dark" href={path('nl', 'properties')}>Ons aanbod</Button>
            <Button variant="text" href={path('nl', 'contact')}>Contact</Button>
          </div>
        </div>

        <div class="col" lang="hu">
          <p class="col-lang">Magyar</p>
          <p class="col-body">
            A keresett oldal nem létezik, vagy áthelyeztük. Nézze meg a kínálatunkat,
            vagy vegye fel velünk a kapcsolatot.
          </p>
          <div class="actions">
            <Button variant="dark" href={path('hu', 'properties')}>Ingatlanok</Button>
            <Button variant="text" href={path('hu', 'contact')}>Kapcsolat</Button>
          </div>
        </div>
      </div>

      <p class="reach">
        <a href={COMPANY.phones[0].href}>{COMPANY.phones[0].display}</a>
        <a href={COMPANY.phones[1].href}>{COMPANY.phones[1].display}</a>
        <a href={`mailto:${COMPANY.email.primary}`}>{COMPANY.email.primary}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* One page for both markets: a light 404 set like the site's figures, the
     apology in both languages, and a way onward from each. */
  .notfound {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    align-items: start;
    padding: 120px var(--pad-x) var(--section-y);
  }
  /* -0.035em: the 4's own side bearing, so its ink meets the margin. */
  .code {
    margin-left: -0.035em;
    font-family: var(--serif);
    font-weight: var(--fw-light);
    font-size: clamp(140px, 19vw, 300px);
    line-height: 0.8;
    letter-spacing: -0.045em;
    color: var(--ink);
    animation: fx-fade-up 1.3s var(--ease-out) 0.2s both;
  }
  .copy {
    animation: fx-fade-up 1.3s var(--ease-out) 0.4s both;
  }
  h1 {
    display: flex;
    flex-direction: column;
    margin-bottom: 56px;
    font-family: var(--serif);
    font-weight: var(--fw-hero);
    font-size: clamp(34px, 3.8vw, 58px);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
    color: var(--ink);
  }
  h1 em {
    font-weight: var(--fw-light);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }
  .col-lang {
    margin-bottom: 12px;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--taupe);
  }
  .col-body {
    margin-bottom: 28px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--taupe);
  }
  /* Stacked in both columns, so neither language wraps differently. */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    color: var(--taupe);
  }
  .reach a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .notfound {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 768px) {
    .notfound {
      padding: 56px var(--pad-x-mob) var(--section-y-mob);
    }
    h1 {
      margin-bottom: 40px;
    }
    .cols {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
